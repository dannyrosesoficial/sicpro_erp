<odoo>
    <record id="view_tree_dbr_module_historial" model="ir.ui.view">
        <field name="name">dbr_module_historial.view.list</field>
        <field name="model">sicpro.modulo.historial.aplicaciones</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  default_order="create_date desc"
                  decoration-danger="type == 'uninstall'"
                  decoration-info="type == 'install'"
                  decoration-warning="type == 'upgrade'">

                <field name="create_date" string="Fecha y Hora" widget="datetime"/>
                <field name="module_name"/>
                <field name="type" widget="badge"
                       decoration-danger="type == 'uninstall'"
                       decoration-info="type == 'install'"
                       decoration-success="type == 'upgrade'"/>
                <field name="user_id" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="view_form_dbr_module_historial" model="ir.ui.view">
        <field name="name">dbr_module_historial.view.form</field>
        <field name="model">sicpro.modulo.historial.aplicaciones</field>
        <field name="arch" type="xml">
            <form string="Detalle de Historial" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="module_name"/>
                            <field name="type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_view_dbr_module_historial" model="ir.actions.act_window">
        <field name="name">Historial de Aplicaciones</field>
        <field name="res_model">sicpro.modulo.historial.aplicaciones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No se han registrado movimientos de módulos todavía.
            </p>
            <p>
                Aquí aparecerán las instalaciones, actualizaciones y desinstalaciones del SICPRO.
            </p>
        </field>
    </record>

    <menuitem name="Historial de Aplicaciones"
              id="menu_view_dbr_module_historial"
              parent="sicpro_app_administracion.menu_administracion_1"
              action="action_view_dbr_module_historial"
              sequence="20"/>
</odoo>