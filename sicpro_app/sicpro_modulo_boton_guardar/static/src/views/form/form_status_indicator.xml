<templates xml:space="preserve">
<t t-inherit="web.FormStatusIndicator" t-inherit-mode="extension">
    <xpath expr="//button[contains(@class, 'o_form_button_save')]" position="replace">
            <button type="button" style="margin-right: 4px;" class="o_form_button_save btn btn-primary"
                data-hotkey="s" t-on-click.stop="save" data-tooltip="Guardar manualmente"
                aria-label="Guardar manualmente" t-ref="save">Guardar
            </button>
    </xpath>
  <xpath expr="//button[contains(@class, 'o_form_button_cancel')]" position="replace">
    <button type="button" class="o_form_button_cancel btn btn-secondary" data-hotkey="j"
        t-on-click.stop="discard" data-tooltip="Descartar cambios" aria-label="Descartar cambios">Descartar
    </button>
    </xpath>
    </t>
</templates>
