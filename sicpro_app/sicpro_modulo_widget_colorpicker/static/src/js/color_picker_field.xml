<templates>
  <t t-name="sicpro_modulo_widget_colorpicker.FieldColorPicker">
    <div t-ref="el" class="o_field_colorpicker">
      <!-- Modo de solo lectura -->
      <div t-if="props.readonly" class="d-flex align-items-center">
        <div class="color-preview me-2"
             t-attf-style="background-color: {{value || 'rgba(0, 0, 0, 1)'}}; width: 30px; height: 30px; border-radius: 3px;"></div>
        <span t-esc="formattedValue"/>
      </div>

      <!-- Modo de edición -->
      <div t-else="" class="d-flex align-items-center">
        <!-- Entrada oculta para almacenar valor -->
        <input
            type="text"
            t-att-id="props.id"
            t-ref="ColorChar"
            t-att-value="value || 'rgba(0, 0, 0, 1)'"
            class="d-none"
            autocomplete="off"/>

        <!-- Contenedor recogedor -->
        <div t-ref="pickrContainer" class="color-picker-button me-2"
             style="width: 40px; height: 30px; border-radius: 3px; cursor: pointer;">
          <div class="pickr-container" style="width: 40px; height: 30px; border-radius: 3px;">
            <div class="pickr-color" style="width: 40px; height: 30px; border-radius: 3px;"></div>
            <div class="pickr-opacity" style="width: 40px; height: 30px; border-radius: 3px;"></div>
          </div>
        </div>

        <!-- Mostrar el valor de color actual -->
        <span class="color-value" t-esc="value || 'rgba(0, 0, 0, 1)'"></span>
      </div>
    </div>
  </t>
</templates>