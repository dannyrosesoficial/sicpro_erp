<odoo>
  <!-- Configuración -->
  <record id="salon_clases_temas_form" model="ir.ui.view">
    <field name="name">sicpro.app.salon.clases.temas.form</field>
    <field name="model">sicpro.app.salon.clases.temas</field>
    <field name="arch" type="xml">
      <form string="Especialista">
        <sheet>
          <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                  invisible="active == True"/>
          <div class="oe_title">
            <h1>
              <field name="name" placeholder="Nombre de la Temática"/>
            </h1>
            <div name="options_active">
              <div>
                <label for="tipo" class="oe_inline" string="Tipo :"/>
                <field name="tipo" class="oe_inline oe_input_align"
                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              </div>
            </div>
          </div>
          <group>
            <group>
              <field name="active" invisible="1"/>
              <field name="user_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </group>
            <group>
              <field name="company_id" invisible="1"/>
              <field name="nivel" widget="priority"/>
            </group>
          </group>
          <group>
            <group>
              <field name="color" widget="color_picker"/>
            </group>
            <group>
            </group>
          </group>
          <group>
            <field name="description"/>
          </group>
        </sheet>
        <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
      </form>
    </field>
  </record>

  <record id="salon_clases_temas_list" model="ir.ui.view">
    <field name="name">sicpro.app.salon.clases.temas.list</field>
    <field name="model">sicpro.app.salon.clases.temas</field>
    <field name="arch" type="xml">
      <list>
        <field name="message_needaction" column_invisible="1"/>
        <field name="active" column_invisible="1"/>
        <field name="name"/>
        <field name="tipo"/>
        <field name="company_id" groups="base.group_multi_company"/>
      </list>
    </field>
  </record>

  <record id="salon_clases_temas_filter" model="ir.ui.view">
    <field name="name">sicpro.app.salon.clases.temas.search</field>
    <field name="model">sicpro.app.salon.clases.temas</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="tipo"/>
        <field name="company_id"/>
        <separator/>
        <filter string="Archivadas" name="inactive" domain="[('active', '=', False)]"/>
        <separator/>
        <group>
          <filter string="Organizador" name="user_id" context="{'group_by': 'user_id'}"/>
          <filter name="tipo" string="Tipo de Temario" context="{'group_by': 'tipo'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="salon_clases_temas_action" model="ir.actions.act_window">
    <field name="name">Tematicas de Estudio</field>
    <field name="res_model">sicpro.app.salon.clases.temas</field>
    <field name="domain">[]</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="salon_clases_temas_filter"/>
    <field name="context">{}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_empty_folder">
        Crear nueva temática de estudio
      </p>
    </field>
  </record>


  <!-- Ejecución -->
  <record model="ir.ui.view" id="salon_clases_temas_kanban">
    <field name="name">sicpro.app.salon.clases.temas.kanban</field>
    <field name="model">sicpro.app.salon.clases.temas</field>
    <field name="arch" type="xml">
      <kanban highlight_color="color"
              class="o_kanban_dashboard o_project_kanban o_emphasize_colors"
              create="false" edit="false" delete="false"
              sample="1">
        <field name="name"/>
        <field name="color"/>
        <field name="tipo"/>
        <field name="user_id"/>
        <field name="clases_count"/>
        <field name="nivel"/> <templates>
        <t t-name="card">
          <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_global_click o_has_icon">
            <div class="o_project_kanban_main">
              <div class="o_kanban_card_content">
                <div class="o_kanban_primary_left">
                  <div class="o_primary">
                    <strong><field name="name"/></strong>
                  </div>

                  <div class="mt-2 mb-2">
                    <div class="row">
                      <div class="col-12">
                        <button class="btn btn-primary btn-sm"
                                name="%(sicpro_app_salon_clases.sicpro_app_salon_clases_action)d"
                                type="action">Ver Clases</button>
                      </div>
                    </div>
                  </div>

                  <div class="text-muted">
                    <span>Tipo: <strong><field name="tipo"/></strong></span>
                  </div>
                  <div class="d-flex align-items-center">
                    <span>Nivel: </span>
                    <field name="nivel" widget="priority" readonly="1" class="ms-1"/>
                  </div>
                </div>
              </div>
              <div class="o_kanban_record_top">
                <div class="o_kanban_record_headings ms-auto">
                  <field name="favorito" widget="boolean_favorite" nolabel="1"/>
                </div>
              </div>
            </div>

            <div class="o_kanban_record_bottom mt-3">
              <div class="oe_kanban_bottom_left">
                <div class="badge rounded-pill text-bg-info">
                  Clases: <field name="clases_count"/>
                </div>
              </div>
              <div class="oe_kanban_bottom_right">
                <field name="user_id" widget="many2one_avatar_user"/>
              </div>
            </div>
          </div>
        </t>
      </templates>
      </kanban>
    </field>
  </record>

  <record id="salon_clases_temas_kanban_action" model="ir.actions.act_window">
    <field name="name">Temáticas de Estudios</field>
    <field name="res_model">sicpro.app.salon.clases.temas</field>
    <field name="domain">[]</field>
    <field name="view_mode">kanban,form</field>
    <field name="view_id" ref="salon_clases_temas_kanban"/>
    <field name="search_view_id" ref="salon_clases_temas_filter"/>
    <field name="target">main</field>
  </record>
</odoo>
