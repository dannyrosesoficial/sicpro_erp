<odoo>
  <record model="ir.ui.view" id="salon_clases_etiquetas_search_view">
    <field name="name">sicpro.app.salon.clases.etiquetas.search</field>
    <field name="model">sicpro.app.salon.clases.etiquetas</field>
    <field name="arch" type="xml">
      <search string="Buscar Etiquetas">
        <field name="name"/>
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="salon_clases_etiquetas_form_view">
    <field name="name">sicpro.app.salon.clases.etiquetas.form</field>
    <field name="model">sicpro.app.salon.clases.etiquetas</field>
    <field name="arch" type="xml">
      <form string="Etiquetas">
        <sheet>
          <group>
            <field name="name"/>
            <field name="color" widget="color_picker"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="salon_clases_etiquetas_list_view">
    <field name="name">sicpro.app.salon.clases.etiquetas.list</field>
    <field name="model">sicpro.app.salon.clases.etiquetas</field>
    <field name="arch" type="xml">
      <list string="Etiquetas" editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="salon_clases_etiquetas_action" model="ir.actions.act_window">
    <field name="name">Etiquetas</field>
    <field name="res_model">sicpro.app.salon.clases.etiquetas</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear nueva etiqueta…
      </p>
    </field>
  </record>
</odoo>
