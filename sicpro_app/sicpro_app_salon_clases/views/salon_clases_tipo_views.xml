<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="salon_clases_tipos_search_view">
            <field name="name">sicpro.app.salon.clases.tipo.search</field>
            <field name="model">sicpro.app.salon.clases.tipo</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="salon_clases_tipos_form_view">
            <field name="name">sicpro.app.salon.clases.tipo.form</field>
            <field name="model">sicpro.app.salon.clases.tipo</field>
            <field name="arch" type="xml">
                <form string="Tipos">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="salon_clases_tipos_tree_view">
            <field name="name">sicpro.app.salon.clases.tipo.tree</field>
            <field name="model">sicpro.app.salon.clases.tipo</field>
            <field name="arch" type="xml">
                <tree string="Tipos" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <record id="salon_clases_tipos_action" model="ir.actions.act_window">
            <field name="name">Tipos de Temáticas</field>
            <field name="res_model">sicpro.app.salon.clases.tipo</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear un nuevo tipo…
              </p>
            </field>
        </record>
    
    </data>
</odoo>