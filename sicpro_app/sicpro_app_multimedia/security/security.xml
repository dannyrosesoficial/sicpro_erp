<odoo>
    <data noupdate="1">
        <record id="module_category_sicpro_multimedia" model="ir.module.category">
            <field name="name">SICPRO Multimedia</field>
            <field name="sequence">95</field>
        </record>

        <record id="group_multimedia_user" model="res.groups">
            <field name="name">Usuario de Multimedia</field>
            <field name="category_id" ref="module_category_sicpro_multimedia"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_multimedia_admin" model="res.groups">
            <field name="name">Administrador de Multimedia</field>
            <field name="category_id" ref="module_category_sicpro_multimedia"/>
            <field name="implied_ids" eval="[(4, ref('group_multimedia_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
