<odoo>
    <record id="view_sicpro_multimedia_tag_list" model="ir.ui.view">
        <field name="name">sicpro.multimedia.tag.list</field>
        <field name="model">sicpro.multimedia.tag</field>
        <field name="arch" type="xml">
            <list string="Etiquetas Multimedia" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_sicpro_multimedia_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas de Medios</field>
        <field name="res_model">sicpro.multimedia.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>