<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="solicitudes_ejecutor_rechazada_form" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.motivo.wizard.t4.form</field>
    <field name="model">sicpro.app.solicitudes.motivo.wizard</field>
    <field name="priority">160</field>
    <field name="arch" type="xml">
      <form string="Motivo del Rechazo">
        <group class="oe_title">
          <field name="action_type" invisible="1"/>
          <field name="lost_reason_id" required="1"/>
        </group>
        <footer>
          <button name="action_procesar" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="solicitudes_ejecutor_rechazada_action" model="ir.actions.act_window">
    <field name="name">Motivo de Rechazo</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.solicitudes.motivo.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="solicitudes_ejecutor_rechazada_form"/>
    <field name="target">new</field>
    <field name="context">{'default_action_type': 'reject_t4'}</field>
  </record>
  <record id="solicitudes_ejecutor_oportunidades_form" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.asignacion.wizard.t4.form</field>
    <field name="model">sicpro.app.solicitudes.asignacion.wizard</field>
    <field name="priority">110</field>
    <field name="arch" type="xml">
      <form string="Crear oportunidad">
        <group name="ejecucion">
          <field name="ejecucion" widget="radio" readonly="1"/>
          <field name="assignment_type" invisible="1"/>
        </group>
        <group string="Asignar esta oportunidad a" class="oe_title">
          <field name="company_id"/>
          <field name="grupo_ejecutor"/>
          <field name="especialista_ejecutor"
                 options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
        </group>
        <footer>
          <button name="action_asignar" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="solicitudes_ejecutor_oportunidades_action" model="ir.actions.act_window">
    <field name="name">Crear Oportunidad</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.solicitudes.asignacion.wizard</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="solicitudes_ejecutor_oportunidades_form"/>
    <field name="target">new</field>
    <field name="context">{'default_assignment_type': 'grupo_t4'}</field>
  </record>

  <record id="solicitudes_ejecutor_horizontal_form" model="ir.ui.view">
    <field name="name">sicpro.app.grupo.ejecutor.horizontal.form</field>
    <field name="model">sicpro.app.grupo.ejecutor.horizontal</field>
    <field name="priority">110</field>
    <field name="arch" type="xml">
      <form string="Crear Solicitud Horizontal">
        <group>
          <group>
            <h4>
              <field name="id_solicitud" readonly="1"/>
            </h4>
          </group>
          <group>
            <field name="solicitud" invisible="True"
                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
          </group>
        </group>
        <group>
          <group>
            <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            <field name="company_currency" invisible="1"/>
            <field name="especialidad"
                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            <field name="codigo_especialidad" invisible="1"/>
            <field name="departamento"
                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
          </group>
          <group>
            <field name="valor_sap_cup"/>
            <field name="priority" widget="priority"/>
            <field name="tag_ids" widget="many2many_tags"/>
          </group>
          <label for="motivo_solicitud_horizontal"/>
          <field name="motivo_solicitud_horizontal"/>
        </group>
        <notebook>
          <page string="Documentación">
            <group string="Documentación para el Proyectista">
              <group>
                <field name="microlocalizacion"/>
                <field name="enia"/>
              </group>
              <group>
                <field name="ipf"/>
              </group>
            </group>
            <group string="Documentación Técnica">
              <group string="Proyecto">
                <field name="ejecucion_proyecto"/>
                <field name="consecutivo_proyecto"
                       invisible="not ejecucion_proyecto"/>
              </group>
              <group string="Tarea Técnica">
                <field name="ejecucion_tt"/>
                <field name="codigo_tt" invisible="not ejecucion_tt"/>
              </group>
              <group>
                <field name="attachment_ids" widget="many2many_binary" class="oe_inline"/>
              </group>
            </group>
          </page>
          <page string="Equipos y Materiales">
            <group string="Equipos y Materiales para la Ejecución">
              <group string="Datos del Equipamiento">
                <field name="datos_equipamiento_1"/>
                <field name="datos_equipamiento_2"/>
                <field name="datos_equipamiento_3"/>
                <field name="datos_equipamiento_4"/>
                <field name="datos_equipamiento_5"/>
              </group>
              <group string="Datos de los Materiales">
                <field name="datos_materiales_1"/>
                <field name="datos_materiales_2"/>
                <field name="datos_materiales_3"/>
                <field name="datos_materiales_4"/>
              </group>
            </group>
          </page>
          <page string="Alcance los Trabajos">
            <field name="description" placeholder="Añadir una descripción..."/>
          </page>
        </notebook>
        <footer>
          <button name="action_crear_solicitud_horizontal" string="Crear" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="solicitudes_ejecutor_horizontal_action" model="ir.actions.act_window">
    <field name="name">Crear Solicitud Horizontal</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.grupo.ejecutor.horizontal</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="solicitudes_ejecutor_horizontal_form"/>
    <field name="target">new</field>
  </record>

  <record id="solicitudes_ejecutor_search" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.ejecutor.search</field>
    <field name="model">sicpro.app.solicitudes.oportunidades</field>
    <field name="arch" type="xml">
      <search string="Buscar iniciativas">
        <field name="name" string="Iniciativas"
               filter_domain="['|','|', ('partner_name', 'ilike', self),('partner_id', 'ilike', self),
                           ('name', 'ilike', self)]"/>
        <field name="tag_ids" string="Etiquetas" filter_domain="[('tag_ids', 'ilike', self)]"/>
        <field name="partner_id"/>
        <field name="id_solicitud" string="Solicitud ID"/>
        <field name="pep_corto" string="Número SAP"/>
        <field name="anio" string="Año"/>
        <separator/>
        <filter string="Iniciativas" name="type_iniciativa" domain="[('type', '=', 'iniciativa')]"/>
        <separator/>
        <filter string="Fecha de Solicitud" name="fecha_solicitud_trabajo" date="fecha_solicitud_trabajo"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
        <group>
          <filter string="Departamento" name="departamento" context="{'group_by':'departamento'}"/>
          <filter string="Cliente" name="partner_id" context="{'group_by':'partner_id'}"/>
          <filter string="Territorio" name="territorio_id" context="{'group_by':'territorio_id'}"/>
          <filter name="provincia_id" string="Provincia" context="{'group_by': 'provincia_id'}"/>
          <filter string="Prioridad" name="priority" context="{'group_by':'priority'}"/>
          <filter string="Proceso Ejecutor" name="company_id" context="{'group_by':'company_id'}"/>
          <separator orientation="vertical"/>
          <filter string="Fecha de creación" context="{'group_by':'fecha_solicitud_trabajo:month'}"
                  name="month_creation"/>
          <filter string="Año" context="{'group_by':'anio'}" name="group_by_anio"/>
        </group>
      </search>
    </field>
  </record>

  <record id="solicitudes_ejecutor_list" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.ejecutor.list</field>
    <field name="model">sicpro.app.solicitudes.oportunidades</field>
    <field name="priority">150</field>
    <field name="arch" type="xml">
      <list string="Iniciativas" create="false"
            decoration-warning="estado_interno == 'rechazada_agrupacion'"
            decoration-success="estado_interno == 'aprobada'">
        <field name="estado_interno" column_invisible="1"/>
        <field name="id_solicitud" string="Id Solicitud"/>
        <field name="especialidad"/>
        <field name="name" string="Iniciativa"/>
        <field name="pep_corto"/>
        <field name="partner_id" optional="hide"/>
        <field name="partner_name" optional="hide"/>
        <field name="territorio_id"/>
        <field name="priority" widget="priority"/>
        <field name="fecha_solicitud_trabajo"/>
        <field name="departamento" groups="sicpro_app_solicitudes.grupo_app_ejecutor_ejecutor"/>
        <field name="company_id" optional="hide"/>
        <field name="tipo" column_invisible="1"/>
      </list>
    </field>
  </record>

  <record id="solicitudes_ejecutor_form" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.ejecutor.form</field>
    <field name="model">sicpro.app.solicitudes.oportunidades</field>
    <field name="priority">150</field>
    <field name="arch" type="xml">
      <form class="o_lead_opportunity_form" create="false" edit="true">
        <header>
          <field name="estado_interno" invisible="1"/>
          <field name="tipo" invisible="1"/>
          <button name="action_archivar_subsolicitud" string="Archivar Subsolicitud" type="object"
                  class="oe_highlight"
                  invisible="tipo == 'principal' or estado_interno != 'nuevo' or not active or type == 'oportunidad'"/>

          <button name="action_desarchivar_subsolicitud" string="Activar Subsolicitud" type="object"
                  invisible="tipo == 'principal' or estado_interno != 'nuevo' or active or type == 'oportunidad'"/>

          <button name="%(solicitudes_ejecutor_oportunidades_action)d" string="Convertir en Oportunidad"
                  type="action" class="oe_highlight"
                  invisible="estado_interno != 'aprobada' or not active or type == 'oportunidad'"/>

          <button name="%(solicitudes_ejecutor_horizontal_action)d" string="Crear Solicitud Horizontal"
                  type="action" class="oe_highlight"
                  invisible="estado_interno != 'aprobada' or not active or type == 'oportunidad'"/>

          <button name="%(solicitudes_ejecutor_oportunidades_action)d" string="Restaurar" type="action"
                  class="oe_highlight"
                  invisible="estado_interno != 'rechazada_agrupacion' or not active or type == 'oportunidad'"/>

          <button name="%(solicitudes_ejecutor_rechazada_action)d" string="Rechazar" type="action"
                  invisible="estado_interno not in ['aprobada', 'rechazada_agrupacion'] or not active or type == 'oportunidad'"/>

          <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"
                 invisible="not active or type == 'iniciativa'"/>

        </header>
        <sheet>
          <field name="solicitud_horizontal" invisible="1"/>
          <field name="active" invisible="1"/>
          <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                  invisible="active"/>
          <widget name="web_ribbon" title="Cancelada" bg_color="text-bg-danger"
                  invisible="estado_interno not in ['cancelada_cliente', 'cancelada_ejecutor']"/>
          <widget name="web_ribbon" title="Rechazado" bg_color="text-bg-warning"
                  invisible="estado_interno not in ['rechazada_dtp', 'rechazada_ejecutor']"/>
          <field name="image_1920" widget="image" class="oe_avatar"
                 options="{'preview_image': 'image_128'}"/>

          <div class="oe_title">
            <label for="name" class="oe_edit_only" string="Iniciativa"/>
            <h1>
              <field name="name" readonly="1"/>
            </h1>
            <h4>
              <field name="especialidad" readonly="1" domain="[('company_id', '=', company_id)]"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </h4>
          </div>
          <group>
            <group>
              <field name="company_currency" invisible="1"/>
              <field name="type" invisible="1"/>
              <field name="valor_sap_cup" readonly="1" widget='monetary'
                     options="{'currency_field': 'company_currency'}"/>
            </group>
            <group>
              <field name="pep" readonly="1"/>
            </group>
            <group>
              <field name="id_solicitud"/>
              <field name="anio" readonly="1"/>
              <field name="tag_ids" widget="many2many_tags"
                     options="{'color_field': 'color', 'no_create_edit': True}"/>
              <field name="c_mep"/>
            </group>
            <group>
              <field name="priority" widget="priority"/>
              <field name="grupo_ejecutor" readonly="1"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="departamento" string="Departamento" readonly="1"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="company_id" string="Proceso" readonly="1"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="lugar_trabajo"/>
            </group>
          </group>
          <group>
            <group string="Detalles importantes sobre la solicitud" class="oe_title">
              <field name="observaciones_grupo_ejecutor" placeholder="Añadir una observación..."/>
            </group>
            <group string="Detalles sobre la solicitud horizontal" class="oe_title">
              <field name="motivo_solicitud_horizontal" readonly="1" string="Motivo"
                     invisible="not solicitud_horizontal"/>
              <field name="solicitante_solicitud_horizontal" readonly="1" string="Solicitante"
                     invisible="not solicitud_horizontal"/>
            </group>
          </group>

          <group>
            <field name="motivo_rechazo" readonly="1"
                   invisible="estado_interno != 'rechazada_agrupacion'"/>
          </group>
          <notebook>
            <page string="Documentación" invisible="tipo == 'principal'">
              <group string="Documentación para el Proyectista">
                <group>
                  <field name="microlocalizacion" readonly="1"/>
                  <field name="enia" readonly="1"/>
                </group>
                <group>
                  <field name="ipf" readonly="1"/>
                </group>
              </group>
              <group string="Documentación Técnica">
                <group string="Proyecto">
                  <field name="ejecucion_proyecto" readonly="1"/>
                  <field name="consecutivo_proyecto"
                         invisible="not ejecucion_proyecto"/>
                </group>
                <group string="Tarea Técnica">
                  <field name="ejecucion_tt" readonly="1"/>
                  <field name="codigo_tt" invisible="not ejecucion_tt"/>
                </group>
                <group>
                  <field name="attachment_ids" widget="many2many_binary" class="oe_inline"/>
                </group>
              </group>
            </page>
            <page string="Equipos y Materiales" invisible="tipo == 'principal'">
              <group string="Equipos y Materiales para la Ejecución">
                <group string="Datos del Equipamiento">
                  <field name="datos_equipamiento_1" readonly="1"/>
                  <field name="datos_equipamiento_2" readonly="1"/>
                  <field name="datos_equipamiento_3" readonly="1"/>
                  <field name="datos_equipamiento_4" readonly="1"/>
                  <field name="datos_equipamiento_5" readonly="1"/>
                </group>
                <group string="Datos de los Materiales">
                  <field name="datos_materiales_1" readonly="1"/>
                  <field name="datos_materiales_2" readonly="1"/>
                  <field name="datos_materiales_3" readonly="1"/>
                  <field name="datos_materiales_4" readonly="1"/>
                </group>
              </group>
            </page>
            <page string="Alcance los Trabajos" invisible="tipo == 'principal'">
              <field name="description" placeholder="Añadir una descripción..."/>
            </page>
            <page string="información extra">
              <group>
                <group string="Asignación" name="categorization">
                  <field name="company_cliente" options="{'no_create': True}"/>
                </group>
                <group string="Análisis">
                  <field name="fecha_solicitud_trabajo" readonly="1"/>
                  <field name="fecha_aprobacion" readonly="1"/>
                  <field name="fecha_revision" readonly="1"/>
                </group>
              </group>
            </page>
            <page string="Cliente">
              <group>
                <group string="Información de contacto">
                  <field name="partner_id" readonly="1"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                  <field name="territorio_id" readonly="1"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                  <field name="provincia_id" readonly="1"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                  <field name="website" readonly="1" widget="url"/>
                </group>
                <group class="mt48">
                  <field name="cargo" readonly="1"/>
                  <field name="telefono_fijo" readonly="1"/>
                  <field name="telefono_movil" readonly="1"/>
                  <field name="correo" widget="email" readonly="1"/>
                  <field name="pagina_web" widget="url" readonly="1"/>
                </group>
                <group string="Otros">
                  <field name="dias_aprobar"/>
                  <field name="dias_asignar"/>
                  <field name="type" invisible="1"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
      </form>
    </field>
  </record>

  <record id="solicitudes_ejecutor_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.ejecutor.kanban</field>
    <field name="model">sicpro.app.solicitudes.oportunidades</field>
    <field name="priority" eval="150"/>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile" archivable="false" sample="1">
        <field name="name"/>
        <field name="partner_id"/>
        <field name="priority"/>
        <field name="tag_ids"/>
        <field name="user_id"/>
        <field name="activity_ids"/>
        <field name="activity_state"/>
        <progressbar field="activity_state"
                     colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_content oe_kanban_global_click">
              <div>
                <strong class="o_kanban_record_title"><span><field name="name"/></span></strong>
              </div>
              <div>
                <span class="o_kanban_record_subtitle"><field name="partner_id"/></span>
              </div>
              <div>
                <field name="tag_ids"/>
              </div>
              <div class="o_kanban_record_bottom">
                <div class="oe_kanban_bottom_left">
                  <field name="priority" widget="priority"/>
                  <div class="o_kanban_inline_block">
                    <field name="activity_ids" widget="kanban_activity"/>
                  </div>
                </div>
                <div class="oe_kanban_bottom_right">
                  <field name="user_id" widget="many2one_avatar_user"/>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="solicitudes_ejecutor_calendar" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.ejecutor.calendar</field>
    <field name="model">sicpro.app.solicitudes.oportunidades</field>
    <field name="priority" eval="150"/>
    <field name="arch" type="xml">
      <calendar string="Iniciativas" mode="month" date_start="activity_date_deadline" color="user_id"
                hide_time="true" event_limit="5">
        <field name="partner_id" avatar_field="image_128"/>
      </calendar>
    </field>
  </record>

  <record id="solicitudes_ejecutor_activity" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.ejecutor.activity</field>
    <field name="model">sicpro.app.solicitudes.oportunidades</field>
    <field name="arch" type="xml">
      <activity string="Iniciativas y oportunidades">
        <field name="partner_id"/>
        <templates>
          <div t-name="activity-box">
            <img t-att-src="'/web/image/sicpro.app.clientes/' + record.partner_id.raw_value + '/image_128'"
                 t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"/>
            <div>
              <field name="name" display="full"/>
            </div>
          </div>
        </templates>
      </activity>
    </field>
  </record>

  <record model="ir.actions.act_window" id="solicitudes_ejecutor_action">
    <field name="name">Distribuidores</field>
    <field name="res_model">sicpro.app.solicitudes.oportunidades</field>
    <field name="view_mode">list,kanban,calendar,form,activity</field>
    <field name="domain">[('tipo', '=', 'subsolicitud'), ('estado_interno', '=', 'aprobada')]</field>
    <field name="search_view_id" ref="solicitudes_ejecutor_search"/>
    <field name="context">{'search_default_anio': (context_today().strftime('%Y')), 'search_default_departamento': 1,
                           'search_default_type_iniciativa': 1}
    </field>
    <field name="view_ids" eval="[(5, 0, 0),
    (0, 0, {'view_mode': 'list', 'view_id': ref('solicitudes_ejecutor_list')}),
    (0, 0, {'view_mode': 'kanban', 'view_id': ref('solicitudes_ejecutor_kanban')}),
    (0, 0, {'view_mode': 'form', 'view_id': ref('solicitudes_ejecutor_form')}),
    (0, 0, {'view_mode': 'calendar', 'view_id': ref('solicitudes_ejecutor_calendar')}),
    (0, 0, {'view_mode': 'activity', 'view_id': ref('solicitudes_ejecutor_activity')})
  ]"/>
  </record>
</odoo>