<?xml version="1.0"?>
<odoo>

     <!-- Inicio de las Vistas del modal para el rechazo de la solicitud-->
    <record id="solicitudes_negocio_rechazada_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.rechazadas.t3.form</field>
            <field name="model">sicpro.app.solicitudes.rechazadas.t3</field>
            <field name="priority">110</field>
            <field name="arch" type="xml">
                <form string="Motivo de Rechazo al Cliente">
                    <group class="oe_title">
                        <field name="lost_reason_id"/>
                    </group>
                    <footer>
                        <button name="action_motivo_rechazo_t3" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
    </record>

    <record id="solicitudes_negocio_rechazada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Rechazo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.solicitudes.rechazadas.t3</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="solicitudes_negocio_rechazada_form"/>
            <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para el rechazo de la solicitud-->

     <!-- Inicio de las Vistas del modal para la cancelación de la solicitud-->
    <record id="solicitudes_negocio_cancelada_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.canceladas.t3.form</field>
            <field name="model">sicpro.app.solicitudes.canceladas.t3</field>
            <field name="priority">120</field>
            <field name="arch" type="xml">
                <form string="Motivo de Cancelación al Cliente">
                    <group class="oe_title">
                        <field name="motivo_cancelacion"/>
                    </group>
                    <footer>
                        <button name="action_motivo_cancelacion_t3" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
    </record>

    <record id="solicitudes_negocio_cancelada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Cancelación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.solicitudes.canceladas.t3</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="solicitudes_negocio_cancelada_form"/>
            <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para la cancelación de la solicitud-->


    <record id="solicitudes_negociacion_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.negociacion.form</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <form class="o_lead_opportunity_form" create="false">
                    <header>
                       <field name="estado_interno" invisible="1"/>
                       <field name="tipo" invisible="1"/>
                       <button name="action_archivar_subsolicitud" string="Archivar Subsolicitud" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'nuevo'), ('tipo', '=', 'principal')]}"/>

                       <button name="action_desarchivar_subsolicitud" string="Activar Subsolicitud" type="object"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '!=', False),
                            ('estado_interno', '!=', 'nuevo'), ('tipo', '=', 'principal')]}"/>

                       <button name="action_negociacion_aprobar" string="Aprobar" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', '|', '|','|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'liberada'), ('tipo', '!=', 'principal'),('pg_rechazado', '!=', False)]}"/>

                       <button name="action_negociacion_pg_aprobar" string="Enviar a Revisión" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', '|', '|','|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'liberada'), ('tipo', '!=', 'principal'),('pg_revisado', '!=', False)]}"/>

                       <button name="%(solicitudes_negocio_rechazada_action)d" string="Rechazar" type="action"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                             ('estado_interno', '!=', 'liberada'), ('tipo', '!=', 'principal')]}"/>

                       <button name="%(solicitudes_negocio_cancelada_action)d" string="Cancelar" type="action"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno','not in',['liberada', 'rechazada_ejecutor']), ('tipo', '!=', 'principal')]}"/>

                       <button name="action_negociacion_restaurar_ejecutor" string="Restaurar" type="object"
                               class="oe_highlight"
                            attrs="{'invisible': ['|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'rechazada_ejecutor')]}"/>
                   </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <field name="user_id" invisible="1"/>
                        <field name="type" invisible="1"/>
                        <field name="pg_revisado" invisible="1"/>
                        <field name="pg_rechazado" invisible="1"/>
                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <widget name="web_ribbon" title="Cancelada" bg_color="bg-danger"
                                attrs="{'invisible': [('estado_interno', 'not in',['cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                        <widget name="web_ribbon" title="Rechazado" bg_color="bg-warning"
                                attrs="{'invisible': [('estado_interno', 'not in',['rechazada_dtp', 'rechazada_ejecutor'])]}"/>
                        <div class="oe_title">
                           <label for="name" class="oe_edit_only" string="Iniciativa"/>
                            <h1>
                                <field name="name" 
                                       attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                       placeholder="ej. Nombre de la solicitud de trabajo" />
                            </h1>
                            <h4>
                                <field name="especialidad" readonly="1" domain="[('company_id', '=', company_id)]"
                                       attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}"/>
                            </h4>
                            <h2 class="o_row row no-gutters d-flex">
                                <div class="col" attrs="{'invisible': ['|', ('estado_interno', '=', False),
                                ('estado_interno', 'in', ['nuevo', 'rechazada_dtp', 'cancelada'])]}">
                                    <label for="valor_sap_cup" class="oe_edit_only" />
                                    <div class="o_row">
                                        <field name="company_currency" invisible="1"/>
                                        <field name="valor_sap_cup" class="oe_inline" widget='monetary'
                                               attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                               options="{'currency_field': 'company_currency'}"/>
                                    </div>
                                </div>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="partner_id" readonly="1"/>
                                <field name="partner_name"/>
                                <field name="territorio_id" options="{'no_open': True}"/>
                                <field name="provincia_id" options="{'no_open': True}" />
                                <field name="website" widget="url" placeholder="ej. https://www.etecsa.cu"/>
                            </group>
                            <group>
                                <field name="cargo"/>
                                <field name="telefono_fijo"/>
                                <field name="telefono_movil"/>
                                <field name="correo"/>
                                <field name="pagina_web" widget="url" placeholder="ej. https://www.cliente.etecsa.cu"/>
                            </group><group>
                                <field name="tag_ids" widget="many2many_tags"
                                       attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                       options="{'color_field': 'color', 'no_create_edit': True}"/>
                                <field name="id_solicitud"/>
                                <field name="anio" invisible="1"/>
                            </group>
                            <group>
                                <field name="priority" widget="priority"/>
                                <field name="pep" readonly="1"
                                       attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}"/>
                            </group>
                            <group>
                                <field name="pep_corto"
                                       attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                            </group>
                            <group>
                                <field name="company_id" string="Proceso"
                                       attrs="{'invisible': [('tipo', '!=', 'principal')],
                                       'readonly': [('company_id', '!=', False)]}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                        </group>
                        <group string="Detalles importantes sobre la solicitud" class="oe_title">
                             <field name="observaciones_grupo_ejecutor" placeholder="Añadir una observación..."/>
                        </group>
                        <group>
                            <field name="motivo_rechazo" readonly="1"
                                   attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}"/>
                            <field name="motivo_cancelacion" readonly="1"
                                   attrs="{'invisible': [('estado_interno', '!=', 'cancelada_ejecutor')]}"/>
                        </group>
                       <notebook>
                           <!-- Pestaña de especialidad para las solicitudes principales-->
                           <page string="Especialidad del Trabajo" autofocus="autofocus"
                                 attrs="{'invisible': ['|','|','|','|', ('pep_corto', '=', False), ('name', '=', False),
                                 ('partner_id', '=', False), ('tipo', '!=', 'principal'),
                                 ('estado_interno', '=', 'rechazada_ejecutor')]}">
                            <field name="hijos_ids" mode="kanban"
                                   context="{'default_id': id, 'default_name': name, 'default_partner_id': partner_id,
                                   'default_tipo': 'subsolicitud', 'default_tag_ids': tag_ids,
                                   'default_pep_corto': pep_corto, 'default_company_id': company_id,
                                   'default_priority': priority }">
                                <kanban>
                                    <field name="id"/>
                                    <field name="especialidad"/>
                                    <field name="pep"/>
                                    <field name="image_128"/>
                                    <field name="valor_sap_cup"/>
                                    <field name="description"/>
                                    <field name="company_id"/>
                                    <field name="company_currency"/>
                                    <field name="departamento"/>
                                   <templates>
                                       <t t-name="kanban-box">
                                           <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                                               <t>
                                                   <div class="o_kanban_image_fill_left o_kanban_image_full"
                                                        t-attf-style="background-image: url(#{kanban_image('sicpro.app.solicitudes.oportunidades', 'image_128', record.id.raw_value, placeholder)})"
                                                        role="img"/>
                                               </t>
                                               <div class="oe_kanban_details">
                                                   <strong class="o_kanban_record_title oe_partner_heading">
                                                       <field name="especialidad"/>
                                                   </strong>
                                                   <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                                   <ul>
                                                       <li t-if="record.departamento.raw_value">
                                                           <field name="departamento" /></li>
                                                       <li t-if="record.pep.raw_value"><field name="pep" /></li>
                                                       <li t-if="record.valor_sap_cup.raw_value">
                                                           <field name="valor_sap_cup" widget='monetary'
                                                                  options="{'currency_field': 'company_currency'}"/></li>
                                                       <li t-if="record.description.raw_value"><strong>Alcance: </strong><field name="description" /></li>
                                                   </ul>
                                                   <div class="oe_kanban_partner_links"/>
                                               </div>
                                           </div>
                                       </t>
                                   </templates>
                                </kanban>
                                <form>
                                    <sheet>
                                        <h1>
                                            <label for="oportunidad_especialidad" string="Oportunidad"/>
                                            <field name="oportunidad_especialidad" class="col-10" required="1"
                                                   placeholder="ej. Nombre de la Solicitud de Trabajo Principal"
                                                   attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        </h1>
                                        <field name="company_id" invisible="1"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        <field name="partner_id" string="Cliente" invisible="1"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        <field name="estado_interno" invisible="1"/>
                                        <field name="tipo" invisible="1"/>
                                        <field name="pep_corto" invisible="1"/>
                                        <field name="name" invisible="1"/>
                                        <field name="partner_name" invisible="1"/>
                                        <field name="territorio_id" invisible="1"/>
                                        <field name="provincia_id" invisible="1"/>
                                        <field name="website" invisible="1"/>
                                        <field name="cargo" invisible="1"/>
                                        <field name="telefono_fijo" invisible="1"/>
                                        <field name="telefono_movil" invisible="1"/>
                                        <field name="correo" widget="email" invisible="1"/>
                                        <field name="pagina_web" widget="url" invisible="1"/>
                                        <group>
                                        <group>
                                            <field name="especialidad" domain="[('company_id', '=', company_id)]" readonly="1"
                                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                            <field name="tag_ids" widget="many2many_tags"
                                                   attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                                            <field name="id_solicitud"/>
                                            <field name="departamento" string="Departamento" required="1"
                                                   attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        </group>
                                        <group>
                                            <field name="company_currency" invisible="1"/>
                                            <field name="valor_sap_cup" class="oe_inline" widget='monetary'
                                                   attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"
                                                   options="{'currency_field': 'company_currency'}"/>
                                            <field name="pep" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                            <field name="priority" widget="priority"/>
                                        </group>
                                         </group>
                                        <notebook>
                                            <page string="Documentación">
                                                <group string="Documentación para el Proyectista">
                                                    <group>
                                                        <field name="microlocalizacion" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                                        <field name="enia" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                                    </group>
                                                    <group>
                                                        <field name="ipf" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                                    </group>
                                                 </group>
                                                <group string="Documentación Técnica">
                                    <group string="Proyecto">
                                        <field name="ejecucion_proyecto" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="consecutivo_proyecto"
                                               attrs="{'invisible': [('ejecucion_proyecto', '=', False)],
                                               'required': [('ejecucion_proyecto', '=', True)]}"/>
                                    </group>
                                    <group string="Tarea Técnica">
                                        <field name="ejecucion_tt" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="codigo_tt" attrs="{'invisible': [('ejecucion_tt', '=', False)]}"/>
                                    </group>
                                    <group>
                                        <field name="attachment_ids" widget="many2many_binary" class="oe_inline"
                                         attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                    </group>
                                </group>
                                            </page>
                                            <page string="Equipos y Materiales">
                                <group string="Equipos y Materiales para la Ejecución" >
                                    <group string="Datos del Equipamiento">
                                        <field name="datos_equipamiento_1" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_equipamiento_2" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_equipamiento_3" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_equipamiento_4" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_equipamiento_5" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                    </group>
                                    <group string="Datos de los Materiales" >
                                        <field name="datos_materiales_1" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_materiales_2" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_materiales_3" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                        <field name="datos_materiales_4" attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                                    </group>
                                </group>
                            </page>
                                            <page string="Alcance los Trabajos">
                                <field name="description" placeholder="Añadir una descripción..."
                                 attrs="{'readonly': [('estado_interno', 'in',['nuevo', 'rechazada_dtp', 'cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                            </page>
                                        </notebook>
                                    </sheet>

                                </form>
                            </field>
                           </page>
                           <page string="Documentación" attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}">
                               <group string="Documentación para el Proyectista">
                                                    <group>
                                                        <field name="microlocalizacion"/>
                                                        <field name="enia"/>
                                                    </group>
                                                    <group>
                                                        <field name="ipf"/>
                                                    </group>
                                                 </group>
                               <group string="Documentación Técnica">
                                    <group string="Proyecto">
                                        <field name="ejecucion_proyecto"/>
                                        <field name="consecutivo_proyecto"
                                               attrs="{'invisible': [('ejecucion_proyecto', '=', False)],
                                               'required': [('ejecucion_proyecto', '=', True)]}"/>
                                    </group>
                                    <group string="Tarea Técnica">
                                        <field name="ejecucion_tt"/>
                                        <field name="codigo_tt" attrs="{'invisible': [('ejecucion_tt', '=', False)]}"/>
                                    </group>
                                    <group>
                                        <field name="attachment_ids" widget="many2many_binary" class="oe_inline"/>
                                    </group>
                                </group>
                           </page>
                           <page string="Equipos y Materiales" attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}">
                                <group string="Equipos y Materiales para la Ejecución" >
                                    <group string="Datos del Equipamiento">
                                        <field name="datos_equipamiento_1"/>
                                        <field name="datos_equipamiento_2"/>
                                        <field name="datos_equipamiento_3"/>
                                        <field name="datos_equipamiento_4"/>
                                        <field name="datos_equipamiento_5"/>
                                    </group>
                                    <group string="Datos de los Materiales" >
                                        <field name="datos_materiales_1"/>
                                        <field name="datos_materiales_2"/>
                                        <field name="datos_materiales_3"/>
                                        <field name="datos_materiales_4"/>
                                    </group>
                                </group>
                            </page>
                           <page string="Alcance los Trabajos" attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}">
                                <field name="description" placeholder="Añadir una descripción..."/>
                            </page>
                           <page string="información extra"
                                 attrs="{'invisible': ['|', ('type', '=', 'oportunidad'),('tipo', '!=', 'principal')]}">
                                <group>
                                    <group string="Asignación" name="categorization">
                                        <field name="company_cliente" options="{'no_create': True}"/>
                                    </group>
                                    <group string="Análisis">
                                        <field name="fecha_solicitud_trabajo" readonly="1"/>
                                        <field name="fecha_aprobacion" readonly="1"/>
                                        <field name="fecha_revision" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                       </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
                </form>
            </field>
        </record>

    <record id="solicitudes_negociacion_tree" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.negociacion.tree</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree string="Iniciativas" create="false"
                  decoration-warning="estado_interno in ['rechazada_dtp', 'rechazada_ejecutor']"
                  decoration-danger="estado_interno in ['cancelada_cliente', 'cancelada_ejecutor']"
                  decoration-success="estado_interno == 'aprobada'" >
                <field name="estado_interno"/>
                <field name="especialidad" attrs="{'invisible': [('estado_interno', '!=', 'rechazada_ejecutor')]}"/>
                <field name="id_solicitud" string="Id Solicitud" />
                <field name="name" string="Iniciativa"/>
                <field name="pep_corto"/>
                <field name="partner_id"/>
                <field name="partner_name"/>
                <field name="territorio_id"/>
                <field name="priority" widget="priority"/>
                <field name="fecha_solicitud_trabajo"/>
                <field name="company_id"/>
                <field name="tipo" invisible="1"/>
                <field name="estado_interno" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="solicitudes_negociacion_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.negociacion.kanban</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" archivable="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="priority"/>
                    <field name="tag_ids"/>
                    <field name="user_id"/>
                    <field name="message_needaction_counter"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    <progressbar field="activity_state"
                                 colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div>
                                    <strong class="o_kanban_record_title"><span><field name="name"/></span></strong>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle"><field name="partner_id"/></span>
                                </div>
                                <div>
                                  <field name="tag_ids"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <t t-if="record.message_needaction_counter.raw_value">
                                            <span role="alert" class="oe_kanban_mail_new"
                                                  title="Unread Messages">
                                                <i class="fa fa-comments" aria-label="Messages"
                                                   role="img"/><t t-raw="record.message_needaction_counter.raw_value"/>
                                            </span>
                                        </t>
                                        <div class="o_kanban_inline_block">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('sicpro.app.clientes', 'image_128', record.partner_id.raw_value)"
                                             t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"
                                             class="oe_kanban_avatar float-right"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    <record  id="solicitudes_negociacion_calendar" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.negociacion.calendar</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <calendar string="Iniciativas" mode="month" date_start="activity_date_deadline" color="user_id"
                          hide_time="true" event_limit="5">
                    <!--<field name="planned_revenue"/> -->
                    <field name="partner_id" avatar_field="image_128"/>
                </calendar>
            </field>
        </record>

    <record id="solicitudes_negociacion_activity" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.negociacion.activity</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="arch" type="xml">
                <activity string="Iniciativas y oportunidades">
                    <field name="partner_id"/>
                  <!--  <field name="company_currency"/> -->
                    <templates>
                        <div t-name="activity-box">
                            <img t-att-src="activity_image('sicpro.app.clientes', 'image_128', record.partner_id.raw_value)"
                                 t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"/>
                            <div>
                                <field name="name" display="full"/>
                               <!-- <field name="planned_revenue" widget="monetary" display="full" muted="1"/> -->
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

    <record id="solicitudes_negociacion_search" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.negociacion.search</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="arch" type="xml">
                <search string="Buscar iniciativas">
                    <field name="name" string="Iniciativas" filter_domain="['|','|','|',('partner_name', 'ilike', self),
                    ('partner_id', 'ilike', self), ('name', 'ilike', self)]"/>
                    <field name="tag_ids" string="Etiquetas" filter_domain="[('tag_ids', 'ilike', self)]"/>
                    <field name="partner_id"/>
                    <separator />
                    <filter string="Nuevas Solicitudes" name="estado_interno"
                            domain="[('estado_interno', 'in', ('liberada','rechazada_ejecutor'))]"/>
                    <separator/>
                    <separator />
                    <filter string="Fecha de Solicitud" name="fecha_solicitud_trabajo" date="fecha_solicitud_trabajo"/>
                    <separator/>
                    <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                    <field name="anio" string="Año"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Cliente" name="partner_id" context="{'group_by':'partner_id'}"/>
                        <filter string="Territorio" name="territorio_id" context="{'group_by':'territorio_id'}"/>
                        <filter name="provincia_id" string="Provincia" context="{'group_by': 'provincia_id'}"/>
                        <filter string="Prioridad" name="priority" context="{'group_by':'priority'}" />
                        <filter string="Proceso Ejecutor" name="company_id" context="{'group_by':'company_id'}"/>
                        <separator orientation="vertical" />
                        <filter string="Fecha de creación" context="{'group_by':'fecha_solicitud_trabajo:month'}" name="month"/>
                        <filter string="Año" context="{'group_by':'anio'}" name="month"/>
                        </group>
                </search>
            </field>
        </record>

    <record id="solicitudes_id_consecutivo_incrementar" model="ir.sequence">
            <field name="name">Solicitdudes: Consecutivo de las solicitudes</field>
            <field name="code">solicitudes_id_consecutivo_incrementar</field>
            <field name="padding">4</field>
            <field name="prefix">SO-%(range_year)s/</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
    </record>

    <record model="ir.actions.act_window" id="solicitudes_negociacion_action">
            <field name="name">Negociación</field>
            <field name="res_model">sicpro.app.solicitudes.oportunidades</field>
            <field name="view_mode">tree,kanban,calendar,form,activity</field>
            <field name="domain">['&amp;', ('type','=','iniciativa'), ('tipo', '=', 'principal')]</field>
            <field name="view_id" ref="solicitudes_negociacion_form"/>
            <field name="search_view_id" ref="solicitudes_negociacion_search"/>
            <field name="context">{
                'search_default_anio': (context_today().strftime('%Y')),
                'search_default_estado_interno': 1
                }
            </field>
    </record>

    <record id="solicitudes_negociacion_view_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="solicitudes_negociacion_tree"/>
            <field name="act_window_id" ref="solicitudes_negociacion_action"/>
        </record>

    <record id="solicitudes_negociacion_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="solicitudes_negociacion_kanban"/>
            <field name="act_window_id" ref="solicitudes_negociacion_action"/>
        </record>

    <record id="solicitudes_negociacion_view_calendar" model="ir.actions.act_window.view">
            <field name="sequence" eval="3"/>
            <field name="view_mode">calendar</field>
            <field name="view_id" ref="solicitudes_negociacion_calendar"/>
            <field name="act_window_id" ref="solicitudes_negociacion_action"/>
        </record>

