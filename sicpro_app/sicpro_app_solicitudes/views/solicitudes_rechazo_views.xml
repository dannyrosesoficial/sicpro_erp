<?xml version="1.0"?>
<odoo>

        <record id="solicitudes_motivo_rechazo_view_search" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.rechazadas.search</field>
            <field name="model">sicpro.app.solicitudes.rechazadas</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name" string="Rechazo"/>
                    <filter string="Incluir archivados" name="active" domain="['|', ('active', '=', True),
                    ('active', '=', False)]"/>
                    <separator/>
                    <filter string="Archivado" name="active" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="solicitudes_motivo_rechazo_view_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.rechazadas.form</field>
            <field name="model">sicpro.app.solicitudes.rechazadas</field>
            <field name="arch" type="xml">
                <form string="Canal">
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1>
                                <field name="name"/>
                            </h1>
                            <field name="active" invisible="1"/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="solicitudes_motivo_rechazo_view_tree" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.rechazadas.tree</field>
            <field name="model">sicpro.app.solicitudes.rechazadas</field>
            <field name="arch" type="xml">
                <tree string="Canal" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="solicitudes_motivo_rechazo_action" model="ir.actions.act_window">
            <field name="name">Motivo de rechazo</field>
            <field name="res_model">sicpro.app.solicitudes.rechazadas</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Defina los motivos de rechazo
              </p><p>
                Aquí puede describir los motivos de rechazo de una solicitud de trabajo.
              </p>
            </field>
        </record>

</odoo>