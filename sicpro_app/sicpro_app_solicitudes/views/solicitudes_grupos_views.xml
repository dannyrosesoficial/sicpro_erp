<?xml version="1.0"?>
<odoo>

    <!-- Inicio de las Vistas del modal para asignar grupo y crear la oportunidad-->
    <record id="solicitudes_grupos_oportunidades_form" model="ir.ui.view">
        <field name="name">sicpro.app.grupo.ejecutor.t5.form</field>
        <field name="model">sicpro.app.grupo.ejecutor.t5</field>
        <field name="priority">230</field>
        <field name="arch" type="xml">
            <form string="Transferir Solicitud">
                <group string="Transferir esta Oportunidad a" class="oe_title">
                    <field name="company_id" invisible="0"/>
                    <field name="especialista_ejecutor" domain="[('company_id', '=', company_id)]"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_grupo_ejecutor_t5" string="Transferir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="solicitudes_grupos_oportunidades_action" model="ir.actions.act_window">
        <field name="name">Transferir Oportunidad</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.grupo.ejecutor.t5</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="solicitudes_grupos_oportunidades_form"/>
        <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para asignar grupo y crear la oportunidad-->


    <!-- Inicio de las Vistas del modal para el rechazo de la solicitud-->
    <record id="solicitudes_grupos_rechazada_form" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.rechazadas.t5.form</field>
        <field name="model">sicpro.app.solicitudes.rechazadas.t5</field>
        <field name="priority">210</field>
        <field name="arch" type="xml">
            <form string="Motivo del Rechazo">
                <group class="oe_title">
                    <field name="lost_reason_id"/>
                </group>
                <footer>
                    <button name="action_motivo_rechazo_t5" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="solicitudes_grupos_rechazada_action" model="ir.actions.act_window">
        <field name="name">Motivo de Rechazo</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.solicitudes.rechazadas.t5</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="solicitudes_grupos_rechazada_form"/>
        <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para el rechazo de la solicitud-->


    <record id="solicitudes_grupos_form" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.grupos.form</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <form class="o_lead_opportunity_form" create="false" edit="true">
                <header>
                    <field name="estado_interno" invisible="1"/>
                    <field name="tipo" invisible="1"/>
                    <field name="especialista_ejecutante_bool" invisible="1"/>

                    <button name="%(solicitudes_grupos_oportunidades_action)d" string="Transferir esta Oportunidad"
                            groups="sicpro_app_solicitudes.grupo_app_grupos_ejecutor"
                            type="action" class="oe_highlight"/>

                    <button name="%(solicitudes_grupos_rechazada_action)d" string="Rechazar" type="action"/>

                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"
                           attrs="{'invisible': [('active', '=', False)]}"/>

                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <widget name="web_ribbon" title="Cancelada" bg_color="bg-danger"
                            attrs="{'invisible': [('estado_interno', 'not in',['cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                    <widget name="web_ribbon" title="Rechazado" bg_color="bg-warning"
                            attrs="{'invisible': [('estado_interno', 'not in',['rechazada_dtp', 'rechazada_ejecutor'])]}"/>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{&quot;preview_image&quot;: &quot;image_128&quot;}"/>

                    <div class="oe_title" readonly="1">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1" placeholder="ej. Nombre de la solicitud de trabajo"/>
                        </h1>
                        <h4>
                            <field name="especialidad" readonly="1" domain="[('company_id', '=', company_id)]"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </h4>
                    </div>
                    <group>
                        <group>
                            <field name="company_currency" invisible="1"/>
                            <field name="type" invisible="1"/>
                            <field name="valor_sap_cup" readonly="1" widget='monetary'
                                   options="{'currency_field': 'company_currency'}"/>
                        </group>
                        <group>
                            <field name="pep" readonly="1"/>
                        </group>
                        <group>
                            <field name="id_solicitud"/>
                            <field name="anio" readonly="1"/>
                            <field name="tag_ids" widget="many2many_tags" readonly="1"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="c_mep"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority" readonly="1"/>
                            <field name="grupo_ejecutor" readonly="1"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="departamento" string="Departamento" readonly="1"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="company_id" readonly="1"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="lugar_trabajo"/>
                        </group>
                    </group>
                    <group string="Asignar esta oportunidad a" class="oe_title">
                        <group string="Responsable de la oportunidad">
                            <field name="especialista_ejecutor" string="Cargo" readonly="1"/>
                            <field name="cargo_especialista"/>
                        </group>
                        <group string="Ejecutante de la oportunidad">
                            <field name="especialista_ejecutante" string="Cargo" readonly="1"/>
                            <field name="cargo_especialista_ejecutante"/>
                        </group>
                    </group>

                    <group string="Detalles importantes sobre la solicitud" class="oe_title">
                        <field name="observaciones_grupo_ejecutor" placeholder="Añadir una observación..."/>
                    </group>
                    <group>
                        <field name="motivo_rechazo" readonly="1"
                               attrs="{'invisible': [('estado_interno', '!=', 'rechazada_agrupacion')]}"/>
                        <field name="temporal_1" invisible="1"/>
                        <field name="temporal_2" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Documentación">
                            <group string="Documentación para el Proyectista">
                                <group>
                                    <field name="microlocalizacion" readonly="1"/>
                                    <field name="enia" readonly="1"/>
                                </group>
                                <group>
                                    <field name="ipf" readonly="1"/>
                                </group>
                            </group>
                            <group string="Documentación Técnica">
                                <group string="Proyecto">
                                    <field name="ejecucion_proyecto" readonly="1"/>
                                    <field name="consecutivo_proyecto"
                                           attrs="{'invisible': [('ejecucion_proyecto', '=', False)]}"/>
                                </group>
                                <group string="Tarea Técnica">
                                    <field name="ejecucion_tt" readonly="1"/>
                                    <field name="codigo_tt" attrs="{'invisible': [('ejecucion_tt', '=', False)]}"/>
                                </group>
                                <group>
                                    <field name="attachment_ids" widget="many2many_binary" class="oe_inline"/>
                                </group>
                            </group>
                        </page>
                        <page string="Equipos y Materiales">
                            <group string="Equipos y Materiales para la Ejecución">
                                <group string="Datos del Equipamiento">
                                    <field name="datos_equipamiento_1" readonly="1"/>
                                    <field name="datos_equipamiento_2" readonly="1"/>
                                    <field name="datos_equipamiento_3" readonly="1"/>
                                    <field name="datos_equipamiento_4" readonly="1"/>
                                    <field name="datos_equipamiento_5" readonly="1"/>
                                </group>
                                <group string="Datos de los Materiales">
                                    <field name="datos_materiales_1" readonly="1"/>
                                    <field name="datos_materiales_2" readonly="1"/>
                                    <field name="datos_materiales_3" readonly="1"/>
                                    <field name="datos_materiales_4" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Alcance los Trabajos">
                            <field name="description" placeholder="Añadir una descripción..." readonly="1"/>
                        </page>
                        <page string="información extra">
                            <group>
                                <group string="Asignación" name="categorization">
                                    <field name="company_cliente" options="{'no_create': True}"/>
                                </group>
                                <group string="Análisis">
                                    <field name="fecha_solicitud_trabajo" readonly="1"/>
                                    <field name="fecha_aprobacion" readonly="1"/>
                                    <field name="fecha_revision" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="iniciativa" string="Cliente">
                            <group>
                                <group string="Información de contacto">
                                    <field name="partner_id" readonly="1"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="territorio_id" readonly="1"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="provincia_id" readonly="1"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="website" readonly="1" widget="url"/>
                                </group>
                                <group class="mt48">
                                    <field name="cargo" readonly="1"/>
                                    <field name="telefono_fijo" readonly="1"/>
                                    <field name="telefono_movil" readonly="1"/>
                                    <field name="correo" widget="email" readonly="1"/>
                                    <field name="pagina_web" widget="url" readonly="1"/>
                                </group>
                                <group string="Otros" name="Misc">
                                    <field name="dias_aprobar"/>
                                    <field name="dias_asignar"/>
                                    <field name="type" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="solicitudes_grupos_tree" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.grupos.tree</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="priority">200</field>
        <field name="arch" type="xml">
            <tree string="Iniciativas" create="false">
                <field name="id_solicitud" string="Id Solicitud"/>
                <field name="especialidad"/>
                <field name="name" string="Oportunidad"/>
                <field name="pep"/>
                <field name="partner_id"/>
                <field name="partner_name"/>
                <field name="territorio_id"/>
                <field name="priority" widget="priority"/>
                <field name="fecha_solicitud_trabajo"/>
                <field name="company_id" invisible="1"/>
                <field name="tipo" invisible="1"/>
                <field name="estado_interno" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="solicitudes_grupos_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.grupos.kanban</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="priority" eval="200"/>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column o_opportunity_kanban"
                    archivable="false" create="false" group_create="false" group_delete="false" group_edit="false">
                <field name="stage_id"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="especialista_ejecutor"/>
                <field name="cargo_especialista"/>
                <field name="especialista_ejecutante"/>
                <field name="cargo_especialista_ejecutante"/>
                <field name="priority"/>
                <field name="tag_ids"/>
                <field name="user_id"/>
                <field name="especialidad"/>
                <field name="color"/>
                <field name="company_currency"/>
                <field name="message_needaction_counter"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <field name="valor_sap_cup" widget='monetary'
                       options="{'currency_field': 'company_currency'}"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
                             sum_field="valor_sap_cup"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''} oe_kanban_global_click">
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown"
                                   data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <t t-if="widget.editable"><a role="menuitem" type="edit"
                                                                 class="dropdown-item">Editar</a></t>
                                    <t t-if="widget.deletable"><a role="menuitem" type="delete"
                                                                  class="dropdown-item">Eliminar</a></t>
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                            </div>
                            <div class="oe_kanban_content">
                                <div>
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <div>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                <div class="text-muted o_kanban_record_subtitle">
                                    <t t-if="record.valor_sap_total.raw_value">
                                        <field name="valor_sap_total" widget="monetary"
                                               options="{'currency_field': 'company_currency'}"/>
                                    </t>
                                    <span t-if="record.especialista_ejecutante.value">
                                        <t t-esc="record.especialista_ejecutante.value"/>
                                    </span>
                                    <span t-else="">
                                        <t t-esc="record.especialista_ejecutor.value"/>
                                    </span>
                                </div>
                                <div>
                                    <strong><field name="especialidad"/></strong>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority" groups="base.group_user"/>
                                        <t t-if="record.message_needaction_counter.raw_value">
                                            <span role="alert" class='oe_kanban_mail_new' title='Unread Messages'>
                                                <i class='fa fa-comments' aria-label="Unread messages" role="img"/>
                                                <t t-raw="record.message_needaction_counter.raw_value"/>
                                            </span>
                                        </t>
                                        <field name="activity_ids" widget="kanban_activity"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('sicpro.app.trabajadores', 'image_128', record.especialista_ejecutor.raw_value)"
                                             t-att-title="record.especialista_ejecutor.value"
                                             t-att-alt="record.especialista_ejecutor.value"
                                             class="oe_kanban_avatar float-right"/>

                                        <t t-if="record.especialista_ejecutante.value">
                                            <img t-att-src="kanban_image('sicpro.app.trabajadores', 'image_128', record.especialista_ejecutante.raw_value)"
                                                 t-att-title="record.especialista_ejecutante.value"
                                                 t-att-alt="record.especialista_ejecutante.value"
                                                 class="oe_kanban_avatar float-right"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <div class="oe_clear"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="solicitudes_grupos_calendar" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.grupos.calendar</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="priority" eval="200"/>
        <field name="arch" type="xml">
            <calendar string="Iniciativas" mode="month" date_start="activity_date_deadline" color="user_id"
                      hide_time="true" event_limit="5">
                <!--<field name="planned_revenue"/> -->
                <field name="partner_id" avatar_field="image_128"/>
            </calendar>
        </field>
    </record>

    <record id="solicitudes_grupos_activity" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.grupos.activity</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="arch" type="xml">
            <activity string="Iniciativas y oportunidades">
                <field name="partner_id"/>
                <!--  <field name="company_currency"/> -->
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('sicpro.app.clientes', 'image_128', record.partner_id.raw_value)"
                             t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"/>
                        <div>
                            <field name="name" display="full"/>
                            <!-- <field name="planned_revenue" widget="monetary" display="full" muted="1"/> -->
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="solicitudes_grupos_search" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.grupos.search</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="arch" type="xml">
            <search string="Buscar Oportunidad">
                <field name="name" string="Oportunidad" filter_domain="[('name', 'ilike', self)]"/>
                <field name="tag_ids" string="Etiquetas" filter_domain="[('tag_ids', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="especialidad"/>
                <field name="id_solicitud" string="Solicitud ID"/>
                <field name="pep_corto" string="Número SAP"/>
                <field name="anio" string="Año"/>
                <separator/>
                <filter string="Fecha de Solicitud" name="fecha_solicitud_trabajo" date="fecha_solicitud_trabajo"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="especialidad" string="Especialidad" context="{'group_by':'especialidad'}"/>
                    <filter string="Cliente" name="partner_id" context="{'group_by':'partner_id'}"/>
                    <filter string="Territorio" name="territorio_id" context="{'group_by':'territorio_id'}"/>
                    <filter name="provincia_id" string="Provincia" context="{'group_by': 'provincia_id'}"/>
                    <filter string="Prioridad" name="priority" context="{'group_by':'priority'}"/>
                    <filter string="Proceso Ejecutor" name="company_id" context="{'group_by':'company_id'}"/>
                    <separator orientation="vertical"/>
                    <filter string="Fecha de creación" context="{'group_by':'fecha_solicitud_trabajo:month'}"
                            name="month"/>
                    <filter string="Año" context="{'group_by':'anio'}" name="month"/>
                </group>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="solicitudes_grupos_action">
        <field name="name">Oportunidades</field>
        <field name="res_model">sicpro.app.solicitudes.oportunidades</field>
        <field name="view_mode">tree,kanban,calendar,form,activity</field>
        <!--<field name="view_mode">tree,kanban,graph,pivot,calendar,form,activity</field>-->
        <field name="domain">['&amp;', ('type', '=', 'oportunidad'), ('tipo', '=', 'subsolicitud')]</field>
        <field name="view_id" ref="solicitudes_grupos_form"/>
        <field name="search_view_id" ref="solicitudes_grupos_search"/>
        <field name="context">{'search_default_anio': (context_today().strftime('%Y')), }
        </field>
    </record>

    <record id="solicitudes_grupos_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="solicitudes_grupos_kanban"/>
        <field name="act_window_id" ref="solicitudes_grupos_action"/>
    </record>

    <record id="solicitudes_grupos_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="solicitudes_grupos_tree"/>
        <field name="act_window_id" ref="solicitudes_grupos_action"/>
    </record>

    <record id="solicitudes_grupos_view_calendar" model="ir.actions.act_window.view">
        <field name="sequence" eval="3"/>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="solicitudes_grupos_calendar"/>
        <field name="act_window_id" ref="solicitudes_grupos_action"/>
    </record>

    <!--    <record id="solicitudes_grupos_view_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="4"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="crm_lead_view_pivot"/>
            <field name="act_window_id" ref="solicitudes_grupos_action"/>
        </record>-->


</odoo>