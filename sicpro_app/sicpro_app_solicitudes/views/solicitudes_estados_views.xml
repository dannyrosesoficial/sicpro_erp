<odoo>
  <record id="solicitudes_estados_search" model="ir.ui.view">
    <field name="name">Buscar Estados</field>
    <field name="model">sicpro.app.solicitudes.estados</field>
    <field name="arch" type="xml">
      <search string="Buscar Estados">
        <field name="name"/>
      </search>
    </field>
  </record>

  <record id="solicitudes_estados_list" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.estados.list</field>
    <field name="model">sicpro.app.solicitudes.estados</field>
    <field name="arch" type="xml">
      <list string="Estados">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="is_inicial"/>
        <field name="is_orden"/>
        <field name="is_detenido"/>
        <field name="is_cancelado"/>
        <field name="is_won"/>
      </list>
    </field>
  </record>

  <record id="solicitudes_estados_form" model="ir.ui.view">
    <field name="name">sicpro.app.solicitudes.estados.form</field>
    <field name="model">sicpro.app.solicitudes.estados</field>
    <field name="priority" eval="1"/>
    <field name="arch" type="xml">
      <form string="Estados">
        <sheet>
          <div class="oe_title">
            <div class="oe_edit_only">
              <label for="name"/>
            </div>
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="is_inicial"/>
              <field name="is_orden"/>
              <field name="is_detenido"/>
              <field name="is_cancelado"/>
              <field name="is_won"/>
              <field name="fold"/>
            </group>
          </group>
          <separator string="Requerimientos"/>
          <field name="requirements" nolabel="1"
                 placeholder="Dale a tu equipo los requerimientos para mover una oportunidad a una face"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="solicitudes_estados_action" model="ir.actions.act_window">
    <field name="name">Estados</field>
    <field name="res_model">sicpro.app.solicitudes.estados</field>
    <field name="view_id" ref="solicitudes_estados_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregue un nuevo estado
      </p>
      <p>
        Agregar los estados por los que navegaran las oportunidades.
      </p>
    </field>
  </record>
</odoo>
