<templates xml:space="preserve">
    <t t-inherit="mail.MessagingMenu" t-inherit-mode="extension">
        <xpath expr="//span[contains(@class, 'o-mail-MessagingMenu-counter')]" position="attributes">
            <attribute name="style">background-color: #DC3545 !important; color: white !important;</attribute>
        </xpath>
    </t>

    <t t-inherit="mail.ActivityMenu" t-inherit-mode="extension">
        <xpath expr="//span[contains(@class, 'o-mail-ActivityMenu-counter')]" position="attributes">
            <attribute name="style">background-color: #DC3545 !important; color: white !important;</attribute>
        </xpath>
    </t>
</templates>
