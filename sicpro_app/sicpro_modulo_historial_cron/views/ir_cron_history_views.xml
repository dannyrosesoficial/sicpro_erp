<odoo>
  <record id="view_ir_cron_history_list" model="ir.ui.view">
    <field name="name">view.ir.cron.history.list</field>
    <field name="model">ir.cron.history</field>
    <field name="arch" type="xml">
      <list create="false" edit="false"
            decoration-muted="state=='interrupted'"
            decoration-info="state=='in_progress'"
            decoration-danger="state=='error'">
        <field name="action_name"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="state"/>
        <field name="message_error"/>
      </list>
    </field>
  </record>

  <record id="action_ir_cron_history" model="ir.actions.act_window">
    <field name="name">Historial de Ejecuciones Cron</field>
    <field name="res_model">ir.cron.history</field>
    <field name="view_mode">list</field>
  </record>

  <menuitem id="menu_ir_cron_history" parent="sicpro_app_administracion.menu_administracion_3"
            action="action_ir_cron_history" sequence="10"/>
</odoo>
