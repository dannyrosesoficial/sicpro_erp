<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record model="ir.ui.view" id="dashboard_view_form">
            <field name="name">Mi Dashboard Personal</field>
            <field name="model">sicpro.app.dashboard</field>
            <field name="arch" type="xml">
                <form string="Mi Dashboard Personal">
                    <board style="2-1">
                        <column>
                        </column>
                    </board>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="mi_dashboards_action">
            <field name="name">Mi Dashboard Personal</field>
            <field name="res_model">sicpro.app.dashboard</field>
            <field name="view_mode">form</field>
            <field name="usage">menu</field>
            <field name="view_id" ref="dashboard_view_form"/>
        </record> 
    </data>
    <data>

        <!-- Top menu item -->
        <menuitem name="Mi Dashboards"
            id="menu_root_dashboard"
            web_icon="sicpro_app_dashboard,static/description/icon.png"
            sequence="5"/>

        <menuitem action="mi_dashboards_action"
                  id="menu_root_dashboard_dashboard"
                  name="Mi Dashboard Personal" parent="menu_root_dashboard"
                  sequence="1"/>
    </data>
</odoo>
