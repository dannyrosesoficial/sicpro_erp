<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- inicio de las Vistas de la configuración de grupos de ejecución -->

        <record id="crm_team_salesteams_search" model="ir.ui.view">
            <field name="name">Grupo Ejecutor</field>
            <field name="model">sicpro.app.solicitudes.grupo.ejecutor</field>
            <field name="arch" type="xml">
                <search string="Buscar grupo ejecutor">
                    <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                    <field name="name"/>
                    <field name="jefe_grupo"/>
                    <group expand="0" string="Group By...">
                        <filter string="Líder del grupo" name="jefe_grupo" domain="[]"
                                context="{'group_by':'jefe_grupo'}"/>
                    </group>
                </search>
            </field>
        </record>-

        <record id="crm_team_view_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.grupo.ejecutor.form</field>
            <field name="model">sicpro.app.solicitudes.grupo.ejecutor</field>
            <field name="arch" type="xml">
                <form string="Grupo Ejecutor">
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only" string="Grupo ejecutor"/>
                            <h1>
                                <field name="name" class="col-12" placeholder="Nombre del departamento o agrupación..."
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </h1>
                            <field name="name" invisible="1"/>
                            <div class="o_row">
                               <span name="opportunities">
                                    <field name="use_opportunities"/>
                                    <label for="use_opportunities"/>
                               </span>
                               <span class="o_row" >
                                   <field name="use_leads"/>
                                   <label for="use_leads"/>
                               </span>
                            </div>
                            <div name="options_active" />
                        </div>
                        <group>
                            <group name="left">
                                <field name="active" invisible="1"/>
                                <field name="jefe_grupo"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="departamento"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="company_id"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                            <group name="right">
                            </group>
                        </group>
                        <notebook>
                            <page name="members" string="Miembros del grupo" >
                                <field name="miembros_ids" widget="many2many"
                                       domain="[('department_id', '=', name)]" options="{'not_delete': True}">
                                    <kanban quick_create="false" create="true" delete="true">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <field name="job_id"/>
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click" style="max-width: 200px">
                                                    <div class="o_kanban_record_top">
                                                        <img t-att-src="kanban_image('sicpro_app_trabajadores_general', 'image_128', record.id.raw_value)"
                                                             class="oe_avatar oe_kanban_avatar_smallbox o_image_40_cover mb0"
                                                             alt="Avatar"/>
                                                        <div class="o_kanban_record_headings ml8">
                                                            <strong class="o_kanban_record_title">
                                                                <field name="name"/></strong>
                                                            <div t-if="record.job_id.raw_value">
                                                                <field name="job_id"/></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"
                               help="Follow this salesteam to automatically track the events associated to
                               users of this team."/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="crm_team_view_tree" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.grupo.ejecutor.tree</field>
            <field name="model">sicpro.app.solicitudes.grupo.ejecutor</field>
            <field name="field_parent">child_ids</field>
            <field name="arch" type="xml">
                <tree string="Grupo Ejecutor">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="jefe_grupo"/>
                    <field name="departamento"/>
                    <field name="company_id" />
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="crm_team_view_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.grupo.ejecutor.kanban</field>
            <field name="model">sicpro.app.solicitudes.grupo.ejecutor</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div class="row">
                                    <div class="col-6">
                                        <strong><field name="name"/></strong>
                                    </div>
                                    <div class="col-6">
                                        <span class="float-right"><field name="jefe_grupo"/></span>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

