        <record id="sale_team_config_action" model="ir.actions.act_window">
            <field name="name">Grupo Ejecutor</field>
            <field name="res_model">sicpro.app.solicitudes.grupo.ejecutor</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="view_id" ref="crm_team_salesteams_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Defina un nuevo grupo ejecutor
                </p><p>
                    Aquí puede agregar los grupos que ejecutaran las solicitudes de trabajo.
                </p>
            </field>
        </record>

        <menuitem id="solicitudes_team_config" name="Grupos de Ejecución"
            parent="solicitudes_menu_config" action="sale_team_config_action"
            groups="grupo_app_solicitud_responsable" sequence="5"/>

    <!-- Fin de las Vistas de la configuración de grupos de ejecución -->

