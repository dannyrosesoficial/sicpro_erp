<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_stage_search" model="ir.ui.view">
        <field name="name">Buscar Estados</field>
        <field name="model">sicpro.app.solicitudes.estados</field>
        <field name="arch" type="xml">
            <search string="Buscar Estados">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="crm_stage_tree" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.estados.tree</field>
        <field name="model">sicpro.app.solicitudes.estados</field>
        <field name="arch" type="xml">
            <tree string="Estados">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_inicial"/>
                <field name="is_won"/>
            </tree>
        </field>
    </record>

    <record id="crm_stage_form" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.estados.form</field>
        <field name="model">sicpro.app.solicitudes.estados</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form string="Estados">
                <sheet>
                    <div class="oe_title">
                        <div class="oe_edit_only">
                            <label for="name"/>
                        </div>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_inicial"/>
                            <field name="is_won"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <separator string="Requerimientos"/>
                    <field name="requirements" nolabel="1" placeholder="Dale a tu equipo los requerimientos para mover una oportunidad a una face"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="crm_stage_action" model="ir.actions.act_window">
        <field name="name">Estados</field>
        <field name="res_model">sicpro.app.solicitudes.estados</field>
        <field name="view_id" ref="crm_stage_tree"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Agregue un nuevo estado
          </p><p>
            Agregar los estados por los que navegaran las oportunidades.
          </p>
        </field>
    </record>

    <menuitem
        id="menu_solicitudes_estados" name="Estados" sequence="0"
        action="crm_stage_action" parent="solicitudes_menu_config"
        groups="grupo_app_solicitud_admin" />

</odoo>
