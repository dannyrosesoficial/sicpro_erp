<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
     <!-- Creo la categoría de permisos Iniciativas -->
      <record id="module_category_solicitud" model="ir.module.category">
        <field name="name">Solicitud</field>
        <field name="description">Módulo para el control de los metadata de la solicitudes de trabajo.</field>
        <field name="sequence" >7</field>
      </record>

      <record id="grupo_app_solicitud_usuario" model="res.groups">
        <field name="name">Usuarios</field>
        <field name="comment">Permisos de lectura</field>
        <field name="category_id" ref="module_category_solicitud"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      </record>

      <record id="grupo_app_solicitud_responsable" model="res.groups">
        <field name="name">Responsable</field>
        <field name="comment">Permisos de lectura/Escritura</field>
        <field name="category_id" ref="module_category_solicitud"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_solicitud_usuario'))]"/>
      </record>

      <record id="grupo_app_solicitud_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="module_category_solicitud"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_solicitud_responsable'))]"/>
      </record>
    </data>

<data noupdate="0">
    <record id="iniciativas_rule_proceso" model="ir.rule">
        <field name="name">Vista de procesos iniciativas</field>
        <field ref="base.model_res_company" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_solicitud_responsable'))]"/>
    </record>
</data>

</odoo>
