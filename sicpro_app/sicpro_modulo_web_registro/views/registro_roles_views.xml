<odoo>
  <record model="ir.ui.view" id="web_registro_roles_search_view">
    <field name="name">sicpro.modulo.web.registro.roles.search</field>
    <field name="model">sicpro.modulo.web.registro.roles</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="descripcion"/>
        <separator/>
        <filter name="automatizar_usuario_externo" string="Roles de Usuarios Externos"
                domain="[('automatizar_usuario_externo','=', True)]"/>
      </search>
    </field>
  </record>

  <record id="web_registro_roles_list_view" model="ir.ui.view">
    <field name="name">sicpro.modulo.web.registro.roles.list</field>
    <field name="model">sicpro.modulo.web.registro.roles</field>
    <field name="arch" type="xml">
      <list string="Roles Web" editable="bottom" sample="1">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="roles" widget="many2many_tags"
               options="{'no_create': True, 'no_create_edit': True}"
               placeholder="Seleccionar roles asociados"/>
        <field name="automatizar_usuario_externo" string="Usuario Externo" widget="boolean_toggle"/>
        <field name="descripcion"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="web_registro_roles_action" model="ir.actions.act_window">
    <field name="name">Configuración de Roles Web</field>
    <field name="res_model">sicpro.modulo.web.registro.roles</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="web_registro_roles_list_view"/>
    <field name="search_view_id" ref="web_registro_roles_search_view"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Define aquí los roles que aparecerán en el formulario web.
      </p>
      <p>
        Estos roles se agruparán en el frontend para facilitar la selección del usuario.
      </p>
    </field>
  </record>
</odoo>