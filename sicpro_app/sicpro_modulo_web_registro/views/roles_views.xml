<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sicpro_modulo_web_registros_roles_form" model="ir.ui.view">
        <field name="name">sicpro.modulo.web.registros.form</field>
        <field name="model">sicpro.modulo.roles</field>
        <field name="inherit_id" ref="sicpro_modulo_roles.view_res_users_role_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='code']" position="inside">
                <field name="nombre_registro"/>
                <field name="automatizar_usuario_externo"/>
            </xpath>
        </field>
    </record>

    <record id="sicpro_modulo_web_registros_roles_search" model="ir.ui.view">
        <field name="name">sicpro.modulo.web.registros.search</field>
        <field name="model">sicpro.modulo.roles</field>
        <field name="inherit_id" ref="sicpro_modulo_roles.view_res_users_role_search"/>
        <field name="arch" type="xml">
            <filter name="inactive" position="after">
                <separator/>
                <filter name="automatizar_usuario_externo" string="Roles de Usuarios Externos"
                        domain="[('automatizar_usuario_externo','=', True)]"/>
            </filter>
        </field>
    </record>

</odoo>
