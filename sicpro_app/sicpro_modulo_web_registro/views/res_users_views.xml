<odoo>
  <record id="user_solicitudes_form" model="ir.ui.view">
    <field name="name">res.solicitudes.users.views.form</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <xpath expr="//div[@name='button_box']" position="inside">
        <button name="solicitudes_acceso_view" type="object" class="o_stat_button" icon="fa-folder-open">
          <field name="solicitudes_acceso_count" widget="statinfo" string="Solicitudes"/>
        </button>
      </xpath>
    </field>
  </record>
</odoo>