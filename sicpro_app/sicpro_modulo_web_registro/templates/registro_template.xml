<?xml version="1.0"?>
<odoo>

  <template id="web_plantilla_registro">
    <t t-call-assets="web.assets_common"/>
    <t t-call-assets="web.assets_backend" t-js="false"/>
    <t t-call-assets="web.web_registros"/>
    <head>
      <meta charset="utf-8"/>
      <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
      <title>SICPRO ERP - Registro</title>
      <meta http-equiv="cache-control" content="no-cache"/>
      <meta http-equiv="pragma" content="no-cache"/>

      <!-- Favicons -->
      <link href="/sicpro_modulo_web_registro/static/src/images/SICPRO_ERP.png" rel="icon"/>
      <link href="/sicpro_modulo_web_registro/static/src/images/SICPRO_ERP.png" rel="apple-touch-icon"/>
    </head>

    <body class="body">
      <div class="main">

        <section class="signup">
          <h2 class="nombre-title">
            <img src="/sicpro_modulo_web_registro/static/src/images/SICPRO ERP_blanco.png" alt="SICPRO"
                 class="img-fluid"/>
            SICPRO ERP</h2>

          <div class="container">
            <div class="signup-content">
              <div class="signup-form">
                <h1 class="form-title">Registro de Usuario</h1>
                <form method="POST" class="register-form" id="register-form">
                  <div class="form-group">
                    <label for="name"><i class="zmdi zmdi-account material-icons-name"></i></label>
                    <input type="text" name="name" id="name" required="" placeholder="Nombre del usuario solicitante"/>
                  </div>
                  <div class="form-group">
                    <label for="email"><i class="zmdi zmdi-email"></i></label>
                    <input type="email" name="email" id="email" required=""
                           placeholder="Correo del usuario solicitante"/>
                  </div>
                  <div class="form-group-detalles">
                    <label for="plaza"><i class="zmdi zmdi-lock"></i></label>
                    <input type="text" name="plaza" id="plaza" required=""
                           placeholder="# Plaza del usuario solicitante"/>
                  </div>
                  <span class="detalles-campos">El #Plaza es el oficial de LDAP</span>
                  <div class="form-group-detalles form-group-top ">
                    <label for="tipo_usuario"><i class="zmdi zmdi-chevron-down"></i></label>
                    <select name="tipo_usuario" id="tipo_usuario" placeholder="Tipo de Usuario">
                      <option value="0">Elija un tipo de usuario</option>
                      <option value="interno">Usuario DVPE</option>
                      <option value="externo">Usuario Externo</option>
                    </select>
                  </div>
                  <span class="detalles-campos">Los usuarios que no pertenecen a la DVPE son Inversionistas</span>

                  <div class="form-group form-group-top ">
                    <input type="checkbox" name="agree-term" id="agree-term" class="agree-term" required=""/>
                    <label for="agree-term" class="label-agree-term"><span><span></span></span>Acepto los
                      <a href="/web/registro_terminos/" class="term-service"><strong>Términos de Servicio</strong></a>
                    </label>
                  </div>

                  <div class="form-group form-button">
                    <input type="submit" name="signup" id="signup" class="form-submit" value="Registrar"/>
                  </div>
                  <span class="text-danger"><i class="fa fa-user-circle-o"/>
                  <a href="/web/login/"> Ya tengo usuario</a></span>
                </form>

              </div>
              <div class="signup-image">
                <figure>
                  <img src="/sicpro_modulo_web_registro/static/src/images/signup-image.jpg" alt="sing up image"/>
                </figure>
                <t t-set="social_links" t-value="request.env['res.company'].sudo().search(
                    [('login_redes_sociales', '=', True)])"/>
                <div class="social-login">
                  <span class="social-label">Nuestras páginas</span>
                  <ul class="socials">
                    <li><a t-if="social_links.social_twitter" t-att-href="social_links.social_twitter"
                           aria-label="Twitter" title="Twitter">
                      <i class="display-flex-center zmdi zmdi-twitter"/>
                    </a></li>
                    <li><a t-if="social_links.social_facebook" t-att-href="social_links.social_facebook"
                           aria-label="Facebook" title="Facebook">
                      <i class="display-flex-center zmdi zmdi-facebook"/>
                    </a></li>
                    <li><a t-if="social_links.social_instagram" t-att-href="social_links.social_instagram"
                           aria-label="Instagram" title="Instagram">
                      <i class="display-flex-center zmdi zmdi-instagram"/>
                    </a></li>
                    <li><a href="https://www.dvpe.etecsa.cu/" title="DVPE">
                      <i class="display-flex-center zmdi zmdi-etecsa">
                        <img src="/sicpro_modulo_web/static/src/img/etecsaCi_300_6_blanco.png" width="18" height="18"/>
                      </i></a></li>
                  </ul>
                </div>

              </div>
            </div>
          </div>
        </section>
      </div>
    </body>
    <script>
      var ejecutar_aviso = {'ejecutar': "<t t-esc="ejecutar"/>",}
    </script>
  </template>

</odoo>
