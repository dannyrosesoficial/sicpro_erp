<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

       <!-- Cron para actualizar los datos del SIPETC con SICPRO -->
        <record id="transporte_sipetc_sicpro" model="ir.cron">
            <field name="name">Transporte: Actualizar SICPRO del SipeTC</field>
            <field name="model_id" ref="sicpro_app_transporte.model_sicpro_app_transporte_api"/>
            <field name="state">code</field>
            <field name="code">model.cron_ejecutar_sipetc()</field>
            <field eval="True" name="active" />
            <field name="user_id" ref="base.user_root" />
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field eval="False" name="doall" />
            <field name="active" eval="True" />
        </record>

    </data>
</odoo>
