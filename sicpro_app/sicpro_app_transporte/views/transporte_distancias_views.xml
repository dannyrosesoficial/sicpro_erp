<odoo>

    <record id='transporte_distancias_view_list' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.distancia.salida.list</field>
        <field name="model">sicpro.app.transporte.distancia.salida</field>
        <field name="arch" type="xml">
            <list string="Distancias" editable="bottom">
                <field name="name"/>
                <field name="destino"/>
                <field name="recorrido"/>
                <field name="km"/>
            </list>
        </field>
    </record>

    <record id='transporte_distancia_action' model='ir.actions.act_window'>
        <field name="name">Tabla de Distancias</field>
        <field name="res_model">sicpro.app.transporte.distancia.salida</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nuevo registro de distancia para los vehículos
            </p>
        </field>
    </record>

    <record id='transporte_distancias_lugar_view_list' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.distancia.lugar.list</field>
        <field name="model">sicpro.app.transporte.distancia</field>
        <field name="arch" type="xml">
            <list string="Lugar" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id='transporte_distancia_lugar_action' model='ir.actions.act_window'>
        <field name="name">Nomenclador de Lugares</field>
        <field name="res_model">sicpro.app.transporte.distancia</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nuevo lugar
            </p>
        </field>
    </record>

</odoo>
