<odoo>
    <record id="sicpro_app_trabajadores_general_transporte" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.transporte.form</field>
        <field name="model">sicpro.app.trabajadores</field>
        <field name="inherit_id" ref="sicpro_app_trabajadores.view_trabajadores_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="transporte_trabajador_view" type="object" class="o_stat_button" icon="fa-car">
                    <field name="transporte_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>


</odoo>
