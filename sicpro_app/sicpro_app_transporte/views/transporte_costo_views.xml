        <field name="model">sicpro.app.transporte.servicios</field>
        <field name="arch" type="xml">
            <tree string="Registro de servicio">
                <field name="date" />
                <field name="vehicle_id" />
                <field name="cost_subtype_id"/>
                <field name="chofer"/>
                <field name="responsable" />
                <field name="inv_ref" />
                <field name="notes" />
                <field name="amount" sum="Total"/>
