<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id='fleet_vehicle_cost_view_tree' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.tree</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <tree string="Coste de vehículos">
                    <field name="currency_id" invisible="1"/>
                    <field name="vehicle_id"/>
                    <field name="description"/>
                    <field name="cost_subtype_id"/>
                    <field name="date"/>
                    <field name="amount" sum="Cost" widget="monetary"/>
                </tree>
            </field>
        </record>

    <record id='fleet_vehicle_cost_view_kanban' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.kanban</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="currency_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div>
                                    <strong>
                                        <field name="vehicle_id"/>
                                        <span class="float-right"><field name="date"/></span>
                                    </strong>
                                </div>
                                <div>
                                    <field name="cost_subtype_id"/>
                                    <span class="float-right"><field name="amount" widget="monetary"/></span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    <record id='fleet_vehicle_cost_view_pivot' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.pivot</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <pivot string="Costos de Vehículos">
                    <field name="vehicle_id" type="row"/>
                    <field name="cost_type" type="row"/>
                    <field name="date" interval="year" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

    <record id='fleet_vehicle_cost_view_graph' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.graph</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <graph string="Costos de Vehículos">
                    <field name="vehicle_id"/>
                    <field name="date" interval="year"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

    <record id='fleet_vehicle_cost_indicative_view_pivot' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.pivot</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <pivot string="Coste de vehículos" >
                    <field name="vehicle_id" type="row"/>
                    <field name="cost_type" type="col"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

    <record id='fleet_vehicle_cost_indicative_view_graph' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.graph</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <graph string="Costos de Vehículos">
                    <field name="parent_id" type="row"/>
                    <field name="cost_type" type="col"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

    <record id='fleet_vehicle_costs_view_search' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.search</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <search string="Coste de vehículos" >
                    <field name="vehicle_id" />
                    <field name="cost_subtype_id"/>
                    <field name="date"/>
                    <field name="parent_id"/>
                    <filter name="parent_false" domain="[('parent_id','=',False)]" string="Costes efectivos"/>
                    <filter name="parent_true" domain="[('parent_id','!=',False)]" string="Costes indicativos"/>
                    <group expand="1" string="Group By">
                        <filter name="groupby_cost_type" context="{'group_by': 'cost_type'}" string="Tipo de coste"/>
                        <filter name="groupby_cost_subtype_id" context="{'group_by': 'cost_subtype_id'}"
                                string="Subtipo de coste"/>
                        <filter name="groupby_vehicle_id" context="{'group_by': 'vehicle_id'}" string="Vehiculo"/>
                        <filter name="groupby_parent_id" context="{'group_by': 'parent_id'}" string="Principal"/>
                        <separator/>
                        <filter name="groupby_date" context="{'group_by': 'date:month'}" string="Fecha"
                                help="Vehicle Costs by Date"/>
                    </group>
                </search>
            </field>
        </record>

    <record id='fleet_vehicle_costs_view_form' model='ir.ui.view'>
            <field name="name">sicpro.app.transporte.costo.form</field>
            <field name="model">sicpro.app.transporte.costo</field>
            <field name="arch" type="xml">
                <form string="Coste de vehículos">
                    <sheet>
                        <field name="currency_id" invisible="1"/>
                        <group col="2" string="Detalles del coste">
                            <group>
                                <field name="vehicle_id" />
                                <field name="cost_subtype_id"/>
                                <field name="amount" widget="monetary"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="parent_id" groups="base.group_no_one"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

    <record id="fleet_vehicle_costs_view_graph" model="ir.ui.view">
           <field name="name">sicpro.app.transporte.costo.graph</field>
           <field name="model">sicpro.app.transporte.costo</field>
           <field name="arch" type="xml">
                <graph string="Costs Per Month" stacked="True">
                    <field name="date" type="row"/>
                    <field name="vehicle_id" type="col"/>
                    <field name="amount" type="measure"/>
                </graph>
            </field>
        </record>

    <record id='fleet_vehicle_costs_action' model='ir.actions.act_window'>
            <field name="name">Costos de Vehículos</field>
            <field name="res_model">sicpro.app.transporte.costo</field>
            <field name="view_mode">tree,kanban,form,graph</field>
            <field name="context">{"search_default_parent_false" : True, "search_default_groupby_vehicle_id" : True,}
            </field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear un nuevo coste para los vehículos
              </p>
            </field>
        </record>

    <record id='fleet_vehicle_log_contract_view_form' model='ir.ui.view'>
        <field name="name">fleet.vehicle.log_contract.form</field>
        <field name="model">sicpro.app.transporte.contratos</field>
        <field name="arch" type="xml">
            <form string="Contract logs">
                <header>
                    <button name="contract_close" states="open,diesoon,expired,future" type="object"
                            class="oe_highlight" string="Cerrar contrato" />
                    <button name="contract_open" states="closed" type="object" class="oe_highlight"
                            string="Pasar contrato a En progreso" />
                    <button class="oe_highlight" name="act_renew_contract" type="object" string="Reiniciar contrato"
                            attrs="{'invisible': [('state', '=', 'open')]}"
                            help="Create a new contract automatically with all the same informations except for the date that will start at the end of current contract" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="currency_id" invisible="1"/>
                    <group col="2">
                        <group string="Información del contrato">
                            <field name="active" invisible="1"/>
                            <field name="ins_ref"/>
                            <field name="cost_subtype_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                   required="1" domain="['|',('category','=','contratos'),('category','=','both')]"/>
                            <field name="insurer_id"/>
                            <field name="user_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </group>
                        <group string="Información del vehículo">
                            <field name="vehicle_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="purchaser_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <label for="odometer"/>
                            <div class="o_row">
                                <field name="odometer"/>
                                <field name="odometer_unit"/>
                            </div>
                        </group>
                    </group>
                    <group col="2">
                        <group>
                            <field name="amount" string="Coste de activación"
                                   help="Cost that is paid only once at the creation of the contract" widget="monetary"/>
                            <label for="cost_generated"/>
                            <div class="o_row">
                                <field name="cost_generated" attrs="{'invisible': [('cost_frequency','=','no')]}"
                                       widget="monetary"/>
                                <field name="cost_frequency"/>
                            </div>
                        </group>
                        <group>
                            <field name="date" string="Fecha de factura"/>
                            <field name="start_date"/>
                            <field name="expiration_date" attrs="{'required': [('cost_frequency', '!=', 'no')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Servicios incluidos">
                            <group>
                                <field name="cost_ids" context="{'vehicle_id': vehicle_id}" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="currency_id" invisible="1"/>
                                        <field name="cost_subtype_id"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                               string="Servicio" domain="[('category','=','servicios')]"/>
                                        <field name="description"/>
                                        <field name="amount" sum="Price" string="Coste indicativo" widget="monetary"/>
                                    </tree>
                                </field>

                            </group>
                        </page>
                        <page string="Costes generados periódicamente">
                            <group>
                                <field name="generated_cost_ids" context="{'vehicle_id': vehicle_id}" nolabel="1"
                                       sum="amount">
                                    <tree editable="bottom" >
                                        <field name="currency_id" invisible="1"/>
                                        <field name="date" />
                                        <field name="amount" sum="amount" widget="monetary"/>
                                    </tree>

                                </field>
                            </group>
                        </page>
                    </notebook>
                    <group string="Terminos y Condisiones">
                        <field name="notes" nolabel="1"
                               placeholder="Escriba cualquier otra información relacionada con el contrato" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options='{"thread_level": 1}'/>
                </div>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_log_contract_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.contratos.tree</field>
        <field name="model">sicpro.app.transporte.contratos</field>
        <field name="arch" type="xml">
            <tree string="Contract logs"
                  decoration-warning="state=='diesoon'"
                  decoration-danger="days_left==0"
                  decoration-muted="state=='closed'">
                <field name="active" invisible="1"/>
                <field name="start_date" />
                <field name="expiration_date" />
                <field name="days_left" invisible="1"/>
                <field name="vehicle_id" />
                <field name="cost_subtype_id"/>
                <field name="insurer_id" />
                <field name="purchaser_id"/>
                <field name="cost_generated"/>
                <field name="cost_frequency"/>
                <field name="state" />
                <field name="activity_exception_decoration" widget="activity_exception"/>
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_log_contract_view_kanban' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.contratos.kanban</field>
        <field name="model">sicpro.app.transporte.contratos</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="activity_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div>
                                <strong>
                                    <field name="vehicle_id"/>
                                    <span class="float-right badge badge-secondary">
                                        <field name="state"/>
                                    </span>
                                </strong>
                            </div>
                            <div>
                                <field name="start_date"/> - <field name="expiration_date"/>
                            </div>
                            <div>
                                <field name="insurer_id"/>
                                <span class="float-right"><field name="cost_subtype_id"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="fleet_vehicle_log_contract_view_graph" model="ir.ui.view">
       <field name="name">sicpro.app.transporte.contratos.graph</field>
       <field name="model">sicpro.app.transporte.contratos</field>
       <field name="arch" type="xml">
            <graph string="Contract Costs Per Month" type="bar" stacked="True">
                <field name="date" type="row"/>
                <field name="vehicle_id" type="row"/>
                <field name="cost_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="fleet_vehicle_log_contract_view_search" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.contratos.search</field>
        <field name="model">sicpro.app.transporte.contratos</field>
        <field name="arch" type="xml">
            <search string="Contratos de vehículos">
                <field name="vehicle_id" string="Vehículo" filter_domain="[('vehicle_id.name', 'ilike', self)]"/>
                <field name="purchaser_id" string="Chofer" filter_domain="[('purchaser_id', 'child_of', self)]"/>
                <field name="insurer_id" string="Proveedor" filter_domain="[('insurer_id', 'child_of', self)]"/>
                <field name="cost_subtype_id" string="Tipo de servicio"
                       filter_domain="[('cost_ids.cost_subtype_id', 'ilike', self)]"/>
                <filter string="En progreso" name="open" domain="[('state', 'in', ['open', 'diesoon'])]"/>
                <filter string="Expirado" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Expirará pronto" name="expire_soon" domain="[('state', '=', 'diesoon')]"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter invisible="1" string="Última actividad" name="activities_overdue"
                    domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                    help="Show all records which has next action date is before today"/>
                <filter invisible="1" string="Actividades diarias" name="activities_today"
                    domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Actividades futuras" name="activities_upcoming_all"
                    domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Vehículo" name="vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_vehicle_log_contract_view_activity" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.contratos.activity</field>
        <field name="model">sicpro.app.transporte.contratos</field>
        <field name="arch" type="xml">
            <activity string="Contratos de vehículos">
                <field name="purchaser_id"/>
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('res.partner', 'image_128', record.purchaser_id.raw_value)"
                             t-att-title="record.purchaser_id.value" t-att-alt="record.purchaser_id.value"/>
                        <div>
                            <field name="vehicle_id" display="full"/>
                            <field name="cost_subtype_id" muted="1" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id='fleet_vehicle_log_contract_action' model='ir.actions.act_window'>
        <field name="name">Contratos de vehículos</field>
        <field name="res_model">sicpro.app.transporte.contratos</field>
        <field name="view_mode">tree,kanban,form,graph,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo contrato para los vehículos
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_log_fuel_view_form' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.combustible.form</field>
        <field name="model">sicpro.app.transporte.combustible</field>
        <field name="arch" type="xml">
            <form string="Fuel Logs">
                <sheet>
                    <group>
                        <group string="Detalles del vehículo">
                            <field name="vehicle_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="combustible" />
                        </group>
                        <group string="Detalles de reabastecimiento de combustible">
                            <field name="liter"/>
                            <field name="price_per_liter"/>
                            <field name="amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Detalles del odómetro">
                            <label for="odometer"/>
                            <div class="o_row">
                                <field name="odometer"/>
                                <field name="odometer_unit"/>
                            </div>
                        </group>
                        <group string="Detalles adicionales">
                            <field name="date" />
                            <field name="quien_hecha_combustible"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                            <field name="tarjeta_combustible"/>
                            <field name="vale_combustible"/>
                            <field name="inv_ref" />
                        </group>
                    </group>
                    <field name="notes" placeholder="Escriba aquí cualquier otra información"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_log_fuel_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.combustible.tree</field>
        <field name="model">sicpro.app.transporte.combustible</field>
        <field name="arch" type="xml">
            <tree string="Fuel Logs">
                <field name="date" />
                <field name="vehicle_id" />
                <field name="quien_hecha_combustible" />
                <field name="inv_ref" invisible="1"/>
                <field name="odometer" />
                <field name="odometer_unit" />
                <field name="liter" />
                <field name="price_per_liter" invisible="1"/>
                <field name="amount" sum="Price"/>
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_log_fuel_view_kanban' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.combustible.kanban</field>
        <field name="model">sicpro.app.transporte.combustible</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div>
                                <strong>
                                    <field name="vehicle_id"/>
                                    <span class="float-right"><field name="date"/></span>
                                </strong>
                            </div>
                            <div>
                                <span><field name="quien_hecha_combustible"/></span>
                            </div>
                            <div>
                                <span><field name="liter"/> Litro</span>
                                <span class="float-right"><field name="amount"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id='fleet_vehicle_log_fuel_view_search' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.combustible.search</field>
        <field name="model">sicpro.app.transporte.combustible</field>
        <field name="arch" type="xml">
            <search string="Registros de combustible de los vehículos" >
                <field name="vehicle_id" />
                <field name="date"/>
                <field name="quien_hecha_combustible" />
                <field name="liter" />
                <field name="amount" sum="Price"/>
                <group expand="0" string="Agrupar por">
                    <filter name="groupby_vehicle" context="{'group_by' : 'vehicle_id'}" string="Vehículo"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_vehicle_log_fuel_view_graph" model="ir.ui.view">
       <field name="name">sicpro.app.transporte.combustible.graph</field>
       <field name="model">sicpro.app.transporte.combustible</field>
       <field name="arch" type="xml">
            <graph string="Costo de combustible por mes">
                <field name="vehicle_id" type="row"/>
                <field name="cost_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <record id='fleet_vehicle_log_fuel_action' model='ir.actions.act_window'>
        <field name="name">Registros de combustible de los vehículos</field>
        <field name="res_model">sicpro.app.transporte.combustible</field>
        <field name="view_mode">tree,kanban,form,graph</field>
        <field name="context">{"search_default_groupby_vehicle" : True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo registro de combustible
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_log_services_view_form' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.servicios.form</field>
        <field name="model">sicpro.app.transporte.servicios</field>
        <field name="arch" type="xml">
            <form string="Registros de servicios">
                <sheet>
                    <group col="2">
                        <group string="Detalles del servicio">
                            <field name="vehicle_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="cost_subtype_id" string="Tipo de Servicio"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                   domain="['|',('category','=','servicios'),('category','=','both')]" required="1"/>
                            <field name="amount"/>
                        </group>
                        <group string="Detalles del odómetro">
                            <label for="odometer"/>
                            <div class="o_row">
                                <field name="odometer"/>
                                <field name="odometer_unit"/>
                            </div>
                        </group>
                    </group>
                    <group col="2">
                        <group string="Detalles adicionales">
                            <field name="date" />
                            <field name="chofer"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                            <field name="responsable"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="inv_ref" />
                        </group>
                    </group>
                    <group string="Servicios incluidos">
                        <field name="cost_ids" nolabel="1">
                            <tree string="Servicios incluidos" editable="bottom">
                                <field name="cost_subtype_id"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                       string="Servicio" domain="[('category','=','servicios')]"/>
                                <field name="amount" sum="Price" string="Coste indicativo"/>
                            </tree>
                        </field>
                    </group>
                    <group string="Notas">
                        <field nolabel="1" name="notes"
                               placeholder="Escriba aquí cualquier otra información relacionada con el servicio."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_log_services_view_tree' model='ir.ui.view'>
