<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id='fleet_vehicle_view_form' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.general.form</field>
        <field name="model">sicpro.app.transporte.general</field>
        <field name="arch" type="xml">
            <form string="Vehículo">
                <header>
                    <field name="state_id"  widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_assignation_logs"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-history">
                            <field name="history_count" widget="statinfo" string="Historial"/>
                        </button>
                        <button name="return_action_to_open"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-book"
                            context="{'xml_id':'fleet_vehicle_log_contract_action'}"
                            help="show the contract for this vehicle">
                            <field name="contract_count" widget="statinfo" string="Contratos"/>
                        </button>
                        <button name="act_show_log_cost"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-usd"
                            help="show all the costs for this vehicle">
                            <field name="cost_count" widget="statinfo" string="Costes"/>
                        </button>
                        <button name="return_action_to_open"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-wrench"
                            context="{'xml_id':'fleet_vehicle_log_services_action'}"
                            help="show the services logs for this vehicle" >
                            <field name="service_count" widget="statinfo" string="Servicios"/>
                        </button>
                        <button name="return_action_to_open"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-flask"
                            context="{'xml_id':'fleet_vehicle_log_fuel_action'}"
                            help="show the fuel logs for this vehicle" >
                            <field name="fuel_logs_count" widget="statinfo" string="Combustible"/>
                        </button>
                        <button name="return_action_to_open"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-tachometer"
                            context="{'xml_id':'fleet_vehicle_odometer_action'}"

                            help="show the odometer logs for this vehicle" >
                            <field name="odometer_count" widget="statinfo" string="Odómetro"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="image_128" widget='image' class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="model_id" class="oe_edit_only"/>
                        <h1>
                            <field name="model_id" placeholder="ej. Model del vehículo"/>
                        </h1>
                        <label for="license_plate" class="oe_edit_only"/>
                        <h2>
                            <field name="license_plate" class="oe_inline" placeholder="ej. HBA6024"/>
                        </h2>
                        <label for="tag_ids" class="oe_edit_only"/>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </div>
                    <group>
                        <group string="Conductor">
                            <field name="active" invisible="1"/>
                            <field name="driver_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                                   domain="['|', ('company_id', '=', False ), ('company_id', '=', company_id)]"/>
                            <field name="cargo_chofer"/>
                            <label for="future_driver_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <div class="o_row">
                                <field name="future_driver_id"/>
                                <button string="Aplicar cambios"
                                    class="btn btn-primary"
                                    type="object"
                                    name="action_accept_driver_change"
                                    attrs="{'invisible': [('future_driver_id', '=', False)]}"/>
                            </div>
                            <field name="jefe_chofer" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="cargo_jefe"/>
                            <field name="next_assignation_date"/>
                            <field name="location"/>
                        </group>
                        <group string="Vehículo">
                            <field name="clase"/>
                            <label for="odometer"/>
                            <div class="o_row">
                                <field name="odometer"/>
                                <field name="odometer_unit"/>
                            </div>
                            <field name="acquisition_date"/>
                            <field name="combustible"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="actividad_fundamental"/>
                            <field name="vin_sn"/>
                            <field name="car_value" widget="monetary"/>
                            <field name="company_id" readonly="1"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </group>
                        </group>
                        <group>
                        <group string="Identificación">
                            <field name="rotulo"/>
                            <field name="circulacion"/>
                            <field name="inventario"/>
                            <field name="denominacion"/>
                        </group>
                        <group string="Modelo">
                            <field name="seats"/>
                            <field name="doors"/>
                            <field name="color"/>
                            <field name="model_year"/>
                        </group>
                        </group>

                        <group>

                    </group>
                    <notebook>
                        <page string="Descripción">
                            <group>
                             <field name="notas"/>
                            </group>
                        </page>
                        <page string="Motor y Consumos">
                        <group>
                            <group string="Motor">
                            <field name="transmission"/>
                            <label for="co2"/>
                            <div class="o_row" name="co2">
                                <field name="co2"/><span>g/km</span>
                            </div>
                            <label for="power"/>
                            <div class="o_row">
                                <field name="power"/><span>kW</span>
                            </div>
                            </group>
                            <group string="Consumos">
                                <field name="indice_consumo_fabrica"/>
                                <field name="indice_consumo_real"/>
                            </group>
                        </group>
                        </page>
                        <page string="Parqueo">
                        <group>
                            <field name="paqueo_tipo"/>
                            <field name="parqueo_nombre"/>
                            <field name="parqueo_direccion"/>
                            <field name="parqueo_observaciones"/>
                        </group>
                        </page>
                        <page string="Contrato">
                        <group>
                            <field name="manager_id"/>
                            <field name="first_contract_date"/>
                        </group>
                        </page>
                        <page string="Otros">
                            <group>
                            <field name="visual_fuerzas_medios"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options='{"thread_level": 1}'/>
                </div>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.general.tree</field>
        <field name="model">sicpro.app.transporte.general</field>
        <field name="arch" type="xml">
            <tree string="Vehículo"
                  decoration-warning="contract_renewal_due_soon and not contract_renewal_overdue"
                  decoration-danger="contract_renewal_overdue">
                <field name="active" invisible="1"/>
                <field name="license_plate"/>
                <field name="model_id"/>
                <field name="driver_id"/>
                <field name="future_driver_id"/>
                <field name="log_drivers" invisible="1"/>
                <field name="vin_sn"/>
                <field name="acquisition_date"/>
                <field name="state_id"/>
                <field name="company_id"/>
                <field name="contract_renewal_due_soon" invisible="1"/>
                <field name="contract_renewal_overdue" invisible="1"/>
                <field name="contract_renewal_total" invisible="1"/>
                <field name="activity_exception_decoration" widget="activity_exception"/>
            </tree>
        </field>
    </record>

    <record id="fleet_vehicle_view_search" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.general.search</field>
        <field name="model">sicpro.app.transporte.general</field>
        <field name="arch" type="xml">
            <search string="Todos los vehículos">
                <field string="Vehículo" name="name"
                       filter_domain="['|', ('name', 'ilike', self), ('license_plate', 'ilike', self)]"/>
                <field string="Chofer" name="log_drivers"
                       filter_domain="[('log_drivers.driver_id.name', 'ilike', self)]"/>
                <field string="Current Driver" name="driver_id"/>
                <field name="future_driver_id"/>
                <field name="tag_ids"/>
                <field name="location"/>
                <field string="Estado" name="state_id"/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter invisible="1" string="Ultimas actividades" name="activities_overdue"
                    domain="[('activity_ids.date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"
                    help="Show all records which has next action date is before today"/>
                <filter invisible="1" string="Actividades diarias" name="activities_today"
                    domain="[('activity_ids.date_deadline', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter invisible="1" string="Actividades futuras" name="activities_upcoming_all"
                    domain="[('activity_ids.date_deadline', '&gt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="1" string="Group By">
                    <filter string="Estado" name="groupby_status" context="{'group_by': 'state_id'}"/>
                    <filter string="Modelo" name="groupby_model" context="{'group_by': 'model_id'}"/>
                    <filter string="Marca" name="groupby_make" context="{'group_by': 'brand_id'}"/>
                </group>
           </search>
        </field>
    </record>

    <record id='fleet_vehicle_view_kanban' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.general.kanban</field>
        <field name="model">sicpro.app.transporte.general</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state_id">
                <field name="license_plate" />
                <field name="model_id" />
                <field name="driver_id" />
                <field name="future_driver_id" />
                <field name="location" />
                <field name="state_id" />
                <field name="id" />
                <field name="tag_ids" />
                <field name="contract_renewal_due_soon" />
                <field name="contract_renewal_overdue" />
                <field name="contract_renewal_name" />
                <field name="contract_renewal_total" />
                <field name="contract_count" />
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('sicpro.app.transporte.general', 'image_128', record.id.raw_value)"
                                     alt="Vehicle"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="license_plate"/> : <field name="model_id"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                <ul>
                                    <li>
                                        <t t-if="record.driver_id.raw_value"><field name="driver_id"/></t>
                                    </li>
                                    <li>
                                        <t t-if="record.future_driver_id.raw_value">Próximo chofer :
                                            <field name="future_driver_id"/></t>
                                    </li>
                                    <li>
                                        <t t-if="record.location.raw_value"><field name="location"/></t>
                                    </li>
                                </ul>
                            </div>
                            <div class="o_kanban_button" t-if="!selection_mode">
                                <a t-if="record.contract_count.raw_value>0" data-type="object"
                                   data-name="return_action_to_open" href="#" class="oe_kanban_action oe_kanban_action_a"
                                   data-context='{"xml_id":"fleet_vehicle_log_contract_action"}'>
                                    <field name="contract_count"/>
                                    Contract(s)
                                    <span t-if="record.contract_renewal_due_soon.raw_value and !record.contract_renewal_overdue.raw_value"
                                        class="fa fa-exclamation-triangle" t-att-style="'color:orange'" role="img"
                                          aria-label="Warning: renewal due soon" title="Warning: renewal due soon">
                                    </span>
                                     <span t-if="record.contract_renewal_overdue.raw_value"
                                        class="fa fa-exclamation-triangle" t-att-style="'color:red;'" role="img"
                                           aria-label="Attention: renewal overdue" title="Attention: renewal overdue">
                                    </span>
                                </a>
                            </div>
                            <div class="o_kanban_inline_block" t-if="!selection_mode">
                                <field name="activity_ids" widget="kanban_activity"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="fleet_vehicle_view_activity" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.general.activity</field>
        <field name="model">sicpro.app.transporte.general</field>
        <field name="arch" type="xml">
            <activity string="Vehículos">
                <field name="license_plate"/>
                <field name="id"/>
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('sicpro.app.transporte.general', 'image_128', record.id.raw_value)"
                             role="img" t-att-title="record.id.value" t-att-alt="record.id.value"/>
                        <div>
                            <field name="license_plate"/> : <field name="model_id"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id='fleet_vehicle_action' model='ir.actions.act_window'>
        <field name="name">Vehículos</field>
        <field name="res_model">sicpro.app.transporte.general</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="context">{'search_default_groupby_status': 1}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo vehículo
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_odometer_view_form' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.odometro.form</field>
        <field name="model">sicpro.app.transporte.odometro</field>
        <field name="arch" type="xml">
            <form string="Registro de odómetros">
                <sheet>
                    <group>
                        <field name="vehicle_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        <field name="value" class="oe_inline"/>
                        <field name="unit" class="oe_inline"/>
                        <field name="date" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_odometer_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.odometro.tree</field>
        <field name="model">sicpro.app.transporte.odometro</field>
        <field name="arch" type="xml">
            <tree string="Registro de odómetros" editable="top">
                <field name="date" />
                <field name="vehicle_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="driver_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="value" />
                <field name="unit" />
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_odometer_view_kanban' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.odometro.kanban</field>
        <field name="model">sicpro.app.transporte.odometro</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div>
                                <strong>
                                    <field name="vehicle_id"/>
                                    <span class="float-right"><field name="date"/></span>
                                </strong>
                            </div>
                            <div>
                                <span><field name="driver_id"/></span>
                                <span class="float-right"><field name="value"/> Km</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id='fleet_vehicle_odometer_view_search' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.odometro.search</field>
        <field name="model">sicpro.app.transporte.odometro</field>
        <field name="arch" type="xml">
            <search string="Odómetro de los vehículos" >
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="value"/>
                <field name="date"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_vehicle" context="{'group_by': 'vehicle_id'}" string="Vehículos"/>
                </group>
            </search>
        </field>
    </record>

    <record id="fleet_vehicle_odometer_view_graph" model="ir.ui.view">
       <field name="name">sicpro.app.transporte.odometro.graph</field>
       <field name="model">sicpro.app.transporte.odometro</field>
       <field name="arch" type="xml">
            <graph string="Odometer Values Per Vehicle">
                <field name="vehicle_id" type="row"/>
                <field name="value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id='fleet_vehicle_odometer_action' model='ir.actions.act_window'>
        <field name="name">Odómetro de los vehículos</field>
        <field name="res_model">sicpro.app.transporte.odometro</field>
        <field name="view_mode">tree,kanban,form,graph</field>
        <field name="context">{"search_default_groupby_vehicle" : True}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo registro de odómetro
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_service_types_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.tipo.servicios.tree</field>
        <field name="model">sicpro.app.transporte.tipo.servicios</field>
        <field name="arch" type="xml">
            <tree string="Tipo de servicios" editable="top">
                <field name="name" />
                <field name="category" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_service_types_action' model='ir.actions.act_window'>
        <field name="name">Tipo de servicios</field>
        <field name="res_model">sicpro.app.transporte.tipo.servicios</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('category','=','servicios')]</field>
        <field name="context">{'default_category':'servicios'}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo tipo de servicio
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_contract_types_action' model='ir.actions.act_window'>
        <field name="name">Tipos de contrato</field>
        <field name="res_model">sicpro.app.transporte.tipo.servicios</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('category','=','contratos')]</field>
        <field name="context">{'default_category':'contratos'}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo contrato
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_state_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.estado.tree</field>
        <field name="model">sicpro.app.transporte.estado</field>
        <field name="arch" type="xml">
            <tree string="State" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_state_action' model='ir.actions.act_window'>
        <field name="name">Estado del vehículo</field>
        <field name="res_model">sicpro.app.transporte.estado</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo estado para los vehiculos
          </p>
        </field>
    </record>

    <record id="fleet_vehicle_tag_view_view_form" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.etiqueta.form</field>
        <field name="model">sicpro.app.transporte.etiqueta</field>
        <field name="arch" type="xml">
            <form string="Etiquetas de vehículo">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="fleet_vehicle_tag_view_view_tree" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.etiqueta.tree</field>
        <field name="model">sicpro.app.transporte.etiqueta</field>
        <field name="arch" type="xml">
            <tree string="Etiquetas de vehículo" editable="bottom">
                <field name="name"/>
                <field name="color"/>
            </tree>
        </field>
    </record>

        <record id="transporte_etiquetas_incrementar" model="ir.sequence">
            <field name="name">Etiquetas</field>
            <field name="code">transporte_etiquetas_incrementar</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>

    <record id="fleet_vehicle_tag_action" model="ir.actions.act_window">
        <field name="name">Etiquetas de vehículo</field>
        <field name="res_model">sicpro.app.transporte.etiqueta</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregar nueva etiqueta
            </p>
        </field>
    </record>

    <record id="fleet_vehicle_assignation_log_view_list" model="ir.ui.view">
        <field name="name">sicpro.app.transporte.historial.view.tree</field>
        <field name="model">sicpro.app.transporte.historial</field>
        <field name="arch" type="xml">
            <tree string="Historial de Registros" editable="bottom">
                <field name="vehicle_id" invisible="1"/>
                <field name="driver_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </tree>
        </field>
    </record>


    <menuitem name="Vehiculos" parent="menu_root" id="fleet_vehicles" sequence="2"/>

    <menuitem name="Vehiculos" action="fleet_vehicle_action" parent="fleet_vehicles" id="fleet_vehicle_menu"
              groups="grupo_app_transporte_usuario"/>

    <menuitem name="Modelo de los vehiculos" action="fleet_vehicle_model_action" parent="fleet_configuration"
              id="fleet_vehicle_model_menu" sequence="11" groups="grupo_app_transporte_responsable"/>

    <menuitem name="Odómetro de los vehiculos" action="fleet_vehicle_odometer_action" parent="fleet_vehicles"
              id="fleet_vehicle_odometer_menu" groups="grupo_app_transporte_ejecutor"/>

    <menuitem name="Tipo de servicios" action="fleet_vehicle_service_types_action" parent="fleet_configuration"
              id="fleet_vehicle_service_types_menu" groups="grupo_app_transporte_gestor" sequence="3"/>

    <menuitem name="Tipos de contratos" action="fleet_vehicle_contract_types_action" parent="fleet_configuration"
