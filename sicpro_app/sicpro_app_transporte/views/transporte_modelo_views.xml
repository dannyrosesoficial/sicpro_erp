<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id='fleet_vehicle_model_view_form' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.form</field>
        <field name="model">sicpro.app.transporte.modelo</field>
        <field name="arch" type="xml">
            <form string="Model">
                <sheet>
                    <field name="image_128" widget='image' class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="ej. Modelo H1"/>
                        </h1>
                        <label for="brand_id" class="oe_edit_only"/>
                        <h2>
                            <field name="brand_id" placeholder="ej. Hyundai"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="clase_id" placeholder="ej. Panel"/>
                            <field name="manager_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Proveedores" name="vendors">
                            <field name="vendors">
                                <kanban quick_create="false" create="true">
                                    <field name="name"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div style="position: relative" class="oe_kanban_global_click">
                                                <div class="oe_module_vignette">
                                                    <div class="oe_module_desc o_kanban_record_title">
                                                        <field name="name"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_model_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.tree</field>
        <field name="model">sicpro.app.transporte.modelo</field>
        <field name="arch" type="xml">
            <tree string="Models">
                <field name="brand_id" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_model_view_kanban' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.kanban</field>
        <field name="model">sicpro.app.transporte.modelo</field>
        <field name="arch" type="xml">
            <kanban string="Models">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_details">
                            <div><strong><field name="name"/></strong></div>
                            <div><field name="brand_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id='fleet_vehicle_model_view_search' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.search</field>
        <field name="model">sicpro.app.transporte.modelo</field>
        <field name="arch" type="xml">
            <search string="Coste de vehículos" >
                <field name="brand_id" />
                <group expand="1" string="Group By">
                    <filter name="groupby_brand" context="{'group_by' : 'brand_id'}" string="Modelo"/>
                </group>
            </search>
        </field>
    </record>

    <record id='fleet_vehicle_model_action' model='ir.actions.act_window'>
        <field name="name">Modelo de Vehículos</field>
        <field name="res_model">sicpro.app.transporte.modelo</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_groupby_brand" : True,}</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nuevo modelo de vehículo
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_model_brand_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.brand.tree</field>
        <field name="model">sicpro.app.transporte.modelo.brand</field>
        <field name="arch" type="xml">
            <tree string="Model Make">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_model_brand_view_form' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.brand.form</field>
        <field name="model">sicpro.app.transporte.modelo.brand</field>
        <field name="arch" type="xml">
            <form string="Model Make">
                <sheet>
                    <group>
                        <div>
                            <field name="image_128" widget="image" class="oe_avatar"/>
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id='fleet_vehicle_model_brand_view_kanban' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.modelo.brandkanban</field>
        <field name="model">sicpro.app.transporte.modelo.brand</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_vignette oe_semantic_html_override">
                            <a type="open" href="#" class="o_kanban_image oe_kanban_action">
                                <img alt="Open" t-att-src="kanban_image('sicpro.app.transporte.modelo.brand', 'image_128', record.id.raw_value)"
                                     class="img-fluid" style="width:100px;"/>
                            </a>
                            <div class="oe_kanban_details">
                                <h4 class="oe_partner_heading">
                                    <a type="open" class="o_kanban_record_title">
                                        <field name="name"/>
                                    </a>
                                </h4>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id='fleet_vehicle_model_brand_action' model='ir.actions.act_window'>
        <field name="name">Fabricantes de automóviles</field>
        <field name="res_model">sicpro.app.transporte.modelo.brand</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Agregar fabricantes de automóviles
          </p>
        </field>
    </record>

    <record id='fleet_vehicle_clase_view_tree' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.clase.tree</field>
        <field name="model">sicpro.app.transporte.clase</field>
        <field name="arch" type="xml">
            <tree string="Clase de vehículo" editable="top">
                <field name="name" />
            </tree>
        </field>
    </record>

    <record id='fleet_vehicle_clase_action' model='ir.actions.act_window'>
        <field name="name">Clase de vehículo</field>
        <field name="res_model">sicpro.app.transporte.clase</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crear nueva clase de vehículo
          </p>
        </field>
    </record>


    <menuitem name="Transporte" id="menu_root" sequence="115" web_icon="sicpro_app_transporte,static/description/icon.png"/>

    <menuitem name="Configuración" parent="menu_root" id="fleet_configuration" sequence="100" />

    <menuitem name="Fabricantes de automóviles" action="fleet_vehicle_model_brand_action"
              groups="grupo_app_transporte_admin" parent="fleet_configuration" id="fleet_vehicle_model_brand_menu"
              sequence="2"/>

    <menuitem name="Clase de automóviles" action="fleet_vehicle_clase_action" groups="grupo_app_transporte_responsable"
              parent="fleet_configuration" id="fleet_vehicle_clase_menu" sequence="3"/>


</odoo>
