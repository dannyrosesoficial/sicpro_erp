<odoo>

    <record id='transporte_estado_view_list' model='ir.ui.view'>
        <field name="name">sicpro.app.transporte.estado.list</field>
        <field name="model">sicpro.app.transporte.estado</field>
        <field name="arch" type="xml">
            <list string="State" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id='transporte_estado_action' model='ir.actions.act_window'>
        <field name="name">Estado del vehículo</field>
        <field name="res_model">sicpro.app.transporte.estado</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nuevo estado para los vehiculos
            </p>
        </field>
    </record>

</odoo>
