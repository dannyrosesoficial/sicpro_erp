<?xml version="1.0" ?>
<odoo>

    <!-- Creo la categoria de permisos Transporte -->
    <record id="module_category_transporte" model="ir.module.category">
            <field name="name">Transporte</field>
            <field name="description">Módulo para el control del parque automotor.</field>
            <field name="sequence" >16</field>
    </record>

    <record id="grupo_app_transporte_usuario" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_transporte_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_usuario'))]"/>
    </record>

    <record id="grupo_app_transporte_gestor" model="res.groups">
            <field name="name">Gestor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_ejecutor'))]"/>
    </record>

    <record id="grupo_app_transporte_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_gestor'))]"/>
    </record>

    <record id="grupo_app_transporte_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_responsable'))]"/>
    </record>






