<?xml version="1.0" ?>
<odoo>

    <!-- Creo la categoría de permisos Transporte -->
    <record id="module_category_transporte" model="ir.module.category">
            <field name="name">Transporte</field>
            <field name="description">Módulo para el control del parque automotor.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_transportacion"/>
            <field name="sequence" >1</field>
    </record>

    <record id="grupo_app_transporte_usuario" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_transporte_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_usuario'))]"/>
    </record>

    <record id="grupo_app_transporte_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_ejecutor'))]"/>
    </record>

    <record id="grupo_app_transporte_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="module_category_transporte"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_responsable'))]"/>
    </record>


        <!-- Creo la categoría de permisos Piquera -->
    <record id="module_category_transporte_piquera" model="ir.module.category">
            <field name="name">Piquera</field>
            <field name="description">Módulo para el control del parque automotor.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_transportacion"/>
            <field name="sequence">2</field>
    </record>

    <record id="grupo_app_transporte_piquera_usuario" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_transporte_piquera"/>
           <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_transporte_piquera_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_transporte_piquera"/>
           <field name="implied_ids" eval="[(4, ref('grupo_app_transporte_piquera_usuario'))]"/>
    </record>

    <data noupdate="0">
        <!-- Regla de permisos para los usuarios de la piquera -->
        <record id="transporte_piquera_usuarios_rule" model="ir.rule">
        <field name="name">Regla de usuarios para la piquera</field>
        <field name="model_id" ref="model_sicpro_app_transporte_piquera"/>
        <field name="domain_force">['|',('solicitante', '=', user.id),('solicitado', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_transporte_piquera_usuario'))]"/>
        </record>

        <!-- Regla de permisos para los ejecutores de la piquera -->
        <record id="transporte_piquera_ejecutores_rule" model="ir.rule">
        <field name="name">Regla de ejecutores para la piquera</field>
        <field name="model_id" ref="model_sicpro_app_transporte_piquera"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_transporte_piquera_ejecutor'))]"/>
        </record>


        </data>

</odoo>
