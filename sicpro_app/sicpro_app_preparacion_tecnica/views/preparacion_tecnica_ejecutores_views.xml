<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Configuración -->
        <record id="preparacion_tecnica_ejecutor_form" model="ir.ui.view">
            <field name="name">sicpro.app.preparacion.tecnica.ejecutor.form</field>
            <field name="model">sicpro.app.preparacion.tecnica.ejecutor</field>
            <field name="arch" type="xml">
                <form string="Especialista">
                <sheet>
                    <div class="oe_button_box" name="button_box" groups="base.group_user">
                        <button  class="oe_stat_button" name="attachment_tree_view" type="object" icon="fa-file-text-o">
                            <field string="Documentos" name="doc_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="action"
                            name="%(sicpro_app_preparacion_tecnica.sicpro_app_preparacion_tecnica_preparaciones_action)d" icon="fa-tasks">
                            <field string="Preparaciones" name="task_count" widget="statinfo" />
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del especialista"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </h1>
                        <div name="options_active">
                            <div>
                                <label for="cargo_especialista" class="oe_inline" string="Cargo del Ejecutor :"/>
                                <field name="cargo_especialista" class="oe_inline oe_input_align"/>
                            </div>
                        </div>
                    </div>
                    <notebook>
                        <page name="settings" string="Configuración">
                            <group>
                                <group string="Jefe inmediato">
                                    <field name="active" invisible="1"/>
                                    <field name="responsable" string="Responsable"/>
                                    <field name="cargo_responsable" string="Cargo"/>
                                </group>
                                <group string="Area">
                                    <field name="departamento"/>
                                    <field name="company_id"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                </group>
                            </group>
                            <group name="misc">
                                <group string="Planificación del tiempo">
                                    <field name="resource_calendar_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
            </field>
        </record>

        <record id="preparacion_tecnica_ejecutor_tree" model="ir.ui.view">
            <field name="name">sicpro.app.preparacion.tecnica.ejecutor.tree</field>
            <field name="model">sicpro.app.preparacion.tecnica.ejecutor</field>
            <field name="arch" type="xml">
                <tree decoration-bf="message_needaction==True" decoration-muted="active == False" string="Especialistas">
                    <field name="sequence" widget="handle"/>
                    <field name="message_needaction" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="name"/>
                    <field name="cargo_especialista"/>
                    <field name="departamento"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </tree>
            </field>
        </record>

        <record id="preparacion_tecnica_ejecutor_filter" model="ir.ui.view">
            <field name="name">sicpro.app.preparacion.tecnica.ejecutor.select</field>
            <field name="model">sicpro.app.preparacion.tecnica.ejecutor</field>
            <field name="arch" type="xml">
                <search string="Buscar Especialista">
                    <field name="name"/>
                    <field name="departamento"/>
                    <field name="company_id"/>
                    <separator/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <record id="preparacion_tecnica_ejecutor_config_action" model="ir.actions.act_window">
            <field name="name">Configurar Especialistas</field>
            <field name="res_model">sicpro.app.preparacion.tecnica.ejecutor</field>
            <field name="domain">[]</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="preparacion_tecnica_ejecutor_filter"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_empty_folder">
                    Crear nuevo especialista ejecutor
                </p>
            </field>
        </record>


        <!-- Ejecución -->
        <record model="ir.ui.view" id="preparacion_tecnica_ejecutor_kanban">
            <field name="name">sicpro.app.preparacion.tecnica.ejecutor.kanban</field>
            <field name="model">sicpro.app.preparacion.tecnica.ejecutor</field>
            <field name="arch" type="xml">
                <kanban class="oe_background_grey o_kanban_dashboard o_project_kanban o_emphasize_colors"
                        create="false" edit="false" delete="false">
                    <field name="name"/>
                    <field name="color"/>
                    <field name="task_count"/>
                    <field name="is_favorite"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="#{kanban_color(record.color.raw_value)} oe_kanban_global_click o_has_icon">
                                <div class="o_project_kanban_main">
                                    <div class="o_kanban_card_content">
                                        <div class="o_kanban_primary_left">
                                            <div class="o_primary">
                                                <span><t t-esc="record.name.value"/></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                        <div class="o_kanban_card_manage_section o_kanban_manage_reports">
                                            <div role="menuitem"><a type="edit">Ver</a></div>
                                            <div role="menuitem"><a type="edit">Editar</a></div>
                                        </div>
                                        <div role="menuitem" aria-haspopup="true" class="o_no_padding_kanban_colorpicker">
                                            <ul class="oe_kanban_colorpicker" data-field="color" role="popup"/>
                                        </div>
                                    </div>
                                    <a class="o_kanban_manage_toggle_button o_left" href="#">
                                        <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                    </a>
                                    <span class="o_right">
                                        <field name="is_favorite" widget="boolean_favorite" nolabel="1" force_save="1" />
                                    </span>
                                </div>
                                <div class="o_project_kanban_boxes">
                                    <a class="o_project_kanban_box" name="%(sicpro_app_preparacion_tecnica.sicpro_app_preparacion_tecnica_preparaciones_action)d" type="action">
                                        <div>
                                            <span class="o_value"><t t-esc="record.task_count.value"/></span> Preparaciones Técnicas
                                        </div>
                                    </a>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="preparacion_tecnica_ejecutor_action" model="ir.actions.act_window">
            <field name="name">Cartera de Especialistas</field>
            <field name="res_model">sicpro.app.preparacion.tecnica.ejecutor</field>
            <field name="domain">[]</field>
            <field name="view_mode">kanban,form</field>
            <field name="view_id" ref="preparacion_tecnica_ejecutor_kanban"/>
            <field name="search_view_id" ref="preparacion_tecnica_ejecutor_filter"/>
            <field name="target">main</field>
        </record>


    </data>
</odoo>