<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="preparacion_tecnica_clasificacion_search_view">
            <field name="name">sicpro.app.preparacion.tecnica.clasificacion.search</field>
            <field name="model">sicpro.app.preparacion.tecnica.clasificacion</field>
            <field name="arch" type="xml">
                <search string="Buscar Etiquetas">
                    <field name="name"/>
                    <field name="especialidad"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="preparacion_tecnica_clasificacion_form_view">
            <field name="name">sicpro.app.preparacion.tecnica.clasificacion.form</field>
            <field name="model">sicpro.app.preparacion.tecnica.clasificacion</field>
            <field name="arch" type="xml">
                <form string="Clasificación">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="especialidad"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="preparacion_tecnica_clasificacion_tree_view">
            <field name="name">sicpro.app.preparacion.tecnica.clasificacion.tree</field>
            <field name="model">sicpro.app.preparacion.tecnica.clasificacion</field>
            <field name="arch" type="xml">
                <tree string="Clasificación" editable="bottom">
                    <field name="name"/>
                    <field name="especialidad"/>
                </tree>
            </field>
        </record>

        <record id="preparacion_tecnica_clasificacion_action" model="ir.actions.act_window">
            <field name="name">Clasificación</field>
            <field name="res_model">sicpro.app.preparacion.tecnica.clasificacion</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear nueva clasificación...
              </p>
            </field>
        </record>
    
    </data>
</odoo>