<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Creo la categoria de permisos Preparacion Tecnica -->
         <record id="module_category_preparacion_tecnica" model="ir.module.category">
            <field name="name">Preparación Técnica</field>
             <field name="description">Módulo para la gestión de la preparación técnica de la obra.</field>
            <field name="sequence" >15</field>
        </record>

        <record id="grupo_app_preparacion_tecnica_usuario" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_preparacion_tecnica"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_app_preparacion_tecnica_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_preparacion_tecnica"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario'))]"/>
        </record>

         <record id="grupo_app_preparacion_tecnica_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="module_category_preparacion_tecnica"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_preparacion_tecnica_ejecutor'))]"/>
        </record>

         <record id="grupo_app_preparacion_tecnica_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="module_category_preparacion_tecnica"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_preparacion_tecnica_responsable'))]"/>
        </record>

            <!-- Creo la categoria de permisos Preparacion Tecnica aprobacion-->
        <record id="module_category_preparacion_tecnica_aprobacion" model="ir.module.category">
            <field name="name">Preparación Técnica Aprobación</field>
             <field name="description">Módulo para la gestión de la preparación técnica de la obra.</field>
            <field name="sequence" >16</field>
        </record>

        <record id="grupo_app_preparacion_tecnica_usuario_aprobacion" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_preparacion_tecnica_aprobacion"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_app_preparacion_tecnica_ejecutor_aprobacion" model="res.groups">
            <field name="name">Aprobar la preparación técnica</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_preparacion_tecnica_aprobacion"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario_aprobacion'))]"/>
        </record>


<data noupdate="0">

    <record id="preparacion_tecnica_rule_preparaciones" model="ir.rule">
        <field name="name">Preparaciones Procesos</field>
        <field ref="model_sicpro_app_preparacion_tecnica_preparaciones" name="model_id"/>
        <field name="domain_force">['|','&amp;', ('company_id','=',False),('company_id', 'child_of', company_ids),
                                    ('stage_id.is_aprobada', '!=', True)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario'))]"/>
    </record>

    <record id="preparacion_tecnica_rule_actividades" model="ir.rule">
        <field name="name">Actividades Procesos</field>
        <field ref="model_sicpro_app_preparacion_tecnica_actividades" name="model_id"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'child_of', company_ids)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario'))]"/>
    </record>

    <record id="preparacion_tecnica_rule_especialistas1" model="ir.rule">
        <field name="name">Especialistas Procesos usuarios</field>
        <field ref="model_sicpro_app_preparacion_tecnica_ejecutor" name="model_id"/>
        <field name="domain_force">[('name', '=', [user.trabajador.id])]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario'))]"/>
    </record>
<!--
    <record id="preparacion_tecnica_rule_especialistas2" model="ir.rule">
        <field name="name">Especialistas Procesos responsable</field>
        <field ref="model_sicpro_app_preparacion_tecnica_ejecutor" name="model_id"/>
        <field name="domain_force">['|', ('company_id','=',False),('company_id', 'child_of', company_ids)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_responsable'))]"/>
    </record>-->

    <record id="preparacion_tecnica_rule_estados1" model="ir.rule">
        <field name="name">Regla Grupos Ejecución Estados</field>
        <field ref="model_sicpro_app_preparacion_tecnica_estados" name="model_id"/>
        <field name="domain_force">[('is_aprobada', '=', False)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario'))]"/>
    </record>




    <record id="preparacion_tecnica_rule_preparaciones_aprobacion" model="ir.rule">
        <field name="name">Preparaciones Procesos aprobacion</field>
        <field ref="model_sicpro_app_preparacion_tecnica_preparaciones" name="model_id"/>
        <field name="domain_force">['|','&amp;', ('company_id','=',False),('company_id', 'child_of', company_ids),
                                    ('stage_id.is_aprobada', '=', True)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario_aprobacion'))]"/>
    </record>

    <record id="preparacion_tecnica_rule_actividades_aprobacion" model="ir.rule">
        <field name="name">Actividades Procesos aprobacion</field>
        <field ref="model_sicpro_app_preparacion_tecnica_actividades" name="model_id"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id', 'child_of', company_ids)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario_aprobacion'))]"/>
    </record>



     <record id="preparacion_tecnica_rule_estados2" model="ir.rule">
        <field name="name">Regla Grupos Aprobación Estados</field>
        <field ref="model_sicpro_app_preparacion_tecnica_estados" name="model_id"/>
        <field name="domain_force">[('is_aprobada', '=', True)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_preparacion_tecnica_usuario_aprobacion'))]"/>
    </record>

</data>
</odoo>
