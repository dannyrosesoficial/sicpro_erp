<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- Heredo vista search de res.user y le agrego filtros de búsquedas -->
    <record id="desactiva_user_email_search_views" model="ir.ui.view">
        <field name="name">res.users.mod.search.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search"/>
        <field name="arch" type="xml">
            <field name="company_ids" position="after">
                <group expand="0" string="Agrupar por">
                    <filter name="tipo" string="Tipo de Usuario" context="{'group_by': 'tipo_usuario'}"/>
                    <separator/>
                </group>
            </field>

        </field>
    </record>

    <!-- Heredo vista form de res.user y le agrego campos -->
    <record id="desactiva_user_email_form_views" model="ir.ui.view">
        <field name="name">res.users.views.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="replace">
                <group>
                    <group>
                        <div>
                            <field name="tipo_usuario" class="font-weight-bold" widget="radio"
                                   options="{'horizontal': true}"/>
                            <div class="col-6 oe_edit_only" attrs="{'invisible': [('tipo_usuario', '=', 'local')]}">
                                <div class="o_row no-gutters d-flex">
                                    <span class='font-weight-bold'>Buscar No. PEP</span>
                                    <field name="buscar_pep"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                </div>
                            </div>
                        </div>
                    </group>
                    <group>
                        <field name="image_1920" widget='image' class="oe_avatar" nolabel="1"
                               options='{"preview_image": "avatar_128"}'/>
                    </group>
                </group>
            </xpath>

            <field name="color" position="after">
                <field name="pep" placeholder="No. Plaza del Trabajador"/>
            </field>

        </field>
    </record>

    <!-- Heredo vista tree de res.user y le agrego campos -->
    <record id="desactiva_user_email_tree_views" model="ir.ui.view">
        <field name="name">res.users.views.tree</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="tipo_usuario" optional="hide"/>
            </field>
        </field>
    </record>


</odoo>
