<odoo>
  <record id="viveres_cierre_list" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.cierre.list</field>
    <field name="model">sicpro.app.viveres.cierre</field>
    <field name="priority">50</field>
    <field name="arch" type="xml">
      <list string="Cierres mensuales Capital Humano" editable="bottom"
            decoration-bf="0" js_class="cargar_cierre" sample="1" decoration-danger="estado == 'error'">
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="mes"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="anio"/>
        <field name="total"/>
        <field name="altas"/>
        <field name="bajas"/>
        <field name="estado" class="font-weight-bold" widget="badge"
               decoration-danger="estado == 'error'"/>
      </list>
    </field>
  </record>

  <record id="viveres_cierre_pivot" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.cierre.pivot</field>
    <field name="model">sicpro.app.viveres.cierre</field>
    <field name="arch" type="xml">
      <pivot string="Cierres mensuales Capital Humano" display_quantity="true"
             disable_linking="false" sample="1">
        <field name="direccion"/>
        <field name="name" type="row"/>
        <field name="mes" type="col"/>
        <field name="total" type="measure"/>
        <field name="bajas" type="measure"/>
        <field name="altas" type="measure"/>
      </pivot>
    </field>
  </record>

  <record id="viveres_cierre_action" model="ir.actions.act_window">
    <field name="name">Cierres mensuales Capital Humano</field>
    <field name="res_model">sicpro.app.viveres.cierre</field>
    <field name="view_mode">list,pivot</field>
    <field name="view_id" ref="viveres_cierre_list"/>
    <field name="context">{'search_default_pendiente': 1}</field>
  </record>
</odoo>

