<odoo>
  <record id="viveres_areas_altas_bajas_list" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.areas.altas.bajas.list</field>
    <field name="model">sicpro.app.viveres.areas.altas.bajas</field>
    <field name="arch" type="xml">
      <list string="Altas y bajas por áreas" sample="1" create="false"
            decoration-primary="estado == 'alta'" decoration-danger="estado == 'baja'" editable="bottom">
        <field name="trabajador"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="direccion"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="fecha"/>
        <field name="mes"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="anio"/>
        <field name="estado" class="font-weight-bold" widget="badge"
               decoration-primary="estado == 'alta'" decoration-danger="estado == 'baja'"/>
      </list>
    </field>
  </record>

  <record id="viveres_areas_altas_bajas_action" model="ir.actions.act_window">
    <field name="name">Altas y bajas por áreas</field>
    <field name="res_model">sicpro.app.viveres.areas.altas.bajas</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
