<odoo>
  <record id="viveres_trabajadores_entregas_form" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.trabajadores.entregas.form</field>
    <field name="model">sicpro.app.viveres.trabajadores.entregas</field>
    <field name="arch" type="xml">
      <form string="Entregas al trabajador">
        <header>
        </header>
        <sheet>
          <group name="group_top">
            <group name="group_left">
              <field name="estado"/>
              <field name="name"
                     options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
              <field name="jefe_area"
                     options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
              <field name="trabajador_id"
                     options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
              <field name="producto_comprado_trabajador" widget="many2many_tags"
                     options="{'color_field': 'color'}"/>
            </group>
            <group name="group_right">
              <field name="fecha_entrega"/>
              <field name="fecha_entrega_trabajador"/>
              <field name="observaciones"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="viveres_trabajadores_entregas_list" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.trabajadores.entregas.list</field>
    <field name="model">sicpro.app.viveres.trabajadores.entregas</field>
    <field name="arch" type="xml">
      <list string="Entregas al trabajador" decoration-bf="0" sample="1">
        <field name="estado"/>
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="jefe_area"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="trabajador_id"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="producto_comprado_trabajador" widget="many2many_tags"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True', 'color_field': 'color'}"/>
        <field name="fecha_entrega"/>
        <field name="fecha_entrega_trabajador"/>
        <field name="observaciones"/>
      </list>
    </field>
  </record>

  <record id="viveres_trabajadores_entregas_filter" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.trabajadores.entregas.search</field>
    <field name="model">sicpro.app.viveres.trabajadores.entregas</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="trabajador_id"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <group>
          <filter string='Producto' name="producto_comprado_trabajador" domain="[]"
                  context="{'group_by': 'producto_comprado_trabajador'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="viveres_trabajadores_entregas_action" model="ir.actions.act_window">
    <field name="name">Entregas al trabajador</field>
    <field name="res_model">sicpro.app.viveres.trabajadores.entregas</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
