<odoo>
  <record id="viveres_areas_fondo_list" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.areas.fondo.list</field>
    <field name="model">sicpro.app.viveres.areas.fondo</field>
    <field name="arch" type="xml">
      <list string="Fondo por áreas" sample="1" editable="bottom" create="false">
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="direccion"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="fondo"/>
        <field name="mes"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="anio"/>
        <field name="fecha_entrega"/>
      </list>
    </field>
  </record>

  <record id="viveres_areas_fondo_action" model="ir.actions.act_window">
    <field name="name">Fondo por áreas</field>
    <field name="res_model">sicpro.app.viveres.areas.fondo</field>
    <field name="view_mode">list</field>
  </record>
</odoo>

