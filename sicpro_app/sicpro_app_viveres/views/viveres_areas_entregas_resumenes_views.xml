<odoo>
  <record id="view_list_viveres_areas_entregas_resumenes" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.areas.entregas.resumenes.list</field>
    <field name="model">sicpro.app.viveres.areas.entregas.resumenes</field>
    <field name="arch" type="xml">
      <list string="Resumen entregas por áreas" sample="1" create="false" editable="bottom">
        <field name="producto"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="fecha_compra"/>
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="direccion"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="fecha_entrega"/>
        <field name="total_entregado_area"/>
        <field name="total_entregado_trabajadores"/>
        <field name="total_pendiente"/>
        <field name="total_no_entregado"/>
      </list>
    </field>
  </record>

  <record id="viveres_areas_entregas_resumenes_action" model="ir.actions.act_window">
    <field name="name">Resumen entregas por áreas</field>
    <field name="res_model">sicpro.app.viveres.areas.entregas.resumenes</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
