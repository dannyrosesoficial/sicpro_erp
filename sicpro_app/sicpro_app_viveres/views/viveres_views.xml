<odoo>
  <record id="viveres_resumen_list" model="ir.ui.view">
    <field name="name">sicpro.app.alimetacion.list</field>
    <field name="model">sicpro.app.viveres</field>
    <field name="arch" type="xml">
      <list string="Entregas generales Víveres" sample="1" editable="bottom" create="false">
        <field name="numero_entrega"/>
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="fecha"/>
        <field name="precio"/>
        <field name="total_trabajadores"/>
      </list>
    </field>
  </record>

  <record id="viveres_resumen_action" model="ir.actions.act_window">
    <field name="name">Entregas generales Víveres</field>
    <field name="res_model">sicpro.app.viveres</field>
    <field name="view_mode">list</field>
  </record>
</odoo>

