<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="viveres_resumen_tree" model="ir.ui.view">
        <field name="name">sicpro.app.alimetacion.tree</field>
        <field name="model">sicpro.app.viveres</field>
        <field name="arch" type="xml">
            <tree string="Entregas generales Víveres" sample="1" editable="bottom" create="false">
                <field name="numero_entrega"/>
                <field name="name"
                       options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
                <field name="fecha"/>
                <field name="precio"/>
                <field name="total_trabajadores"/>
            </tree>
        </field>
    </record>

    <record id="viveres_resumen_action" model="ir.actions.act_window">
        <field name="name">Entregas generales Víveres</field>
        <field name="res_model">sicpro.app.viveres</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>

