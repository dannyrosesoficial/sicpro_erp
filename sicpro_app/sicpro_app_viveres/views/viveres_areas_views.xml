<odoo>
  <record id="viveres_areas_list" model="ir.ui.view">
    <field name="name">sicpro.app.viveres.areas.list</field>
    <field name="model">sicpro.app.viveres.areas</field>
    <field name="arch" type="xml">
      <list string="Áreas" editable="bottom" sample="1">
        <field name="name"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
        <field name="direccion"
               options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
      </list>
    </field>
  </record>

  <record id="viveres_areas_action" model="ir.actions.act_window">
    <field name="name">Áreas</field>
    <field name="res_model">sicpro.app.viveres.areas</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
