<odoo>
    <data noupdate="0">
        <!-- Plantilla de entrega productos área -->
        <record id="viveres_entregas_areas" model="mail.template">
            <field name="name">Víveres: Entrega productos al área</field>
            <field name="model_id" ref="sicpro_app_viveres.model_sicpro_app_viveres_areas_entregas"/>
            <field name="email_from">"SICPRO ERP" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
            <field name="auto_delete" eval="False"/>
            <field name="subject">•SICPRO ERP-Víveres: {{ object.create_uid.name }} ha realizado una entrega de productos al área - {{ object.name.name.name }}</field>
            <field name="body_html" type="html">
                <table style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
                       cellspacing="0" cellpadding="0" border="0">
                    <tbody>
                        <tr>
                            <td align="center">
                                <table style="padding:16px;background-color: white; color: #454748; border-collapse:separate;"
                                       width="590" cellspacing="0" cellpadding="0" border="0">
                                    <tbody>
                                        <!-- ENCABEZADO -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                       width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td valign="middle">
                                                                <span style="font-size:10px;">Bienvenido/a a SICPRO
                                                                </span>
                                                                <br></br>
                                                                <span style="font-size:20px;font-weight: bold;"> Entrega
                                                                    de víveres a:
                                                                    <t t-out="object.name.name.name"/>
                                                                </span>
                                                            </td>
                                                            <td valign="middle" align="right">
                                                                <img src="/sicpro_app_administracion/static/src/img/logo_sicpro 4.png"
                                                                     style="padding:0px;margin: 0px; height: auto; width: 25%;"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2" style="text-align:center;">
                                                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                    width="100%"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- CONTENIDO -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                       width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td style="font-size:13px;" valign="top">
                                                                <div>Se ha realizado una entrega de productos al área
                                                                    <b>
                                                                        <t t-out="object.name.name.name"/>
                                                                    </b>
                                                                    , a continuación se relacionan todos los datos:
                                                                    <br></br>
                                                                    <br></br>
                                                                    <b>Fecha:</b>
                                                                    <t t-out="format_date(object.fecha)"/>
                                                                    <br></br>
                                                                    <br></br>
                                                                    <b>Entregado a:</b>
                                                                    <t t-out="object.trabajador.name"/>
                                                                    <br></br>
                                                                    <br></br>
                                                                    <b>Total entregado:</b>
                                                                    <t t-out="object.total_entregado"/>
                                                                    <br></br>
                                                                    <b>Total trabajadores:</b>
                                                                    <t t-out="object.total_trabajadores"/>
                                                                    <br></br>
                                                                    <b>Observaciones:</b>
                                                                    <t t-out="object.observaciones"/>
                                                                    <b>
                                                                        <br></br>
                                                                    </b>
                                                                    <br></br>
                                                                    <b>Listado de productos entregados:</b>
                                                                    <br></br>
                                                                    <t t-set="count_listado" t-value="1"/>
                                                                    <t t-foreach="object.producto_comprado" t-as="prod">
                                                                        <i><b><span t-out="count_listado"/></b>-
                                                                            <t t-out="prod.producto_id.name"/></i>
                                                                        <t t-set="count_listado" t-value="count_listado + 1"/>
                                                                        <br></br>
                                                                    </t>
                                                                    <br></br>
                                                                    <br></br>
                                                                    <br></br>
                                                                    <br></br>
                                                                    <div style="margin:16px 0px 16px 0px;">
                                                                        <a t-att-href="'/mail/view?model=%s&amp;res_id=%s' % ('sicpro.app.viveres.areas.entregas', object.id,)"
                                                                           style="background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                                                            ver Registro de la Entrega
                                                                        </a>
                                                                    </div>
                                                                    <br></br>
                                                                    <br></br>
                                                                    <br></br>
                                                                    --<br></br>Equipo de administración SICPRO ERP.
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center;">
                                                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                    width="100%"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- PIE -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                       width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td valign="middle" align="left">
                                                                <t t-out="object.company_id.name"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="opacity:0.7;" valign="middle" align="left">
                                                                <t t-out="object.company_id.phone"/>
                                                                <t t-if="object.company_id.email">
                                                                    |
                                                                    <a t-att-href="'mailto:%s' % object.company_id.email"
                                                                       style="color:#454748;">
                                                                        <t t-out="object.company_id.email"/>
                                                                    </a>
                                                                </t>
                                                                <t t-if="object.company_id.website">
                                                                    |
                                                                    <a t-att-href="'%s' % object.company_id.website"
                                                                       style="color:#454748;">
                                                                        <t t-out="website_url"/>
                                                                    </a>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                        <!-- POWERED BY -->
                        <tr>
                            <td style="min-width:590px;" align="center">
                                <br></br>
                                <table style="min-width:590px;background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;"
                                       width="590" cellspacing="0" cellpadding="0" border="0">
                                    <tbody>
                                        <tr>
                                            <td style="text-align:center;font-size: 13px;">
                                                Recibes notificaciones con la tecnología de
                                                <b>
                                                    <a target="_blank" style="color:#875A7B;">
                                                        <font style="color:rgb(7, 140, 7);">SICPRO
                                                        </font>
                                                    </a>
                                                    <font style="color:rgb(7, 140, 7);">
                                                        <br></br>
                                                    </font>
                                                </b>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="text-align:center;font-size: 13px;">
                                                <p>
                                                    <font style="font-size:10px;" class="text-600">© 2019 - 2023
                                                        División de Proyectos y Ejecución de Obras, DVPE.
                                                    </font>
                                                    <br></br>
                                                    <font style="font-size:10px;" class="text-600">Edificio Masónico,
                                                        Ave. Carlos III / Calle Santiago y Belascoain.
                                                    </font>
                                                </p>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </field>
        </record>
    </data>
</odoo>
