<templates xml:space="preserve">
    <t t-name="sicpro_app_viveres.template_viveres_distribuir_productos" t-inherit="web.ListView"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="before">
            <t t-if="props.resModel === 'sicpro.app.viveres.trabajadores.entregas'">
                <button type="button" class="btn btn-primary fa fa-cart-arrow-down">
                Distribuir Productos
            </button>
            </t>
        </xpath>

      <xpath expr="//button[hasclass('o_list_button_add')]" position="attributes">
            <attribute name="t-if">props.resModel !== 'sicpro.app.viveres.trabajadores.entregas'</attribute>
        </xpath>
    </t>
</templates>