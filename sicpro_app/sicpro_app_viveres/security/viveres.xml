<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>
        <!-- Categoría Principal de Módulo de víveres -->
        <record id="modulo_categoria_viveres" model="ir.module.category">
            <field name="name">Víveres</field>
            <field name="description">Módulo para el acceso a las aplicaciones de Víveres.</field>
            <field name="sequence">70</field>
        </record>
    </data>

    <data>
        <!-- Categoría de permisos víveres Resumen -->
        <record id="modulo_categoria_viveres_resumen" model="ir.module.category">
            <field name="name">Gestión Logística</field>
            <field name="description">Módulo para la gestión de entrega del módulo de víveres.</field>
            <field name="parent_id" ref="modulo_categoria_viveres"/>
             <field name="sequence" >1</field>
         </record>
        <record id="grupo_app_viveres_resumen_usuario" model="res.groups">
            <field name="name">Visualizar</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="modulo_categoria_viveres_resumen"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="grupo_app_viveres_resumen_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="modulo_categoria_viveres_resumen"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_viveres_resumen_usuario'))]"/>
        </record>
        <record id="grupo_app_viveres_resumen_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="modulo_categoria_viveres_resumen"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_viveres_resumen_ejecutor'))]"/>
        </record>
        <record id="grupo_app_viveres_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="modulo_categoria_viveres_resumen"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_viveres_resumen_responsable'))]"/>
        </record>
    </data>

    <data>
        <!-- Categoría de permisos víveres Áreas -->
        <record id="modulo_categoria_viveres_areas" model="ir.module.category">
            <field name="name">Distribución Áreas</field>
            <field name="description">Módulo para la gestión de entrega del módulo de víveres.</field>
            <field name="parent_id" ref="modulo_categoria_viveres"/>
             <field name="sequence" >1</field>
         </record>
        <record id="grupo_app_viveres_areas_usuario" model="res.groups">
            <field name="name">Visualizar</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="modulo_categoria_viveres_areas"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="grupo_app_viveres_areas_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="modulo_categoria_viveres_areas"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_viveres_areas_usuario'))]"/>
        </record>
        <record id="grupo_app_viveres_areas_responsable" model="res.groups">
            <field name="name">Jefe</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="modulo_categoria_viveres_areas"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_viveres_areas_ejecutor'))]"/>
        </record>
    </data>
</odoo>