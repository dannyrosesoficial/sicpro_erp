<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_users_form_simple_modif_notify_inherit" model="ir.ui.view">
        <field name="name">res.users.form.simple.view.modif.notify.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Notificación web de prueba" name="test_web_notify">
                    <group>
                        <group>
                            <button name="notify_success" type="object" string="Notificación de éxito de la prueba"
                                    class="oe_highlight"/>
                        </group>
                        <group>
                            <button name="notify_danger" type="object" string="Notificación de peligro de prueba"
                                    class="oe_highlight"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <button name="notify_warning" type="object" string="Notificación de advertencia de prueba"
                                    class="oe_highlight"/>
                        </group>
                        <group>
                            <button name="notify_info" type="object" string="Notificación de información de prueba"
                                    class="oe_highlight"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <button name="notify_default" type="object" string="Probar notificación predeterminada"
                                    class="oe_highlight"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
