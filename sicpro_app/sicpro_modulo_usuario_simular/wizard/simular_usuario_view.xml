<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="user_simulation_wizard_view" model="ir.ui.view">
            <field name="name">Simular Usuario</field>
            <field name="model">sicpro.modulo.simular.usuario</field>
            <field name="arch" type="xml">
                <form string="Simular Usuario">
                    <label for="user_id" />
                    <field name="user_id" widhet="many2one" context="{'user_simulation_context':True}"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <footer>
                        <button string="Login" name="login_simulation" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_user_simulation" model="ir.actions.act_window">
            <field name="name">Simular Usuario</field>
            <field name="res_model">sicpro.modulo.simular.usuario</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="user_simulation_wizard_view" />
            <field name="target">new</field>
        </record>

    </data>
</odoo>
