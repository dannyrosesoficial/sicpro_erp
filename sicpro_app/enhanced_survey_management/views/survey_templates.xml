<odoo>
    <template id="question_container" name="Survey: question container" inherit_id="survey.question_container">
        <xpath expr="//div[@role='alert']" position="before">
            <t t-if="question.question_type == 'time'"><t t-call="enhanced_survey_management.question_time"/></t>
            <t t-if="question.question_type == 'month'"><t t-call="enhanced_survey_management.question_month"/></t>
            <t t-if="question.question_type == 'name'"><t t-call="enhanced_survey_management.question_name"/></t>
            <t t-if="question.question_type == 'address'"><t t-call="enhanced_survey_management.question_address"/></t>
            <t t-if="question.question_type == 'signature'"><t t-call="enhanced_survey_management.question_signature"/></t>
            <t t-if="question.question_type == 'qr'"><t t-call="enhanced_survey_management.question_qr"/></t>
            <t t-if="question.question_type == 'email'"><t t-call="enhanced_survey_management.question_email"/></t>
            <t t-if="question.question_type == 'password'"><t t-call="enhanced_survey_management.question_password"/></t>
            <t t-if="question.question_type == 'url'"><t t-call="enhanced_survey_management.question_url"/></t>
            <t t-if="question.question_type == 'week'"><t t-call="enhanced_survey_management.question_week"/></t>
            <t t-if="question.question_type == 'color'"><t t-call="enhanced_survey_management.question_color"/></t>
            <t t-if="question.question_type == 'range'"><t t-call="enhanced_survey_management.question_range"/></t>
            <t t-if="question.question_type == 'many2one'"><t t-call="enhanced_survey_management.question_many2one"/></t>
            <t t-if="question.question_type == 'matrix' and question.matrix_subtype == 'custom'"><t t-call="enhanced_survey_management.question_matrix_custom"/></t>
            <t t-if="question.question_type == 'file'"><t t-call="enhanced_survey_management.question_file"/></t>
            <t t-if="question.question_type == 'many2many'"><t t-call="enhanced_survey_management.question_many2many"/></t>
            <t t-if="question.question_type == 'selection'"><t t-call="enhanced_survey_management.question_selection_choice"/></t>
            <t t-if="question.question_type == 'barcode'"><t t-call="enhanced_survey_management.question_barcode"/></t>
        </xpath>
    </template>

    <template id="question_time" name="Question: Time">
        <input type="time" class="form-control o_survey_question_time bg-transparent border-0 border-bottom rounded-0"
               t-att-name="question.id" t-att-value="answer_lines.get_value_time() if answer_lines else ''" t-att-data-question-type="question.question_type"/>
    </template>

    <template id="question_month" name="Question: Month">
        <input type="month" class="form-control bg-transparent border-0 border-bottom rounded-0"
               t-att-name="question.id" t-att-value="answer_lines[0].value_month if answer_lines else ''" t-att-data-question-type="question.question_type"/>
    </template>

    <template id="question_name" name="Question: Name">
        <div class="row g-2">
            <div class="col-md-4"><input type="text" class="form-control" t-attf-name="#{question.id}-first" placeholder="First Name" t-att-value="answer_lines.get_value_name('first') if answer_lines else ''"/></div>
            <div class="col-md-4"><input type="text" class="form-control" t-attf-name="#{question.id}-middle" placeholder="Middle Name" t-att-value="answer_lines.get_value_name('middle') if answer_lines else ''"/></div>
            <div class="col-md-4"><input type="text" class="form-control" t-attf-name="#{question.id}-last" placeholder="Last Name" t-att-value="answer_lines.get_value_name('last') if answer_lines else ''"/></div>
        </div>
    </template>

    <template id="question_address" name="Question: Address">
        <div class="row g-2">
            <div class="col-12 mb-2"><input type="text" class="form-control" t-attf-name="#{question.id}-adders" placeholder="Address" t-att-value="answer_lines.get_value_address('adders') if answer_lines else ''"/></div>
            <div class="col-12 mb-2"><input type="text" class="form-control" t-attf-name="#{question.id}-street" placeholder="Street" t-att-value="answer_lines.get_value_address('street') if answer_lines else ''"/></div>
            <div class="col-md-4"><input type="text" class="form-control" t-attf-name="#{question.id}-city" placeholder="City" t-att-value="answer_lines.get_value_address('city') if answer_lines else ''"/></div>
            <div class="col-md-4">
                <select class="form-select o_select_Country" t-attf-name="#{question.id}-country" t-att-data-id="question.id">
                    <option value=""><t t-esc="answer_lines.get_value_address('country') if answer_lines else 'Country'"/></option>
                </select>
            </div>
            <div class="col-md-4">
                <select class="form-select o_select_State" t-attf-name="#{question.id}-state">
                    <option value=""><t t-esc="answer_lines.get_value_address('state') if answer_lines else 'State'"/></option>
                </select>
            </div>
        </div>
    </template>

    <template id="question_signature" name="Question: Signature">
        <div class="o_survey_signature_wrapper border p-3 rounded bg-white">
            <t t-call="portal.signature_form">
                <t t-set="call_url" t-value="''"/>
                <t t-set="default_name" t-value="''"/>
            </t>
        </div>
    </template>

    <template id="question_qr" name="Question: QR">
        <div class="text-center">
            <t t-if="question.qrcode">
                <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value=#{question.qrcode}&amp;width=120&amp;height=120" alt="QR"/>
            </t>
            <t t-else="">
                <div class="input-group">
                    <input type="text" class="form-control" t-att-name="question.id" placeholder="QR Code Data" readonly="1"/>
                    <button class="btn btn-outline-secondary fa fa-qrcode" type="button"/>
                </div>
            </t>
        </div>
    </template>

    <template id="question_email" name="Question: Email">
        <input type="email" class="form-control bg-transparent border-0 border-bottom rounded-0"
               t-att-name="question.id" placeholder="example@mail.com" t-att-value="answer_lines[0].value_email if answer_lines else ''"/>
    </template>

    <template id="question_password" name="Question: Password">
        <input type="password" class="form-control bg-transparent border-0 border-bottom rounded-0"
               t-att-name="question.id" t-att-value="answer_lines[0].value_password if answer_lines else ''"/>
    </template>

    <template id="question_url" name="Question: URL">
        <input type="url" class="form-control bg-transparent border-0 border-bottom rounded-0"
               t-att-name="question.id" t-att-value="answer_lines[0].value_url if answer_lines else ''"/>
    </template>

    <template id="question_week" name="Question: Week">
        <input type="week" class="form-control bg-transparent border-0 border-bottom rounded-0"
               t-att-name="question.id" t-att-value="answer_lines[0].value_week if answer_lines else ''"/>
    </template>

    <template id="question_color" name="Question: Color">
        <input type="color" class="form-control form-control-color w-100 border-0"
               t-att-name="question.id" t-att-value="answer_lines[0].value_color if answer_lines else '#000000'"/>
    </template>

    <template id="question_range" name="Question: Range">
        <div class="d-flex align-items-center gap-2">
            <input type="range" class="form-range" t-att-min="question.range_min or 0"
       t-att-max="question.range_max or 100"
                   t-att-name="question.id" t-att-value="answer_lines[0].value_range if answer_lines else question.range_min"
                   oninput="this.nextElementSibling.value = this.value"/>
            <output class="badge bg-primary"><t t-esc="answer_lines[0].value_range if answer_lines else question.range_min"/></output>
        </div>
    </template>

    <template id="question_many2one" name="Question: Many2one">
        <select class="form-select o_select_many2one" t-att-name="question.id" required="1">
            <option value="">Select Option...</option>
            <t t-foreach="question.prepare_model_id(False)" t-as="option">
                <option t-att-value="list(option.values())[0]" t-att-selected="answer_lines and answer_lines[0].value_many2one == str(list(option.values())[0])">
                    <t t-esc="list(option.values())[1]"/>
                </option>
            </t>
        </select>
    </template>

    <template id="question_matrix_hide" name="Question: matrix hide" inherit_id="survey.question_matrix">
        <xpath expr="//table" position="attributes">
            <attribute name="t-att-hidden">None if question.matrix_subtype != 'custom' else 'hidden'</attribute>
        </xpath>
    </template>

    <template id="question_matrix_custom" name="Question: matrix custom">
        <div class="table-responsive">
            <table class="table table-sm table-borderless o_survey_question_matrix" t-att-data-name="question.id">
                <thead>
                    <tr>
                        <th/>
                        <th t-foreach="question.suggested_answer_ids" t-as="col_label" class="text-center fw-normal">
                            <span t-field="col_label.value"/>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="item_idx" t-value="0"/>
                    <tr t-foreach="question.matrix_row_ids" t-as="row_label">
                        <th class="fw-normal text-start"><span t-field="row_label.value"/></th>
                        <t t-foreach="question.suggested_answer_ids" t-as="col_label">
                            <td>
                                <t t-set="cell_name" t-value="'%s-%s' % (item_idx, question.id)"/>
                                <t t-set="cell_val" t-value="answer_lines.get_value_matrix(item_idx) if answer_lines else ''"/>
                                <t t-if="col_label.answer_type == 'char_box'"><input type="text" class="form-control form-control-sm" t-att-name="cell_name" t-att-value="cell_val"/></t>
                                <t t-if="col_label.answer_type == 'numerical_box'"><input type="number" class="form-control form-control-sm" t-att-name="cell_name" t-att-value="cell_val"/></t>
                                <t t-if="col_label.answer_type == 'date'"><input type="date" class="form-control form-control-sm" t-att-name="cell_name" t-att-value="cell_val"/></t>
                                <t t-if="col_label.answer_type == 'datetime'"><input type="datetime-local" class="form-control form-control-sm" t-att-name="cell_name" t-att-value="cell_val"/></t>
                                <t t-if="col_label.answer_type == 'time'"><input type="time" class="form-control form-control-sm" t-att-name="cell_name" t-att-value="cell_val"/></t>
                                <t t-if="col_label.answer_type == 'email'"><input type="email" class="form-control form-control-sm" t-att-name="cell_name" t-att-value="cell_val"/></t>
                                <t t-set="item_idx" t-value="item_idx + 1"/>
                            </td>
                        </t>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="question_file" name="Question: File">
        <input type="file" class="form-control" t-att-name="question.id" t-att-data-question-type="question.question_type"/>
    </template>

    <template id="question_many2many" name="Question: Many2many">
        <select class="form-select o_select_many2many" t-att-name="question.id" multiple="multiple">
            <t t-foreach="question.prepare_model_id(False)" t-as="option">
                <option t-att-value="list(option.values())[0]"><t t-esc="list(option.values())[1]"/></option>
            </t>
        </select>
    </template>

    <template id="question_selection_choice" name="Question: Selection">
        <select class="form-select" t-att-name="question.id">
            <option value="">Choose...</option>
            <t t-foreach="question.suggested_answer_ids" t-as="label">
                <option t-att-value="label.id"><t t-esc="label.value"/></option>
            </t>
        </select>
    </template>

    <template id="question_barcode" name="Question: Barcode">
        <div class="input-group">
            <input type="text" class="form-control" t-att-name="question.id" placeholder="Scan barcode..."/>
            <span class="input-group-text"><i class="fa fa-barcode"/></span>
        </div>
    </template>

</odoo>