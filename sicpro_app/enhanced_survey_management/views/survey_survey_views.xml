<odoo>
    <record id="survey_survey_view_form" model="ir.ui.view">
        <field name="name">survey.survey.view.form.inherit.enhanced.survey.management</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='access_mode']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>

            <xpath expr="//page[@name='options']//group[@name='participants']" position="inside">
                <field name="visibility" string="Visible en Portal Público" help="Si se marca, la encuesta aparecerá en la lista pública del sitio web."/>
            </xpath>

            <xpath expr="//button[@name='action_result_survey']" position="after">
                <button name="action_answer_report_download"
                        string="Descargar XLSX"
                        type="object"
                        class="btn-secondary"
                        icon="fa-file-excel-o"
                        title="Generar reporte de respuestas en formato Excel"
                        invisible="not id"/>
            </xpath>

        </field>
    </record>
</odoo>