<odoo>
    <record id="survey_user_input_line_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.line.view.form.inherit.enhanced.survey.management</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_char_box']" position="after">
                <field name="filename" invisible="1"/>


                <field name="value_many2one_option" string="Respuesta (Many2one)"
                       invisible="answer_type != 'many2one'"/>

                <field name="value_name" string="Nombre Completo"
                       invisible="answer_type != 'name'"/>

                <field name="value_selection" string="Selección SICPRO"
                       invisible="answer_type != 'selection'"/>

                <field name="value_time" invisible="answer_type != 'time'"/>
                <field name="value_month" invisible="answer_type != 'month'"/>
                <field name="value_color" widget="color" invisible="answer_type != 'color'"/>
                <field name="value_range" invisible="answer_type != 'range'"/>

                <field name="value_many2one" invisible="answer_type != 'many2one'"/>
            </xpath>


        </field>
    </record>
</odoo>