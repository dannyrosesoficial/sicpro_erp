<odoo>

  <record id="clientes_filter_view" model="ir.ui.view">
    <field name="name">Buscar Clientes</field>
    <field name="model">sicpro.app.clientes</field>
    <field name="arch" type="xml">
      <search string="Buscar Clientes">
        <field name="name"/>
        <field name="cargo"/>
        <field name="territorio"/>
        <field name="provincias_id"/>
        <field name="etiquetas"/>
        <filter string="Persona" name="es_entidad" domain="[('es_entidad', '=',False)]"/>
        <filter string="Entidad" name="es_entidad" domain="[('es_entidad', '=',True)]"/>
        <separator/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        <group>
          <filter string="Unidad Organizativa" name="territorio" domain="[]" context="{'group_by':'territorio'}"/>
          <filter string="Provincia" name="provincia_id" domain="[]" context="{'group_by':'provincias_id'}"/>
        </group>
        <searchpanel>
          <field name="territorio" enable_counters="1" expand="1" icon="fa-building"/>
          <field name="provincias_id" enable_counters="1" expand="1" icon="fa-users"/>
        </searchpanel>
      </search>
    </field>
  </record>

  <record id="clientes_view_list" model="ir.ui.view">
    <field name="name">clientes.view.list</field>
    <field name="model">sicpro.app.clientes</field>
    <field name="arch" type="xml">
      <list string="">
        <field name="tipo_registro"/>
        <field name="name"/>
        <field name="cargo"/>
        <field name="telefono_movil"/>
        <field name="correo"/>
        <field name="territorio"/>
        <field name="provincias_id"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="clientes_view_form" model="ir.ui.view">
    <field name="name">clientes.view.form</field>
    <field name="model">sicpro.app.clientes</field>
    <field name="arch" type="xml">
      <form string="name">
        <sheet>
          <div class="oe_button_box" name="button_box"/>
          <widget name="web_ribbon" text="Archivado" bg_color="bg-danger"
                  invisible="active"/>
          <field name="image_1920" widget="image" class="oe_avatar"
                 options="{&quot;preview_image&quot;: &quot;image_128&quot;}"/>

          <div class="oe_title">
            <field name="es_entidad" invisible="1"/>
            <field name="active" invisible="1"/>
            <field name="tipo_registro" widget="radio" class="oe_edit_only" options="{'horizontal': true}"/>
            <h1>
              <field name="name" default_focus="1" placeholder="Nombre"/>
            </h1>
            <div class="o_row">
              <field name="entidad" placeholder="Entidad"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                     domain="[('es_entidad', '=', True)]"
                     context="{'default_es_entidad': True, 'show_vat': True}"
                     invisible="es_entidad"/>
            </div>
          </div>

          <group name="group_top">
            <group name="group_left">
              <field name="jefe_entidad" invisible="not es_entidad"/>
              <field name="territorio" placeholder="Unidad Organizativa"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="provincias_id" placeholder="Provincia"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="pagina_web" string="Sitio Web" widget="url"
                     placeholder="Ej. https://www.etecsa.cu"/>
            </group>

            <group name="group_right">
              <field name="cargo" string="Cargo Laboral" placeholder="Ej. Director Territorial"
                     invisible="es_entidad"/>
              <field name="nivel_escolar"/>
              <field name="telefono_fijo" widget="phone"/>
              <field name="telefono_movil" widget="phone"/>
              <field name="correo" widget="email"/>
              <field name="etiquetas" widget="many2many_tags"
                     options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Etiquetas"/>
            </group>
          </group>

          <notebook colspan="4">
            <page string="Entidades &amp; Contactos" autofocus="autofocus" invisible="not es_entidad">
              <field name="hijos_ids" mode="kanban" widget="many2many"
                     context="{'default_entidad': id, 'default_cargo': cargo,
                   'default_telefono_movil': telefono_movil, 'default_correo': correo,
                   'default_territorio': territorio,
                   'default_provincias_id': provincias_id,
                   'default_es_entidad': False, 'default_tipo_registro':'persona'}">
                <kanban sample="1">
                  <field name="id"/>
                  <field name="name"/>
                  <field name="cargo"/>
                  <field name="telefono_movil"/>
                  <field name="correo"/>
                  <field name="territorio"/>
                  <field name="provincias_id"/>
                  <field name="entidad"/>
                  <field name="etiquetas"/>
                  <field name="image_128"/>
                  <templates>
                    <t t-name="card">
                      <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                        <div class="d-flex align-items-start">

                          <div class="o_kanban_image_fill_left d-flex align-items-center justify-content-center"
                               style="flex-shrink: 0; background: #f0f0f0; width: 95px; height: 105px;">
                            <img
                                t-att-src="record.image_128.raw_value ? '/web/image/sicpro.app.clientes/' + record.id.raw_value + '/image_128' : '/base/static/img/avatar_grey.png'"
                                alt="Contacto"
                                class="img-fluid rounded"
                                style="width: 100%; height: 100%; object-fit: cover;"/>
                          </div>

                          <div class="oe_kanban_details d-flex flex-column ms-3">
                            <strong class="o_kanban_record_title oe_partner_heading">
                              <field name="name"/>
                            </strong>

                            <div class="o_kanban_tags_section oe_kanban_partner_categories mt-1">
                              <field name="etiquetas" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            </div>

                            <ul class="list-unstyled mt-1 small">
                              <li t-if="record.cargo.raw_value" class="fw-bold text-primary">
                                <field name="cargo"/>
                              </li>

                              <li t-if="record.territorio.raw_value or record.provincias_id.raw_value">
                                <i class="fa fa-map-marker text-muted me-1" title="Ubicación"/>
                                <field name="territorio"/><t t-if="record.provincias_id.raw_value">, </t>
                                <field name="provincias_id"/>
                              </li>

                              <li t-if="record.correo.raw_value" class="o_text_overflow">
                                <i class="fa fa-envelope text-muted me-1" title="Correo electrónico"/>
                                <field name="correo" widget="email"/>
                              </li>
                              <li t-if="record.telefono_movil.raw_value">
                                <i class="fa fa-phone text-muted me-1" title="Teléfono móvil"/>
                                <field name="telefono_movil"/>
                              </li>
                            </ul>
                          </div>

                        </div>
                      </div>
                    </t>
                  </templates>
                </kanban>
              </field>
            </page>
            <page name="user_settings" string="Configuración de Usuario" invisible="es_entidad">
              <group>
                <group string='Estado' name="active_group">
                  <field name="user_id" string="Usuario SICPRO ERP" readonly="1"/>
                  <field name="firma_acuerdo_servicio"/>
                </group>
                <group string="Servicio" name="identification_group">
                  <field name="pin" readonly="1"/>
                  <field name="id_user_cliente" invisible="1"/>
                </group>
              </group>
            </page>
            <page name="observaciones" string="Detalles Generales del Cliente">
              <field name="observaciones" placeholder="Notas sobre el cliente..."/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="clientes_view_kanban" model="ir.ui.view">
    <field name="name">clientes.view.kanban</field>
    <field name="model">sicpro.app.clientes</field>
    <field name="arch" type="xml">
      <kanban sample="1">
        <field name="id"/>
        <field name="name"/>
        <field name="cargo"/>
        <field name="telefono_movil"/>
        <field name="correo"/>
        <field name="territorio"/>
        <field name="provincias_id"/>
        <field name="etiquetas"/>
        <field name="active" invisible="1"/>
        <field name="entidad" invisible="1"/>
        <field name="es_entidad" invisible="1"/>
        <field name="image_128"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
              <div class="d-flex align-items-start">

                <t t-if="!record.es_entidad.raw_value">
                  <t t-set="placeholder" t-value="'/base/static/img/avatar_grey.png'"/>
                  <t t-set="entidad_placeholder" t-value="'/sicpro_app_clientes/static/src/img/etecsaCi_300_8.png'"/>

                  <div class="o_kanban_image_fill_left d-none d-md-block" style="flex-shrink: 0;">
                    <img alt="Persona"
                         t-att-src="record.image_128.raw_value ? '/web/image/sicpro.app.clientes/' + record.id.raw_value + '/image_128' : placeholder"
                         class="img-fluid rounded"
                         style="width:100px; height:110px; object-fit: cover;"/>
                  </div>

                  <div class="o_kanban_image d-md-none me-3" style="flex-shrink: 0;">
                    <img alt="Logo Entidad"
                         t-att-src="record.entidad.raw_value ? '/web/image/sicpro.app.clientes/' + record.entidad.raw_value + '/image_128' : entidad_placeholder"
                         class="img-fluid rounded-circle"
                         style="width: 60px; height: 60px; object-fit: contain; background: #fff; border: 1px solid #dee2e6;"/>
                  </div>
                </t>

                <t t-else="">
                  <t t-set="entidad_placeholder" t-value="'/sicpro_app_clientes/static/src/img/etecsaCi_300_8.png'"/>
                  <div class="o_kanban_image_fill_left o_kanban_image_full" style="flex-shrink: 0;">
                    <img alt="Entidad"
                         t-att-src="record.image_128.raw_value ? '/web/image/sicpro.app.clientes/' + record.id.raw_value + '/image_128' : entidad_placeholder"
                         class="img-fluid rounded"
                         style="width:100px; height:110px; object-fit: contain; background: #f8f9fa;"/>
                  </div>
                </t>

                <div class="oe_kanban_details d-flex flex-column ms-3">
                  <strong class="o_kanban_record_title oe_partner_heading">
                    <field name="name"/>
                  </strong>

                  <div class="o_kanban_tags_section oe_kanban_partner_categories mt-1">
                    <field name="etiquetas" widget="many2many_tags" options="{'color_field': 'color'}"/>
                  </div>

                  <ul class="list-unstyled mt-2">
                    <li t-if="record.cargo.raw_value" class="fw-bold text-primary small">
                      <field name="cargo"/>
                    </li>
                    <li t-if="!record.es_entidad.raw_value and record.entidad.raw_value" class="text-muted small">
                      <i class="fa fa-building-o me-1" title="Entidad"/> <field name="entidad"/>
                    </li>
                    <li t-if="record.territorio.raw_value or record.provincias_id.raw_value" class="small">
                      <i class="fa fa-map-marker me-1" title="Localidad"/>
                      <field name="territorio"/><t t-if="record.provincias_id.raw_value">, </t>
                      <field name="provincias_id"/>
                    </li>
                    <li t-if="record.correo.raw_value" class="o_text_overflow small">
                      <i class="fa fa-envelope me-1" title="Correo electrónico"/>
                      <field name="correo" widget="email"/>
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_clientes" model="ir.actions.act_window">
    <field name="name">Clientes</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.clientes</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea un cliente en tu libreta de direcciones
      </p>
      <p>
        SICPRO ERP lo ayuda a rastrear fácilmente todas las actividades relacionadas con un cliente.
      </p>
    </field>
  </record>

</odoo>
