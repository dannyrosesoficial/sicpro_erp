<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="inversionista_user_tree" model="ir.ui.view">
    <field name="name">res.users.inversionista.tree</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_tree" />
    <field name="arch" type="xml">
      <field name="company_id" position="after">
          <field name="user_inversionista" />
          <field name="inversionista_cargo" optional="hide"/>
          <field name="inversionista_territorio" optional="hide"/>
      </field>
    </field>
  </record>

    <record id="inversionista_user_search_inherit" model="ir.ui.view">
        <field name="name">res.users.inversionista.search.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search" />
        <field name="arch" type="xml">
            <filter name='Inactive' position="after">
                <separator/>
                <filter string="Inversionistas" name="user_inversionista" domain="[('user_inversionista', '=',True)]"/>
                <separator/>
            </filter>
            <filter name='company_id' position="after">
                <separator/>
                <filter name="territorio" string="Territorio" context="{'group_by': 'inversionista_territorio'}"/>
                <separator/>
            </filter>
        </field>
    </record>


  <record id="inversionistas_user_form" model="ir.ui.view">
    <field name="name">res.users.departamento.form</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form" />
    <field name="arch" type="xml">
        <field name="companies_count" position="after">
            <field name="user_inversionista" readonly="0"/>
        </field>
        <xpath expr="//notebook/page[3]" position="after">
            <page name="page_inversionista" string="Información del Inversionista"
                  attrs="{'invisible': [('user_inversionista', '!=', True)]}">
                <group>
                    <div class="text-danger">
                        <strong>ATENCIÓN: </strong>Antes de configurar esta pestaña debe guardar el registro del
                        usuario, esta acción creara él, id del registro del usuario y evitara errores al procesar las
                        funcionalidades seleccionadas.
                    </div>
                </group>
                <group string="Inversionista">
                 <group>
                         <field name="nombre_inversionista"/>
                     <field name="nombre_inversionista_2" invisible="1"/>
                       <field name="inversionista_cargo"/>
                     <field name="inversionista_nivel_escolar" string="Nivel Escolar"/>
                     </group>
                 <group>
                     <field name="inversionista_territorio"/>
                     <field name="inversionista_provincia"/>
                 </group>
             </group>
           <group>
             <group>
               <field name="inversionista_etiquetas" widget="many2many_tags"
                      options="{'color_field': 'color', 'no_create_edit': True}"/>
             </group>
             <group>
               <field name="inversionista_telefono_fijo"/>
               <field name="inversionista_telefono_movil"/>
             </group>
           </group>
         </page>
      </xpath>
    </field>
  </record>


<!--        Inserta un atributo en la página del trabajador-->
      <record id="trabajadores_inversionistas_user_form" model="ir.ui.view">
    <field name="name">res.users.trabajadores.inversionistas.form</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="sicpro_app_trabajadores.departamento_user_form" />
    <field name="arch" type="xml">
        <xpath expr="//notebook/page[@name='page_trabajador']" position="attributes">
            <attribute name="attrs">{'invisible': [('user_inversionista', '=', True)]}</attribute>
        </xpath>
    </field>
  </record>



</odoo>
