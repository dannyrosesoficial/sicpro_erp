<?xml version="1.0" encoding="utf-8"?>
<odoo>
     <data>
          <!-- Creo la categoría de permisos Proyectos -->
           <record id="module_category_clientes" model="ir.module.category">
            <field name="name">Clientes</field>
             <field name="description">Módulo para la gestión de los clientes del proceso.</field>
            <field name="sequence" >11</field>
        </record>

        <record id="grupo_app_clientes_usuario" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_clientes"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

         <record id="grupo_app_clientes_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_clientes"/>
             <field name="implied_ids" eval="[(4, ref('grupo_app_clientes_usuario'))]"/>
        </record>

         <record id="grupo_app_clientes_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="module_category_clientes"/>
             <field name="implied_ids" eval="[(4, ref('grupo_app_clientes_ejecutor'))]"/>
        </record>

        <record id="grupo_app_clientes_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="module_category_clientes"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_clientes_responsable'))]"/>
        </record>

     </data>


</odoo>