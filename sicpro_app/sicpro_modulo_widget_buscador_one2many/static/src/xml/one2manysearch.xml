<templates xml:space="preserve">
    <t t-name="sicpro_modulo_widget_buscador_one2many.One2ManySearch">
        <div class="o_one2many_search_container mb-2">
            <t t-if="props.type === 'one2many' or props.widget === 'one2many_search'">
                <div class="d-flex align-items-center">
                    <input type="text"
                           class="oe_search_value searchInput ps-3"
                           t-att-placeholder="props.placeholder or 'Buscar...'"
                           t-on-input="_onSearchInput"
                           t-ref="searchField"/>

                  <i class="fa fa-search position-absolute ms-2 text-muted"
                     style="pointer-events: none;"/>
                </div>
            </t>
        </div>
    </t>
</templates>