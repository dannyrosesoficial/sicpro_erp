<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inicio de las Vistas del modal para el rechazo de la solicitud-->
    <record id="solicitudes_acceso_rechazada_form" model="ir.ui.view">
            <field name="name">sicpro.modulo.plantilla.acceso.rechazar.form</field>
            <field name="model">sicpro.modulo.plantilla.acceso.rechazar</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <form string="Motivo de Rechazo">
                    <group class="oe_title">
                        <field name="motivo_rechazo"/>
                    </group>
                    <footer>
                        <button name="action_motivo_rechazo" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
    </record>

    <record id="solicitudes_acceso_rechazada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Rechazo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.modulo.plantilla.acceso.rechazar</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="solicitudes_acceso_rechazada_form"/>
            <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para el rechazo de la solicitud-->

    <record id="view_solicitud_roles_filter" model="ir.ui.view">
        <field name="name">sicpro.modulo.plantilla.acceso.filter</field>
        <field name="model">sicpro.modulo.plantilla.acceso</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="numero_consecutivo"/>
                <field name="name"/>
                <field name="solicitado_por_fecha" string="Fecha"/>
                <field name="codigo_sap"/>
                <field name="area"/>
                <separator/>
                <filter string="Pendientes" name="estado_pendiente" domain="[('estado', '=', 'pendiente')]"/>
                <filter string="Ejecutadas" name="estado_ejecutada" domain="[('estado', '=', 'ejecutado')]"/>
                <separator/>
                <filter string="Rechazadas" name="estado_rechazada" domain="[('estado', '=', 'rechazado')]"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" name="group_by" string="Group By">
                    <filter name="solicitado_por_fecha" string="Fecha de Solicitud"
                            context="{'group_by': 'solicitado_por_fecha'}"/>
                    <filter name="name" string="Usuario" context="{'group_by': 'name'}"/>
                    <filter name="codigo_sap" string="# Plaza" context="{'group_by': 'codigo_sap'}"/>
                    <filter name="tipo_movimiento" string="Tipo Solicitud" context="{'group_by': 'tipo_movimiento'}"/>
                    <filter name="area" string="Área" context="{'group_by': 'area'}"/>
                    <filter name="estado" string="Estado" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_solicitud_roles_form" model="ir.ui.view">
        <field name="name">sicpro.modulo.plantilla.acceso.form</field>
        <field name="model">sicpro.modulo.plantilla.acceso</field>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <form string="Solicitudes de Roles" create="false">
                <header>
                    <button name="%(sicpro_app_clientes.action_clientes)d" string="Crear Inversionista" type="action"
                            attrs="{'invisible': ['|', ('tipo_movimiento', '!=', 'alta'), ('estado', '!=', 'pendiente')]}"/>
                    <button name="%(base.action_res_users)d" string="Crear Usuario" type="action"
                            attrs="{'invisible': ['|', ('tipo_movimiento', '!=', 'alta'), ('estado', '!=', 'pendiente')]}"/>
                    <button name="buscar_usuario_inversionista" string="Buscar Usuario" type="object" class="oe_highlight"
                            attrs="{'invisible': [('estado', '!=', 'pendiente')]}"/>
                    <button name="actualizar_usuario_roles_aprobar" string="Aprobar" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', ('estado', '!=', 'pendiente'), ('existe_usuario', '!=', True)]}"/>
                    <button name="%(solicitudes_acceso_rechazada_action)d" string="Rechazar" type="action"
                            attrs="{'invisible': [('estado', '!=', 'pendiente')]}"/>
                    <button name="correo_actualiza_roles" string="Enviar Correo de Actualización de Roles" type="object"
                            attrs="{'invisible': ['|', ('estado', '!=', 'ejecutado'), ('correo_actualizacion_roles', '=', True)]}"/>
                    <field name="estado" widget="statusbar" options="{'clickable': '0'}" readonly="0"/>
                </header>
                <div class="alert alert-info text-center" colspan="4" role="alert"
                     attrs="{'invisible': ['|', ('tipo_usuario', '!=', 'externo'), ('existe_inversionista', '=', False)]}"
                     style="margin-bottom: 0px !important;">
                    <strong>El registro de inversionistas existe en el sistema, es posible actualizar los
                        roles.</strong>
                </div>
                <div class="alert alert-warning text-center" colspan="4" role="alert"
                     attrs="{'invisible': ['|', ('tipo_usuario', '!=', 'externo'), ('existe_inversionista', '=', True)]}"
                     style="margin-bottom: 0px !important;">
                    <strong>El registro de inversionistas para este usuario no existe en el sistema, no es posible
                        actualizar los roles.</strong>
                </div>

                <div class="alert alert-info text-center" colspan="4" role="alert"
                     attrs="{'invisible': ['|', ('existe_usuario', '!=', True), ('estado', '=', 'ejecutado')]}"
                     style="margin-bottom: 0px !important;">
                    <strong>El usuario existe en el sistema, es posible actualizar los roles.</strong>
                </div>
                <div class="alert alert-danger text-center" colspan="4" role="alert"
                     attrs="{'invisible': [('existe_usuario', '=', True)]}" style="margin-bottom: 0px !important;">
                    <strong>El usuario no existe en el sistema, no es posible actualizar los roles.</strong>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title mb24">
                        <field name="active" invisible="1"/>
                        <field name="tipo_usuario" invisible="1"/>
                        <field name="existe_inversionista" invisible="1"/>
                        <field name="rechazado" invisible="1"/>
                        <field name="existe_usuario" invisible="1"/>
                        <field name="correo_actualizacion_roles" invisible="1"/>
                        <h1>
                            <field class="o_text_overflow" name="name" default_focus="1" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="numero_consecutivo" readonly="1"/>
                        </h2>
                    </div>

                    <group>
                        <group>
                            <field name="carne_identidad" readonly="1"/>
                            <field name="tipo_usuario" readonly="1"/>
                            <label for="codigo_sap" readonly="True"/>
                             <div style="width:160px;">
                                <field name="codigo_sap" attrs="{'readonly': [('estado', '=', 'ejecutado')]}"
                                       widget="CopyClipboardChar"/>
                            </div>
                            <field name="nivel_escolar" readonly="1"/>
                        </group>
                        <group>
                            <field name="uo" readonly="1"/>
                            <field name="area" readonly="1"/>
                            <field name="cargo" readonly="1"/>
                            <field name="telefonos" readonly="1"/>
                            <field name="email" readonly="1"/>
                        </group>
                    </group>

                    <group>
                        <field name="tipo_movimiento" widget="radio" options="{'horizontal': true}" readonly="0"/>
                    </group>
                    <group>
                        <group string="Fundamentar el motivo de la solicitud">
                            <field name="fundamentacion_especificaciones" nolabel="1" readonly="1"/>
                        </group>
                        <group string="Fundamentar la solicitud de permisos especiales">
                            <field name="fundamentacion_especiales" nolabel="1" readonly="1"/>
                        </group>
                    </group>
                    <group string="Motivo del rechazo" attrs="{'invisible': [('rechazado', '!=', True)]}">
                        <field name="rechazado_motivo" nolabel="1"/>
                    </group>
                    <notebook colspan="4">
                        <page string="Autorización">
                            <group>
                                <field name="fecha_recibido"/>
                            </group>
                            <group>
                                <group string="Solicitado">
                                    <field name="solicitado_por_nombre_apellidos" string="Nombre y Apellidos" readonly="1"/>
                                    <field name="solicitado_por_cargo" string="Cargo" readonly="1"/>
                                    <field name="solicitado_por_unidad_organizativa" string="Unidad Organizativa" readonly="1"/>
                                    <field name="solicitado_por_fecha" string="Fecha"/>
                                    <field name="solicitado_por_telefono" string="Teléfono" readonly="1"/>
                                </group>
                                <group string="Autorizado">
                                    <field name="autorizado_por_nombre_apellidos" string="Nombre y Apellidos" readonly="1"/>
                                    <field name="autorizado_por_cargo" string="Cargo" readonly="1"/>
                                    <field name="autorizado_por_unidad_organizativa" string="Unidad Organizativa" readonly="1"/>
                                    <field name="autorizado_por_fecha" string="Fecha"/>
                                    <field name="autorizado_por_telefono" string="Teléfono" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Roles de Accesos" attrs="{'invisible': [('tipo_movimiento', '=', 'baja')]}">
                            <group>
                                <group string="Configuración de fechas para los Roles">
                                    <div>
                                        <field name="fecha_inicio" class="oe_inline" attrs="{'readonly': [('estado', '=', 'ejecutado')]}"/> -
                                        <field name="fecha_fin" class="oe_inline" attrs="{'readonly': [('estado', '=', 'ejecutado')]}"/>
                                    </div>
                                </group>
                                <group string="Actualizar datos de los Roles">
                                    <button name="actualizar_fecha_roles" string="Actualizar Fechas y Usuario"
                                            type="object" class="oe_highlight"
                                            attrs="{'invisible': ['|','|', ('fecha_inicio', '=', False),
                                            ('fecha_fin', '=', False),('estado', '=', 'ejecutado')]}"/>
                                </group>
                            </group>
                            <field name="role_ids" invisible="1"/>
                            <field name="role_line_ids" nolabel="1" attrs="{'readonly': [('estado', '=', 'ejecutado')]}">
                                <tree editable="bottom" decoration-muted="not aprobado">
                                    <field name="role_id" domain="[('id', 'not in', parent.role_ids)]"
                                           attrs="{'readonly': [('aprobado', '=', True)]}"/>
                                    <field name="desde" attrs="{'readonly': [('aprobado', '=', True)]}"/>
                                    <field name="hasta" attrs="{'readonly': [('aprobado', '=', True)]}"/>
                                    <field name="aprobado" invisible="1"/>
                                    <field name="user_id" invisible="1"/>
                                    <button name="aprobar_rol" string="Aprobar ROL" type="object" class="oe_highlight"
                                            attrs="{'invisible': ['|','|', ('aprobado', '!=', False), ('desde', '=', False), ('hasta', '=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
            </form>
        </field>
    </record>

    <record id="view_solicitud_roles_tree" model="ir.ui.view">
        <field name="name">sicpro.modulo.plantilla.acceso.tree</field>
        <field name="model">sicpro.modulo.plantilla.acceso</field>
        <field name="arch" type="xml">
            <tree string="Solicitudes de Roles" create="false" sample="1">
                <field name="numero_consecutivo"/>
                <field name="tipo_movimiento"/>
                <field name="solicitado_por_fecha" string="Fecha"/>
                <field name="name"/>
                <field name="codigo_sap"/>
                <field name="area"/>
                <field name="cargo"/>
                <field name="telefonos"/>
                <field name="estado" readonly="1" decoration-info="estado=='pendiente'"
                       decoration-danger="estado=='rechazado'" decoration-success="estado=='ejecutada'" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_solicitud_roles" model="ir.actions.act_window">
        <field name="name">Solicitudes de Accesos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.modulo.plantilla.acceso</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_solicitud_roles_filter"/>
        <field name="context">{'search_default_estado_pendiente': 1}</field>
    </record>

</odoo>
