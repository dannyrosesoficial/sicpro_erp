<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="app_soporte_category">
      <field name="name">Soporte Técnico</field>
      <field name="description">Sistema de soporte a la aplicación.</field>
      <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_administracion_general"/>
      <field name="sequence">20</field>
    </record>

    <record id="group_soporte_ejecutor" model="res.groups">
        <field name="name">Ejecutor</field>
        <field name="category_id" ref="app_soporte_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_soporte_responsable" model="res.groups">
        <field name="name">Responsable</field>
        <field name="category_id" ref="app_soporte_category"/>
        <field name="implied_ids" eval="[(4, ref('group_soporte_ejecutor'))]"/>
    </record>

    <record id="group_soporte_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="app_soporte_category"/>
        <field name="implied_ids" eval="[(4, ref('group_soporte_responsable'))]"/>
    </record>


<data>
    <record id="group_soporte_todos" model="res.groups">
        <field name="name">Visualizar Todos los Tickets de Soporte</field>
        <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_accesos_variados"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

</data>

<data noupdate="0">
    <record id="helpesk_ticket_usuario_rule" model="ir.rule">
        <field name="name">Tickets Usuario</field>
        <field ref="model_sicpro_app_soporte" name="model_id"/>
        <field name="domain_force">[('partner_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="helpesk_ticket_personal_rule" model="ir.rule">
        <field name="name">Tickets Personal</field>
        <field ref="model_sicpro_app_soporte" name="model_id"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('group_soporte_ejecutor'))]"/>
    </record>

    <record id="helpdesk_ticket_responsable_rule" model="ir.rule">
        <field name="name">Todos los Tickets Responsable</field>
        <field ref="model_sicpro_app_soporte" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_soporte_responsable'))]"/>
    </record>

    <record id="helpdesk_ticket_admin_rule" model="ir.rule">
        <field name="name">Todos los Tickets Admin</field>
        <field ref="model_sicpro_app_soporte" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_soporte_admin'))]"/>
    </record>
</data>
</odoo>
