<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_soporte_categoria_search" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.categoria.search</field>
        <field name="model">sicpro.app.soporte.categoria</field>
        <field name="arch" type="xml">
            <search string="Buscar Categoría">
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="view_soporte_categoria_form" model="ir.ui.view">
        <field name="name">view.helpdesk_category.form</field>
        <field name="model">sicpro.app.soporte.categoria</field>
        <field name="arch" type="xml">
            <form string="Categorías">
                <header>
                </header>
                <sheet>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" required="1"/></h1>
                    </div>
                    <group name="main">
                        <field name="active" invisible="1"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soporte_categoria_tree" model="ir.ui.view">
        <field name="name">view.helpdesk_category.tree</field>
        <field name="model">sicpro.app.soporte.categoria</field>
        <field name="arch" type="xml">
            <tree string="Categoría">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="soporte_categoria_action" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">sicpro.app.soporte.categoria</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear una nueva categoría
            </p>
        </field>
    </record>


</odoo>
