<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_soporte_versiones_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.versiones.search</field>
    <field name="model">sicpro.app.soporte.versiones</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <field name="name" filter_domain="[('name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="view_soporte_versiones_form" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.versiones.form</field>
    <field name="model">sicpro.app.soporte.versiones</field>
    <field name="arch" type="xml">
      <form string="Versiones">
        <header>
          <field name="stage_id" widget="statusbar" clickable="false" />
        </header>
        <sheet>
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1>
              <field name="name" required="1"/>
            </h1>
          </div>
          <group name="main">
              <field name="active" invisible="1"/>
          </group>
               <group string="Paquetes Linux">
                    <field name="paquetes_ids" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="descripcion"/>
                            <field name="aplicaciones"/>
                        </tree>
                    </field>
                </group>
                <group string="Aplicaciones">
                    <field name="aplicaciones_ids" nolabel="1">
                        <tree>
                            <field name="image_128" widget='image' string='Logo' class="oe_text_center oe_centeralign" height="30"  options='{"zoom": true, "preview_image":"image_128"}'/>
                            <field name="name"/>
                            <field name="tipo"/>
                            <field name="descripcion"/>
                        </tree>
                    </field>
                </group>
            <group string="Ticket de Soporte">
                    <field name="tickets_ids" nolabel="1">
                        <tree>
                            <field name="name"/>
                            <field name="aplicaciones"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                            <field name="stage_id"/>
                        </tree>
                    </field>
                </group>
        </sheet>
          <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
      </form>
    </field>
  </record>

  <record id="view_soporte_versiones_tree" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.versiones.tree</field>
    <field name="model">sicpro.app.soporte.versiones</field>
    <field name="arch" type="xml">
      <tree string="Versiones">
        <field name="name"/>
      </tree>
    </field>
  </record>

  <record id="view_soporte_versiones_kanban" model="ir.ui.view">
      <field name="name">sicpro.app.soporte.versiones.kanban</field>
      <field name="model">sicpro.app.soporte.versiones</field>
      <field name="arch" type="xml">
          <kanban class="o_kanban_mobile" archivable="false"  default_group_by="stage_id" >
              <field name="name"/>
              <field name="stage_id"/>
              <field name="cuenta_paquetes"/>
              <field name="cuenta_aplicaciones"/>
              <field name="cuenta_actividades"/>
              <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>
              <templates>
                  <t t-name="kanban-box">
                    <div t-attf-class="oe_kanban_content oe_kanban_global_click">

                          <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                              <strong class="o_kanban_record_title" style="font-weight: bold">
                                <field name="name"/></strong>
                            </div>
                          </div>

                        <div class="col-12 o_kanban_primary_right">
                             <div class="row">
                                 <div class="col-9 text-danger">Pack Linux</div>
                                 <div class="col-3"><strong><t t-esc="record.cuenta_paquetes.value"/></strong></div>
                                 <div class="col-9 text-danger">Aplicaciones</div>
                                 <div class="col-3"><strong><t t-esc="record.cuenta_aplicaciones.value"/></strong></div>
                                 <div class="col-9 text-danger">Actividades</div>
                                 <div class="col-3"><strong><t t-esc="record.cuenta_actividades.value"/></strong></div>
                             </div>
                         </div>


                      <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left"/>
                            <div class="oe_kanban_bottom_right">
                              <field name="activity_ids" widget="kanban_activity" related="activity_state"/>
                              <field name="activity_state" invisible="1"/>
                            </div>
                      </div>
                      </div>
                  </t>
              </templates>
          </kanban>
      </field>
  </record>

    <record id="view_soporte_versiones_activity" model="ir.ui.view">
            <field name="name">sicpro.app.soporte.versiones.activity</field>
            <field name="model">sicpro.app.soporte.versiones</field>
            <field name="arch" type="xml">
                <activity string="Registro de Versiones">
                    <field name="name"/>
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <field name="name" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

  <record id="soporte_versiones_action" model="ir.actions.act_window">
        <field name="name">Registro de Versiones</field>
        <field name="res_model">sicpro.app.soporte.versiones</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear una nueva Versión
            </p>
        </field>
    </record>



</odoo>
