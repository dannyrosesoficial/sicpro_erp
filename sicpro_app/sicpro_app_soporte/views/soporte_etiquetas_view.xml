<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_soporte_etiquetas_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.etiquetas.search</field>
    <field name="model">sicpro.app.soporte.etiquetas</field>
    <field name="arch" type="xml">
      <search string="Buscar Etiquetas">
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <field name="name" filter_domain="[('name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="view_soporte_etiquetas_form" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.etiquetas.form</field>
    <field name="model">sicpro.app.soporte.etiquetas</field>
    <field name="arch" type="xml">
      <form string="Etiquetas">
        <header>
                </header>
        <sheet>
         
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1>
              <field name="name" required="1"/>
            </h1>
          </div>
          <group name="main">
              <field name="active" invisible="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_soporte_etiquetas_tree" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.etiquetas.tree</field>
    <field name="model">sicpro.app.soporte.etiquetas</field>
    <field name="arch" type="xml">
      <tree string="Etiquetas">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </tree>
    </field>
  </record>

  <record id="soporte_etiquetas_action" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">sicpro.app.soporte.etiquetas</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear una nueva etiqueta
            </p>
        </field>
    </record>



</odoo>
