<odoo>
  <record id="view_soporte_ticket_canales_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.canales.search</field>
    <field name="model">sicpro.app.soporte.canales</field>
    <field name="arch" type="xml">
      <search string="Buscar canal">
        <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <field name="name" filter_domain="[('name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="view_soporte_canales_list" model="ir.ui.view">
    <field name="name">view.helpdesk_channel.list</field>
    <field name="model">sicpro.app.soporte.canales</field>
    <field name="arch" type="xml">
      <list string="Canales" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="code"/>
        <field name="color" widget="color_picker"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="soporte_canales_action" model="ir.actions.act_window">
    <field name="name">Canales de Solicitud</field>
    <field name="res_model">sicpro.app.soporte.canales</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear un nuevo Canal de Solicitud
      </p>
    </field>
  </record>
</odoo>
