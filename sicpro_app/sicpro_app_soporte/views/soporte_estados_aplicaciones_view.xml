<odoo>
  <record id="view_soporte_ticket_stage_aplicaciones_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.estados.aplicaciones.search</field>
    <field name="model">sicpro.app.soporte.estados.aplicaciones</field>
    <field name="arch" type="xml">
      <search string="Buscar Estados">
        <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <field name="name" filter_domain="[('name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="view_soporte_estados_aplicaciones_list" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.estados.aplicaciones.list</field>
    <field name="model">sicpro.app.soporte.estados.aplicaciones</field>
    <field name="arch" type="xml">
      <list string="Estados" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="inicial"/>
        <field name="desarrollo"/>
        <field name="closed"/>
        <field name="detenido"/>
        <field name="descontinuado"/>
        <field name="fold"/>
      </list>
    </field>
  </record>

  <record id="soporte_estados_aplicaciones_action" model="ir.actions.act_window">
    <field name="name">Estados de las Aplicaciones</field>
    <field name="res_model">sicpro.app.soporte.estados.aplicaciones</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear un nuevo estado de Aplicaciones
      </p>
    </field>
  </record>
</odoo>
