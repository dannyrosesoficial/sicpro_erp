<odoo>
  <record id="view_soporte_trabajadores_form" model="ir.ui.view">
    <field name="name">view_soporte_trabajadores_form</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="inherit_id" ref="sicpro_app_trabajadores.view_trabajadores_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_view_soporte_tickets"
                type="object"
                class="oe_stat_button"
                icon="fa-life-ring"
                context="{'search_default_trabajador_id': id, 'default_trabajador_id': id}">
          <div class="o_field_widget o_stat_info">
            <span class="o_stat_value">
              <field name="ticket_count"/>
            </span>
            <span class="o_stat_text">Tickets</span>
          </div>
        </button>
      </div>
    </field>
  </record>
</odoo>
