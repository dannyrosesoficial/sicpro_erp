<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_soporte_cronograma_anios_search" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.cronograma.anio.search</field>
        <field name="model">sicpro.app.soporte.cronograma.anio</field>
        <field name="arch" type="xml">
            <search string="Buscar Años">
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="view_soporte_cronograma_anios_tree" model="ir.ui.view">
        <field name="name">view.sicpro.app.soporte.cronograma.anio.tree</field>
        <field name="model">sicpro.app.soporte.cronograma.anio</field>
        <field name="arch" type="xml">
            <tree string="Años" editable="bottom">
                <field name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="titulo" invisible="1"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="soporte_cronograma_anios_action" model="ir.actions.act_window">
        <field name="name">Años del Cronograma</field>
        <field name="res_model">sicpro.app.soporte.cronograma.anio</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="view_soporte_cronograma_anios_search"/>
        <field name="view_id" ref="view_soporte_cronograma_anios_tree"/>
    </record>


    <record id="view_soporte_cronograma_anios_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.cronograma.anio.kanban</field>
        <field name="model">sicpro.app.soporte.cronograma.anio</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" edit="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="name"/>
                <field name="active"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card o_kanban_record_has_image_fill">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title oe_partner_heading font-weight-bold"
                                        style="font-size: 20px;">
                                    <field name="titulo"/>
                                </strong>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li class="font-weight-bold">Planificación del Cronograma de Desarrollo</li>
                                </ul>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <button class="btn btn-primary" name="action_cronograma_plan" type="object"
                                                t-attf-data-context="{'default_id': #{record.id.raw_value}}">
                                            Ver </button>

                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                                <div class="oe_kanban_partner_links"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="soporte_cronograma_kanban_anios_action" model="ir.actions.act_window">
        <field name="name">Planificación del Cronograma</field>
        <field name="res_model">sicpro.app.soporte.cronograma.anio</field>
        <field name="view_mode">kanban,form</field>
        <field name="search_view_id" ref="view_soporte_cronograma_anios_search"/>
        <field name="view_id" ref="view_soporte_cronograma_anios_kanban"/>
    </record>

</odoo>
