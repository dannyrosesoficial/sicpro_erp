<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_soporte_paquetes_search" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.paquetes</field>
        <field name="model">sicpro.app.soporte.paquetes</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="view_soporte_paquetes_form" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.paquetes.form</field>
        <field name="model">sicpro.app.soporte.paquetes</field>
        <field name="arch" type="xml">
            <form string="Versiones">
                <header>
                    <field name="stage_id" widget="statusbar" clickable="false"/>
                </header>
                <sheet>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group name="main">
                        <field name="active" invisible="1"/>
                        <field name="descripcion"/>
                    </group>
                    <group>
                        <group>
                            <field name="version_id"/>
                        </group>
                        <group>
                            <field name="aplicaciones"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soporte_paquetes_tree" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.paquetes</field>
        <field name="model">sicpro.app.soporte.paquetes</field>
        <field name="arch" type="xml">
            <tree string="Versiones">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_soporte_paquetes_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.paquetes.kanban</field>
        <field name="model">sicpro.app.soporte.paquetes</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" archivable="false" default_group_by="stage_id" group_create="false"
                    group_delete="false" group_edit="false">
                <field name="name"/>
                <field name="stage_id"/>
                <progressbar field="activity_state"
                             colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">

                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong>Paquete: </strong><strong class="o_kanban_record_title text-danger"
                                                                      style="font-weight: bold">
                                    <field name="name"/></strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_headings">
                                Versión: <field name="version_id"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity" related="activity_state"/>
                                    <field name="activity_state" invisible="1"/>

                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="soporte_paquetes_action" model="ir.actions.act_window">
        <field name="name">Registro de Paquetes (Linux)</field>
        <field name="res_model">sicpro.app.soporte.paquetes</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nuevo paquete
            </p>
        </field>
    </record>


</odoo>
