<odoo>
  <record id="view_soporte_aplicaciones_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.search</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <field name="name" filter_domain="[('name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="view_soporte_aplicaciones_form" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.form</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <form string="Aplicaciones">
        <header>
          <field name="stage_id" widget="statusbar" clickable="true"/>
        </header>
        <sheet>
          <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                  invisible="active"/>
          <field name="image_1920" widget='image' class="oe_avatar"
                 options='{"zoom": true, "preview_image":"image_128"}'/>
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1>
              <field name="name" required="1"/>
            </h1>
          </div>
          <group>
            <group>
              <label for="tipo" string="Tipo de desarrollo: "/>
              <field name="tipo"/>
            </group>
            <group>
              <field name="modulo_base"/>
            </group>
          </group>

          <group name="main">
            <field name="active" invisible="1"/>
            <field name="descripcion"/>
          </group>
          <group string="Gestión de Fechas">
            <group>
              <field name="fecha_desarrollo"/>
              <field name="fecha_detenido"/>
            </group>
            <group>
              <field name="fecha_produccion"/>
              <field name="fecha_descontinuado"/>
            </group>
          </group>
        </sheet>
        <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
      </form>
    </field>
  </record>

  <record id="view_soporte_aplicaciones_list" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.list</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <list string="Aplicaciones">
        <field name="tipo"/>
        <field name="name"/>
        <field name="descripcion"/>
        <field name="stage_id"/>
        <field name="fecha_produccion"/>
        <field name="fecha_desarrollo"/>
        <field name="fecha_detenido"/>
        <field name="fecha_descontinuado"/>
      </list>
    </field>
  </record>

  <record id="view_soporte_aplicaciones_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.kanban</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
        <kanban class="o_kanban_mobile" archivable="false" default_group_by="stage_id"
                group_create="false" group_delete="false" group_edit="false" sample="1">
            <field name="id"/>
            <field name="name"/>
            <field name="stage_id"/>
            <field name="tipo"/>
            <field name="fecha_desarrollo"/>
            <field name="fecha_produccion"/>
            <field name="image_128"/>
            <field name="activity_state"/>
            <progressbar field="activity_state"
                         colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
            <templates>
                <t t-name="card">
                    <!-- Contenedor con Flexbox explícito para forzar la fila -->
                    <div class="oe_kanban_global_click o_kanban_record_has_image_fill d-flex flex-row align-items-stretch" style="min-height: 110px; padding: 0 !important;">

                        <!-- ÁREA DE IMAGEN: Forzamos dimensiones mínimas -->
                        <div class="o_kanban_image_fill_left d-flex align-items-center justify-content-center"
                             style="width: 110px !important; min-width: 110px !important; max-width: 110px !important; position: relative; background-color: #f0f0f0; border-right: 1px solid #dee2e6;">

                            <img t-if="record.image_128.raw_value"
                                 t-att-src="'/web/image/sicpro.app.soporte.aplicaciones/' + record.id.raw_value + '/image_128'"
                                 style="width: 100%; height: 100%; object-fit: cover; display: block;"
                                 alt="App Logo"/>

                            <img t-else=""
                                 src="/web/static/img/placeholder.png"
                                 style="width: 100%; height: 100%; object-fit: cover; opacity: 0.5;"
                                 alt="Placeholder"/>
                        </div>

                        <!-- ÁREA DE TEXTO: Ocupa el resto del ancho -->
                        <div class="oe_kanban_details d-flex flex-column justify-content-between p-3" style="flex: 1; min-width: 0;">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title fw-bold fs-5 text-dark" style="display: block; line-height: 1.2;">
                                        <field name="name"/>
                                    </strong>
                                    <div class="text-muted small mt-1">
                                        <i class="fa fa-tag me-1"/> <field name="tipo"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_record_body mt-2">
                                <div t-if="record.fecha_desarrollo.raw_value" class="small">
                                    <strong>Desarrollo: </strong><field name="fecha_desarrollo"/>
                                </div>
                                <div t-if="record.fecha_produccion.raw_value" class="small text-danger fw-bold">
                                    <strong>Producción: </strong><field name="fecha_produccion"/>
                                </div>
                            </div>

                            <div class="o_kanban_record_bottom mt-2 border-top pt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span class="badge rounded-pill bg-info text-dark">
                                        <field name="stage_id"/>
                                    </span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

  <record id="view_soporte_aplicaciones_activity" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.activity</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <activity string="Registro de Aplicaciones">
        <field name="name"/>
        <field name="tipo"/> <templates>
        <div t-name="activity-box">
          <div class="d-flex flex-column">
            <strong class="o_activity_info">
              <field name="name" display="full"/>
            </strong>
            <span t-if="record.tipo.raw_value" class="text-muted small">
              Tipo: <field name="tipo"/>
            </span>
          </div>
        </div>
      </templates>
      </activity>
    </field>
  </record>

  <record id="soporte_aplicaciones_action" model="ir.actions.act_window">
    <field name="name">Registro de Módulos &amp; Aplicaciones</field>
    <field name="res_model">sicpro.app.soporte.aplicaciones</field>
    <field name="view_mode">kanban,list,form,activity</field>
    <field name="target">current</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Registra tu primera Aplicación o Módulo
      </p>
      <p>
        Aquí podrás gestionar el ciclo de vida de tus desarrollos,
        desde la fase de diseño hasta la puesta en producción.
      </p>
    </field>
  </record>


</odoo>
