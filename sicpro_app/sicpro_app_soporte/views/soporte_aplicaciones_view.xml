<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_soporte_aplicaciones_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.search</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <field name="name" filter_domain="[('name', 'ilike', self)]"/>
      </search>
    </field>
  </record>

  <record id="view_soporte_aplicaciones_form" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.form</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <form string="Aplicaciones">
        <header>
          <field name="stage_id" widget="statusbar" clickable="true" />
        </header>
        <sheet>
         <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <field name="image_1920" widget='image' class="oe_avatar"
                               options='{"zoom": true, "preview_image":"image_128"}'/>
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1>
              <field name="name" required="1"/>
            </h1>
              </div>
            <label for="tipo" string="Tipo de desarrollo: "/>
            <field name="tipo"/>

          <group name="main">
              <field name="active" invisible="1"/>
              <field name="descripcion"/>
          </group>
          <group string="Gestión de Fechas">
              <group>
                  <field name="fecha_desarrollo"/>
                  <field name="fecha_detenido"/>
              </group>
              <group>
                  <field name="fecha_produccion"/>
                  <field name="fecha_descontinuado"/>
              </group>
          </group>
        </sheet>
          <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
      </form>
    </field>
  </record>

  <record id="view_soporte_aplicaciones_tree" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.aplicaciones.tree</field>
    <field name="model">sicpro.app.soporte.aplicaciones</field>
    <field name="arch" type="xml">
      <tree string="Aplicciones">
        <field name="name"/>
      </tree>
    </field>
  </record>

     <record id="view_soporte_aplicaciones_kanban" model="ir.ui.view">
      <field name="name">sicpro.app.soporte.aplicaciones.kanban</field>
      <field name="model">sicpro.app.soporte.aplicaciones</field>
      <field name="arch" type="xml">
          <kanban class="o_kanban_mobile" archivable="false"  default_group_by="stage_id" >
              <field name="name"/>
              <field name="stage_id"/>
              <progressbar field="activity_state" colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>
              <templates>
                  <t t-name="kanban-box">
                   <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                           <field name="image_128" widget="image" class="o_kanban_image_fill_left" options="{'zoom': true, 'zoom_delay': 1000, 'background': true, 'preventClicks': false}"/>

                      <div class="oe_kanban_details">
                               <div class="o_kanban_record_top">
                                   <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                       </strong>
                                       <span t-if="record.tipo.raw_value" class="o_kanban_record_subtitle"><field name="tipo"/></span>
                                   </div>
                               </div>
                               <ul>
                                   <li t-if="record.fecha_desarrollo.raw_value" class="o_text_overflow">
                                       <strong>Desarrollo: </strong><field name="fecha_desarrollo" /></li>
                                   <li t-if="record.fecha_produccion.raw_value" class="o_force_ltr">
                                       <strong>Producción: </strong><field name="fecha_produccion" /></li>
                               </ul>
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left"/>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="activity_ids" widget="kanban_activity" related="activity_state"/>
                                            <field name="activity_state" invisible="1"/>
                                        </div>
                                    </div>
                                </div>
                           </div>
                  </div>
                       </t>
              </templates>
          </kanban>
      </field>
  </record>

    <record id="view_soporte_aplicaciones_activity" model="ir.ui.view">
            <field name="name">sicpro.app.soporte.aplicaciones.activity</field>
            <field name="model">sicpro.app.soporte.aplicaciones</field>
            <field name="arch" type="xml">
                <activity string="Registro de Aplicaciones">
                    <field name="name"/>
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <field name="name" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

  <record id="soporte_aplicaciones_action" model="ir.actions.act_window">
        <field name="name">Registro de Módulos &amp; Aplicaciones</field>
        <field name="res_model">sicpro.app.soporte.aplicaciones</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear una nueva Versión
            </p>
        </field>
    </record>



</odoo>
