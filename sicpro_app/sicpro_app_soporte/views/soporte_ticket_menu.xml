<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="soporte_estados_action" model="ir.actions.act_window">
        <field name="name">Estados</field>
        <field name="res_model">sicpro.app.soporte.estados</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo estado de soporte
            </p>
        </field>
    </record>

    <record id="soporte_canales_action" model="ir.actions.act_window">
        <field name="name">Canales</field>
        <field name="res_model">sicpro.app.soporte.canales</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear un nuevo canal
            </p>
        </field>
    </record>

    <record id="soporte_categoria_action" model="ir.actions.act_window">
        <field name="name">Categorías</field>
        <field name="res_model">sicpro.app.soporte.categoria</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear una nueva categoría
            </p>
        </field>
    </record>

     <record id="soporte_equipos_action" model="ir.actions.act_window">
        <field name="name">Equipos de Soporte</field>
        <field name="res_model">sicpro.app.soporte.equipos</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                 Crear un nuevo equipo de soporte
            </p>
        </field>
    </record>

     <record id="soporte_etiquetas_action" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">sicpro.app.soporte.etiquetas</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear una nueva etiqueta
            </p>
        </field>
    </record>

    <record id="helpdesk_ticket_action_main" model="ir.actions.act_window">
        <field name="name">Todos los Tickets</field>
        <field name="res_model">sicpro.app.soporte</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <!--<field name="search_view_id" ref="helpdesk_ticket_view_search"/>-->
        <field name="context">{'search_default_my_ticket': True, 'search_default_is_open': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo ticket.
                </p>
        </field>
    </record>

    <record id="helpdesk_ticket_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tablero</field>
        <field name="res_model">sicpro.app.soporte.equipos</field>
        <field name="view_mode">kanban,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Aquí aparecen los equipos de trabajo
            </p>
        </field>
    </record>

    <!-- Reporting action for dashboard -->
    <record id="helpdesk_ticket_reporting_action" model="ir.actions.act_window">
        <field name="name">Closed Tickets Analysis</field>
        <field name="res_model">sicpro.app.soporte</field>
        <field name="view_mode">pivot,graph</field>
        <!--
        <field name="search_view_id" ref="helpdesk_ticket_view_search_analysis_closed"/>
        <field name="domain" eval="[('close_date', '>=', (DateTime.today() - relativedelta(hours=12)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
        <field name="context">{'search_default_my_ticket': True}</field>
        <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'graph', 'view_id': ref('helpdesk_ticket_view_graph_analysis')}),
                          (0, 0, {'view_mode': 'pivot', 'view_id': ref('helpdesk_ticket_view_pivot_analysis')})]"/>
-->
    </record>

    <!-- Menus -->
    <menuitem id="soporte_root_menu" name="Soporte Técnico" sequence="99"
              web_icon="sicpro_app_soporte,static/description/icon.png"
              groups="group_soporte_usuarios"/>

        <menuitem id="helpdesk_dashboard_menu" name="General"
            parent="soporte_root_menu" sequence="10"
            action="helpdesk_ticket_dashboard_action"/>


        <menuitem id="helpdesk_ticket_menu_main" name="Tickets"
            parent="soporte_root_menu" sequence="20"
            groups="group_soporte_ejecutor"/>

            <menuitem id="helpdesk_ticket_menu" name="Tickets"
                      parent="helpdesk_ticket_menu_main"
                      action="helpdesk_ticket_action_main" sequence="10"/>


        <menuitem id="helpdesk_ticket_reporting_main_menu" name="Reportes"
            parent="soporte_root_menu" sequence="30"
            groups="group_soporte_ejecutor"/>

            <menuitem id="helpdesk_ticket_reporting_menu" name="Informes"
                      parent="helpdesk_ticket_reporting_main_menu"
                      action="helpdesk_ticket_reporting_action" sequence="10"/>


        <menuitem id="helpdesk_ticket_config_main_menu" name="Configuración"
            parent="soporte_root_menu" sequence="40"
            groups="group_soporte_admin"/>

            <menuitem id="helpdesk_ticket_team_menu" name="Equipos"
                      parent="helpdesk_ticket_config_main_menu"
                      action="soporte_equipos_action" sequence="10"/>

            <menuitem id="helpdesk_ticket_category_menu" name="Categorías"
                      parent="helpdesk_ticket_config_main_menu"
                      action="soporte_categoria_action" sequence="20"/>

            <menuitem id="helpdesk_ticket_tag_menu" name="Etiquetas"
                      parent="helpdesk_ticket_config_main_menu"
                      action="soporte_etiquetas_action" sequence="30"/>

            <menuitem id="helpdesk_ticket_stage_menu" name="Estados"
                      parent="helpdesk_ticket_config_main_menu"
                      action="soporte_estados_action" sequence="40"/>

            <menuitem id="helpdesk_ticket_channel_menu" name="Canales"
                      parent="helpdesk_ticket_config_main_menu"
                      action="soporte_canales_action" sequence="50"/>

</odoo>
