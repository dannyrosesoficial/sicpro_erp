<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_soporte_bitacora_search" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.bitacora.search</field>
    <field name="model">sicpro.app.soporte.bitacora</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
          <filter string="VPN PC" name="vpn_pc" domain="[('name','=','vpn_pc')]"/>
          <filter string="VPN Móvil" name="vpn_movil" domain="[('name','=','vpn_movil')]"/>
        <separator/>
        <field name="usuario" filter_domain="[('usuario', 'ilike', self)]"/>
          <field name="name" filter_domain="[('name', 'ilike', self)]"/>
          <separator/>
          <group  expand='0' string='Group by...'>
              <filter string='Actividad' name="name" context="{'group_by': 'name'}"/>
              <filter string='Fecha Solicitud' name="fecha_solicitud" context="{'group_by': 'fecha_solicitud'}"/>
              <filter string='Fecha Ejecucion' name="fecha_ejecucion" context="{'group_by': 'fecha_ejecucion'}"/>
              <filter string='Usuario' name="usuario" context="{'group_by': 'usuario'}"/>
              <filter string='Proceso' name="proceso" context="{'group_by': 'proceso'}"/>
          </group>
      </search>
    </field>
  </record>

  <record id="view_soporte_bitacora_form" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.bitacora.form</field>
    <field name="model">sicpro.app.soporte.bitacora</field>
    <field name="arch" type="xml">
      <form string="Bitácora de Usuarios">
        <sheet>
          <div class="oe_title">
            <label for="usuario"/>
            <h1>
              <field name="usuario" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </h1>
              <field name="proceso"/>
          </div>
            <group>
              <field name="active" widget="boolean_toggle"/>
          </group>
            <group>
                <group>
                    <field name="name"/>
                    <field name="ejecutor" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </group>
                <group>
                    <field name="fecha_solicitud"/>
                    <field name="fecha_ejecucion"/>
                </group>
            </group>
            <group>
                <field name="roles" widget="many2many_tags"/>
            </group>
            <group>
                <field name="nota"/>
            </group>
        </sheet>
          <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
      </form>
    </field>
  </record>

  <record id="view_soporte_bitacora_tree" model="ir.ui.view">
    <field name="name">sicpro.app.soporte.bitacora.tree</field>
    <field name="model">sicpro.app.soporte.bitacora</field>
    <field name="arch" type="xml">
      <tree string="Bitácora de Usuarios">
          <field name="name"/>
          <field name="fecha_solicitud" optional="hide"/>
          <field name="fecha_ejecucion" string="Ejecutado"/>
          <field name="ejecutor" optional="hide"/>
          <field name="usuario"/>
          <field name="proceso"/>
          <field name="roles" widget="many2many_tags" string="Roles de permisos asignados"/>
          <field name="nota" optional="hide"/>
      </tree>
    </field>
  </record>

    <record id="view_soporte_bitacora_activity" model="ir.ui.view">
            <field name="name">sicpro.app.soporte.bitacora.activity</field>
            <field name="model">sicpro.app.soporte.bitacora</field>
            <field name="arch" type="xml">
                <activity string="Bitácora de Usuarios">
                    <field name="usuario"/>
                    <templates>
                        <div t-name="activity-box">
                            <div>
                                <field name="usuario" display="full"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

  <record id="soporte_bitacora_action" model="ir.actions.act_window">
        <field name="name">Bitácora de Usuario</field>
        <field name="res_model">sicpro.app.soporte.bitacora</field>
        <field name="view_mode">tree,form,activity</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
               Crear un nuevo registro
            </p>
        </field>
    </record>



</odoo>
