<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_soporte_ticket_stage_versiones_search" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.estados.versiones.search</field>
        <field name="model">sicpro.app.soporte.estados.versiones</field>
        <field name="arch" type="xml">
            <search string="Buscar Estados">
                <filter string="Archivados" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <field name="name" filter_domain="[('name', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <record id="view_soporte_estados_versiones_form" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.estados.versiones.form</field>
        <field name="model">sicpro.app.soporte.estados.versiones</field>
        <field name="arch" type="xml">
            <form string="Estados">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" required="1"/></h1>
                    </div>
                    <group name="main">
                        <group name="main_left">
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                        <group name="main_right">
                            <field name="inicial"/>
                            <field name="closed"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <field name="descripcion" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_soporte_estados_versiones_tree" model="ir.ui.view">
        <field name="name">sicpro.app.soporte.estados.versiones.tree</field>
        <field name="model">sicpro.app.soporte.estados.versiones</field>
        <field name="arch" type="xml">
            <tree string="Estados">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="soporte_estados_versiones_action" model="ir.actions.act_window">
        <field name="name">Estados de las Versiones</field>
        <field name="res_model">sicpro.app.soporte.estados.versiones</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo estado de las versiones
            </p>
        </field>
    </record>


</odoo>
