<odoo>
  <data noupdate="0">
    <!-- Cron para actualizar los avisos de mantenimiento -->
    <record id="metrologia_mantenimiento" model="ir.cron">
      <field name="name">Metrología: Actualizar Mantenimiento</field>
      <field name="model_id" ref="sicpro_app_metrologia.model_sicpro_app_metrologia_equipos"/>
      <field name="state">code</field>
      <field name="code">model.cron_ejecutar_aviso_mtto()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>
  </data>
</odoo>
