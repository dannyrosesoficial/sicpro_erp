<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Creo la categoría de permisos Metrología -->
        <record id="module_category_metrologia" model="ir.module.category">
            <field name="name">Metrología</field>
            <field name="description">Módulo para el control de los equipos de medición.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_activos_herramientas"/>
            <field name="sequence">1</field>
        </record>

        <record id="grupo_app_metrologia_usuario" model="res.groups">
            <field name="name">Usuarios</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_metrologia"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_app_metrologia_ejecutor" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="module_category_metrologia"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_metrologia_usuario'))]"/>
        </record>

        <record id="grupo_app_metrologia_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="module_category_metrologia"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_metrologia_ejecutor'))]"/>
        </record>

        <record id="grupo_app_metrologia_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="module_category_metrologia"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_metrologia_responsable'))]"/>
        </record>


    </data>

    <data noupdate="0">
        <record id="metrologia_rule_proceso" model="ir.rule">
            <field name="name">Regla Procesos Metrología</field>
            <field ref="base.model_res_company" name="model_id"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_metrologia_responsable'))]"/>
        </record>

        <!-- El caso de alicia y berny de civiles, q no deja acceder a los archivados, mientras
        tanto lo deshabilito hasta encontrar el problema-->
        <!-- <record id="metrologia_equipos_multi_rule_ejecutor" model="ir.rule">
            <field name="name">Regla Equipos Multicompañia Ejecutor</field>
            <field name="model_id" ref="model_sicpro_app_metrologia_equipos"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_metrologia_ejecutor'))]"/>
        </record>-->

        <record id="metrologia_equipos_multi_rule_responsable" model="ir.rule">
            <field name="name">Regla Equipos Multicompañia Responsable</field>
            <field name="model_id" ref="model_sicpro_app_metrologia_equipos"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_metrologia_responsable'))]"/>
        </record>

        <record id="metrologia_equipo_mtt_multi_rule_ejecutor" model="ir.rule">
            <field name="name">Regla Equipos mantenimiento Multicompañia Ejecutor</field>
            <field name="model_id" ref="model_sicpro_app_metrologia_direcciones"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_metrologia_ejecutor'))]"/>
        </record>

        <record id="metrologia_equipo_mtt_multi_rule_responsable" model="ir.rule">
            <field name="name">Regla Equipos mantenimiento Multicompañia Responsable</field>
            <field name="model_id" ref="model_sicpro_app_metrologia_direcciones"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_metrologia_responsable'))]"/>
        </record>


    </data>
</odoo>
