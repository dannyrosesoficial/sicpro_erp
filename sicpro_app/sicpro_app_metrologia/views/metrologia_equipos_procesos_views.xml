<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="metrologia_procesos_equipos_view_form" model="ir.ui.view">
        <field name="name">metrologia.direcciones.form</field>
        <field name="model">sicpro.app.metrologia.direcciones</field>
        <field name="arch" type="xml">
            <form string="Proceso de Mantenimiento">
                <sheet>
                <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"/>
                <div class="oe_title">
                    <label for="name" class="oe_edit_only" string="Nombre del Proceso"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                <group>
                    <group>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <field name="company_id" options="{'no_create': True}"/>
                    </group>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="metrologia_procesos_equipos_view_tree" model="ir.ui.view">
        <field name="name">metrologia.direcciones.tree</field>
        <field name="model">sicpro.app.metrologia.direcciones</field>
        <field name="arch" type="xml">
            <tree string="Equipo de Calibración" editable="bottom">
                <field name="name"/>
                <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="gestores" widget="many2many_tags"
                      options="{'color_field': 'color', 'no_create_edit': True}" placeholder="Gestores"/>
            </tree>
        </field>
    </record>

    <record id="metrologia_equipos_view_search" model="ir.ui.view">
        <field name="name">metrologia.direcciones.search</field>
        <field name="model">sicpro.app.metrologia.direcciones</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field string="Team" name="name"/>
                <filter string="Archivado" domain="[('active', '=', False)]" name="inactive"/>
            </search>
        </field>
    </record>

    <record id="metrologia_procesos_equipos_action" model="ir.actions.act_window">
        <field name="name">Equipos de Mantenimiento</field>
        <field name="res_model">sicpro.app.metrologia.direcciones</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="metrologia_equipos_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('metrologia_procesos_equipos_view_tree')})]"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Agregar una dirección de proceso para mantenimiento
          </p>
        </field>
    </record>
</odoo>
