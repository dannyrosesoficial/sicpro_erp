<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sicpro_app_trabajadores_general_metrologia" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.general.metrologia.form</field>
        <field name="model">sicpro.app.trabajadores.general</field>
        <field name="inherit_id" ref="sicpro_app_trabajadores.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(hr_equipment_action)d"
                    context="{'search_default_owner_user_id': id, 'default_owner_user_id': id}"
                    groups="sicpro_app_metrologia.grupo_app_metrologia_solicitante"
                    class="o_stat_button"
                    icon="fa-cubes"
                    type="action">
                    <field name="equipment_count" widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>


</odoo>
