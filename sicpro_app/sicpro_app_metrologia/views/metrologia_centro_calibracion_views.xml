<odoo>
  <record id="metrologia_centro_calibracion_view_list" model="ir.ui.view">
    <field name="name">metrologia.centro.calibracion.list</field>
    <field name="model">sicpro.app.metrologia.centro.calibracion</field>
    <field name="arch" type="xml">
      <list string="Centro de Calibración" editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="metrologia_centro_calibracion_view_search" model="ir.ui.view">
    <field name="name">metrologia.centro.calibracion.search</field>
    <field name="model">sicpro.app.metrologia.centro.calibracion</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field string="Centro de Calibración" name="name"/>
        <filter string="Archivado" domain="[('active', '=', False)]" name="active"/>
      </search>
    </field>
  </record>

  <record id="metrologia_centro_calibracion_action" model="ir.actions.act_window">
    <field name="name">Centro de Calibración</field>
    <field name="res_model">sicpro.app.metrologia.centro.calibracion</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="metrologia_centro_calibracion_view_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregar los centros donde se calibran los equipos
      </p>
    </field>
  </record>
</odoo>
