<odoo>
  <record id="metrologia_estado_tecnico_view_list" model="ir.ui.view">
    <field name="name">metrologia.estado.tecnico.list</field>
    <field name="model">sicpro.app.metrologia.estado.tecnico</field>
    <field name="arch" type="xml">
      <list string="Estado Técnico" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="active" invisible="1"/>
        <field name="laboratorio"/>
        <field name="sin_calibrar"/>
        <field name="fold"/>
        <field name="baja"/>
      </list>
    </field>
  </record>

  <record id="metrologia_estado_tecnico_view_search" model="ir.ui.view">
    <field name="name">metrologia.estado.tecnico.search</field>
    <field name="model">sicpro.app.metrologia.estado.tecnico</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field string="Estado" name="name"/>
        <filter string="Archivado" domain="[('active', '=', False)]" name="active"/>
      </search>
    </field>
  </record>

  <record id="metrologia_estado_tecnico_action" model="ir.actions.act_window">
    <field name="name">Estado Técnico</field>
    <field name="res_model">sicpro.app.metrologia.estado.tecnico</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="metrologia_estado_tecnico_view_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregar los estados del equipo
      </p>
    </field>
  </record>
</odoo>
