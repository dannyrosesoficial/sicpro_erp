<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="metrologia_equipos_views_kanban" model="ir.ui.view">
        <field name="name">metrologia.direcciones.kanban</field>
        <field name="model">sicpro.app.metrologia.direcciones</field>
        <field name="arch" type="xml">
            <kanban class="oe_background_grey o_kanban_dashboard o_maintenance_team_kanban" create="0">
                <field name="name"/>
                <field name="color"/>
                <field name="todo_request_ids"/>
                <field name="todo_request_count"/>
                <field name="todo_request_planificado"/>
                <field name="todo_request_count_laboratorio"/>
                <field name="todo_request_count_sin_calibrar"/>
                <field name="todo_request_count_transferencias"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                            <div t-attf-class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <a name="%(metrologia_equipamiento_action)d" type="action">
                                            <field name="name"/>
                                        </a></div>
                                </div>
                                <div class="o_kanban_manage_button_section">
                                    <a class="o_kanban_manage_toggle_button" href="#">
                                        <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/></a>
                                </div>
                            </div>
                            <div class="container o_kanban_card_content">
                                <div class="row">
                                    <div class="col-6 o_kanban_primary_left">
                                        <button class="btn btn-primary"
                                                name="%(metrologia_equipamiento_action)d"
                                                type="action" context="{'search_default_todo': 1}">
                                            <t t-esc="record.todo_request_count.value"/> Equipos
                                        </button>
                                    </div>
                                    <div class="col-6 o_kanban_primary_right">
                                        <div class="row">
                                            <div class="col-9">
                                                <a name="%(metrologia_equipamiento_action)d"
                                                   type="action" context="{'search_default_aviso_mtto': 1}">
                                                    Planificado
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t t-esc="record.todo_request_planificado.value"/>
                                            </div>
                                            <div class="col-9">
                                                <a name="%(metrologia_equipamiento_action)d"
                                                   type="action" context="{'search_default_estado_laboratorio': 1}">
                                                    En Laboratorio
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t t-esc="record.todo_request_count_laboratorio.value"/>
                                            </div>
                                            <div class="col-9">
                                                <a name="%(metrologia_equipamiento_action)d"
                                                   type="action" context="{'search_default_estado_sin_calibrar': 1}">
                                                    Sin Calibrar
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t t-esc="record.todo_request_count_sin_calibrar.value"/>
                                            </div>
                                            <div class="col-9">
                                                <a name="%(metrologia_equipamiento_action)d" class="text-danger"
                                                   type="action" context="{'search_default_transferencia_pendiente': 1}">
                                                    Pendiente Economía
                                                </a>
                                            </div>
                                            <div class="col-3">
                                                <t t-esc="record.todo_request_count_transferencias.value"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div><div class="container o_kanban_card_manage_pane dropdown-menu" role="menu">
                                <div class="row">
                                    <div class="col-6 o_kanban_card_manage_section o_kanban_manage_view">
                                        <div role="menuitem" class="o_kanban_card_manage_title">
                                            <span>Ver</span>
                                        </div>
                                        <div role="menuitem">
                                            <a name="%(metrologia_equipamiento_action)d" type="action">
                                                Todos
                                            </a>
                                        </div>
                                        <div role="menuitem">
                                            <a name="%(metrologia_equipamiento_action)d"
                                               type="action" context="{'search_default_todo': 1}">
                                                Por hacer
                                            </a>
                                        </div>
                                        <div role="menuitem">
                                            <a name="%(metrologia_equipamiento_action)d"
                                               type="action" context="{'search_default_progress': 1}">
                                                En Progreso
                                            </a>
                                        </div>
                                        <div role="menuitem">
                                            <a name="%(metrologia_equipamiento_action)d"
                                               type="action" context="{'search_default_done': 1}">
                                                Hecho
                                            </a>
                                        </div>
                                    </div>
                                    <div class="col-6 o_kanban_card_manage_section o_kanban_manage_new">
                                        <div role="menuitem" class="o_kanban_card_manage_title">
                                            <span>Informes</span>
                                        </div>
                                    </div>
                                </div>
                                <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                    <div class="col-8" role="menuitem" aria-haspopup="true">
                                        <ul role="menu" class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                    <div role="menuitem" class="col-4 text-right">
                                        <a type="edit">Ajustes</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="metrologia_equipos_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tablero de Calibración</field>
        <field name="res_model">sicpro.app.metrologia.direcciones</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="metrologia_equipos_views_kanban"/>
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Agregar nuevas solicitudes de mantenimiento
          </p>
        </field>
    </record>
</odoo>
