<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="metrologia_categorias_view_form" model="ir.ui.view">
        <field name="name">sicpro.app.metrologia.categoria.form</field>
        <field name="model">sicpro.app.metrologia.categoria</field>
        <field name="arch" type="xml">
            <form string="Categoría de Equipos">
                <sheet>
                <div class="oe_title">
                    <label for="name" class="oe_edit_only" string="Nombre de la Categoría"/>
                    <h1>
                        <field name="name"/>
                    </h1>
                </div>
                    <field name="notas"/>
                    <field name="vigencia"/>
                    <field name="dias"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="metrologia_categorias_view_tree" model="ir.ui.view">
        <field name="name">sicpro.app.metrologia.categoria.tree</field>
        <field name="model">sicpro.app.metrologia.categoria</field>
        <field name="arch" type="xml">
            <tree string="Assign To User" editable="bottom">
                <field name="name" string="Equipo"/>
                <field name="notas"/>
                <field name="vigencia"/>
                <field name="dias"/>
            </tree>
        </field>
    </record>

    <record id="metrologia_categorias_view_search" model="ir.ui.view">
        <field name="name">sicpro.app.metrologia.categoria.search</field>
        <field name="model">sicpro.app.metrologia.categoria</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Categoría" filter_domain="[('name','ilike',self)]"/>
            </search>
        </field>
    </record>

    <record id="metrologia_categorias_action" model="ir.actions.act_window">
        <field name="name">Categoría de Equipos</field>
        <field name="res_model">sicpro.app.metrologia.categoria</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="metrologia_categorias_view_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregar una Categorías de equipamientos
            </p>
        </field>
    </record>

</odoo>
