                <!-- sección de las tareas  -->
                <div t-attf-class="article">
                    <!-- sección del page -->
                    <t t-foreach="docs" t-as="inf">
                        <table cellspacing="0" border="0">
                            <colgroup width="35"></colgroup>
                            <colgroup width="4"></colgroup>
                            <colgroup width="678"></colgroup>
                            <tbody>
                                <tr>
                                    <td colspan="3" valign="middle" height="17" align="left">
                                        <b>TAREAS PRINCIPALES:</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" valign="middle" height="11" align="center">
                                        <b>
                                            <br></br>
                                        </b>
                                    </td>
                                </tr>
<!--                            valor viejo: <t t-set="tipos_tareas" t-value="inf.buscar_datos_img()"/>-->
                                <t t-set="tipos_tareas" t-value="inf.report_busca_calendario()"/>
                                <t t-set="count_principales" t-value="1"/>
                                <t t-set="count_generales" t-value="1"/>

                                <t t-foreach='tipos_tareas' t-as='principales'>
                                    <t t-if="principales['tipo_tarea'] == 'principales'">
                                        <tr>
                                            <td height="17" align="right">
                                                <span t-out="count_principales"/>.
                                            </td>
                                            <td align="right">
                                                <br></br>
                                            </td>
                                            <td valign="middle" align="left">
                                                <span t-out="principales['evento']"/>
                                            </td>
                                        </tr>
                                        <t t-set="count_principales" t-value="count_principales + 1"/>
                                    </t>
                                </t>
                                <tr>
                                    <td colspan="3" valign="middle" height="17" align="center">
                                        <br></br>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" valign="middle" height="17" align="center">
                                        <br></br>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" valign="middle" height="17" align="left">
                                        <b>TAREAS GENERALES:</b>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3" valign="middle" height="11" align="center">
                                        <br></br>
                                    </td>
                                </tr>
                                <t t-foreach='tipos_tareas' t-as='principales'>
                                    <t t-if="principales['tipo_tarea'] == 'generales'">
                                        <tr>
                                            <td height="17" align="right">
                                                <span t-out="count_generales"/>.
                                            </td>
                                            <td align="right">
                                                <br></br>
                                            </td>
                                            <td valign="middle" align="left">
                                                <span t-out="principales['evento']"/>
                                            </td>
                                        </tr>
