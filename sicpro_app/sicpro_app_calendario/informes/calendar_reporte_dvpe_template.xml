                <!-- sección de los datos  -->
                <div t-attf-class="article">
                    <!-- sección del page -->
                    <t t-foreach="docs" t-as="inf">
                        <table cellspacing="0" border="0">
                            <colgroup width="35"></colgroup>
                            <colgroup width="500"></colgroup>
                            <colgroup width="200"></colgroup>
                            <colgroup width="250"></colgroup>
                            <colgroup width="300"></colgroup>
                            <tbody>
                                <t t-set="calendario" t-value="inf.report_busca_dias()"/>
                                <t t-set="eventos" t-value="inf.report_busca_calendario()"/>
                                <tr>
                                    <td colspan="5" valign="middle" height="23" align="center">
                                        <b>
                                            <font size="4">PLAN DE TRABAJO DVPE PARA EL MES DE
                                                <t t-esc="inf.mes.name.upper()"/>
                                            </font>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="background-color: #FFCC99; border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000"
                                        height="19" align="center">
                                        <b>
                                            <font face="Arial">No.</font>
                                        </b>
                                    </td>
                                    <td style="background-color: #FFCC99; border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000"
                                        align="center">
                                        <b>
                                            <font face="Arial">Actividad</font>
                                        </b>
                                    </td>
                                    <td style="background-color: #FFCC99; border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000"
                                        align="center">
                                        <b>
                                            <font face="Arial">Hora y Lugar</font>
                                        </b>
                                    </td>
                                    <td style="background-color: #FFCC99; border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000"
                                        align="center">
                                        <b>
                                            <font face="Arial">Dirige</font>
                                        </b>
                                    </td>
                                    <td style="background-color: #FFCC99; border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                        align="center">
                                        <b>
                                            <font face="Arial">Participan</font>
                                        </b>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="5" valign="middle" height="17" align="center">
                                        <br></br>
                                    </td>
                                </tr>
                                <t t-foreach='calendario' t-as='dia_nombre'>
                                    <tr>
                                        <td style="background-color: #CCFFFF; border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                            colspan="5" valign="middle" height="17" align="left">
                                            <font face="Arial">DÍA
                                                <span t-out="dia_nombre['dia']"/>
                                                <t t-if="dia_nombre['nombre'] == 'Sábado' or dia_nombre['nombre'] == 'Domingo'">
                                                    (<span class="text-danger font-weight-bold"
                                                           t-out="dia_nombre['nombre']"/>)
                                                </t>
                                                <t t-else="">
                                                    (<span class="font-weight-bold" t-out="dia_nombre['nombre']"/>)
                                                </t>
                                            </font>
                                        </td>
                                    </tr>
                                    <t t-set="count_eventos" t-value="1"/>
                                    <t t-foreach='eventos' t-as='evento'>
                                        <t t-if="evento['dia'] == dia_nombre['dia']">
                                            <tr>
                                                <td style="border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                                    sdval="1" sdnum="9226;" height="18" align="center">
                                                    <font face="Arial">
                                                        <span t-out="count_eventos"/>
                                                    </font>
                                                </td>
                                                <td style="border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                                    align="justify">
                                                    <font face="Arial">
                                                        <t t-out="evento['evento']"/>
                                                    </font>
                                                </td>
                                                <td style="border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                                    align="center">
                                                    <font face="Arial">
                                                        <span class="font-weight-bold" t-out="evento['hora']"/>-
                                                        <t t-if="evento['tipo_ubicacion'] == 'otro'">
                                                            <span t-out="evento['ubicacion']"/>
                                                        </t>
                                                        <t t-else="">
                                                            <span t-out="evento['ubicacion_dvpe']"/>
                                                        </t>
                                                    </font>
                                                </td>
                                                <td style="border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                                    align="center">
                                                    <font face="Arial">
                                                        <t t-if="evento['tipo_ubicacion'] == 'externo'">
                                                            <t t-foreach="evento['dirige_externos']" t-as="dirige">
                                                                <span t-field="dirige.name"/>
                                                                <br></br>
                                                            </t>
                                                        </t>
                                                        <t t-else="">
                                                            <t t-foreach="evento['dirige']" t-as="dirige">
                                                                <span t-field="dirige.ocupacion_id"/>
                                                                -
                                                                <span t-field="dirige.company_id.identificador_corto"/>
                                                                <br></br>
                                                            </t>
                                                        </t>
                                                    </font>
                                                </td>
                                                <td style="border-top: 1px solid #000000; border-bottom: 1px solid #000000; border-left: 1px solid #000000; border-right: 1px solid #000000"
                                                    align="justify">
                                                    <font face="Arial">
                                                        <t t-foreach="evento['participantes']" t-as="participantes">
                                                            <span t-field="participantes.name"/>
                                                            <br></br>
                                                        </t>
                                                    </font>
                                                </td>
                                            </tr>
                                            <t t-set="count_eventos" t-value="count_eventos + 1"/>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>
                    </t>
                </div>

                <t t-out="0"/>

