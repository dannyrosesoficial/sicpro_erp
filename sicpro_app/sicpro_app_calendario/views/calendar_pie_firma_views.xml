<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="calendario_pie_firma_search_view">
            <field name="name">calendar.pie.firmas.search</field>
            <field name="model">calendar.pie.firmas</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name"/>
                    <field name="tipo"/>
                    <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="calendario_pie_firma_tree_view">
            <field name="name">calendar.pie.firmas.tree</field>
            <field name="model">calendar.pie.firmas</field>
            <field name="arch" type="xml">
                <tree string="Tipo" editable="bottom">
                    <field name="name" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="tipo"/>
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="calendario_pie_firma_action" model="ir.actions.act_window">
            <field name="name">Firma del Plan de Trabajo</field>
            <field name="res_model">calendar.pie.firmas</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear un nuevo pie de firma para el calendario
              </p>
            </field>
        </record>
    
    </data>
</odoo>