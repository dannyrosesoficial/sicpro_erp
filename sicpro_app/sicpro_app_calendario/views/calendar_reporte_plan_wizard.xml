<odoo>
  <record id="reporte_calendar_plan_trabajo_wizard" model="ir.ui.view">
    <field name="name">calendar.plan.reporte.form</field>
    <field name="model">calendar.plan.reporte</field>
    <field name="arch" type="xml">
      <form string="Reporte de Plan de Trabajo">
        <group>
          <group>
            <field name="mes" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            <field name="anio"/>
            <field name="codigo_mes" invisible="1"/>
          </group>
          <group>
            <field name="type" widget="radio" string="Tipo"/>
            <field name="plan" domain="[('plantilla_impresion','=',True)]"
                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            <field name="plan_dvpe" invisible="1"/>
          </group>
        </group>
        <footer>
          <button name="generar_reporte" string="Imprimir" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="reporte_plan_trabajo_action" model="ir.actions.act_window">
    <field name="name">Reporte de Plan de Trabajo</field>
    <field name="res_model">calendar.plan.reporte</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="reporte_calendar_plan_trabajo_wizard"/>
    <field name="target">new</field>
  </record>
</odoo>
