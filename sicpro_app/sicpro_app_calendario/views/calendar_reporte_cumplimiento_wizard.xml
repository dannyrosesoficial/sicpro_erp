<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reporte_calendar_cumplimiento_wizard" model="ir.ui.view">
        <field name="name">calendar.cumplimiento.reporte.form</field>
        <field name="model">calendar.cumplimiento.reporte</field>
        <field name="arch" type="xml">
            <form string="Cumplimiento del Plan de Trabajo">
                <group>
                    <group>
                        <field name="mes" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        <field name="anio"/>
                        <field name="codigo_mes" invisible="1"/>
                    </group>
                    <group>
                        <field name="type" widget="radio" string="Tipo"/>
                        <field name="tipo_calendario"
                               attrs="{'invisible': [('type', '!=', 'calendario')], 'required': [('type', '=', 'calendario')],}"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    </group>
                </group>
                <group>
                    <field name="descripcion_cumplimiento"/>
                </group>
                <footer>
                    <button name="generar_reporte" string="Imprimir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_cumplimiento_action" model="ir.actions.act_window">
        <field name="name">Cumplimiento del Plan de Trabajo</field>
        <field name="res_model">calendar.cumplimiento.reporte</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reporte_calendar_cumplimiento_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
