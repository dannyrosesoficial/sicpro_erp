<odoo>
  <data noupdate="0">
    <record id="calendar.ir_cron_scheduler_alarm" model="ir.cron">
      <field name="name">Plan Actividades: Recordatorios de Eventos</field>
      <field name="model_id" ref="calendar.model_calendar_alarm_manager"/>
      <field name="state">code</field>
      <field name="code">model._send_reminder()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
    </record>
  </data>
</odoo>