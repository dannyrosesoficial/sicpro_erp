<templates xml:space="preserve">

    <t t-name="sicpro_modulo_vistas_split.SplitViewContainer" t-inherit="web.ListView" t-inherit-mode="extension"
       owl="1">
        <xpath expr="//Layout" position="attributes">
            <attribute name="className"
                       add="(state.splitViewEnabled ? ' o_list_view_split' : '') + (state.splitViewEnabled and state.splitViewMode == 'vertical' ? ' o_list_view_split_vertical' : '')"
                       separator=" + "/>
        </xpath>

      <xpath expr="//t[@t-component='props.Renderer']" position="after">
            <t t-if="state.splitViewEnabled and state.selectedRecordId">
                <div class="o_split_view_resizer" t-on-mousedown="onResizeStart"/>
              <div class="o_split_view_pane"
                   t-att-class="{ 'o_split_view_vertical': state.splitViewMode == 'vertical' }">
                    <View t-props="getSplitViewProps()" t-key="state.selectedRecordId"/>
                </div>
            </t>
        </xpath>

      <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <div class="btn-group o_split_view_dropdown me-2">
                    <button type="button"
                            class="btn btn-light o_switch_view o_split_view_button"
                            t-att-class="{ active: state.splitViewEnabled }"
                            t-on-click="toggleSplitView"
                            title="Alternar vista dividida">
                        <i class="fa fa-columns"/>
                    </button>
                  <button type="button" class="btn btn-light dropdown-toggle dropdown-toggle-split"
                          data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.setSplitMode('horizontal')">Split Horizontal</a></li>
                    <li><a class="dropdown-item" href="#" t-on-click.prevent="() => this.setSplitMode('vertical')">Split Vertical</a></li>
                    </ul>
                </div>
            </t>
        </xpath>
    </t>

</templates>
