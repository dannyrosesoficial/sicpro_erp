<odoo>
  <data noupdate="0">
    <!-- Cron para actualizar los correos de los trabajadores en los servicios internos -->
    <record id="servicios_internos_correos_ldap" model="ir.cron">
      <field name="name">Servicios Internos: Actualizar Correos con LDAP</field>
      <field name="model_id" ref="sicpro_modulo_ldap_servicios_internos.model_sicpro_app_servicios_internos_correos"/>
      <field name="state">code</field>
      <field name="code">model.cron_correo_ldap_servicios_internos()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
    </record>
  </data>
</odoo>
