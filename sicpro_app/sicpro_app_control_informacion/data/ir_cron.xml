<odoo>
  <data noupdate="0">
    <!-- Cron para generar y controlar el envío de las informaciones -->
    <record id="cron_control_informaciones" model="ir.cron">
      <field name="name">Control Informativo: Control de la información</field>
      <field name="model_id"
             ref="sicpro_app_control_informacion.model_sicpro_app_control_informacion_control_actividades"/>
      <field name="state">code</field>
      <field name="code">model.cron_control_informaciones()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
    </record>
  </data>
</odoo>
