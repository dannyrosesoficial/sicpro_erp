<odoo>
  <record id="control_informacion_etiquetas_list" model="ir.ui.view">
    <field name="name">sicpro.app.control.informacion.etiquetas.list</field>
    <field name="model">sicpro.app.control.informacion.etiquetas</field>
    <field name="arch" type="xml">
      <list string="Etiquetas" editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="control_informacion_etiquetas_action" model="ir.actions.act_window">
    <field name="name">Etiquetas</field>
    <field name="res_model">sicpro.app.control.informacion.etiquetas</field>
    <field name="view_id" ref="control_informacion_etiquetas_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear etiquetas para el control de información
      </p>
    </field>
  </record>
</odoo>
