<odoo>
  <record id="control_informacion_actividades_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.control.informacion.actividad.kanban</field>
    <field name="model">sicpro.app.control.informacion.actividad</field>
    <field name="priority" eval="50"/>
    <field name="arch" type="xml">
      <kanban highlight_color="color" class="oe_background_grey o_kanban_dashboard" create="0">
        <field name="name"/>
        <field name="color"/>
        <field name="gestores"/>
        <field name="cuenta_mes_actual"/>
        <field name="cuenta_enviados"/>
        <field name="cuenta_pendientes"/>
        <field name="cuenta_validados"/>
        <field name="cuenta_atrasados"/>
        <templates>
          <t t-name="menu">
            <div class="container">
              <div class="row">
                <div class="col-6">
                  <h5 role="menuitem" class="dropdown-header">Opciones</h5>
                  <a role="menuitem" type="open" class="dropdown-item">Abrir</a>
                  <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">
                    Editar</a>
                </div>
                <div class="col-6">
                  <h5 role="menuitem" class="dropdown-header">Color</h5>
                  <ul class="oe_kanban_colorpicker" data-field="color"/>
                </div>
              </div>
            </div>
          </t>

          <t t-name="card">
            <div t-attf-class="oe_kanban_color_#{record.color.raw_value || 0} oe_kanban_global_click_edit">
              <div class="o_kanban_card_header">
                <div class="o_kanban_card_header_title">
                  <div class="o_primary">
                    <a name="%(control_informacion_actividades_control_action)d" type="action"
                       class="fw-bold">
                      <field name="name"/>
                    </a>
                  </div>
                </div>
                <div class="o_kanban_manage_button_section">
                  <a class="o_kanban_manage_toggle_button" href="#" data-bs-toggle="dropdown">
                    <i class="fa fa-ellipsis-v" title="Opciones"/>
                  </a>
                </div>
              </div>

              <div class="container o_kanban_card_content mt-2">
                <div class="row">
                  <div class="col-5 o_kanban_primary_left d-flex align-items-center justify-content-center">
                    <button class="btn btn-primary w-100"
                            name="%(control_informacion_actividades_control_action)d"
                            type="action"
                            t-att-context="{'search_default_filter_mes_actual': 1, 'search_default_filter_anio_actual': 1}">
                      <div class="fs-4 fw-bold"><t
                          t-esc="record.cuenta_mes_actual.value || 0"/></div>
                      <div class="small">Mes Actual</div>
                    </button>
                  </div>

                  <div class="col-7 o_kanban_primary_right border-start">
                    <div class="row g-0">
                      <div class="col-9">
                        <a name="%(control_informacion_actividades_control_action)d"
                           type="action"
                           class="text-warning small fw-bold"
                           t-att-context="{'search_default_filter_mes_actual': 1, 'search_default_pendiente': 1}">
                          Pendientes
                        </a>
                      </div>
                      <div class="col-3 text-end">
                        <t t-esc="record.cuenta_pendientes.value || 0"/>
                      </div>
                    </div>
                    <div class="row g-0">
                      <div class="col-9">
                        <a name="%(control_informacion_actividades_control_action)d"
                           type="action"
                           class="text-dark small fw-bold"
                           t-att-context="{'search_default_filter_mes_actual': 1, 'search_default_enviados': 1}">
                          Enviados
                        </a>
                      </div>
                      <div class="col-3 text-end">
                        <t t-esc="record.cuenta_enviados.value || 0"/>
                      </div>
                    </div>
                    <div class="row g-0">
                      <div class="col-9">
                        <a name="%(control_informacion_actividades_control_action)d"
                           type="action"
                           class="text-success small fw-bold"
                           t-att-context="{'search_default_filter_mes_actual': 1, 'search_default_validado': 1}">
                          Validados
                        </a>
                      </div>
                      <div class="col-3 text-end">
                        <t t-esc="record.cuenta_validados.value || 0"/>
                      </div>
                    </div>
                    <div class="row g-0">
                      <div class="col-9">
                        <a name="%(control_informacion_actividades_control_action)d"
                           type="action"
                           class="text-danger small fw-bold"
                           t-att-context="{'search_default_filter_mes_actual': 1, 'search_default_atrasado': 1}">
                          Atrasados
                        </a>
                      </div>
                      <div class="col-3 text-end">
                        <t t-esc="record.cuenta_atrasados.value || 0"/>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="control_informacion_actividades_dashboard_action" model="ir.actions.act_window">
    <field name="name">Control Informativo</field>
    <field name="res_model">sicpro.app.control.informacion.actividad</field>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="control_informacion_actividades_kanban"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear nueva actividad
      </p>
    </field>
  </record>
</odoo>
