<?xml version="1.0"?>
<odoo>

    <!-- Inicio de las Vistas del modal para el motivo de devolución -->
    <record id="motivos_devolucion_form" model="ir.ui.view">
        <field name="name">sicpro.app.control.informacion.devueltas.form</field>
        <field name="model">sicpro.app.control.informacion.devueltas</field>
        <field name="priority">60</field>
        <field name="arch" type="xml">
            <form string="Motivo de devolución">
                <group class="oe_title">
                    <field name="motivo_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="detalles"/>
                </group>
                <footer>
                    <button name="action_motivo_devolucion" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="motivos_devolucion_action" model="ir.actions.act_window">
        <field name="name">Motivo de la devolución</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.control.informacion.devueltas</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="motivos_devolucion_form"/>
        <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para el motivo de devolución -->


    <record id="control_informaciones_search" model="ir.ui.view">
        <field name="name">sicpro.app.control.informacion.search</field>
        <field name="model">sicpro.app.control.informacion</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name"/>
                <field name="anio" string="Año"/>
                <field name="etiquetas_ids" string="Etiquetas" filter_domain="[('etiquetas_ids', 'ilike', self)]"/>
                <separator/>
                <filter string="Informaciones en proceso" name="pendiente_enviada"
                        domain="[('estado', 'in', ['pendiente','enviado'])]"/>
                <separator/>
                <separator/>
                <filter string="Fecha de Entrega" name="fecha_entrega" date="fecha_entrega"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Devueltas" name="devueltas" domain="[('estado', '=', 'devuelto')]"/>
                <filter string="Validado" name="validado" domain="[('estado', '=', 'validado')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Información" name="name" context="{'group_by':'name'}"/>
                    <filter string="Motivo de Devolución" name="devolucion_motivo"
                            context="{'group_by':'devolucion_motivo'}"/>
                    <filter string="Proceso" name="proceso" context="{'group_by':'company_id'}"/>
                    <filter string="Área Informativa" name="area" context="{'group_by':'area'}"/>
                    <filter string="Estado" name="estado" context="{'group_by':'estado'}"/>
                    <filter string="Mes" name="mes" context="{'group_by':'mes'}"/>
                    <filter string="Usuario" name="user_id" context="{'group_by':'user_id'}"/>
                    <separator orientation="vertical"/>
                    <filter string="Fecha de Entrega" context="{'group_by':'fecha_entrega:month'}" name="month"/>
                    <filter string="Fecha de Requerida" context="{'group_by':'fecha_requerida:month'}" name="month"/>
                    <filter string="Año" context="{'group_by':'anio'}" name="month"/>
                </group>
            </search>
        </field>
    </record>

    <record id="control_informaciones_form" model="ir.ui.view">
        <field name="name">sicpro.app.control.informacion.form</field>
        <field name="model">sicpro.app.control.informacion</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form class="o_lead_opportunity_form">
                <header>
                    <button name="action_enviar_info" string="Enviar información" type="object" class="oe_highlight"
                            groups="sicpro_app_control_informacion.grupo_control_informacion_ejecutor"
                            attrs="{'invisible': ['|', ('active', '=', False), ('estado', '!=','pendiente',) ,]}"/>

                    <button name="%(motivos_devolucion_action)d" string="Devolver información" type="action"
                            groups="sicpro_app_control_informacion.grupo_control_informacion_revision"
                            attrs="{'invisible': ['|', ('active', '=', False), ('estado', '!=','enviado'), ]}"/>

                    <button name="action_validar_info" string="Validar información" type="object" class="oe_highlight"
                            groups="sicpro_app_control_informacion.grupo_control_informacion_revision"
                            attrs="{'invisible': ['|', ('active', '=', False), ('estado', '!=', 'enviado')]}"/>

                    <button name="%(motivos_devolucion_action)d" string="Solicitar nueva información" type="action"
                            class="oe_highlight"
                            groups="sicpro_app_control_informacion.grupo_control_informacion_revision"
                            attrs="{'invisible': ['|', ('active', '=', False), ('estado', '!=', 'validado')]}"/>

                    <field name="estado" widget="statusbar" options="{'clickable': '0'}" readonly="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_empaty_documentos" type="object" class="oe_stat_button" icon="fa-archive">
                            <field string="Documentos" name="doc_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-cubes" name="action_empaty_version" type="object">
                            <field name="version" widget="statinfo" string="Versión"/>
                        </button>
                    </div>
                    <field name="readonly_admin" invisible="1"/>
                    <field name="id" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="anio" invisible="1"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <widget name="web_ribbon" title="Devuelto" bg_color="bg-warning"
                            attrs="{'invisible': [('estado', '!=', 'devuelto')]}"/>
                    <field name="mes" class="oe_avatar font-weight-bold oe_read_only"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Organo Colegiado o Actividad"/>
                        <h1><field name="name" attrs="{'readonly':[('estado','!=','pendiente')]}"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </h1>
                        <h4>
                            <field name="descripcion"/>
                        </h4>
                    </div>
                    <group>
                        <group>
                            <field name="user_id" readonly="0"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="company_id" invisible="1"/>
                            <field name="area" class="oe_read_only"/>
                        </group>
                        <group>
                            <field name="fecha_requerida"/>
                            <field name="fecha_entrega" readonly="1"/>
                            <field name="etiquetas_ids" widget="many2many_tags"
                                   attrs="{'readonly':[('estado','in', ['devuelto', 'validado'])]}"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>
                        </group>
                    </group>

                    <group string="Documentación Digital" attrs="{'invisible':[('id','=', False)]}">
                        <field name="documentos_ids" widget="many2many_binary" class="o_Attachment_image"
                               attrs="{'readonly':[('estado','!=','pendiente')]}"/>
                    </group>

                    <group>
                        <field name="observaciones" nolabel='1'
                               attrs="{'readonly':[('estado','in', ['devuelto', 'validado'])]}"
                               placeholder="Añadir una observación sobre la información…"/>
                    </group>

                    <group string="Devolución" attrs="{'invisible': [('estado', '!=', 'devuelto')]}">
                        <group>
                            <field name="devolucion_motivo" readonly="1"/>
                        </group>
                        <group>
                            <field name="devolucion_user_id" readonly="1"/>
                            <field name="devolucion_fecha" readonly="1"/>
                        </group>
                        <field name="devolucion_detalles" readonly="1"/>
                    </group>

                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="control_informaciones_tree" model="ir.ui.view">
        <field name="name">sicpro.app.control.informacion.tree</field>
        <field name="model">sicpro.app.control.informacion</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <tree string="Control de la Información" decoration-bf="1" decoration-danger="estado == 'devuelto'"
                  decoration-warning="estado == 'pendiente'" decoration-success="estado == 'validado'">
                <field name="area"/>
                <field name="mes"/>
                <field name="estado"/>
                <field name="name"/>
                <field name="fecha_requerida"/>
                <field name="fecha_entrega"/>
                <field name="observaciones"/>
                <field name="version"/>
                <field name="documentos_ids" string="Documentos" widget="many2many_binary" class="o_Attachment_image"
                       optional="hide"/>
                <field name="devolucion_motivo" optional="hide"/>
                <field name="devolucion_user_id" optional="hide"/>
                <field name="devolucion_fecha" optional="hide"/>
                <field name="devolucion_detalles" optional="hide"/>
                <field name="anio" invisible="0"/>
            </tree>
        </field>
    </record>

    <record id="control_informaciones_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.control.informacion.kanban</field>
        <field name="model">sicpro.app.control.informacion</field>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" group_create="false" group_delete="false" group_edit="false"
                    class="o_kanban_small_column o_kanban_project_tasks"
                    archivable="false">
                <field name="id"/>
                <field name="estado" readonly="True"/>
                <field name="name"/>
                <field name="etiquetas_ids"/>
                <field name="user_id"/>
                <field name="message_needaction_counter"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>
                <field name="etiquetas_ids"/>
                <field name="mes"/>
                <field name="identificador_corto"/>
                <progressbar field="activity_state"
                             colors="{&quot;planned&quot;: &quot;success&quot;, &quot;today&quot;: &quot;warning&quot;, &quot;overdue&quot;: &quot;danger&quot;}"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title oe_partner_heading font-weight-bold">
                                    <field name="name"/></strong>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li class="font-weight-bold text-danger">Requerido: <field
                                            name="fecha_requerida"/></li>
                                    <li class="font-weight-bold">Enviado: <field name="fecha_entrega"/></li>
                                    <li t-if="record.etiquetas_ids.raw_value">
                                        <field name="etiquetas_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </li>
                                </ul>
                                <div class="oe_kanban_partner_links"/>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="mes"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <div class="font-weight-bold">
                                                <field name="identificador_corto"/>
                                            </div>
                                            <field name="activity_ids" widget="kanban_activity"/>
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="oe_clear"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="control_informaciones_activity" model="ir.ui.view">
        <field name="name">sicpro.app.control.informacion.activity</field>
        <field name="model">sicpro.app.control.informacion</field>
        <field name="arch" type="xml">
            <activity string="Control de la información">
                <field name="name"/>
                <field name="estado"/>
                <templates>
                    <div t-name="activity-box">
                        <field name="user_id" widget="many2one_avatar_user"/><div>
                        <field name="name" display="full"/>
                        <field name="estado" display="full" muted="1"/>
                    </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record model="ir.actions.act_window" id="control_informaciones_action">
        <field name="name">Control de la Información</field>
        <field name="res_model">sicpro.app.control.informacion</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="view_id" ref="control_informaciones_form"/>
        <field name="search_view_id" ref="control_informaciones_search"/>
        <field name="context">
            {'search_default_anio': (context_today().strftime('%Y'))}
        </field>
    </record>

        <record model="ir.actions.act_window" id="control_informaciones_control_action">
        <field name="name">Control de la Información</field>
        <field name="res_model">sicpro.app.control.informacion</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="view_id" ref="control_informaciones_form"/>
        <field name="search_view_id" ref="control_informaciones_search"/>
    </record>

    <record id="control_informaciones_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="control_informaciones_tree"/>
        <field name="act_window_id" ref="control_informaciones_action"/>
    </record>

    <record id="control_informaciones_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="control_informaciones_kanban"/>
        <field name="act_window_id" ref="control_informaciones_action"/>
    </record>


</odoo>