<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>
    <!-- Creo la categoría de Administración General -->
    <record id="modulo_categoria_administracion_general" model="ir.module.category">
        <field name="name">Administración SICPRO ERP</field>
        <field name="description">Módulo para el acceso a los tableros de mando del sistemas SICPRO.</field>
        <field name="sequence" >1</field>
    </record>

    <!-- Creo la categoría de SICPRO Administración -->
    <record id="modulo_categoria_administracion" model="ir.module.category">
        <field name="name">Administración</field>
        <field name="description">Módulo para el control de los sistemas SICPRO.</field>
        <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_administracion_general"/>
        <field name="sequence" >1</field>
    </record>

    <record id="grupo_app_administracion_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="modulo_categoria_administracion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>


     <!-- Creo la categoría de notificaciones de la  Administración -->
    <record id="modulo_categoria_notificaciones_administracion" model="ir.module.category">
        <field name="name">Notificaciones</field>
        <field name="description">Módulo para el control de los sistemas SICPRO.</field>
        <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_administracion_general"/>
        <field name="sequence">2</field>
    </record>

    <record id="grupo_app_administracion_notificaciones" model="res.groups">
        <field name="name">Notificar</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="modulo_categoria_notificaciones_administracion"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

     <!-- Creo la categoría de acceso a los canales de comunicación -->
    <record id="modulo_categoria_canales" model="ir.module.category">
        <field name="name">Accesos a Canales de Comunicación</field>
        <field name="description">Módulo para otorgar el acceso a los canales de comunicación en el sistema.</field>
        <field name="sequence" >1</field>
    </record>

    <record id="grupo_canal_staff" model="res.groups">
        <field name="name">Canal del STAFF</field>
        <field name="comment">Permisos al Canal del STAFF</field>
        <field name="category_id" ref="modulo_categoria_canales"/>
    </record>
    <record id="grupo_canal_proyectos" model="res.groups">
        <field name="name">Canal de Proyectos</field>
        <field name="comment">Permisos al Canal de Proyectos</field>
        <field name="category_id" ref="modulo_categoria_canales"/>
    </record>
    <record id="grupo_canal_deoct" model="res.groups">
        <field name="name">Canal de DEOCT</field>
        <field name="comment">Permisos al Canal de DEOCT</field>
        <field name="category_id" ref="modulo_categoria_canales"/>
    </record>
    <record id="grupo_canal_deoit" model="res.groups">
        <field name="name">Canal de DEOIT</field>
        <field name="comment">Permisos al Canal de DEOIT</field>
        <field name="category_id" ref="modulo_categoria_canales"/>
    </record>


