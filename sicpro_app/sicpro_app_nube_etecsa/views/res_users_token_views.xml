<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crear_token_wizard_view" model="ir.ui.view">
        <field name="name">Crear Token</field>
        <field name="model">sicpro.app.nube.etecsa.token</field>
        <field name="arch" type="xml">
            <form string="Crear Token">
                <group>
                    <group>
                        <field name="usuario" readonly="1"/>
                    </group>
                    <group>
                        <field name="password" required="True" password="True"/>
                    </group>
                </group>
                <footer>
                    <button string="Generar" name="buscar_token" type="object" class="btn-primary fa fa-search-plus"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="crear_token_wizard_action" model="ir.actions.act_window">
        <field name="name">Crear Token</field>
        <field name="res_model">sicpro.app.nube.etecsa.token</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
