<templates xml:space="preserve">

    <t t-name="odoo_fullscreen_mode.Fullscreen">
        <div class="d-flex align-items-center">
            <button t-if="!state.isFullscreen"
                    class="o-dropdown dropdown-toggle mx-1"
                    t-att-title="'Expandir Pantalla'"
                    t-on-click="toggleFullscreen">
                <i class="fa fa-expand" title="Expandir Pantalla" aria-label="Expandir Pantalla"/>
            </button>

          <button t-else=""
                  class="o-dropdown dropdown-toggle mx-1"
                  t-att-title="'Minimizar Pantalla'"
                  t-on-click="toggleFullscreen">
                <i class="fa fa-compress" title="Minimizar Pantalla" aria-label="Minimizar Pantalla"/>
            </button>
        </div>
    </t>

</templates>
