<?xml version="1.0"?>
<odoo>


    <record id="note_tableros_tag_view_tree" model="ir.ui.view">
        <field name="name">tableros.note.tag.tree</field>
        <field name="model">note.tag</field>
        <field name="inherit_id" ref="note.note_tag_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="color" widget="color_picker"/>
            </xpath>
        </field>
    </record>


</odoo>
