<?xml version="1.0"?>
<odoo>


    <record id="view_tableros_note_stage_tree" model="ir.ui.view">
        <field name="name">tableros.note.stage.tree</field>
        <field name="model">note.stage</field>
        <field name="inherit_id" ref="note.view_note_stage_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="tableros_id"/>
            </xpath>
        </field>
    </record>


</odoo>
