<odoo>
    <data>
        <record id="sicpro_backup_eliminacion_wizard_view" model="ir.ui.view">
            <field name="name">sicpro.backup.eliminacion.form</field>
            <field name="model">sicpro.backup.eliminacion</field>
            <field name="arch" type="xml">
                <form string="Backup Process Deletion Confirmation">
                    <sheet>
                        <field name="message" readonly="1"/>
                    </sheet>
                    <footer class="d-flex justify-content-end">
                        <button string="Cancel" class="btn-default" special="cancel"  />
                        <button string='Delete' name="action_delete_backup_detail" type="object" class="btn-primary me-2" widget="many2many_buttons"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sicpro_backup_eliminacion_wizard" model="ir.actions.act_window">
            <field name="name">Backup Details Deletion Confirmation</field>
            <field name="res_model">sicpro.backup.eliminacion</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sicpro_backup_eliminacion_wizard_view"/>
            <field name="context">{'default_backup_id': active_id}</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
