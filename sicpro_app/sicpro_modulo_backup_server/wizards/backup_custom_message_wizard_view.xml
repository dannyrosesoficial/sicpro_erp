<odoo>
    <data>
        <record id="sicpro_backup_mensaje_wizard_view" model="ir.ui.view">
            <field name="name">sicpro.backup.mensaje.wizard.form</field>
            <field name="model">sicpro.backup.mensaje.wizard</field>
            <field name="arch" type="xml">
                <form string="Backup Custom Message">
                    <sheet>
                        <field name="message" />
                    </sheet>
                    <footer class="d-flex justify-content-end">
                        <button string="OK" class="btn btn-primary" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sicpro_backup_mensaje_wizard" model="ir.actions.act_window">
            <field name="name">Message</field>
            <field name="res_model">sicpro.backup.mensaje.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sicpro_backup_mensaje_wizard_view"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
