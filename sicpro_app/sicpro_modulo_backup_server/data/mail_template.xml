<odoo>
  <data noupdate="0">
    <record id="sicpro_modulo_backup_server.backup_failure_template" model="mail.template">
      <field name="name">Correo electrónico de error en la copia de seguridad de la base de datos</field>
      <field name="email_from">{{ (user.company_id.email_formatted or user.email_formatted) }}</field>
      <field name="subject">Fallo en el proceso de copia de seguridad de la base de datos</field>
      <field name="model_id" ref="sicpro_modulo_backup_server.model_sicpro_backup_local_detalles"/>
      <field name="auto_delete" eval="False"/>
      <field name="lang">{{user.partner_id.lang}}</field>
      <field name="body_html" type="html">
        <div style="margin: 0px; padding: 0px;">
          Querido Admin,
          <br/>
          <p>Saludos</p>
          <p>La creación de la copia de seguridad.
            <strong>
              <t t-esc="object.sicpro_backup_local_id.name"/>
            </strong>
            ha sido fallida.
          </p>
          <p>Error:
            <br/>
            <pre>
              <t t-esc="object.message"/>
            </pre>
          </p>
          <p>Gracias</p>
        </div>
      </field>
    </record>
  </data>
</odoo>
