<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_solicitudes_soporte_bitacora_form" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.soporte.bitacora.form</field>
        <field name="model">sicpro.app.soporte.bitacora</field>
        <field name="inherit_id" ref="sicpro_app_soporte.view_soporte_bitacora_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="cerrar_ticket_solicitud" string="Cerrar Ticket" type="object" class="oe_highlight"
                            attrs="{'invisible': [('ticket_cerrado', '=', True)]}"/>
            </xpath>
            <xpath expr="//group[@name='consecutivo']" position="inside">
                <label for="numero_consecutivo"/>
                <div>
                    <field name="ticket_cerrado" invisible="1"/>
                    <field name="numero_consecutivo" string="No. Solicitud" class="oe_inline"/>
                    <button type="object" name="ver_solicitud" class="btn-sm btn-link mb4 fa fa-bullhorn"
                            aria-label="Ver Solicitud" title="Ver Solicitud"/>
                </div>
            </xpath>
        </field>
    </record>


</odoo>
