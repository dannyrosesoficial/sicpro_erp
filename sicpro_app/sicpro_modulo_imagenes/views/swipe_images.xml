<odoo>
    <data>
        <!-- BACKEND swipe images -->
        <template id="assets_backend_imagen" inherit_id="web.assets_backend">
            <xpath expr="." position="inside">
                    <link rel="stylesheet" href="/sicpro_modulo_imagenes/static/src/libs/jQuery.Brazzers-Carousel.css" />
