<!-- Agregar función de clic en el widget de imagen -->
<template id="template" xml:space="preserve">
        <t t-name="sicpro_modulo_imagenes.image" t-inherit="web.ImageField" t-inherit-mode="extension" owl="1">
            <xpath expr="//img" position="attributes">
                <attribute name="t-on-click">img_click</attribute>
            </xpath>
        </t>
    </template>
