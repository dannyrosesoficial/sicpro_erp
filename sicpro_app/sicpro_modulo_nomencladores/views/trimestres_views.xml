<odoo>
  <record id="trimestre_filter_view" model="ir.ui.view">
    <field name="name">Buscar Trimestre</field>
    <field name="model">sicpro.nomenclador.trimestre</field>
    <field name="arch" type="xml">
      <search string="Buscar Trimestre">
        <field name="name" string="Trimestre"/>
        <field name="descripcion" string="Descripción"/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
      </search>
    </field>
  </record>

  <record id="trimestre_list_view" model="ir.ui.view">
    <field name="name">trimestre.list.view</field>
    <field name="model">sicpro.nomenclador.trimestre</field>
    <field name="arch" type="xml">
      <list string="Estado de Trimestre" editable="bottom">
        <field name="name"/>
        <field name="descripcion"/>
        <field name="active" invisible="1"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="action_trimestre" model="ir.actions.act_window">
    <field name="name">Estado de Trimestre</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.nomenclador.trimestre</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
