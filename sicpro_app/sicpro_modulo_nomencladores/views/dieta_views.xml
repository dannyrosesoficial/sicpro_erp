<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

     <!--vista formulario-->
    <record id="nomenclador_dieta_form_view" model="ir.ui.view">
        <field name="name">nomenclado.dieta.form.view</field>
        <field name="model">sicpro.nomenclador.dieta</field>
        <field name="arch" type="xml">
            <form string="Dieta">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


     <!--vista arbol-->
    <record id="nomenclador_dieta_tree_view" model="ir.ui.view">
        <field name="name">nomenclador.dieta.tree.view</field>
        <field name="model">sicpro.nomenclador.dieta</field>
        <field name="arch" type="xml">
            <tree string="Dieta"  editable="bottom">
                <field name="name"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <!--Busqueda-->
    <record id="nomenclador_dieta_filter_view" model="ir.ui.view">
       <field name="name">Buscar Dieta</field>
       <field name="model">sicpro.nomenclador.dieta</field>
        <field name="arch" type="xml">
            <search string="Buscar Dieta">
            <field name="name"/>
            <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        </search>
       </field>
    </record>

    <!--Acción-->
    <record id="action_nomenclador_dieta" model="ir.actions.act_window">
        <field name="name">Dieta</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.nomenclador.dieta</field>
        <field name="view_mode">tree,form</field>
    </record>


    </data>
</odoo>