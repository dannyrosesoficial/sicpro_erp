<odoo>
  <record id="nomenclador_areas_filter_view" model="ir.ui.view">
    <field name="name">Buscar Área de Empresa</field>
    <field name="model">sicpro.nomenclador.areas.empresa</field>
    <field name="arch" type="xml">
      <search string="Buscar Área de Empresa">
        <field name="name" string="Área de Empresa"/>
        <field string="Descripción" name="descripcion"/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
      </search>
    </field>
  </record>

  <record id="nomenclador_areas_list_view" model="ir.ui.view">
    <field name="name">nomenclador.areas.list.view</field>
    <field name="model">sicpro.nomenclador.areas.empresa</field>
    <field name="arch" type="xml">
      <list string="Área de Empresa" editable="bottom">
        <field name="name"/>
        <field name="descripcion"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="action_nomenclador_areas" model="ir.actions.act_window">
    <field name="name">Área de Empresa</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.nomenclador.areas.empresa</field>
    <field name="view_mode">list</field>
  </record>
</odoo>


