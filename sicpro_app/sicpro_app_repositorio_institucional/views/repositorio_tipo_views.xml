<odoo>
  <record id="view_repositorio_institucional_tipo_list" model="ir.ui.view">
    <field name="name">sicpro.app.repo.tipo.list</field>
    <field name="model">sicpro.app.repo.tipo</field>
    <field name="arch" type="xml">
      <list string="Tipos de repositorios" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="descripcion"/>
      </list>
    </field>
  </record>

  <record id="action_view_repositorio_institucional_tipo" model="ir.actions.act_window">
    <field name="name">Tipos de repositorios</field>
    <field name="res_model">sicpro.app.repo.tipo</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
