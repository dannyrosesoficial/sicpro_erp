<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de Árbol (Tree) para Tipos de Repositorio -->
        <record id="view_repositorio_institucional_tipo_tree" model="ir.ui.view">
            <field name="name">sicpro.app.repo.tipo.tree</field>
            <field name="model">sicpro.app.repo.tipo</field>
            <field name="arch" type="xml">
                <tree string="Tipos de repositorios" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="descripcion"/>
                </tree>
            </field>
        </record>

        <!-- Acción de Ventana (Action Window) para Tipos de Repositorio -->
        <record id="action_view_repositorio_institucional_tipo" model="ir.actions.act_window">
            <field name="name">Tipos de repositorios</field>
            <field name="res_model">sicpro.app.repo.tipo</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>