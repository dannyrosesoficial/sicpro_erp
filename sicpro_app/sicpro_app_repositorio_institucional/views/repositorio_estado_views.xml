<odoo>
  <record id="view_repositorio_institucional_estado_list" model="ir.ui.view">
    <field name="name">sicpro.app.repo.estados.list</field>
    <field name="model">sicpro.app.repo.estados</field>
    <field name="arch" type="xml">
      <list string="Estado" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="requirements"/>
        <field name="is_inicial"/>
        <field name="is_won"/>
        <field name="is_cancelado"/>
        <field name="fold"/>
      </list>
    </field>
  </record>

  <record id="action_view_repositorio_institucional_estado" model="ir.actions.act_window">
    <field name="name">Estados</field>
    <field name="res_model">sicpro.app.repo.estados</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
