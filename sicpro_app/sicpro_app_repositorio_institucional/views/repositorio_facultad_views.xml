<odoo>
  <record id="view_repositorio_institucional_facultad_list" model="ir.ui.view">
    <field name="name">sicpro.app.repo.facultad.list</field>
    <field name="model">sicpro.app.repo.facultad</field>
    <field name="arch" type="xml">
      <list string="Institución" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="parent_id"/>
        <field name="repositorio_ids" invisible="1"/>
        <field name="descripcion"/>
      </list>
    </field>
  </record>

  <record id="action_view_repositorio_institucional_facultad" model="ir.actions.act_window">
    <field name="name">Instituciones</field>
    <field name="res_model">sicpro.app.repo.facultad</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
