<odoo>
  <record id="view_repositorio_institucional_licencia_list" model="ir.ui.view">
    <field name="name">sicpro.app.repo.licencia.list</field>
    <field name="model">sicpro.app.repo.licencia</field>
    <field name="arch" type="xml">
      <list string="Licencias" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="siglas"/>
        <field name="url" widget="url"/>
        <field name="description"/>
      </list>
    </field>
  </record>

  <record id="action_view_repositorio_institucional_licencia" model="ir.actions.act_window">
    <field name="name">Licencias</field>
    <field name="res_model">sicpro.app.repo.licencia</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
