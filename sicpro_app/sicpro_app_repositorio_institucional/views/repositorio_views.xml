<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Vista de Búsqueda (Search) -->
        <record id="view_repositorio_institucional_search" model="ir.ui.view">
            <field name="name">sicpro.app.repo.search</field>
            <field name="model">sicpro.app.repo</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="parent_id"/>
                    <filter name="filter_is_root" string="Directorios" domain="[('parent_id', '=', False)]"/>
                    <group>
                        <filter name="group_by_parent_id" string="Carpeta" context="{'group_by': 'parent_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Vista de Lista (Tree) -->
        <record id="view_repositorio_institucional_tree" model="ir.ui.view">
            <field name="name">sicpro.app.repo.tree</field>
            <field name="model">sicpro.app.repo</field>
            <field name="arch" type="xml">
                <tree string="Elementos del Repositorio" default_order="sequence, id">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="tipo"/>
                    <field name="fecha_publicacion"/>
                    <field name="stage_id" widget="badge"/>
                    <field name="parent_full_name" invisible="'default_parent_id' in context"/>
                    <field name="child_count" optional="show"/>
                    <field name="create_uid"/>
                    <field name="create_date"/>
                    <field name="write_uid"/>
                    <field name="write_date"/>
                </tree>
            </field>
        </record>

        <!-- Vista Kanban -->
        <record id="view_repositorio_institucional_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.repo.kanban</field>
            <field name="model">sicpro.app.repo</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_document">
                    <field name="id"/>
                    <field name="color"/>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="create_uid"/>
                    <field name="write_date"/>
                    <field name="child_count"/>
                    <field name="doc_carpeta"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="#{kanban_color(record.color.raw_value)}">
                                <div class="o_dropdown_kanban dropdown">
                                    <a role="button" class="dropdown-toggle o-no-caret btn" data-toggle="dropdown"
                                       data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                        <span class="fa fa-ellipsis-v"/>
                                    </a>
                                    <div class="dropdown-menu" role="menu">
                                        <a role="menuitem" type="open" class="dropdown-item">Abrir</a>
                                        <a t-if="widget.editable" role="menuitem" type="edit" class="dropdown-item">
                                            Editar</a>
                                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">
                                            Eliminar</a>
                                        <div role="separator" class="dropdown-divider"/>
                                        <ul class="oe_kanban_colorpicker" data-field="color"/>
                                    </div>
                                </div>
                                <div t-attf-class="oe_kanban_content">
                                    <t t-if="record.doc_carpeta.raw_value == 'carpeta'">
                                        <!-- LO QUE MUESTRA UNA CARPETA -->
                                        <div class="o_kanban_image">
                                            <a type="object" name="action" t-attf-data-context="{'module_action_id':
        'sicpro_app_repositorio_institucional.repositorio_institucional_carpetas_view_action', 'search_default_parent_id':
         {{record.id.raw_value}}, 'default_parent_id': {{record.id.raw_value}}}"
                                               title="Entrar" role="button">
                                                <span class="badge badge-dark"><t
                                                        t-esc="record.child_count.raw_value || ''"/></span>
                                                <img src="/sicpro_app_repositorio_institucional/static/description/carpeta.png"
                                                     alt="icon"/>
                                            </a>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <!-- LO QUE MUESTRA UN DOCUMENTO (si no es carpeta) -->
                                        <div class="o_kanban_image">
                                            <a type="open" title="Entrar">
                                                <img src="/sicpro_app_repositorio_institucional/static/description/documento.png"
                                                     alt="icon"/>
                                            </a>
                                        </div>
                                    </t>
                                    <div class="oe_kanban_details">
                                        <ul>
                                            <div class="oe_kanban_details d-flex justify-content-between">
                                                <div class="o_kanban_left">
                                                    <t t-if="record.doc_carpeta.raw_value != 'carpeta'">
                                                        <h3 class="text-danger">
                                                            <li>
                                                                <a type="open" t-att-title="record.name.value">
                                                                    <strong><t t-esc="record.name.value"/></strong>
                                                                </a>
                                                            </li>
                                                        </h3>
                                                    </t>
                                                    <t t-else="">
                                                        <h5 class="text-success">
                                                            <li>
                                                                <a type="open" t-att-title="record.name.value">
                                                                    <strong><t t-esc="record.name.value"/></strong>
                                                                </a>
                                                            </li>
                                                        </h5>
                                                    </t>
                                                </div>
                                                <div class="o_kanban_right">
                                                    <!-- Solo muestra el estado si NO es una carpeta -->
                                                    <t t-if="record.doc_carpeta.raw_value != 'carpeta'">
                                                        <field name="stage_id" widget="label_selection"
                                                               options="{'clickable': true}"/>
                                                    </t>
                                                </div>
                                            </div>

                                            <li t-if="record.description.value">
                                                <t t-esc="record.description.value"/>
                                            </li>
                                        </ul>
                                        <div class="o_kanban_record_bottom">
                                            <div class="oe_kanban_bottom_left">
                                                <div>
                                                    <span class="o_value">Gestor del repositorio:</span>
                                                </div>
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <field name="create_uid" widget="many2one_avatar_user"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista de Formulario (Form) -->
        <record id="view_repositorio_institucional_form" model="ir.ui.view">
            <field name="name">sicpro.app.repo.form</field>
            <field name="model">sicpro.app.repo</field>
            <field name="arch" type="xml">
                <form class="o_form_document">
                    <header>
                        <button name="action_liberar" string="Liberar" type="object" class="oe_highlight"
                                attrs="{'invisible': ['|', ('doc_carpeta','=','carpeta'), ('stage_id_is_inicial', '!=', True)]}"
                                groups="sicpro_app_repositorio_institucional.group_repositorio_institucional_creador"/>

                        <button name="action_revisado" string="Publicar" type="object" class="oe_highlight"
                                attrs="{'invisible': ['|', ('doc_carpeta','=','carpeta'), ('stage_id_is_revision', '!=', True)]}"
                                groups="sicpro_app_repositorio_institucional.group_repositorio_institucional_validar"/>

                        <button name="action_rechazada" string="Rechazar" type="object"
                                attrs="{'invisible': ['|', ('doc_carpeta','=','carpeta'), ('stage_id_is_revision', '!=', True)]}"
                                groups="sicpro_app_repositorio_institucional.group_repositorio_institucional_validar"/>

                        <field name="stage_id" widget="statusbar" clickable="False"
                               attrs="{'invisible':[('doc_carpeta','=','carpeta')]}"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">


                        </div>
                        <field name="id" invisible="1"/>
                        <field name="stage_id_is_inicial" invisible="1"/>
                        <field name="stage_id_is_revision" invisible="1"/>
                        <field name="stage_id_is_won" invisible="1"/>
                        <field name="doc_carpeta" widget="radio" class="oe_edit_only" options="{'horizontal': true}"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Ej. Carpeta o documento de..."/></h1>
                        </div>

                        <group>
                            <group>
                                <field name="parent_id" domain="[('id', '!=', id)]"
                                       context="{'display_full_name': True}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="parent_full_name"/>
                            </group>
                        </group>

                        <group string="Descripción de la carpeta" attrs="{'invisible':[('doc_carpeta','=','documento')],
                        'required' :[('doc_carpeta','=','carpeta')]}">
                            <field name="description" nolabel="1" widget="text"
                                   placeholder="Añade una descripción de la carpeta..."/>
                        </group>
                        <group string="Resumen de la documentación"
                               attrs="{'invisible':[('doc_carpeta','=','carpeta')],
                                'required' :[('doc_carpeta','=','documento')]}">
                            <field name="resumen" nolabel="1" widget="text"
                                   placeholder="Escriba un resumen del contenido..."/>
                        </group>
                        <separator/>

                        <group string="Archivos" attrs="{'invisible':[('doc_carpeta','=','carpeta')],
                        'required' :[('doc_carpeta','=','documento')]}">
                            <group>
                                <field name="attachment_ids" widget="many2many_binary"
                                       class="o_Attachment_image"/>
                            </group>
                            <group>
                                <field name="download_count"/>
                                <field name="public_url"/>
                            </group>
                        </group>

                        <group>
                            <group>
                                <field name="create_uid" string="Creada por:" readonly="1"/>
                                <field name="write_uid" string="Actualizada por" readonly="1"/>
                            </group>
                            <group>
                                <field name="create_date" string="Fecha Creada" readonly="1"/>
                                <field name="write_date" string="Fecha Actualizada" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page name="actualizar" string="Actualización de datos"
                                  attrs="{'invisible':[('doc_carpeta','=','carpeta')]}">
                                <group>
                                    <group name="identificacion">
                                        <field name="tipo"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        <field name="idioma_id" context="{'active_test': False}"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        <field name="palabras_claves_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                        <field name="issn"/>
                                        <field name="facultad_id"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    </group>
                                    <group name="archivo_y_publicacion">
                                        <field name="nombre_revista_libro"/>
                                        <field name="volumen"/>
                                        <field name="numero"/>
                                        <field name="paginas"/>
                                        <field name="fecha_publicacion"/>
                                    </group>
                                </group>
                                <group>
                                    <group>
                                        <field name="licencia_id"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    </group>
                                    <group>
                                        <field name="identificador_objeto_digital"/>
                                    </group>
                                </group>
                            </page>
                            <page name="autores" string="Información de los Autores"
                                  attrs="{'invisible':[('doc_carpeta','=','carpeta')]}">
                                <group string="Autores">
                                    <div class="row">
                                        <div class="col-lg-10 d-flex">
                                            <field name="autores_ids" mode="tree" nolabel="1"
                                                   context="{'default_orden_id': id,}">
                                                <tree editable="bottom" sample="1">
                                                    <field name="repositorio_id" invisible="1"/>
                                                    <field name="user_id" invisible="1"/>
                                                    <field name="user_partner_id" invisible="1"/>
                                                    <field name="name"
                                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                                    <field name="autor_estudio_titulo"/>
                                                    <field name="autor_ocupacion_titulo" class="font-weight-bold"/>
                                                    <field name="autor_area_id"/>
                                                    <field name="autor_company_id"/>
                                                </tree>
                                            </field>
                                        </div>
                                    </div>
                                </group>
                            </page>
                            <page name="tutores" string="Información de los Tutores"
                                  attrs="{'invisible':[('doc_carpeta','=','carpeta')]}">
                                <group string="Tutores Internos">
                                    <div class="row">
                                        <div class="col-lg-10 d-flex">
                                            <field name="tutores_internos_ids" mode="tree" nolabel="1"
                                                   context="{'default_orden_id': id,}">
                                                <tree editable="bottom" sample="1">
                                                    <field name="repositorio_id" invisible="1"/>
                                                    <field name="name"
                                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                                    <field name="tutor_estudio_titulo"/>
                                                    <field name="tutor_ocupacion_titulo" class="font-weight-bold"/>
                                                    <field name="tutor_area_id"/>
                                                    <field name="tutor_company_id"/>
                                                </tree>
                                            </field>
                                        </div>
                                    </div>
                                </group>
                                <group string="Tutores Externos">
                                    <div class="row">
                                        <div class="col-lg-10 d-flex">
                                            <field name="tutores_externos_ids" mode="tree" nolabel="1"
                                                   context="{'default_orden_id': id,}">
                                                <tree editable="bottom" sample="1">
                                                    <field name="repositorio_id" invisible="1"/>
                                                    <field name="name"
                                                           options="{'no_create': True, 'no_create_edit':True}"/>
                                                    <field name="tutor_nivel_escolar"/>
                                                    <field name="tutor_estudio_titulo"/>
                                                    <field name="tutor_company_id"/>
                                                </tree>
                                            </field>
                                        </div>
                                    </div>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Acciones de Ventana (Window Actions) -->
        <record id="view_repositorio_institucional_inicio_view_action" model="ir.actions.act_window">
            <field name="name">Sistema de Gestión</field>
            <field name="res_model">sicpro.app.repo</field>
            <field name="view_mode">kanban,form</field>
            <field name="domain">[]</field>
            <field name="context" eval="{'search_default_filter_is_root':1}"/>
        </record>

        <record id="repositorio_institucional_carpetas_view_action" model="ir.actions.act_window">
            <field name="name">Repositorio Institucional</field>
            <field name="res_model">sicpro.app.repo</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain">[]</field>
        </record>

    </data>
</odoo>