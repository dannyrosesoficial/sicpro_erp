<odoo>
  <record id="view_repositorio_institucional_search" model="ir.ui.view">
    <field name="name">sicpro.app.repo.search</field>
    <field name="model">sicpro.app.repo</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="parent_id"/>
        <filter name="filter_is_root" string="Directorios" domain="[('parent_id', '=', False)]"/>
        <group>
          <filter name="group_by_parent_id" string="Carpeta" context="{'group_by': 'parent_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_repositorio_institucional_list" model="ir.ui.view">
    <field name="name">sicpro.app.repo.list</field>
    <field name="model">sicpro.app.repo</field>
    <field name="arch" type="xml">
      <list string="Elementos del Repositorio" default_order="sequence, id">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="tipo"/>
        <field name="fecha_publicacion"/>
        <field name="stage_id" widget="badge"/>
        <field name="parent_full_name" invisible="'default_parent_id' in context"/>
        <field name="child_count" optional="show"/>
        <field name="create_uid"/>
        <field name="create_date"/>
        <field name="write_uid"/>
        <field name="write_date"/>
      </list>
    </field>
  </record>

  <record id="view_repositorio_institucional_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.repo.kanban</field>
    <field name="model">sicpro.app.repo</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_document" highlight_color="color">
        <field name="id"/>
        <field name="color"/>
        <field name="name"/>
        <field name="description"/>
        <field name="create_uid"/>
        <field name="write_date"/>
        <field name="child_count"/>
        <field name="doc_carpeta"/>
        <field name="stage_id"/>

        <templates>
          <t t-name="menu" t-if="!selection_mode">
            <div class="container">
              <div class="o_kanban_card_manage_settings row">
                <div t-if="widget.editable" role="menuitem" aria-haspopup="true" class="col-6">
                  <field name="color" widget="kanban_color_picker"/>
                </div>
                <div class="col-6 text-end">
                  <a role="menuitem" type="open" class="dropdown-item small">Abrir</a>
                  <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">
                    Editar</a></t>
                  <t t-if="widget.deletable"><a role="menuitem" type="delete"
                                                class="dropdown-item">Eliminar</a></t>
                </div>
              </div>
            </div>
          </t>
          <t t-name="card">
            <div t-attf-class="oe_kanban_color_#{record.color.raw_value || 0} oe_kanban_global_click p-2">
              <div class="oe_kanban_content">
                <div class="d-flex align-items-start">

                  <div class="o_kanban_image" style="width: 50px; overflow: visible !important;">
                    <t t-if="record.doc_carpeta.raw_value == 'carpeta'">
                      <a type="object" name="action"
                         t-att-context="{'module_action_id': 'sicpro_app_repositorio_institucional.repositorio_institucional_carpetas_view_action', 'search_default_parent_id': record.id.raw_value, 'default_parent_id': record.id.raw_value}"
                         title="Entrar" role="button">
                        <span class="badge rounded-pill bg-dark text-white"
                              style="position: absolute; top: -5px; z-index: 1;">
                          <t t-esc="record.child_count.value or '0'"/>
                        </span>
                        <img src="/sicpro_app_repositorio_institucional/static/description/carpeta.png"
                             alt="Carpeta" class="img-fluid" style="max-height: 45px;"/>
                      </a>
                    </t>
                    <t t-else="">
                      <a type="open" title="Abrir Documento">
                        <img src="/sicpro_app_repositorio_institucional/static/description/documento.png"
                             alt="Documento" class="img-fluid" style="max-height: 45px;"/>
                      </a>
                    </t>
                  </div>

                  <div class="ms-3 flex-grow-1">
                    <div class="d-flex justify-content-between align-items-start">
                      <div class="o_kanban_record_top">
                        <t t-if="record.doc_carpeta.raw_value != 'carpeta'">
                          <strong class="o_kanban_record_title text-danger fs-5">
                            <field name="name"/>
                          </strong>
                        </t>
                        <t t-else="">
                          <strong class="o_kanban_record_title text-success fs-5">
                            <field name="name"/>
                          </strong>
                        </t>
                      </div>


                      <div t-if="record.doc_carpeta.raw_value != 'carpeta' and record.stage_id.raw_value">
                        <field name="stage_id" widget="badge"
                               options="{'color_field': 'color'}"/>
                      </div>
                    </div>

                    <div class="text-muted small mt-1" t-if="record.description.raw_value">
                      <field name="description"/>
                    </div>
                  </div>
                </div>

                <div class="o_kanban_record_bottom mt-3 border-top pt-2">
                  <div class="oe_kanban_bottom_left">
                    <span class="text-muted small">Gestores:</span>
                  </div>
                  <div class="oe_kanban_bottom_right">
                    <field name="create_uid" widget="many2one_avatar_user"/>
                  </div>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Vista de Formulario (Form) -->
  <record id="view_repositorio_institucional_form" model="ir.ui.view">
    <field name="name">sicpro.app.repo.form</field>
    <field name="model">sicpro.app.repo</field>
    <field name="arch" type="xml">
      <form class="o_form_document">
        <header>
          <button name="action_liberar" string="Liberar" type="object" class="oe_highlight"
                  invisible="doc_carpeta == 'carpeta' or not stage_id_is_inicial"
                  groups="sicpro_app_repositorio_institucional.group_repositorio_institucional_creador"/>

          <button name="action_revisado" string="Publicar" type="object" class="oe_highlight"
                  invisible="doc_carpeta == 'carpeta' or not stage_id_is_revision"
                  groups="sicpro_app_repositorio_institucional.group_repositorio_institucional_validar"/>

          <button name="action_rechazada" string="Rechazar" type="object"
                  invisible="doc_carpeta == 'carpeta' or not stage_id_is_revision"
                  groups="sicpro_app_repositorio_institucional.group_repositorio_institucional_validar"/>

          <field name="stage_id" widget="statusbar" clickable="False"
                 invisible="doc_carpeta == 'carpeta'"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
          </div>
          <field name="id" invisible="1"/>
          <field name="stage_id_is_inicial" invisible="1"/>
          <field name="stage_id_is_revision" invisible="1"/>
          <field name="stage_id_is_won" invisible="1"/>
          <field name="doc_carpeta" widget="radio" class="oe_edit_only" options="{'horizontal': true}"/>
          <div class="oe_title">
            <h1><field name="name" placeholder="Ej. Carpeta o documento de..."/></h1>
          </div>

          <group>
            <group>
              <field name="parent_id" domain="[('id', '!=', id)]"
                     context="{'display_full_name': True}"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </group>
            <group>
              <field name="parent_full_name"/>
            </group>
          </group>

          <group string="Descripción de la carpeta" invisible="doc_carpeta == 'documento'"
                 required="doc_carpeta == 'carpeta'">
            <field name="description" nolabel="1" widget="text"
                   placeholder="Añade una descripción de la carpeta..."/>
          </group>
          <group string="Resumen de la documentación"
                 invisible="doc_carpeta == 'carpeta'" required="doc_carpeta == 'documento'">
            <field name="resumen" nolabel="1" widget="text"
                   placeholder="Escriba un resumen del contenido..."/>
          </group>
          <separator/>

          <group string="Archivos" invisible="doc_carpeta == 'carpeta'"
                 required="doc_carpeta == 'documento'">
            <group>
              <field name="attachment_ids" widget="many2many_binary"
                     class="o_Attachment_image"/>
            </group>
            <group>
              <field name="download_count"/>
              <field name="public_url"/>
            </group>
          </group>

          <group>
            <group>
              <field name="create_uid" string="Creada por:" readonly="1"/>
              <field name="write_uid" string="Actualizada por" readonly="1"/>
            </group>
            <group>
              <field name="create_date" string="Fecha Creada" readonly="1"/>
              <field name="write_date" string="Fecha Actualizada" readonly="1"/>
            </group>
          </group>

          <notebook>
            <page name="actualizar" string="Actualización de datos"
                  invisible="doc_carpeta == 'carpeta'">
              <group>
                <group name="identificacion">
                  <field name="tipo"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                  <field name="idioma_id" context="{'active_test': False}"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                  <field name="palabras_claves_ids" widget="many2many_tags"
                         options="{'color_field': 'color'}"/>
                  <field name="issn"/>
                  <field name="facultad_id"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </group>
                <group name="archivo_y_publicacion">
                  <field name="nombre_revista_libro"/>
                  <field name="volumen"/>
                  <field name="numero"/>
                  <field name="paginas"/>
                  <field name="fecha_publicacion"/>
                </group>
              </group>
              <group>
                <group>
                  <field name="licencia_id"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </group>
                <group>
                  <field name="identificador_objeto_digital"/>
                </group>
              </group>
            </page>
            <page name="autores" string="Información de los Autores"
                  invisible="doc_carpeta == 'carpeta'">
              <group string="Autores">
                <div class="row">
                  <div class="col-lg-10 d-flex">
                    <field name="autores_ids" mode="list" nolabel="1"
                           context="{'default_orden_id': id,}">
                      <list editable="bottom" sample="1">
                        <field name="repositorio_id" invisible="1"/>
                        <field name="user_id" invisible="1"/>
                        <field name="user_partner_id" invisible="1"/>
                        <field name="name"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        <field name="autor_estudio_titulo"/>
                        <field name="autor_ocupacion_titulo" class="font-weight-bold"/>
                        <field name="autor_area_id"/>
                        <field name="autor_company_id"/>
                      </list>
                    </field>
                  </div>
                </div>
              </group>
            </page>
            <page name="tutores" string="Información de los Tutores"
                  invisible="doc_carpeta == 'carpeta'">
              <group string="Tutores Internos">
                <div class="row">
                  <div class="col-lg-10 d-flex">
                    <field name="tutores_internos_ids" mode="list" nolabel="1"
                           context="{'default_orden_id': id,}">
                      <list editable="bottom" sample="1">
                        <field name="repositorio_id" invisible="1"/>
                        <field name="name"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        <field name="tutor_estudio_titulo"/>
                        <field name="tutor_ocupacion_titulo" class="font-weight-bold"/>
                        <field name="tutor_area_id"/>
                        <field name="tutor_company_id"/>
                      </list>
                    </field>
                  </div>
                </div>
              </group>
              <group string="Tutores Externos">
                <div class="row">
                  <div class="col-lg-10 d-flex">
                    <field name="tutores_externos_ids" mode="list" nolabel="1"
                           context="{'default_orden_id': id,}">
                      <list editable="bottom" sample="1">
                        <field name="repositorio_id" invisible="1"/>
                        <field name="name"
                               options="{'no_create': True, 'no_create_edit':True}"/>
                        <field name="tutor_nivel_escolar"/>
                        <field name="tutor_estudio_titulo"/>
                        <field name="tutor_company_id"/>
                      </list>
                    </field>
                  </div>
                </div>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
      </form>
    </field>
  </record>

  <!-- Acciones de Ventana (Window Actions) -->
  <record id="view_repositorio_institucional_inicio_view_action" model="ir.actions.act_window">
    <field name="name">Repositorio Institucional</field>
    <field name="res_model">sicpro.app.repo</field>
    <field name="view_mode">kanban,form</field>
    <field name="domain">[]</field>
    <field name="context" eval="{'search_default_filter_is_root':1}"/>
  </record>

  <record id="repositorio_institucional_carpetas_view_action" model="ir.actions.act_window">
    <field name="name">Repositorio Institucional</field>
    <field name="res_model">sicpro.app.repo</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[]</field>
  </record>
</odoo>
