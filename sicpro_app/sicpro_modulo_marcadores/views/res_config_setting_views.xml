<odoo>
  <record id="res_config_settings_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.main_menu</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Marcadores" string="Marcadores" name="sicpro_modulo_marcadores" groups="base.group_system">
          <block title="Menu">
            <setting help="Mostrar panel de widgets con la fecha y los anuncios.">
              <field name="show_widgets"/>
            </setting>
          </block>
        </app>
      </xpath>
    </field>
  </record>
</odoo>
