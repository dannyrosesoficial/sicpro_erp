<odoo>
  <record id="menu_bookmark_action_my_bookmarks" model="ir.actions.act_window">
    <field name="name">Marcadores</field>
    <field name="res_model">sicpro.menu.marcadores</field>
    <field name="view_mode">list,form</field>
    <field name="path">bookmarks</field>
    <field name="domain">[('user_id', '=', uid)]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea tu primer marcador.
      </p>
    </field>
  </record>

  <record id="menu_bookmark_view_list" model="ir.ui.view">
    <field name="name">sicpro.menu.marcadores.view.list</field>
    <field name="model">sicpro.menu.marcadores</field>
    <field name="arch" type="xml">
      <list string="Marcadores" editable="top">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="url"/>
        <field name="target"/>
      </list>
    </field>
  </record>
</odoo>
