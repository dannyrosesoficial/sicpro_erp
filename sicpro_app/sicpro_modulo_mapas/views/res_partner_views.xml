<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="rest_partner_mapa_view">
        <field name="model">res.partner</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <map longitude="partner_longitude" latitude="partner_latitude" geofield="map_form">
                <field name="image_128"/>
                <field name="image_256"/>
                <field name="name"/>
                <field name="partner_longitude"/>
                <field name="partner_latitude"/>
                <field name="map_form"/>
            </map>
        </field>
    </record>

    <record id="partner_form_inherit_view" model="ir.ui.view">
        <field name="name">sol.inherit.view.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//page[1]" position="after">
                <page string="Localización" name="localizacion" class="o_field_map_from">
                    <field name="map_form" widget="MapForm"
                           options="{
                            'longitude': 'partner_longitude',
                            'latitude': 'partner_latitude',
                            'street': 'street',
                            'postalcode': 'zip',
                            'city': 'city',
                            'state': 'state_id',
                            'country': 'country_id',
                            'geocode_btn' : '1'
                            }">
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record model="ir.actions.act_window" id="contacts.action_contacts">
            <field name="view_mode">kanban,tree,form,activity,map</field>
    </record>

    <record id="action_sol_map_partner_integration" model="ir.actions.act_window.view">
        <field name="view_mode">map</field>
        <field name="view_id" ref="rest_partner_mapa_view"/>
        <field name="act_window_id" ref="contacts.action_contacts"/>
    </record>
</odoo>