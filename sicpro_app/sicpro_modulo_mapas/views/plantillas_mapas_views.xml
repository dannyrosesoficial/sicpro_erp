<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record model="ir.ui.view" id="plantillas_mapas_tree">
        <field name="model">sicpro.modulo.mapas</field>
        <field name="name">sicpro.modulo.mapas.tree</field>
        <field name="arch" type="xml">
            <tree string="Overlay">
                <field name="name"/>
                <field name="model_name"/>
                <field name="is_default"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="plantillas_mapas_form">
        <field name="model">sicpro.modulo.mapas</field>
        <field name="name">sicpro.modulo.mapas.Form</field>
        <field name="arch" type="xml">
             <form string="Overlay Template">
                 <group>
                     <field name="name"/>
                     <field name="model_name"/>
                     <field name="overlay_template" widget="ace" options="{'mode': 'xml'}"/>
                     <field name="is_default"/>
                 </group>
             </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="plantillas_mapas_actions">
        <field name="name">Plantillas de Mapas</field>
        <field name="res_model">sicpro.modulo.mapas</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="plantillas_mapas_tree"/>
    </record>


    <menuitem id="mapas_menu" name="Mapas" parent="sicpro_app_administracion.menu_configuracion_administrador"/>

              <menuitem id="plantillas_mapas_menu" name="Plantillas de Mapas" parent="mapas_menu"
                        action="plantillas_mapas_actions" sequence="1"/>
</odoo>