<odoo>
  <record id="view_model_form_inherit_records" model="ir.ui.view">
    <field name="name">ir.model.form.inherit.records</field>
    <field name="model">ir.model</field>
    <field name="inherit_id" ref="base.view_model_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='%(base.act_menu_create)d']" position="after">
        <button name="action_show_records" string="Ver registros" type="object"
                icon="fa-align-justify" class="oe_highlight"/>
      </xpath>
    </field>
  </record>
</odoo>