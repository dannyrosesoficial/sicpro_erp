<odoo>
    <record model="ir.ui.view" id="instrucciones_etiquetas_search_view">
      <field name="name">sicpro.app.instrucciones.etiquetas.search</field>
      <field name="model">sicpro.app.instrucciones.etiquetas</field>
      <field name="arch" type="xml">
        <search string="Buscar Etiquetas">
          <field name="name"/>
          <separator/>
          <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
          <filter string="Activos" name="active" domain="[('active','=',True)]"/>
        </search>
      </field>
    </record>

    <record model="ir.ui.view" id="instrucciones_etiquetas_list_view">
      <field name="name">sicpro.app.instrucciones.etiquetas.list</field>
      <field name="model">sicpro.app.instrucciones.etiquetas</field>
      <field name="arch" type="xml">
        <list string="Etiquetas de las Instrucciones" editable="bottom" sample="1">
          <field name="name"/>
          <field name="color" widget="color_picker"/>
          <field name="active" widget="boolean_toggle"/>
        </list>
      </field>
    </record>

    <record id="instrucciones_etiquetas_action" model="ir.actions.act_window">
      <field name="name">Etiquetas de las Instrucciones</field>
      <field name="res_model">sicpro.app.instrucciones.etiquetas</field>
      <field name="view_mode">list</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Crear nueva etiqueta
        </p>
        <p>
          Las etiquetas te ayudan a categorizar las instrucciones por urgencia, tipo o departamento.
        </p>
      </field>
    </record>
</odoo>