<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="instrucciones_tipos_search_view">
            <field name="name">sicpro.app.instrucciones.tipos.search</field>
            <field name="model">sicpro.app.instrucciones.tipos</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name"/>
                    <field name="abreviatura"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="instrucciones_tipos_tree_view">
            <field name="name">sicpro.app.instrucciones.tipos.tree</field>
            <field name="model">sicpro.app.instrucciones.tipos</field>
            <field name="arch" type="xml">
                <tree string="Tipos de Instrucciones" editable="bottom">
                    <field name="name"/>
                    <field name="abreviatura"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <record id="instrucciones_tipos_action" model="ir.actions.act_window">
            <field name="name">Tipos de Instrucciones</field>
            <field name="res_model">sicpro.app.instrucciones.tipos</field>
            <field name="view_mode">tree</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear nuevo tipo de instrucción...
              </p>
            </field>
        </record>
    
    </data>
</odoo>