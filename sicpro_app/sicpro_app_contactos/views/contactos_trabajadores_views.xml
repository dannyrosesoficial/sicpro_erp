<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_contactos_trabajadores_filter" model="ir.ui.view">
        <field name="name">view.contactos.trabajadores.select</field>
        <field name="model">sicpro.app.trabajadores</field>
        <field name="arch" type="xml">
            <search string="Trabajadores">
                <field name="name" string="Trabajador" filter_domain="[('name', 'ilike', self)]"/>
                <field name="plaza_id"/>
                <field name="company_id"/>
                <field name="ocupacion_id"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Donantes" name="donante" domain="[('donante', '=', 'si')]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="company_id" string="Proceso" context="{'group_by': 'company_id'}"/>
                    <filter name="categoria_ocupacional" string="Categoría ocupacional"
                            context="{'group_by': 'categoria_ocupacional'}"/>
                    <filter name="group_manager" string="Responsable" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_department" string="Área" context="{'group_by': 'area_id'}"/>
                    <filter name="group_job" string="Puesto de Trabajo" context="{'group_by': 'ocupacion_id'}"/>
                    <filter name="grupo_sanguineo" string="Grupos Sanguíneos"
                            context="{'group_by': 'grupo_sanguineo'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_contactos_trabajadores_form" model="ir.ui.view">
        <field name="name">view.contactos.trabajadores.form</field>
        <field name="model">sicpro.app.trabajadores</field>
        <field name="priority" eval="14"/>
        <field name="arch" type="xml">
            <form string="Trabajadores" js_class="hr_employee_form" class='o_employee_form'
                  create="false" edit="false" delete="false">
                <header>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <field name="image_1920" widget='image' class="oe_avatar"
                           options='{"zoom": true, "preview_image":"image_128"}'/>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="name" placeholder="Nombre del trabajador"/>
                        </h1>
                        <h2>
                            <field name="ocupacion_titulo" placeholder="Puestos de Trabajo"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="movil_trabajo" widget="phone"/>
                            <field name="telefono_trabajo" widget="phone"/>
                            <field name="correo_trabajo" widget="email"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="area_id"/>
                            <field name="ocupacion_id"/>
                            <field name="parent_id"/>
                            <field name="centro_costo"/>
                            <field name="local_id" invisible="1"/>
                            <field name="local_cc"/>
                        </group>
                    </group>
                    <div id="o_work_employee_container">
                        <div id="o_work_employee_main">
                            <group string="Ubicación">
                                <field name="ubicacion_laboral"/>
                            </group>
                            <group string="Planificacion">
                                <field name="resource_calendar_id" string="Horas laborales"/>
                                <field name="tz"/>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </div>
                        <div id="o_employee_right">
                            <h4 class="o_org_chart_title mb16 mt0">Organigrama</h4>
                            <field name="child_ids" widget="hr_org_chart"/>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_contactos_trabajadores_tree" model="ir.ui.view">
        <field name="name">view.contactos.trabajadores.tree</field>
        <field name="model">sicpro.app.trabajadores</field>
        <field eval="12" name="priority"/>
        <field name="arch" type="xml">
            <tree string="Trabajadores" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="telefono_trabajo" widget="phone"/>
                <field name="movil_trabajo" widget="phone"/>
                <field name="correo_trabajo"/>
                <field name="area_id"/>
                <field name="ocupacion_id"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="view_contactos_trabajadores_kanban" model="ir.ui.view">
        <field name="name">view.contactos.trabajadores.kanban</field>
        <field name="model">sicpro.app.trabajadores</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="id"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image:url('#{kanban_image('sicpro.app.trabajadores',
                                'image_128', record.id.raw_value,  placeholder)}')">
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <span class="font-weight-bold">
                                                <field name="name" placeholder="Nombre del trabajador"/>
                                            </span>
                                        </strong>
                                        <span t-if="record.ocupacion_titulo.raw_value" class="o_kanban_record_subtitle">
                                            <field name="ocupacion_titulo"/></span>
                                    </div>
                                </div>
                                <span class="text-danger font-weight-bold"><field name="company_id"/></span>
                                <ul>
                                    <li/>
                                    <li t-if="record.correo_trabajo.raw_value" class="o_text_overflow">
                                        <field name="correo_trabajo" widget="email"/>
                                    </li>
                                </ul>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span class="font-weight-bold text-primary">M: </span>
                                        <span class="font-weight-bold"><field name="movil_trabajo"/></span> -
                                        <span class="font-weight-bold text-primary">F: </span>
                                        <span class="font-weight-bold"><field name="telefono_trabajo"/></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"
                                               attrs="{'invisible': [('user_id','=', False)]}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_contactos_trabajadores" model="ir.actions.act_window">
        <field name="name">Contactos Trabajadores</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.trabajadores</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_contactos_trabajadores_filter"/>
        <field name="view_id" ref="view_contactos_trabajadores_kanban"/>
        <field name="domain">['|','|', ["linea_ids", "!=", False], ["fijo_ids", "!=", False], ["correo_ids", "!=", False]]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear contactos en la libreta de direcciones
            </p>
        </field>
    </record>


    <record id="action_contactos_trabajadores_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="sicpro_app_contactos.view_contactos_trabajadores_kanban"/>
        <field name="act_window_id" ref="action_contactos_trabajadores"/>
    </record>

    <record id="action_contactos_trabajadores_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="sicpro_app_contactos.view_contactos_trabajadores_tree"/>
        <field name="act_window_id" ref="action_contactos_trabajadores"/>
    </record>

    <record id="action_contactos_trabajadores_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="sicpro_app_contactos.view_contactos_trabajadores_form"/>
        <field name="act_window_id" ref="action_contactos_trabajadores"/>
    </record>


</odoo>
