<odoo>
  <record id="view_contactos_trabajadores_filter" model="ir.ui.view">
    <field name="name">view.contactos.trabajadores.search</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="arch" type="xml">
      <search string="Trabajadores">
        <field name="name" string="Trabajador" filter_domain="[('name', 'ilike', self)]"/>
        <field name="plaza_id"/>
        <field name="company_id"/>
        <field name="ocupacion_id"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
        <filter string="Donantes" name="donante" domain="[('donante', '=', 'si')]"/>
        <group>
          <filter name="company_id" string="Proceso" context="{'group_by': 'company_id'}"/>
          <filter name="categoria_ocupacional" string="Categoría ocupacional"
                  context="{'group_by': 'categoria_ocupacional'}"/>
          <filter name="group_manager" string="Responsable" context="{'group_by': 'parent_id'}"/>
          <filter name="group_department" string="Área" context="{'group_by': 'area_id'}"/>
          <filter name="group_job" string="Puesto de Trabajo" context="{'group_by': 'ocupacion_id'}"/>
          <filter name="grupo_sanguineo" string="Grupos Sanguíneos"
                  context="{'group_by': 'grupo_sanguineo'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="view_contactos_trabajadores_list" model="ir.ui.view">
    <field name="name">view.contactos.trabajadores.list</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field eval="12" name="priority"/>
    <field name="arch" type="xml">
      <list string="Trabajadores" create="false" edit="false" delete="false">
        <field name="name"/>
        <field name="telefono_trabajo" widget="phone"/>
        <field name="movil_trabajo" widget="phone"/>
        <field name="correo_trabajo"/>
        <field name="area_id"/>
        <field name="ocupacion_id"/>
        <field name="company_id"/>
      </list>
    </field>
  </record>

  <record id="view_contactos_trabajadores_form" model="ir.ui.view">
    <field name="name">view.contactos.trabajadores.form</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="priority" eval="14"/>
    <field name="arch" type="xml">
      <form string="Trabajadores" class='o_employee_form' create="false" edit="false" delete="false">
        <header>
        </header>
        <sheet>
          <field name="active" invisible="1"/>
          <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                  invisible="active"/>
          <field name="image_1920" widget='image' class="oe_avatar"
                 options='{"zoom": true, "preview_image":"image_128"}'/>
          <div class="oe_title">
            <h1 class="d-flex">
              <field name="name" placeholder="Nombre del trabajador"/>
            </h1>
            <h2>
              <field name="ocupacion_titulo" placeholder="Puestos de Trabajo"/>
            </h2>
          </div>
          <group>
            <group>
              <field name="movil_trabajo" widget="phone"/>
              <field name="telefono_trabajo" widget="phone"/>
              <field name="correo_trabajo" widget="email"/>
            </group>
            <group>
              <field name="company_id"/>
              <field name="area_id"/>
              <field name="ocupacion_id"/>
              <field name="parent_id"/>
              <field name="centro_costo"/>
              <field name="local_id" invisible="1"/>
              <field name="local_cc"/>
            </group>
          </group>
          <div id="o_work_employee_container">
            <div id="o_work_employee_main">
              <group string="Ubicación">
                <field name="ubicacion_laboral"/>
              </group>
              <group string="Planificacion">
                <field name="resource_calendar_id" string="Horas laborales"/>
                <field name="tz"/>
                <field name="color" widget="color_picker"/>
              </group>
            </div>
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_contactos_trabajadores_kanban" model="ir.ui.view">
    <field name="name">view.contactos.trabajadores.kanban</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="priority" eval="10"/>
    <field name="arch" type="xml">
      <kanban highlight_color="color" sample="1" duplicate="false">
        <field name="id"/>
        <field name="estado_conexion"/>
        <field name="user_id"/>
        <field name="image_128"/>
        <templates>
          <t t-name="menu" t-if="!selection_mode">
            <div class="container">
              <div class="o_kanban_card_manage_settings row">
                <div t-if="widget.editable" role="menuitem" aria-haspopup="true" class="col-6">
                  <field name="color" widget="kanban_color_picker"/>
                </div>
                <div class="col-6">
                  <a t-if="widget.editable" role="menuitem" class="dropdown-item" type="open">
                    Editar Trabajador
                  </a>
                </div>
              </div>
            </div>
          </t>
          <t t-name="card" class="flex-row">
            <aside>
              <t t-if="record.image_128.raw_value">
                <div class="o_kanban_image me-6">
                  <img alt="Trabajador"
                       t-att-src="'/web/image/sicpro.app.trabajadores/' + record.id.raw_value + '/image_128'"
                       class="img-fluid rounded"
                       style="width:100px; height:120px; object-fit: cover;"/>
                </div>
              </t>
              <div t-else=""
                   class="d-flex align-items-center justify-content-center bg-100 bg-gradient">
                <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20"
                     xmlns="http://www.w3.org/2000/svg">
                  <g fill="currentColor">
                    <path
                        d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                    <circle cx="10" cy="5.5" r="4.5"/>
                  </g>
                </svg>
              </div>
            </aside>
            <main class="ms-2">
              <div>
                <div t-if="record.estado_conexion.raw_value" class="float-end">
                  <strong class="o_kanban_record_title">
                    <div class="float-right"
                         t-if="record.estado_conexion.raw_value == 'present'">
                      <span class="fa fa-circle text-success" role="img"
                            aria-label="Presente"
                            title="Presente" name="presence_present"/>
                    </div>
                    <div class="float-right"
                         t-if="record.estado_conexion.raw_value == 'absent'">
                      <span class="fa fa-circle text-danger" role="img"
                            aria-label="Ausente"
                            title="Ausente" name="presence_absent"/>
                    </div>
                    <div class="float-right"
                         t-if="record.estado_conexion.raw_value == 'to_define'">
                      <span class="fa fa-circle text-warning" role="img"
                            aria-label="Sin Usuario" title="Sin Usuario"
                            name="presence_to_define"/>
                    </div>
                  </strong>
                </div>
                <span class="font-weight-bold">
                  <field class="fw-bold fs-5" name="name" placeholder="Nombre del trabajador"/>
                </span>
              </div>
              <div t-if="record.ocupacion_titulo.raw_value" class="text-truncate">
                <i class="fa fa-fw me-2 fa-suitcase text-primary" title="Ocupación"/>
                <field name="ocupacion_titulo"/>
              </div>

              <div t-if="record.correo_trabajo.raw_value">
                <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                <field name="correo_trabajo"/>
                <span t-if="record.correo_trabajo.raw_value">&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;</span>
                <i t-if="record.movil_trabajo.raw_value" class="fa fa-fw me-2 fa-phone text-primary" title="Celular"/>
                <field t-if="record.movil_trabajo.raw_value" name="movil_trabajo"/>
              </div>

              <div t-if="record.clase_contrato.raw_value">
                <i class="fa fa-fw me-2 fa-briefcase text-primary" title="Clase de contrato"/>
                <span style="color: red; font-weight: bold;">
                  <field name="clase_contrato"/>
                </span>
                <span t-if="record.categoria_ocupacional.raw_value">&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;</span>
                <span t-if="record.categoria_ocupacional.raw_value" style="color: black; font-weight: bold;">
                  <field name="categoria_ocupacional"/>
                </span>
              </div>

              <footer class="py-0">
                <div class="d-flex ms-auto">
                  <field name="user_id" widget="many2one_avatar_user" readonly="1"
                         class="mb-1 ms-2"/>
                  <field name="activity_ids" widget="kanban_activity" class="m-1 ms-2"/>
                </div>
              </footer>
            </main>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="action_contactos_trabajadores" model="ir.actions.act_window">
    <field name="name">Contactos Trabajadores</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.trabajadores</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_contactos_trabajadores_filter"/>
    <field name="view_id" ref="view_contactos_trabajadores_kanban"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear contactos en la libreta de direcciones
      </p>
    </field>
  </record>
</odoo>
