                    </a>
                  </p>
                </div>
              </div>

            </div>

            <hr class="my-5 border-secondary" style="opacity: 0.2;"/>

            <div class="text-center small pb-4 opacity-75">
              <img t-att-src="'/sicpro_modulo_web/static/src/img/etecsaCi_300_6_blanco.png'"
                   alt="ETECSA"
                   style="height: 20px; width: auto; margin-right: 8px; object-fit: contain; vertical-align: middle;"/>
              <span style="vertical-align: middle;"> © <span t-esc="datetime.datetime.now().year"/> División de
                Proyectos y Ejecución de Obras. 🌹</span>
            </div>
          </div>
        </footer>
        <!--    fin del footer-->
      </div>

      <script src="/sicpro_modulo_web/static/src/js/bootstrap.bundle.min.js"></script>
      <script src="/sicpro_modulo_web/static/src/js/aos.js"></script>
      <script src="/sicpro_modulo_web/static/src/js/directorio.js"></script>
    </t>
  </template>
