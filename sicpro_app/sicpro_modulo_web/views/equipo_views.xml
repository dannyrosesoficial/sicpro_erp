<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="web_equipo_search_view">
            <field name="name">sicpro.modulo.web.equipo.search</field>
            <field name="model">sicpro.modulo.web.equipo</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="web_equipo_form_view" model="ir.ui.view">
            <field name="name">sicpro.modulo.web.equipo.form</field>
            <field name="model">sicpro.modulo.web.equipo</field>
            <field name="arch" type="xml">
                <form string="Equipo de Trabajo">
                    <sheet>
                        <widget name="web_ribbon" text="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                            <field name="active" invisible="1"/>
                            <h1>
                                <field name="name" default_focus="1" placeholder="Nombre del Trabajador"/>
                            </h1>
                            <h4>
                                <field name="cuenta_correo"/>
                            </h4>
                        </div>
                        <group>
                            <group>
                                <field name="cargo"/>
                            </group>
                            <group>
                                <field name="responsabilidad" widget="html" class="oe-bordered-editor" options="{'style-inline': true, 'codeview': true }"/>
                            </group></group>
                        <group>
                            <group>
                                <field name="cuenta_twitter"/>
                                <field name="cuenta_facebook"/>
                            </group>
                            <group>
                                <field name="cuenta_instagram"/>
                                <field name="cuenta_linkedin"/>
                            </group>
                        </group>
                        <group>
                            <field name="image" widget="image" options='{"size": [128, 128]}'/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="web_equipo_tree_view">
            <field name="name">sicpro.modulo.web.equipo.tree</field>
            <field name="model">sicpro.modulo.web.equipo</field>
            <field name="arch" type="xml">
                <tree string="Equipo de trabajo">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="cargo"/>
                    <field name="responsabilidad"/>
                    <field name="cuenta_correo"/>
                </tree>
            </field>
        </record>

        <record id="web_equipo_action" model="ir.actions.act_window">
            <field name="name">Equipo de Trabajo</field>
            <field name="res_model">sicpro.modulo.web.equipo</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Agregar usuario al equipo de trabajo…
                </p>
            </field>
        </record>

    </data>
</odoo>