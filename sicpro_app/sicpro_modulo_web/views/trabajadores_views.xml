<odoo>
  <record model="ir.ui.view" id="web_trabajadores_search_view">
    <field name="name">sicpro.modulo.web.trabajadores.search</field>
    <field name="model">sicpro.modulo.web.trabajadores</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="area_id"/>
        <field name="ocupacion_id"/>
        <separator/>
        <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record model="ir.ui.view" id="web_trabajadores_list_view">
    <field name="name">sicpro.modulo.web.trabajadores.list</field>
    <field name="model">sicpro.modulo.web.trabajadores</field>
    <field name="arch" type="xml">
      <list string="Trabajadores" editable="bottom" multi_edit="1" decoration-muted="not active">
        <field name="sequence" widget="handle"/>
        <field name="image_1024" widget="image" options="{'size': [40, 40]}" string="Foto"/>
        <field name="name" options="{'no_create': True, 'no_open': False}"/>
        <field name="ocupacion_id" readonly="1" optional="show"/>
        <field name="area_id" readonly="1"/>
        <field name="movil_trabajo" widget="phone" readonly="1"/>
        <field name="telefono_trabajo" widget="phone" readonly="1" optional="hide"/>
        <field name="correo_trabajo" widget="email" readonly="1"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="web_trabajadores_action" model="ir.actions.act_window">
    <field name="name">Contactos DVPE</field>
    <field name="res_model">sicpro.modulo.web.trabajadores</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agrega los contactos de la DVPE.
      </p>
      <p>
        Configura los contactos que aparecerán en la página principal de SICPRO.
      </p>
    </field>
  </record>
</odoo>