<odoo>
  <record id="view_aviso_mantenimiento_list" model="ir.ui.view">
    <field name="name">sicpro.modulo.web.aviso.mantenimiento.list</field>
    <field name="model">sicpro.modulo.web.aviso.mantenimiento</field>
    <field name="arch" type="xml">
      <list editable="bottom" create="0" delete="0">
        <field name="name" column_invisible="True"/>
        <field name="mantenimiento_activo" widget="boolean_toggle"/>
        <field name="fecha_mantenimiento" placeholder="Seleccione fecha..."
               invisible="not mantenimiento_activo" required="mantenimiento_activo"/>
      </list>
    </field>
  </record>

  <record id="action_aviso_mantenimiento" model="ir.actions.act_window">
    <field name="name">Planificación de Mantenimiento</field>
    <field name="res_model">sicpro.modulo.web.aviso.mantenimiento</field>
    <field name="view_mode">list</field>
    <field name="target">current</field>
  </record>
</odoo>