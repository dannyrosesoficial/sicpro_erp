<odoo>
  <record id="view_sicpro_version_search" model="ir.ui.view">
    <field name="name">sicpro.modulo.web.version.search</field>
    <field name="model">sicpro.modulo.web.version</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <filter string="Todos" name="all_records" domain="['|', ('active', '=', True), ('active', '=', False)]"/>
        <separator/>
        <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="view_sicpro_version_list" model="ir.ui.view">
    <field name="name">sicpro.modulo.web.version.list</field>
    <field name="model">sicpro.modulo.web.version</field>
    <field name="arch" type="xml">
      <list decoration-success="version_actual == True" decoration-bf="version_actual == True">
        <field name="name"/>
        <field name="date_release"/>
        <field name="version_actual" widget="boolean_toggle" string="Actual"/>
      </list>
    </field>
  </record>

  <record id="view_sicpro_version_form" model="ir.ui.view">
    <field name="name">sicpro.modulo.web.version.form</field>
    <field name="model">sicpro.modulo.web.version</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="ej. v2026.1.4"/></h1>
          </div>
          <group>
            <field name="date_release"/>
            <field name="version_actual"/>
          </group>
          <notebook>
            <page string="Cambios y Mejoras">
              <field name="line_ids">
                <list editable="bottom">
                  <field name="tipo"/>
                  <field name="name"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_sicpro_version" model="ir.actions.act_window">
    <field name="name">Versiones del Sistema</field>
    <field name="res_model">sicpro.modulo.web.version</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'active_test': False}</field>
    <field name="search_view_id" ref="view_sicpro_version_search"/>
  </record>
</odoo>

