<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="web_galeria_search_view">
            <field name="name">sicpro.modulo.web.galeria.search</field>
            <field name="model">sicpro.modulo.web.galeria</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="web_galeria_form_view" model="ir.ui.view">
        <field name="name">sicpro.modulo.web.galeria.form</field>
        <field name="model">sicpro.modulo.web.galeria</field>
        <field name="arch" type="xml">
            <form string="Galería">
                <sheet>
                    <widget name="web_ribbon" text="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <field name="active" invisible="1"/>
                        <h1>
                            <field name="name" default_focus="1" placeholder="Nombre de la Imagen"/>
                        </h1>
                        <h4>
                        <field name="etiquetas" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </h4>
                    </div>
                  <group name="group_top">
                   <field name="image" widget="image" options='{"size": [800, 600]}'/>
                  </group>
                </sheet>
            </form>
        </field>
    </record>

        <record model="ir.ui.view" id="web_galeria_tree_view">
            <field name="name">sicpro.modulo.web.galeria.tree</field>
            <field name="model">sicpro.modulo.web.galeria</field>
            <field name="arch" type="xml">
                <tree string="Etiquetas del Contrato">
                    <field name="name"/>
                    <field name="etiquetas" widget="many2many_tags"
                           options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </tree>
            </field>
        </record>

        <record id="web_galeria_action" model="ir.actions.act_window">
            <field name="name">Etiquetas de la Galería</field>
            <field name="res_model">sicpro.modulo.web.galeria</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Agregar imagen a la galería…
              </p>
            </field>
        </record>
    
    </data>
</odoo>