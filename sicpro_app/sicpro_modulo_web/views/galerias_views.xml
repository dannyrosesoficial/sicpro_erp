<odoo>
  <record model="ir.ui.view" id="web_galeria_search_view">
    <field name="name">sicpro.modulo.web.galeria.search</field>
    <field name="model">sicpro.modulo.web.galeria</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="tipo"/>
        <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="web_galeria_form_view" model="ir.ui.view">
    <field name="name">sicpro.modulo.web.galeria.form</field>
    <field name="model">sicpro.modulo.web.galeria</field>
    <field name="arch" type="xml">
      <form string="Galería">
        <sheet>
          <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger" invisible="active"/>
          <field name="image_1920" widget="image" class="oe_avatar"
                 options="{'preview_image': 'image_1920', 'size': [200, 200]}"/>
          <div class="oe_title">
            <label for="name" string="Nombre de la Imagen"/>
            <h1>
              <field name="name" placeholder="Ej. Banner Principal 2026"/>
            </h1>
          </div>
          <group>
            <group name="datos_principales">
              <field name="tipo" widget="radio" options="{'horizontal': true}"/>
              <field name="sequence" invisible="1"/>
              <field name="active" invisible="1"/>
            </group>
          </group>
          <notebook>
            <page string="Vista Previa" name="preview">
              <field name="image_1920" widget="image" nolabel="1" options="{'size': [0, 600]}"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record model="ir.ui.view" id="web_galeria_list_view">
    <field name="name">sicpro.modulo.web.galeria.list</field>
    <field name="model">sicpro.modulo.web.galeria</field>
    <field name="arch" type="xml">
      <list string="Galería de Imágenes" decoration-muted="not active">
        <field name="sequence" widget="handle"/>
        <field name="image_1920" widget="image" options="{'size': [50, 50]}" string="Miniatura"/>
        <field name="name"/>
        <field name="tipo" widget="badge" decoration-info="tipo == 'normal'" decoration-warning="tipo == 'wide'"
               decoration-success="tipo == 'tall'"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="web_galeria_action" model="ir.actions.act_window">
    <field name="name">Galería SICPRO</field>
    <field name="res_model">sicpro.modulo.web.galeria</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Carga la primera imagen para la galería.
      </p>
    </field>
  </record>
</odoo>