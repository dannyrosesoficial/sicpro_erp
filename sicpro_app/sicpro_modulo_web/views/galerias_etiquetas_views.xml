<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="web_galeria_etiquetas_search_view">
            <field name="name">sicpro.modulo.web.galeria.etiquetas.search</field>
            <field name="model">sicpro.modulo.web.galeria.etiquetas</field>
            <field name="arch" type="xml">
                <search string="Buscar Etiquetas">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="web_galeria_etiquetas_tree_view">
            <field name="name">sicpro.modulo.web.galeria.etiquetas.tree</field>
            <field name="model">sicpro.modulo.web.galeria.etiquetas</field>
            <field name="arch" type="xml">
                <tree string="Etiquetas del Contrato" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                    <field name="active" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="web_galeria_etiquetas_action" model="ir.actions.act_window">
            <field name="name">Etiquetas de la Galería</field>
            <field name="res_model">sicpro.modulo.web.galeria.etiquetas</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear nueva etiqueta…
              </p>
            </field>
        </record>
    
    </data>
</odoo>