<?xml version="1.0" ?>
<odoo>

    <!-- Creo la categoria de permisos Transporte -->
    <record id="module_category_transporte" model="ir.module.category">
            <field name="name">Transporte</field>
            <field name="sequence" >16</field>
    </record>

    <record id="grupo_transporte_admin" model="res.groups">
            <field name="name">0. Administración Módulo Transporte</field>
            <field name="comment">Permisos total a la app</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_general" model="res.groups">
            <field name="name">1. Transporte General</field>
            <field name="comment">Permisos a transporte general</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_contratos" model="res.groups">
            <field name="name">2. Contratos</field>
            <field name="comment">Permisos a Contratos</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_servicios" model="res.groups">
            <field name="name">3. Servicios de Transporte</field>
            <field name="comment">Permisos a servicios de transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_combustible" model="res.groups">
            <field name="name">4. Combustible</field>
            <field name="comment">Permisos al combustible del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_historial" model="res.groups">
            <field name="name">5. Historial de uso</field>
            <field name="comment">Permisos al historial del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_costo" model="res.groups">
            <field name="name">6. Calculos de Costos</field>
            <field name="comment">Permisos a los costos del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_odometro" model="res.groups">
            <field name="name">7. Odometro</field>
            <field name="comment">Permisos al odometro del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_tipo_servicios" model="res.groups">
            <field name="name">8. Tipo de Servicios</field>
            <field name="comment">Permisos a los tipos de servicios del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_modelo" model="res.groups">
            <field name="name">9. Config-Modelos</field>
            <field name="comment">Permisos a los modelos del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_etiqueta" model="res.groups">
            <field name="name">10. config-Etiquetas</field>
            <field name="comment">Permisos a las etiquetas del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_estado" model="res.groups">
            <field name="name">11. Config-Estados</field>
            <field name="comment">Permisos a los estados del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_modelo_brand" model="res.groups">
            <field name="name">12. Config-Modelos Brand</field>
            <field name="comment">Permisos a los modelos Brand del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>

    <record id="grupo_transporte_tipo_actividad" model="res.groups">
            <field name="name">13. Config-Tipos de actividades</field>
            <field name="comment">Permisos a los tipos de actividades del transporte</field>
            <field name="category_id" ref="module_category_transporte"/>
    </record>


