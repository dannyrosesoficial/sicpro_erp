                            </tr>
                            <tr>
                                <td colspan="7"
                                    data-sheets-value="{ &quot;1&quot;: 2, &quot;2&quot;: &quot;MTTO\/REPARACIÓN O TERMINACIÓN DE VIVIENDAS POR ESFUERZO PROPIO DEL TRABAJADOR&quot;}"
