<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="formato_papel_horizontal_vivienda_anexo_3" model="report.paperformat">
        <field name="name">Papel Vertical Vivienda anexo 3</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
    </record>

