                                    <span t-field="inf.especialista_obras"/></font></td>
                                <td data-sheets-value="{ &quot;1&quot;: 2, &quot;2&quot;: &quot;&quot;}"
                                    align="left"><font face="Times New Roman">
                                </font></td>
                                <td colspan="3"
                                    data-sheets-value="{ &quot;1&quot;: 2, &quot;2&quot;: &quot;logistica&quot;}"
                                    align="center" valign="middle"><font size="4" face="Times New Roman">
                                    <span t-field="inf.jefe_logistica"/></font></td>
                            </tr>
                            <tr>
