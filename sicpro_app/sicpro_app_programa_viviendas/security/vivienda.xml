<?xml version="1.0" ?>
<odoo>

    <data>
        <!-- Creo la categoría Principal del programa de la vivienda -->
        <record id="modulo_categoria_programa_vivienda" model="ir.module.category">
            <field name="name">Programa de la Vivienda</field>
            <field name="description">Módulo para el acceso a las aplicaciones del programa de la vivienda.</field>
            <field name="sequence">16</field>
        </record>

        <!-- Creo la categoría de permisos para el programa de la vivienda (Sindicato) -->
        <record id="module_category_vivienda_sindicato" model="ir.module.category">
            <field name="name">Sindicato</field>
            <field name="description">Módulo para el acceso a la aplicación del programa de la vivienda.</field>
            <field name="parent_id" ref="sicpro_app_programa_viviendas.modulo_categoria_programa_vivienda"/>
            <field name="sequence">4</field>
        </record>

        <record id="grupo_app_vivienda_secretario" model="res.groups">
            <field name="name">Secretario sindical</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_vivienda_sindicato"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>


        <!-- Creo la categoría de permisos para el programa de la vivienda (Operaciones) -->
        <record id="module_category_vivienda_operaciones" model="ir.module.category">
            <field name="name">Operaciones</field>
            <field name="description">Módulo para las operaciones de la aplicación del programa de la vivienda.</field>
            <field name="parent_id" ref="sicpro_app_programa_viviendas.modulo_categoria_programa_vivienda"/>
            <field name="sequence">5</field>
        </record>

        <record id="grupo_app_vivienda_visualizar" model="res.groups">
            <field name="name">Usuario</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_app_vivienda_secretario_general" model="res.groups">
            <field name="name">Secretario general</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_vivienda_visualizar'))]"/>
        </record>

        <record id="grupo_app_vivienda_validar" model="res.groups">
            <field name="name">Validar solicitud</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_vivienda_secretario_general'))]"/>
        </record>

        <record id="grupo_app_vivienda_logistica" model="res.groups">
            <field name="name">Logística</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_vivienda_validar'))]"/>
        </record>

        <record id="grupo_app_vivienda_economia" model="res.groups">
            <field name="name">Economía</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_vivienda_logistica'))]"/>
        </record>

        <record id="grupo_app_vivienda_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_vivienda_economia'))]"/>
        </record>

        <record id="grupo_app_vivienda_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos de lectura/Escritura/Eliminación</field>
            <field name="category_id" ref="module_category_vivienda_operaciones"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_vivienda_responsable'))]"/>
        </record>
    </data>

    <data>

        <!-- Regla de permisos para los secretarios sindicales -->
        <record id="vivienda_trabajador_secretarios_vivienda_rule" model="ir.rule">
            <field name="name">Regla de usuarios para secretarios sindicales</field>
            <field name="model_id" ref="model_sicpro_app_vivienda_trabajador"/>
            <field name="domain_force">[('seccion_sindical', '=', user.trabajador.seccion_sindical_id.id)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_vivienda_secretario'))]"/>
        </record>

        <!-- Regla de permisos de los usuarios que visualizan -->
        <record id="vivienda_trabajador_visualizar_vivienda_rule" model="ir.rule">
            <field name="name">Regla de usuarios para visualizar todos los trabajadores</field>
            <field name="model_id" ref="model_sicpro_app_vivienda_trabajador"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_vivienda_visualizar'))]"/>
        </record>

        <record id="vivienda_trabajador_validar_trabajadores_rule" model="ir.rule">
            <field name="name">Regla de usuarios que ver todos los trabajadores</field>
            <field name="model_id" ref="sicpro_app_trabajadores.model_sicpro_app_trabajadores"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_vivienda_validar'))]"/>
        </record>

    </data>
</odoo>
