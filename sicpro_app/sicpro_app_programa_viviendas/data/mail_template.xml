    <!-- Plantilla de cancelación de la solicitud de materiales -->
    <record id="vivienda_cancelacion" model="mail.template">
      <field name="name">Vivienda: Solicitud Cancelada</field>
      <field name="model_id" ref="model_sicpro_app_vivienda_trabajador"/>
      <field name="email_from">"SICPRO ERP" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
