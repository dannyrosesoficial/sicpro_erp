                                  <b>Sección Sindical:</b>
                                  <t t-out="object.seccion_sindical.name"/>
                                  <br></br>
                                  <br></br>
                                  <b>Escalafón:</b>
                                  <t t-out="object.escalafon.name"/>
                                  <br></br>
                                  <b>Prioridad:</b>
                                  <t t-out="object.prioridad"/>
                                  <br></br>
                                  <br></br>
                                  <b>Motivo de cancelación:</b>
                                  <t t-out="object.motivo_cancelacion"/>
                                  <br></br>
                                  <b>Fecha de cancelación:</b>
                                  <t t-out="format_date(object.fecha_cancelado)"/>
                                  <br></br>
                                  <br></br>
                                  <br></br>
                                  <br></br>
                                  <div style="margin:16px 0px 16px 0px;">
                                    <a t-att-href="'/mail/view?model=%s&amp;res_id=%s' % ('sicpro.app.vivienda.trabajador', object.id,)"
                                       style="background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                      ver Solicitud del trabajador
