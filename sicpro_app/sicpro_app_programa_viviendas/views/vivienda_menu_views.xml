    <!--Fin: Menu Dashboard-->


    <menuitem id="vivienda_menu_operaciones" name="Operaciones" parent="viviendas_menu_root" sequence="2"/>

    <menuitem id="menu_vivienda_solicitudes" name="Solicitud de Materiales" parent="vivienda_menu_operaciones"
              action="vivienda_trabajo_action" sequence="1"/>

    <menuitem id="menu_vivienda_fondo" name="Fondo de la Vivienda" parent="vivienda_menu_operaciones"
