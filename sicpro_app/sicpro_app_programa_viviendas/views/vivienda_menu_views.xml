        <field name="tag">sicpro_dashboard_view</field>
        <field name="context">{'nombre_modelo_dashboard': 'sicpro.app.vivienda'}</field>
    </record>
    <menuitem id="menu_vivienda_dashboard" name="Dashboard" action="menu_vivienda_dashboard_action" sequence="1"
