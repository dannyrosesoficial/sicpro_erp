<?xml version="1.0"?>
<odoo>
    <record id="vivienda_materiales_um_search" model="ir.ui.view">
        <field name="name">sicpro.app.vivienda.materiales.um.search</field>
        <field name="model">sicpro.app.vivienda.materiales.um</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="vivienda_materiales_um_tree" model="ir.ui.view">
        <field name="name">sicpro.app.vivienda.materiales.um.tree</field>
        <field name="model">sicpro.app.vivienda.materiales.um</field>
        <field name="arch" type="xml">
            <tree string="Unidades de medidas" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="vivienda_materiales_um_form" model="ir.ui.view">
        <field name="name">sicpro.app.vivienda.materiales.um.form</field>
        <field name="model">sicpro.app.vivienda.materiales.um</field>
        <field name="arch" type="xml">
            <form string="Unidades de medidas">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vivienda_materiales_um_action" model="ir.actions.act_window">
        <field name="name">Unidades de Medidas</field>
        <field name="res_model">sicpro.app.vivienda.materiales.um</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="vivienda_materiales_um_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nueva unidad de medidas
            </p>
        </field>
    </record>

</odoo>
