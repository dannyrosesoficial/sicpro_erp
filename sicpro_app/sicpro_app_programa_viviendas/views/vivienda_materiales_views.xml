<?xml version="1.0"?>
<odoo>

    <record id="vivienda_materiales_search" model="ir.ui.view">
        <field name="name">sicpro.app.vivienda.materiales.search</field>
        <field name="model">sicpro.app.vivienda.materiales</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="vivienda_materiales_tree" model="ir.ui.view">
        <field name="name">sicpro.app.vivienda.materiales.tree</field>
        <field name="model">sicpro.app.vivienda.materiales</field>
        <field name="arch" type="xml">
            <tree string="Materiales" editable="bottom">
                <field name="name"/>
                <field name="um"/>
            </tree>
        </field>
    </record>

    <record id="vivienda_materiales_action" model="ir.actions.act_window">
        <field name="name">Materiales</field>
        <field name="res_model">sicpro.app.vivienda.materiales</field>
        <field name="view_id" ref="vivienda_materiales_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nuevo material
            </p>
        </field>
    </record>

</odoo>
