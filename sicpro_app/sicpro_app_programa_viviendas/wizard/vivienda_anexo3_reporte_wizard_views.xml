<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reporte_vivienda_anexo3_wizard" model="ir.ui.view">
        <field name="name">sicpro.app.vivienda.reporte.anexo3.form</field>
        <field name="model">sicpro.app.vivienda.reporte.anexo3</field>
        <field name="arch" type="xml">
            <form string="Anexo 3">
                <group>
                    <group>
                        <field name="reporte_general" widget="boolean_toggle"/>
                        <field name="etapa" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"
                               attrs="{'invisible': [('reporte_general','=', True)],
                           'required': [('reporte_general','!=', True)]}"/>
                    </group>
                    <group string="Pie de firma">
                        <field name="especialista_obras" required="1"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        <field name="jefe_logistica" required="1"
                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="generar_reporte" string="Imprimir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_vivienda_anexo3_action" model="ir.actions.act_window">
        <field name="name">Demanda de Materiales (Anexo 3)</field>
        <field name="res_model">sicpro.app.vivienda.reporte.anexo3</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="reporte_vivienda_anexo3_wizard"/>
        <field name="target">new</field>
    </record>
</odoo>
