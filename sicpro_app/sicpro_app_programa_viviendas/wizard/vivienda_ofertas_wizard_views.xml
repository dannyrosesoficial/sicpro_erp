<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="vivienda_ofertas_wizard_tree" model="ir.ui.view">
            <field name="name">sicpro.app.vivienda.ofertas.tree</field>
            <field name="model">sicpro.app.vivienda.ofertas</field>
            <field name="arch" type="xml">
                <tree string="Ofertas" editable="bottom">
                    <field name="name"/>
                    <field name="proveedor_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="etapa_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="fecha" readonly="1"/>
                    <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                    <field name="active" invisible="1"/>
                    <button name="archivar" type="object" string="Archivar"
                            class="btn btn-danger"
                            icon="fa-times" attrs="{'invisible': [('active','!=', True)]}"/>

                    <button name="desarchivar" type="object" string="Desarchivar"
                            class="btn btn-success"
                            icon="fa-check" attrs="{'invisible': [('active','=', True)]}"/>
                </tree>
            </field>
        </record>

        <record id="vivienda_ofertas_wizard_search" model="ir.ui.view">
            <field name="name">sicpro.app.vivienda.ofertas.search</field>
            <field name="model">sicpro.app.vivienda.ofertas</field>
            <field name="arch" type="xml">
                <search string="Buscar">
                    <field name="name"/>
                    <separator/>
                    <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Agrupar por">
                    </group>
                </search>
            </field>
        </record>

        <record id="vivienda_ofertas_wizard_action" model="ir.actions.act_window">
            <field name="name">Ofertas de proveedores</field>
            <field name="res_model">sicpro.app.vivienda.ofertas</field>
            <field name="view_mode">tree</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>