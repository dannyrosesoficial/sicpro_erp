<odoo>
  <record id="vivienda_ofertas_wizard_search" model="ir.ui.view">
    <field name="name">sicpro.app.vivienda.ofertas.search</field>
    <field name="model">sicpro.app.vivienda.ofertas</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="proveedor_id"/>
        <field name="etapa_id"/>
        <separator/>
        <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
        <group>
          <filter string="Proveedor" name="group_proveedor" context="{'group_by':'proveedor_id'}"/>
          <filter string="Etapa" name="group_etapa" context="{'group_by':'etapa_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="vivienda_ofertas_wizard_list" model="ir.ui.view">
    <field name="name">sicpro.app.vivienda.ofertas.list</field>
    <field name="model">sicpro.app.vivienda.ofertas</field>
    <field name="arch" type="xml">
      <list string="Ofertas" editable="bottom" sample="1">
        <field name="name"/>
        <field name="proveedor_id" options="{'no_create': True, 'no_open': True}"/>
        <field name="etapa_id" options="{'no_create': True, 'no_open': True}"/>
        <field name="fecha" readonly="1"/>
        <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
        <field name="active" invisible="1"/>

        <button name="action_archive" type="object" string="Archivar"
                class="text-danger" icon="fa-archive"
                invisible="not active" help="Mover a históricos"/>

        <button name="action_unarchive" type="object" string="Restaurar"
                class="text-success" icon="fa-undo"
                invisible="active" help="Volver a activar oferta"/>
      </list>
    </field>
  </record>

  <record id="vivienda_ofertas_wizard_action" model="ir.actions.act_window">
    <field name="name">Ofertas de proveedores</field>
    <field name="res_model">sicpro.app.vivienda.ofertas</field>
    <field name="view_mode">list</field>
    <field name="target">current</field>
    <field name="search_view_id" ref="vivienda_ofertas_wizard_search"/>
  </record>
</odoo>