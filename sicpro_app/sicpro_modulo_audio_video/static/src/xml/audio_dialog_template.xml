<templates xml:space="preserve">
    <t t-name="sicpro_modulo_audio_video.AudioDialog" owl="1">
        <Dialog title="title" size="'md'" contentClass="'o_audio_dialog_content'">
            <div class="o_audio_dialog">
                <div class="form-group">
                    <div style="margin-bottom: 10px; display: flex;">
                        <span class="record-dot" style="font-size: 24px; color: red; font-weight: bold;">●</span>
                      <span class="record-timer"
                            style="font-size: 24px; color: red; font-weight: bold; margin-left: 6px;">00:00</span>
                    </div>
                  <div class="audios">
                        <audio class="recorded" autoplay="autoplay" playsinline="true" controls="controls"></audio>
                    </div>
                  <div style="margin-top: 20px;margin-left: 10px;">
                        <button class="note-record-btn btn btn-primary" t-on-click="onStartRecording">Iniciar</button>
                    <button class="note-record-stop-btn btn btn-primary" t-on-click="onStopRecording"
                            disabled="disabled" style="margin-left: 5px;">Parar</button>
                    <button class="note-audio-play btn btn-primary" t-on-click="onPlayAudio" disabled="disabled"
                            style="margin-left: 5px;">Play</button>
                    <button class="note-audio-download btn btn-primary" t-on-click="onDownloadAudio"
                            disabled="disabled" style="margin-left: 5px;">Descarga</button>
                    </div>
                </div>
            </div>

          <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="() => this.save()">Agregar</button>
            <button class="btn btn-secondary" t-on-click="() => this.props.close()">Cerrar</button>
            </t>
        </Dialog>
    </t>
</templates>
