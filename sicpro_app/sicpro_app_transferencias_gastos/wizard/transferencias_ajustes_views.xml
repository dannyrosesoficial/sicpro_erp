<odoo>
  <record id="transferencias_ajustar_gastos_wizard_view" model="ir.ui.view">
    <field name="name">sicpro.app.transferencias.gastos.ajustes.form</field>
    <field name="model">sicpro.app.transferencias.gastos.ajustes</field>
    <field name="arch" type="xml">
      <form string="Ajuste de Gastos">
        <div class="col-lg-12 font-weight-bold">
          AJUSTAR GASTOS DE LA CUENTA
        </div>
        <field name="company_id" invisible="1"/>
        <field name="company_currency" invisible="1"/>
        <field name="transferencia_sap" invisible="1"/>
        <group>
          <group string="Valor del gasto anterior">
            <field name="gasto_sap_anterior"/>
          </group>
          <group string="Valor del gasto nuevo">
            <field name="gasto_sap_nuevo"/>
          </group>
        </group>
        <footer>
          <button name="modificar_gasto_transferido" string="Modificar" type="object"
                  class="btn-primary"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="transferencias_ajustar_gastos_wizard_action" model="ir.actions.act_window">
    <field name="name">Ajustar valor de Gastos</field>
    <field name="res_model">sicpro.app.transferencias.gastos.ajustes</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
