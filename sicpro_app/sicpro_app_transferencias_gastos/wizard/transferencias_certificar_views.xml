<odoo>
  <record id="transferencias_economia_wizard_view" model="ir.ui.view">
    <field name="name">sicpro.app.transferencias.gastos.economia.wizard.form</field>
    <field name="model">sicpro.app.transferencias.gastos.economia.wizard</field>
    <field name="arch" type="xml">
      <form string="Certificar Gastos">
        <div class="col-lg-12 font-weight-bold">
          ENVIAR LOS GASTOS A CERTIFICAR
        </div>
        <group string="Gastos de las Órdenes de Trabajo que serán enviados a certificar.">
          <field name="anio"/>
          <field name="mes_ids" widget="many2many_tags"
                 options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
          <field name="ordenes_ids" widget="many2many_tags"
                 options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
        </group>
        <footer>
          <button name="modificar_estado_gastos" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="transferencias_economia_wizard_action" model="ir.actions.act_window">
    <field name="name">Certificar Gastos</field>
    <field name="res_model">sicpro.app.transferencias.gastos.economia.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
