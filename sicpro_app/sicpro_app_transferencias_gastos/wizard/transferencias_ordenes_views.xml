<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="transferencias_ordenes_wizard_view" model="ir.ui.view">
            <field name="name">sicpro.app.transferencias.gastos.importar.wizard.ordenes.form</field>
            <field name="model">sicpro.app.transferencias.gastos.importar.wizard.ordenes</field>
            <field name="arch" type="xml">
                <form string="Modificación de Órdenes">
                    <div class="col-lg-12 font-weight-bold">
                        MODIFICAR EL OBJETO DE LA ORDEN DE TRABAJO
                    </div>
                    <group>
                        <group string="Seleccione la orden que va a sustituir al objeto">
                            <field name="orden_trabajo_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </group>
                        <group string="Objeto de orden exportado de SAP">
                            <field name="objeto"/>
                        </group>
                    </group>
                    <footer>
                        <button name="modificar_objeto_orden" string="Modificar" type="object" class="btn-primary"/>
                        <button string="Cancelar" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="transferencias_ordenes_wizard_action" model="ir.actions.act_window">
            <field name="name">Modificar Objeto de Orden</field>
            <field name="res_model">sicpro.app.transferencias.gastos.importar.wizard.ordenes</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_sicpro_app_transferencias_gastos_importar"/>
        </record>

    </data>
</odoo>
