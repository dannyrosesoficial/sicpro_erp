<odoo>
  <record id="transferencias_gastos_search" model="ir.ui.view">
    <field name="name">sicpro.app.transferencias.gastos.search</field>
    <field name="model">sicpro.app.transferencias.gastos</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="estado"/>
        <field name="anio"/>
        <field name="mes"/>
        <field name="usuario"/>
        <separator/>
        <filter string="Contabilizado" name="contabilizado" domain="[('contabilizado', '=', True)]"/>
        <filter string="No Contabilizado" name="no_contabilizado" domain="[('contabilizado', '=', False)]"/>
        <separator/>
        <filter string="Pendientes por Contabilizar" name="pendiente_contabilizar"
                domain="[('estado', '=', 'pendiente_contabilizar')]"/>
        <separator/>
        <filter string="En Espera por Contabilizar" name="espera_contabilizar"
                domain="[('estado', '=', 'espera_contabilizar')]"/>
        <separator/>
        <filter string="Fecha Contable" name="fecha_contable" date="fecha_contable"/>
        <filter string="Fecha Doc" name="fecha_doc" date="fecha_doc"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
        <separator/>
        <group>
          <filter name="estado" string="Estados" context="{'group_by': 'estado'}"/>
          <filter name="objeto" string="Orden de Trabajo" context="{'group_by': 'name'}"/>
          <filter name="mes" string="Mes" context="{'group_by': 'mes'}"/>
          <filter name="cl_coste" string="Cuentas" context="{'group_by': 'cl_coste'}"/>
          <filter name="usuario" string="Usuario SAP" context="{'group_by': 'usuario'}"/>
          <filter name="material" string="Material" context="{'group_by': 'material'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="transferencias_gastos_list" model="ir.ui.view">
    <field name="name">sicpro.app.transferencias.gastos.list</field>
    <field name="model">sicpro.app.transferencias.gastos</field>
    <field name="priority">50</field>
    <field name="arch" type="xml">
      <list string="Transferencias de Gastos" sample="1"
            decoration-success="estado == 'contabilizado'" decoration-danger="estado == 'pendiente_contabilizar'">
        <header>
        </header>
        <button name="ajustar_gastos_cj74" string="Ajustar" type="object" icon="fa-money"
                class="btn-warning" invisible="estado != 'revision_economica'"
                groups="sicpro_app_transferencias_gastos.grupo_transferencias_economia,sicpro_app_transferencias_gastos.grupo_transferencias_admin"/>

        <field name="estado" widget="badge" class="font-weight-bold" readonly="1"
               decoration-muted="estado == 'revision_economica'" decoration-success="estado == 'contabilizado'"
               decoration-info="estado in ['revision_dtp', 'validacion_ejecutor', 'Validacion_inversionista']"
               decoration-warning="estado in ['rechazado_dtp', 'rechazado_ejecutor', 'espera_contabilizar']"
               decoration-danger="estado in ['rechazado_inversionista', 'pendiente_contabilizar']"/>
        <field name="name" readonly="1"/>
        <field name="per" readonly="1" optional="hide"/>
        <field name="anio" readonly="1"/>
        <field name="mes" readonly="1" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
        <field name="fecha_contable" readonly="1"/>
        <field name="fecha_doc" readonly="1" optional="hide"/>
        <field name="denominacion_objeto" readonly="1"/>
        <field name="valor_var" readonly="1"/>
        <field name="monO" readonly="1"/>
        <field name="cl_coste" readonly="1"/>
        <field name="denom_cl_coste" readonly="1"/>
        <field name="cta_cp" readonly="1" optional="hide"/>
        <field name="denomctacp" readonly="1" optional="hide"/>
        <field name="n_doc" readonly="1" optional="hide"/>
        <field name="n_doc_ref" readonly="1" optional="hide"/>
        <field name="denominacion" readonly="1" optional="hide"/>
        <field name="usuario" readonly="1"/>
        <field name="texto_cabecera_documento" readonly="1" optional="hide"/>
        <field name="material" readonly="1" optional="hide"/>
        <field name="texto_breve_material" readonly="1" optional="hide"/>
        <field name="ud_cantidad_contab" readonly="1" optional="hide"/>
        <field name="cantidad_total_reg" readonly="1" optional="hide"/>
        <field name="cliente_id" optional="hide"/>
        <field name="company_id" column_invisible="1"/>
        <field name="company_currency" column_invisible="1"/>
        <field name="company_abreviatura"/>
        <field name="contabilizado" column_invisible="1"/>
        <field name="motivo_rechazo" readonly="1" optional="hide"/>
      </list>
    </field>
  </record>

  <record model="ir.actions.act_window" id="transferencias_gastos_action">
    <field name="name">Gastos para las Transferencias</field>
    <field name="res_model">sicpro.app.transferencias.gastos</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="transferencias_gastos_list"/>
    <field name="search_view_id" ref="transferencias_gastos_search"/>
    <field name="context">{'search_default_anio': (context_today().strftime('%Y')),
                           'search_default_no_contabilizado': 1, }
    </field>
  </record>
</odoo>
