<odoo>
  <record id="transferencias_cuentas_gastos_list" model="ir.ui.view">
    <field name="name">sicpro.app.transferencias.cuentas.gastos.list</field>
    <field name="model">sicpro.app.transferencias.cuentas.gastos</field>
    <field name="arch" type="xml">
      <list string="Cuentas" editable="bottom">
        <field name="name"/>
        <field name="descripcion"/>
        <field name="active" column_invisible="1"/>
        <field name="traspasos"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="transferencias_cuentas_gastos_action" model="ir.actions.act_window">
    <field name="name">Cuentas de Gastos</field>
    <field name="res_model">sicpro.app.transferencias.cuentas.gastos</field>
    <field name="view_id" ref="transferencias_cuentas_gastos_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear cuentas de gastos para las transferencias
      </p>
    </field>
  </record>
</odoo>
