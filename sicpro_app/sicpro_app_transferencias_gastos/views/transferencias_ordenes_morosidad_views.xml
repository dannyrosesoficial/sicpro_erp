<?xml version="1.0"?>
<odoo>

    <record id="transferencias_ordenes_morosidad_tree" model="ir.ui.view">
        <field name="name">sicpro.app.transferencias.gastos.ordenes.morosidad.tree</field>
        <field name="model">sicpro.app.transferencias.gastos.ordenes.morosidad</field>
        <field name="arch" type="xml">
            <tree string="Morosidad" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" invisible="1"/>
                <field name="company_id"/>
                <field name="company_abreviatura"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="transferencias_ordenes_morosidad_action" model="ir.actions.act_window">
        <field name="name">Tiempo de certificación de gastos del inversionista</field>
        <field name="res_model">sicpro.app.transferencias.gastos.ordenes.morosidad</field>
        <field name="view_id" ref="transferencias_ordenes_morosidad_tree"/>
    </record>

</odoo>
