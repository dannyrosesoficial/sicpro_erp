<odoo>
  <data noupdate="0">
    <!-- Cron para dar aviso de los gastos pendientes por el inversionista -->
    <record id="transferencias_cron_gastos_pendientes" model="ir.cron">
      <field name="name">Transferencias: Aviso de Gastos Pendientes</field>
      <field name="model_id" ref="sicpro_app_transferencias_gastos.model_sicpro_app_transferencias_gastos_ordenes"/>
      <field name="state">code</field>
      <field name="code">model.cron_gastos_pendientes_inversionistas()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
    </record>
  </data>
</odoo>
