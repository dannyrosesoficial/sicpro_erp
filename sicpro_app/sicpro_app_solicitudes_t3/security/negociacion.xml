<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>

         <!-- Creo la categoría de permisos Negocio -->
    <record id="module_category_solicitud_negocio" model="ir.module.category">
        <field name="name">Negociación</field>
        <field name="description">Módulo para el control del Negocio de trabajo de los inversionistas.</field>
        <field name="sequence" >9</field>
    </record>

    <record id="grupo_app_negocio_usuario" model="res.groups">
        <field name="name">Usuarios</field>
        <field name="comment">Permisos de lectura</field>
        <field name="category_id" ref="module_category_solicitud_negocio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_negocio_ejecutor" model="res.groups">
        <field name="name">Ejecutor</field>
        <field name="comment">Permisos de lectura/Escritura</field>
        <field name="category_id" ref="module_category_solicitud_negocio"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_negocio_usuario'))]"/>
    </record>

    <record id="grupo_app_negocio_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="module_category_solicitud_negocio"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_negocio_ejecutor'))]"/>
    </record>

</data>

<data noupdate="0">

    <record id="negocio_rule_proceso" model="ir.rule">
        <field name="name">Vista de procesos negocios</field>
        <field ref="base.model_res_company" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_negocio_usuario'))]"/>
    </record>

    <record id="negocio_rule_clientes_1" model="ir.rule">
        <field name="name">Iniciativas Negocio Procesos</field>
        <field ref="sicpro_app_solicitudes_t1.model_sicpro_app_solicitudes_oportunidades" name="model_id"/>
        <field name="domain_force">['&amp;', ('company_id', 'in', company_ids),
            ('estado_interno', 'in', ('liberada', 'rechazada_ejecutor', 'cancelada_ejecutor'))]</field>
        <field name="groups" eval="[(4, ref('grupo_app_negocio_usuario'))]"/>
    </record>


</data>

</odoo>
