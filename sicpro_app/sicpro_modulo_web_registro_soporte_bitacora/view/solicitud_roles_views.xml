<odoo>
  <record id="view_solicitud_roles_bitacora_form" model="ir.ui.view">
    <field name="name">sicpro.modulo.plantilla.acceso.form</field>
    <field name="model">sicpro.modulo.solicitud.acceso</field>
    <field name="inherit_id" ref="sicpro_modulo_web_registro.view_solicitud_roles_form"/>
    <field name="arch" type="xml">
      <xpath expr="//button[@name='correo_actualiza_roles']" position="after">
        <field name="bitacora_actualizada" invisible="1"/>

        <button name="actualizar_bitacora" string="Actualizar Bitácora del Usuario" class="oe_highlight"
                type="object" invisible="estado != 'ejecutado' or bitacora_actualizada"/>

        <button name="ver_bitacora" string="Ver la Bitácora del Usuario" type="object"
                invisible="estado != 'ejecutado' or not bitacora_actualizada"/>
      </xpath>
    </field>
  </record>
</odoo>