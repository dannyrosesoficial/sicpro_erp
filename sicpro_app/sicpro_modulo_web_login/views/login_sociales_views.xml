<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="login_sociales_tree_view">
            <field name="name">sicpro.app.login.config.sociales.tree</field>
            <field name="model">sicpro.app.login.config.sociales</field>
            <field name="arch" type="xml">
                <tree string="Versión" editable="bottom" create="false">
                    <field name="name" invisible="1"/>
                    <field name="plantilla_acceso"/>
                    <field name="facebook"/>
                    <field name="twitter"/>
                    <field name="linkedin"/>
                    <field name="instagram"/>
                    <field name="telegram"/>
                </tree>
            </field>
        </record>

    <record id="login_sociales_action" model="ir.actions.act_window">
        <field name="name">Plantilla de Accesos y Redes Sociales</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.login.config.sociales</field>
        <field name="view_mode">tree</field>
    </record>

        <menuitem
                id="menu_login_sociales"
                name="Plantilla de Accesos y Redes Sociales"
                parent="sicpro_app_administracion.menu_administracion_1"
                sequence="180"
                action="login_sociales_action"
                groups="base.group_system"/>



    </data>
</odoo>