<?xml version="1.0" encoding="utf-8"?>
<odoo>

   	 <template id="assets_login" inherit_id="web.assets_frontend">
   	 	<xpath expr="." position="inside">
   	 		<link rel="stylesheet" href="/sicpro_modulo_web_login/static/css/web_login_style.css"/>
   	 	</xpath>
    </template>

   	<template id="login_layout" inherit_id="web.login_layout" name="Login Layout Inherit">
   		<xpath expr="//div[hasclass('container')]" position="attributes">
   			<attribute name="class">body_login</attribute>
   		</xpath>
   	</template>

   	<template id="login" inherit_id="web.login" name="Login Inherit">
   		<xpath expr="//label[@for='db']" position="replace" />
		<xpath expr="//label[@for='login']" position="replace" />
		<xpath expr="//label[@for='password']" position="replace" />

		<xpath expr="//input[@name='login']" position="attributes">
			<attribute name="placeholder">Usuario...</attribute>
			<attribute name="autocomplete">off</attribute>
			<attribute name="autocorrect">off</attribute>
		</xpath>

		<xpath expr="//input[@name='password']" position="attributes">
			<attribute name="placeholder">Contraseña...</attribute>
			<attribute name="oncopy">return false</attribute>
			<attribute name="onpaste">return false</attribute>
		</xpath>

		<xpath expr="//a[@href='/web/database/selector']" position="replace">
			<a role="button" href="/web/database/selector" class="btn btn-secondary">
				<i class="fa fa-database" role="img" aria-label="Database" title="Database"></i>
			</a>
		</xpath>
	</template>

	<template id="replace_login" name="Login Layout" inherit_id="web.login_layout">

		<xpath expr="//t[@t-set='body_classname']" position="after">
			<t t-set="body_classname" t-value="''"/>
   		</xpath>

   		<xpath expr="//div[hasclass('card-body')]/div/img[1]" position="attributes">
   			<attribute name="class">company_logo</attribute>
   		</xpath>

		<xpath expr="//div[@t-attf-class='card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list']"
			   position="before">
   			<div id="background-wrapper" t-attf-style="background-image: url('#{background_src}');"></div>
   		</xpath>

		<xpath expr="//div[@t-attf-class='card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list']"
			   position="replace">
			<div t-attf-class="card border-0 mx-auto bg-login2 {{login_card_classes}} o_database_list " style="">
				<div t-attf-class="text-center pb-3 border-bottom {{'mb-3' if form_small else 'mb-4'}}">
				<img t-attf-src="/sicpro_modulo_web_login/static/img/logo_sicpro.png" alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
			</div>
				<t t-raw="0"/>
				<div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
				<small><i class="fa fa-envelope fa-fw mr-2"/></small>
					<a href="mailto:daniel.borrero@etecsa.cu" target="_blank"><span>SOPORTE TÉCNICO</span></a>
				<br>
					<small><i class="fa fa-phone"/></small>
					<span>M: </span>52183663  -
					<small><i class="fa fa-phone"/></small>
					<span>F: </span>78741436</br>
                <br>
					<t t-set="version" t-value="request.env['sicpro.app.login.config.version'].sudo().search([('config', '=', 'config_version')])"/>
					<small><t t-raw="version.name"/></small>
				</br>
					<br></br>
					<t t-set="sociales" t-value="request.env['sicpro.app.login.config.sociales'].sudo().search([('config', '=', 'config_version')])"/>
					<small><i class="fa fa-sign-in fa-fw mr-1"/></small>
					<a t-att-href="sociales.plantilla_acceso" target="_blank"><span>Plantilla Solicitud de Accesos</span></a>

					<br></br>
				<br><strong>
					<img src="/sicpro_modulo_web_login/static/img/logo_etecsa_circular_blanco.png" width="32" height="32" alt=""/>
					DIVISIÓN DE PROYECTOS Y EJECUCIÓN DE OBRAS
				</strong></br>
					<div class="o_footer_social_media s_share mt-2">
						<a t-att-href="sociales.facebook" class="mr-3">
							<i class="ez-social-link fa fa-fw fa-facebook"></i>
						</a>
						<a t-att-href="sociales.twitter" class="mr-3">
							<i class="ez-social-link fa fa-fw fa-twitter"></i>
						</a>
						<a t-att-href="sociales.linkedin" class="mr-3">
							<i class="ez-social-link fa fa-fw fa-linkedin"></i>
						</a>
						<a t-att-href="sociales.instagram" class="mr-3">
							<i class="ez-social-link fa fa-fw fa-instagram"></i>
						</a>
						<a t-att-href="sociales.telegram" class="mr-3">
							<i class="ez-social-link fa fa-fw fa-telegram"></i>
						</a>
					</div>
				</div>
			</div>
		</xpath>

        </template>

</odoo>
