<?xml version="1.0"?>
<odoo>
    <function
        model="ir.config_parameter"
        name="set_param" eval="('auth_signup.allow_uninvited', True)" />

        <data noupdate="1">
            <record id="demo_sicpro_modulo_web_login" model="ir.attachment">
                <field name="public" eval="True" />
                <field name="name">Imagen del Login</field>
                <field name="store_fname">background_login.jpeg</field>
                <field name="use_as_background">True</field>
                <field name="type">binary</field>
                <field name="id_img_login">1</field>
                <field name="datas" type="base64" file="sicpro_modulo_web_login/static/img/background_login_produccion.jpeg"/>
            </record>

            <record id="mantenimiento_sicpro_modulo_web_login" model="ir.attachment">
                <field name="public" eval="True" />
                <field name="name">Imagen de Mantenimiento</field>
                <field name="store_fname">mantenimiento_login.jpeg</field>
                <field name="type">binary</field>
                <field name="id_img_login">2</field>
                <field name="datas" type="base64" file="sicpro_modulo_web_login/static/img/mantenimiento.png"/>
            </record>
        </data>
</odoo>
