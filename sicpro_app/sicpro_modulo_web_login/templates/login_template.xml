<odoo>
    <template id="login_template" name="Web Login Layout">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="head">
                <t t-call-assets="web.web_login"/>
                <t t-call-assets="web.assets_common" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_common" t-css="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </t>
            <t t-set="body_classname" t-value="''"/>

            <!-- Partículas-->
            <div id="particles-background" class="vertical-centered-box"></div>
            <div id="particles-foreground" class="vertical-centered-box"></div>

            <div class="content">
                <div class="container">
                    <div class="row">
                        <div class="col-md-6">
                            <img src="/sicpro_modulo_web_login/static/src/images/features.svg" alt="Image"
                                 class="img-fluid"/>
                        </div>
                        <div class="col-md-6 contents">
                            <div class="row justify-content-center">
                                <div class="col-md-8">
                                    <div class="mb-4">

                                        <div class="d-flex align-items-center">
                                            <img src="/sicpro_modulo_web_login/static/src/images/SICPRO_ERP_blanco.png"
                                                 alt="ETECSA" width="38" height="38"/>
                                            <span class="caption text-white text-logo">SICPRO ERP</span>
                                        </div>

                                        <p class="mb-4">Sistema de Control Integral de la Producción
                                            División de Proyecto y Ejecución de Obras</p>
                                    </div>


                                    <form role="form" t-attf-action="/web/login" method="post"
                                          onsubmit="this.action = '/web/login' + location.hash">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                        <div class="form-group database" t-if="databases and len(databases) &gt; 1">
                                            <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                                                <input type="form-control" name="db" t-att-value="request.db" id="db"
                                                       t-attf-class="form-control-db #{'form-control-sm' if form_small else ''}"
                                                       required="required" readonly="readonly"/>
                                                <a role="button" href="/web/database/selector" class="text-icon-db">
                                                    <i class="fa fa-database" role="img" aria-label="Database"
                                                       title="Base de Datos"></i>
                                                </a>

                                            </div>
                                        </div>

                                        <div class="form-group first">
                                            <label class="text-dark" for="username">Usuario</label>
                                            <input type="text" class="form-control" name="login" t-att-value="login"
                                                   id="username" required="required" autofocus="autofocus"
                                                   autocomplete="off" autocorrect="off" autocapitalize="off"/>
                                        </div>

                                        <div class="form-group last mb-4">
                                            <label class="text-dark" for="password">Contraseña</label>
                                            <input type="password" class="form-control" name="password"
                                                   id="password" required="required" oncopy="return false"
                                                   onpaste="return false" autocomplete="current-password"
                                                   t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                                        </div>

                                        <div name="sector_post_login" class="d-flex mb-5 align-items-center">
                                            <label class="control control--checkbox mb-0">
                                                <span class="caption">Mostrar Contraseña</span>
<!--                                                <input type="checkbox"/>-->
                                                <div class="control__indicator"></div>
                                            </label>

                                            <t t-set="version_ids" t-value="request.env['sicpro.modulo.web.version'].sudo().search([])"/>
                                            <span name="sector_post_version" class="ml-auto">
                                                <a href="#" class="suprimir-barra-link forgot-pass text-white"
                                                   style="text-decoration: none;"> <t t-out="version_ids['name']"/>
                                                </a>
                                            </span>
                                        </div>

                                        <p class="alert alert-danger" t-if="error" role="alert">
                                            <t t-esc="error"/>
                                        </p>
                                        <p class="alert alert-success" t-if="message" role="status">
                                            <t t-esc="message"/>
                                        </p>

                                        <div t-attf-class="clearfix oe_login_buttons text-center mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                                            <button type="submit" class="btn btn-block btn-primary btn-info">Iniciar
                                                Sesión</button>
                                            <t t-if="debug">
                                                <button type="submit" name="redirect" value="/web/become"
                                                        class="btn btn-link btn-sm btn-block">Iniciar sesión como
                                                    SuperUsuario</button>
                                            </t>
                                            <div name="otros_acceso">
                                            </div>
                                            <div class="o_login_auth"/>
                                        </div>

                                        <input type="hidden" name="redirect" t-att-value="redirect"/>

                                        <span class="d-block text-left my-4 text-muted">&#8212; Nuestras Redes
                                            &#8212;</span>

                                        <t t-set="social_links" t-value="request.env['res.company'].sudo().search(
                                                            [('login_redes_sociales', '=', True)])"/>
                                        <div class="social-login">
                                            <a t-if="social_links.social_twitter"
                                               t-att-href="social_links.social_twitter"
                                               class="twitter" aria-label="Twitter" title="Twitter">
                                                <span class="icon-twitter mr-3"/>
                                            </a>
                                            <a t-if="social_links.social_facebook"
                                               t-att-href="social_links.social_facebook"
                                               class="facebook" aria-label="Facebook" title="Facebook">
                                                <span class="icon-facebook mr-3"/>
                                            </a>
                                            <a t-if="social_links.social_instagram"
                                               t-att-href="social_links.social_instagram"
                                               class="instagram" aria-label="Instagram" title="Instagram">
                                                <span class="icon-instagram mr-3"/>
                                            </a>
                                            <a href="https://www.dvpe.etecsa.cu/" class="etecsa" title="DVPE">
                                                <span>
                                                <img src="/sicpro_modulo_web_login/static/src/images/etecsaCi_300_6_blanco.png"
                                                     width="18" height="18"/>
                                                </span>
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <script src="/sicpro_modulo_web_login/static/src/js/jquery-3.3.1.min.js"></script>
            <script src="/sicpro_modulo_web_login/static/src/js/popper.min.js"></script>
            <script src="/sicpro_modulo_web_login/static/src/js/bootstrap.min.js"></script>
            <script src="/sicpro_modulo_web_login/static/src/js/main.js"></script>
            <script src="/sicpro_modulo_web_login/static/src/js/particulas.js"></script>
        </t>
    </template>

</odoo>