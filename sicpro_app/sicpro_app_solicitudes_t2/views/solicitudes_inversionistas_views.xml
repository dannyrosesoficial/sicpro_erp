<?xml version="1.0"?>
<odoo>

    <!-- Inicio de las Vistas del modal para la cancelación de la solicitud-->
    <record id="solicitudes_inversionista_cancelada_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.canceladas.t2.form</field>
            <field name="model">sicpro.app.solicitudes.canceladas.t2</field>
            <field name="priority">60</field>
            <field name="arch" type="xml">
                <form string="Motivo de Cancelación del Cliente">
                    <group class="oe_title">
                        <field name="motivo_cancelacion"/>
                    </group>
                    <footer>
                        <button name="action_motivo_cancelacion_t2" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
    </record>

    <record id="solicitudes_inversionista_cancelada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Cancelación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.solicitudes.canceladas.t2</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="solicitudes_inversionista_cancelada_form"/>
            <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para la cancelación de la solicitud-->

    <record id="solicitudes_inversionista_form" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.inversionista.form</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <form class="o_lead_opportunity_form">
                    <header>
                       <field name="estado_interno" invisible="1"/>
                       <field name="tipo" invisible="1"/>
                       <button name="action_archivar_subsolicitud" string="Archivar Subsolicitud" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'nuevo'), ('tipo', '=', 'principal')]}"/>

                       <button name="action_desarchivar_subsolicitud" string="Activar Subsolicitud" type="object"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '!=', False),
                            ('estado_interno', '!=', 'nuevo'), ('tipo', '=', 'principal')]}"/>


                       <button name="action_inversionista_liberar" string="Liberar" type="object" class="oe_highlight"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'nuevo'), ('tipo', '!=', 'principal')]}"/>

                       <button name="action_inversionista_restaurar_rechazada" string="Restaurar" type="object"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'rechazada_dtp'), ('tipo', '!=', 'principal')]}"/>

                       <button name="%(solicitudes_inversionista_cancelada_action)d" string="Cancelar" type="action"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'rechazada_dtp'), ('tipo', '!=', 'principal')]}"/>

                       <button name="action_inversionista_restaurar_cancelada" string="Restaurar" type="object"
                            attrs="{'invisible': ['|', '|', '|', ('type', '=', 'oportunidad'), ('active', '=', False),
                            ('estado_interno', '!=', 'cancelada_cliente'), ('tipo', '!=', 'principal')]}"/>


                       <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"
                            attrs="{'invisible': ['|', ('active', '=', False), ('type', '=', 'iniciativa')]}"/>

                   </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <!-- Boton suparior de calendario
                       <div class="oe_button_box" name="button_box">
                             <button name="action_calendario_oportunidades" type="object"
                                class="oe_stat_button" icon="fa-calendar"
                                context="{'partner_id': partner_id, 'search_default_opportunity_id': active_id}"
                                attrs="{'invisible': [('type', '=', 'iniciativa')]}">
                                <div class="o_stat_info">
                                    <field name="meeting_count" class="o_stat_value"/>
                                    <span class="o_stat_text" attrs="{'invisible': [('meeting_count', '&lt;', 2)]}"> Reuniones</span>
                                    <span class="o_stat_text" attrs="{'invisible': [('meeting_count', '&gt;', 1)]}"> Reunion</span>
                                </div>
                             </button>
                       </div>-->

                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <widget name="web_ribbon" title="Cancelada" bg_color="bg-danger"
                                attrs="{'invisible': [('estado_interno', 'not in',['cancelada_cliente', 'cancelada_ejecutor'])]}"/>
                        <widget name="web_ribbon" title="Rechazado" bg_color="bg-warning"
                                attrs="{'invisible': [('estado_interno', 'not in',['rechazada_dtp', 'rechazada_ejecutor'])]}"/>
                        <div class="oe_title">
                           <label for="name" class="oe_edit_only" string="Iniciativa"
                                  attrs="{'invisible': [('type', '=', 'oportunidad')]}"/>
                            <label for="name" class="oe_edit_only"
                                   attrs="{'invisible': [('type', '=', 'iniciativa')]}"/>
                            <h1><field name="name" placeholder="ej. Nombre de la solicitud de trabajo" /></h1>
                            <h2 class="o_row row no-gutters d-flex">
                                <div class="col" attrs="{'invisible': ['|', ('estado_interno', '=', False),
                                ('estado_interno', 'in', ['nuevo', 'rechazada_dtp', 'cancelada'])]}">
                                    <label for="valor_sap_cup" class="oe_edit_only" />
                                    <div class="o_row">
                                        <field name="company_currency" invisible="1"/>
                                        <field name="valor_sap_cup" class="oe_inline" widget='monetary'
                                               options="{'currency_field': 'company_currency'}"/>
                                        <span class="oe_grey p-2"> - </span>
                                    </div>
                                </div>
                                <div class="col" attrs="{'invisible': ['|', ('estado_interno', '=', False),
                                ('estado_interno', 'in', ['nuevo', 'rechazada_dtp', 'cancelada'])]}">
                                    <span class="oe_edit_only o_pls_probability">
                                        <label for="valor_sap_cuc"/>
                                        </span>
                                    <div id="probability" class="o_row d-flex">
                                        <field name="valor_sap_cuc"  widget='monetary'
                                               options="{'currency_field': 'company_currency'}"/>
                                    </div>
                                </div>
                            </h2>
                        </div>

                        <group>
                            <!-- información de la entidad (INICIATIVA)-->
                            <group attrs="{'invisible': ['|', ('type', '=', 'oportunidad'), ('tipo', '!=', 'principal')]}">
                                <field name="partner_id" attrs="{'readonly': [('partner_id', '!=', False)]}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="partner_name" attrs="{'readonly': [('partner_id', '!=', False)]}"/>
                                <field name="territorio_id" attrs="{'readonly': [('partner_id', '!=', False)]}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="provincia_id" attrs="{'readonly': [('partner_id', '!=', False)]}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                                <field name="website" widget="url" placeholder="ej. https://www.etecsa.cu"/>
                            </group>

                             <!-- Cliente (OPORTUNIDAD) -->
                            <group attrs="{'invisible': [('type', '=', 'iniciativa')]}">
                                <field name="partner_id" string="Cliente"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                            </group>

                              <!-- información del cliente (INICIATIVA)-->
                            <group attrs="{'invisible': ['|', ('type', '=', 'oportunidad'), ('tipo', '!=', 'principal')]}">
                                <field name="cargo" attrs="{'readonly': [('partner_id', '!=', False)]}"/>
                                <field name="telefono_fijo"/>
                                <field name="telefono_movil"/>

                                <field name="correo" widget="email"/>
                                <field name="pagina_web" widget="url" placeholder="ej. https://www.cliente.etecsa.cu"/>
                            </group>

                              <!-- Prioridad y etiquetas (OPORTUNIDAD) -->
                            <group attrs="{'invisible': [('type', '=', 'iniciativa')]}">
                                <field name="priority" widget="priority"/>
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': True}"/>
                            </group>

                            <group attrs="{'invisible': [('type', '=', 'iniciativa')]}">
                                <field name="user_id" />
                                <field name="team_id" widget="selection" />
                                <field name="type" invisible="1"/>
                            </group>

                            <!-- especialidades en Sub Solicitud (INICIATIVA)-->
                            <group attrs="{'invisible': [('tipo', '=', 'principal')]}">
                                <field name="especialidad" domain="[('company_id', '=', company_id)]"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                           </group>
                            <group attrs="{'invisible': [('tipo', '=', 'principal')]}">
                             <field name="pep" />
                            </group>

                              <!-- Prioridad y etiquetas (INICIATIVA)-->
                            <group name="lead_priority" attrs="{'invisible': [('type', '=', 'oportunidad')]}">
                                <field name="tag_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create_edit': True}"/>
                                <field name="id_solicitud" attrs="{'invisible': [('estado_interno', '=', 'nuevo')]}"/>
                                <field name="anio" invisible="1"/>
                            </group>
                            <group name="lead_priority" attrs="{'invisible': [('type', '=', 'oportunidad')]}">
                                <field name="priority" widget="priority"/>
                            </group>

                            <group attrs="{'invisible': [('tipo', '!=', 'principal')]}">
                                <field name="pep_corto"/>
                            </group>
                            <group>
                                <field name="company_id" string="Ejecutor"
                                       attrs="{'invisible': [('tipo', '!=', 'principal')],
                                       'readonly': [('company_id', '!=', False)]}" options="{'no_create': True,
                                       'no_create_edit':True, 'no_open': True}"/>
                                <field name="departamento" string="Departamento"
                                       attrs="{'invisible': [('tipo', '!=', 'subsolicitud')]}"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>

                            <!-- Fechas (OPORTUNIDAD) -->
                            <group attrs="{'invisible': [('type', '=', 'iniciativa')]}">
                                <field name="fecha_solicitud" readonly="1"/>
                                <field name="fecha_aprobacion" readonly="1"/>
                                <field name="company_id" readonly="0"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                        </group>
                        <group>
                            <field name="motivo_rechazo" readonly="1"
                                   attrs="{'invisible': [('estado_interno', '!=', 'rechazada_dtp')]}"/>
                            <field name="motivo_cancelacion" readonly="1"
                                   attrs="{'invisible': [('estado_interno', 'not in', 'cancelada_cliente', 'cancelada_ejecutor')]}"/>
                        </group>
                       <notebook>
                           <!-- Pestaña de especialidad para las solicitudes principales-->
                           <page string="Especialidad del Trabajo" autofocus="autofocus"
                                 attrs="{'invisible': ['|','|','|', ('pep_corto', '=', False), ('name', '=', False),
                                 ('partner_id', '=', False), ('tipo', '!=', 'principal')]}">
                            <field name="hijos_ids" mode="kanban"
                                   context="{'default_id': id, 'default_name': name, 'default_partner_id': partner_id,
                                   'default_tipo': 'subsolicitud', 'default_tag_ids': tag_ids, 'default_pep_corto': pep_corto,
                                   'default_company_id': company_id, 'default_departamento': departamento, 'default_priority': priority }">
                                <kanban>
                                    <field name="id"/>
                                    <field name="especialidad"/>
                                    <field name="pep"/>
                                    <field name="image_128"/>
                                   <templates>
                                       <t t-name="kanban-box">
                                           <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                                               <t>
                                                   <div class="o_kanban_image_fill_left o_kanban_image_full"
                                                        t-attf-style="background-image: url(#{kanban_image('sicpro.app.solicitudes.oportunidades', 'image_128', record.id.raw_value, placeholder)})"
                                                        role="img"/>
                                               </t>
                                               <div class="oe_kanban_details">
                                                   <strong class="o_kanban_record_title oe_partner_heading">
                                                       <field name="especialidad"/></strong>
                                                   <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                                   <ul>
                                                       <li t-if="record.pep.raw_value"><field name="pep" /></li>
                                                   </ul>
                                                   <div class="oe_kanban_partner_links"/>
                                               </div>
                                           </div>
                                       </t>
                                   </templates>
                                </kanban>
                            </field>
                           </page>

                           <!-- Pestaña de especialidad para las Subsolicitudes-->
                           <page string="Especialidad del Trabajo" attrs="{'invisible': [('tipo', '=', 'principal')]}">
                           </page>

                           <page string="Documentación" attrs="{'invisible': [('tipo', '=', 'principal')]}">
                                <group string="Documentación Técnica">
                                    <group string="Proyecto">
                                        <field name="ejecucion_proyecto"/>
                                        <field name="consecutivo_proyecto"
                                               attrs="{'invisible': [('ejecucion_proyecto', '=', False)]}"/>
                                        <field name="adjunto_proyecto"/>
                                    </group>
                                    <group string="Tarea Técnica">
                                        <field name="ejecucion_tt"/>
                                        <field name="codigo_tt" attrs="{'invisible': [('ejecucion_tt', '=', False)]}"/>
                                        <field name="adjunto_tt"/>
                                    </group>
                                </group>
                            </page>

                           <page string="Equipos y Materiales" attrs="{'invisible': [('tipo', '=', 'principal')]}">
                                <group string="Equipos y Materiales para la Ejecución" >
                                    <group string="Datos del Equipamiento">
                                        <field name="datos_equipamiento_1"/>
                                        <field name="datos_equipamiento_2"/>
                                        <field name="datos_equipamiento_3"/>
                                        <field name="datos_equipamiento_4"/>
                                        <field name="datos_equipamiento_5"/>
                                    </group>
                                    <group string="Datos de los Materiales" >
                                        <field name="datos_materiales_1"/>
                                        <field name="datos_materiales_2" />
                                        <field name="datos_materiales_3"/>
                                        <field name="datos_materiales_4"/>
                                    </group>
                                </group>
                            </page>

                           <page string="Alcance los Trabajos" attrs="{'invisible': [('tipo', '=', 'principal')]}">
                                <field name="description" placeholder="Añadir una descripción..."/>
                            </page>

                           <page string="información extra"
                                 attrs="{'invisible': ['|', ('type', '=', 'oportunidad'),('tipo', '!=', 'principal')]}">
                                <group>
                                    <group string="Asignación" name="categorization">
                                        <field name="company_cliente" options="{'no_create': True}"/>
                                    </group>
                                    <group string="Análisis">
                                        <field name="fecha_solicitud"/>
                                        <field name="fecha_aprobacion"/>
                                    </group>
                                </group>
                            </page>

                           <page name="iniciativa" string="Cliente" attrs="{'invisible': [('type', '=', 'iniciativa')]}">
                                <group>
                                    <group string="Información de contacto">
                                        <field name="partner_name"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                        <field name="territorio_id"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                                        <field name="provincia_id"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                                        <field name="website" widget="url" />
                                    </group>
                                <group class="mt48">
                                        <field name="cargo"/>
                                        <field name="telefono_fijo"/>
                                        <field name="telefono_movil" />
                                        <field name="correo" widget="email" />
                                        <field name="pagina_web" widget="url" />
                                    </group>
                                    <group string="Marketing">

                                    </group>
                                    <group string="Otros" name="Misc">
                                        <field name="dias_aprobar" />
                                        <field name="dias_asignar" />
                                        <field name="type" invisible="1"/>
                                    </group>
                                </group>
                            </page>

                       </notebook>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </form>
            </field>
        </record>

    <record id="solicitudes_inversionista_tree" model="ir.ui.view">
        <field name="name">sicpro.app.solicitudes.inversionista.tree</field>
        <field name="model">sicpro.app.solicitudes.oportunidades</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <tree string="Iniciativas"
                  decoration-warning="estado_interno in ['rechazada_dtp', 'rechazada_dtp']"
                  decoration-danger="estado_interno in ['cancelada_cliente', 'cancelada_ejecutor']"
                  decoration-success="estado_interno == 'aprobada'" >
                <field name="name" string="Iniciativa"/>
                <field name="pep_corto"/>
                <field name="partner_id"/>
                <field name="partner_name"/>
                <field name="territorio_id"/>
                <field name="priority" widget="priority"/>
                <field name="fecha_solicitud"/>
                <field name="company_id"/>
                <field name="tipo" invisible="1"/>
                <field name="estado_interno" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="solicitudes_inversionista_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.inversionista.kanban</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" archivable="false">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="priority"/>
                    <field name="tag_ids"/>
                    <field name="user_id"/>
                    <field name="message_needaction_counter"/>
                    <field name="activity_ids"/>
                    <field name="activity_state"/>
                    <progressbar field="activity_state"
                                 colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div>
                                    <strong class="o_kanban_record_title"><span><field name="name"/></span></strong>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle"><field name="partner_id"/></span>
                                </div>
                                <div>
                                  <field name="tag_ids"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                        <t t-if="record.message_needaction_counter.raw_value">
                                            <span role="alert" class="oe_kanban_mail_new" title="Unread Messages">
                                                <i class="fa fa-comments" aria-label="Messages" role="img"/>
                                                <t t-raw="record.message_needaction_counter.raw_value"/>
                                            </span>
                                        </t>
                                        <div class="o_kanban_inline_block">
                                            <field name="activity_ids" widget="kanban_activity"/>
                                        </div>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <img t-att-src="kanban_image('sicpro.app.clientes', 'image_128', record.partner_id.raw_value)"
                                             t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"
                                             class="oe_kanban_avatar float-right"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

    <record  id="solicitudes_inversionista_calendar" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.inversionista.calendar</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="priority" eval="2"/>
            <field name="arch" type="xml">
                <calendar string="Iniciativas" mode="month" date_start="activity_date_deadline" color="user_id"
                          hide_time="true" event_limit="5">
                    <!--<field name="planned_revenue"/> -->
                    <field name="partner_id" avatar_field="image_128"/>
                </calendar>
            </field>
        </record>

    <record id="solicitudes_inversionista_activity" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.inversionista.activity</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="arch" type="xml">
                <activity string="Iniciativas y oportunidades">
                    <field name="partner_id"/>
                  <!--  <field name="company_currency"/> -->
                    <templates>
                        <div t-name="activity-box">
                            <img t-att-src="activity_image('sicpro.app.clientes', 'image_128', record.partner_id.raw_value)"
                                 t-att-title="record.partner_id.value" t-att-alt="record.partner_id.value"/>
                            <div>
                                <field name="name" display="full"/>
                               <!-- <field name="planned_revenue" widget="monetary" display="full" muted="1"/> -->
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

    <record id="solicitudes_inversionista_search" model="ir.ui.view">
            <field name="name">sicpro.app.solicitudes.inversionista.search</field>
            <field name="model">sicpro.app.solicitudes.oportunidades</field>
            <field name="arch" type="xml">
                <search string="Buscar iniciativas">
                    <field name="name" string="Iniciativas" filter_domain="['|','|','|',('partner_name', 'ilike', self),
                    ('partner_id', 'ilike', self), ('name', 'ilike', self)]"/>
                    <field name="tag_ids" string="Etiquetas" filter_domain="[('tag_ids', 'ilike', self)]"/>
                    <field name="partner_id"/>
                    <field name="team_id"/>
                    <separator />
                    <filter string="Nuevas Solicitudes" name="estado_interno" domain="[('estado_interno', '=', 'nuevo')]"/>
                    <separator/>
                    <filter string="Fecha de Solicitud" name="fecha_solicitud" date="fecha_solicitud"/>
                    <separator/>
                    <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                    <field name="anio" string="Año"/>
                    <group expand="0" string="Agrupar por">
                        <filter string="Cliente" name="partner_id" context="{'group_by':'partner_id'}"/>
                        <filter string="Territorio" name="territorio_id" context="{'group_by':'territorio_id'}"/>
                        <filter name="provincia_id" string="Provincia" context="{'group_by': 'provincia_id'}"/>
                        <filter string="Prioridad" name="priority" context="{'group_by':'priority'}" />
                        <filter string="Proceso Ejecutor" name="company_id" context="{'group_by':'company_id'}"/>
                        <separator orientation="vertical" />
                        <filter string="Fecha de creación" context="{'group_by':'fecha_solicitud:month'}" name="month"/>
