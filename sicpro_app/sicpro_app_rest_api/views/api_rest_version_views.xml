<?xml version="1.0" encoding="UTF-8"?>

<odoo>


    <record model="ir.ui.view" id="view_api_rest_version_tree">
        <field name="name">api.rest.version.tree</field>
        <field name="model">api.rest.version</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree string="Versiones" decoration-muted="not active">
                <field name="active"/>
                <field name="name"/>
                <field name="description"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="view_api_rest_version_form">
        <field name="name">api.rest.version.form</field>
        <field name="model">api.rest.version</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Versión">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" class="oe_stat_button"
                                icon="fa-globe" name="go_to_api_docs">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">
                                    Ir a <br/>Consulta API</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Inactive" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group string="Información de la API">
                        <field name="active" widget="boolean_toggle"/>
                        <field name="description"/>
                        <field name="active_log" widget="boolean_toggle"/>
                        <field name="last_usage_date" readonly="1"
                               attrs="{'invisible': [('active_log', '=', False)]}"/>
                    </group>
                    <notebook colspan="4">
                        <page string="Directorios">
                            <field name="path_ids"
                                   context="{'default_version_id': active_id}"
                                   nolabel="1" />
                        </page>
                        <page string="Seguridad">
                            <field name="user_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="api_rest_key"/>
                                    <button type="object" class="oe_highlight"
                                            name="generate_api_rest_key"
                                            string="Generar clave API"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="name"/>
                                            <field name="api_rest_key"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Registros"
                              attrs="{'invisible': [('active_log', '=', False)]}">
                            <field name="log_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_api_rest_version">
        <field name="name">Versiones</field>
        <field name="res_model">api.rest.version</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'active_test': False}</field>
    </record>


</odoo>
