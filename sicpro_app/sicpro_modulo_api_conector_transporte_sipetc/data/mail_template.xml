<odoo>
  <data noupdate="0">
    <!-- Plantilla SipeTC actualizado con éxito -->
    <record id="transporte_conector_rest_api_exito" model="mail.template">
      <field name="name">Conector API-Transporte: Actualización RestApi exitosa</field>
      <field name="model_id" ref="sicpro_modulo_api_conector.model_sicpro_modulo_api_conector"/>
      <field name="email_from">"SICPRO ERP" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
      <field name="subject">SICPRO ERP-Conector API: Se ha ejecutado la actualización RestApi correctamente.</field>
      <field name="body_html" type="html">
        <table style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;" cellspacing="0" cellpadding="0" border="0">
          <tbody>
            <tr>
              <td align="center">
                <table style="padding:16px;background-color: white; color: #454748; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <!-- ENCABEZADO -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td valign="middle">
                                <span style="font-size:10px;">Bienvenido/a a SICPRO</span>
                                <br/>
                                <span style="font-size:20px;font-weight: bold;"> Aplicación: <t t-out="object.name"/></span>
                              </td>
                              <td valign="middle" align="right">
                                <img src="/sicpro_app_administracion/static/src/img/logo_sicpro 4.png" style="padding:0px;margin: 0px; height: auto; width: 25%;"/>
                              </td>
                            </tr>
                            <tr>
                              <td colspan="2" style="text-align:center;">
                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;" width="100%"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                    <!-- CONTENIDO -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td style="font-size:13px;" valign="top">
                                <div>Ha sido ejecutado correctamente la importación de datos del RestApi al sistema SICPRO ERP.
                                  <br/><br/>
                                  <div style="margin:16px 0px 16px 0px;">
                                    <t t-set="website_url" t-value="object.get_base_url()"/>
                                    <a t-att-href='website_url' style="background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">Iniciar Sesión</a>
                                  </div>
                                  <br/><br/><br/>
                                  --<br/>Equipo de administración SICPRO ERP.
                                </div>
                              </td>
                            </tr>
                            <tr>
                              <td style="text-align:center;">
                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;" width="100%"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                    <!-- PIE -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td valign="middle" align="left">
                                <t t-out="object.company_id.name"/>
                              </td>
                            </tr>
                            <tr>
                              <td style="opacity:0.7;" valign="middle" align="left">
                                <t t-out="object.company_id.phone"/>
                                <t t-if="object.company_id.email">
                                  | <a t-att-href="'mailto:%s' % object.company_id.email" style="color:#454748;"><t t-out="object.company_id.email"/></a>
                                </t>
                                <t t-if="object.company_id.website">
                                  | <a t-att-href="'%s' % object.company_id.website" style="color:#454748;"><t t-out="website_url"/></a>
                                </t>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
            <!-- POWERED BY -->
            <tr>
              <td style="min-width:590px;" align="center">
                <br/>
                <table style="min-width:590px;background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <tr>
                      <td style="text-align:center;font-size: 13px;">
                        Recibes notificaciones con la tecnología de <b><a target="_blank" style="color:#875A7B;"><font style="color:rgb(7, 140, 7);">SICPRO</font></a><br/></b>
                      </td>
                    </tr>
                    <tr>
                      <td style="text-align:center;font-size: 13px;">
                        <p>
                          <font style="font-size:10px;" class="text-600">© 2019 - 2026 División de Proyectos y Ejecución de Obras, DVPE.</font>
                          <br/>
                          <font style="font-size:10px;" class="text-600">Edificio Masónico, Ave. Carlos III / Calle Santiago y Belascoain.</font>
                        </p>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
      </field>
    </record>

    <!-- Plantilla SipeTC actualizado con fallida -->
    <record id="transporte_conector_rest_api_fallida" model="mail.template">
      <field name="name">Conector API-Transporte: Actualización RestApi Fallida</field>
      <field name="model_id" ref="sicpro_modulo_api_conector.model_sicpro_modulo_api_conector"/>
      <field name="email_from">"SICPRO ERP" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
      <field name="subject">SICPRO ERP-Conector API: La actualización del RestApi no se ha ejecutado correctamente.</field>
      <field name="body_html" type="html">
        <table style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;" cellspacing="0" cellpadding="0" border="0">
          <tbody>
            <tr>
              <td align="center">
                <table style="padding:16px;background-color: white; color: #454748; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <!-- CONTENIDO DE FALLO (SIMILAR AL ANTERIOR) -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;" width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td style="font-size:13px;" valign="top">
                                <div>No se ha ejecutado correctamente la importación de datos del RestApi al sistema SICPRO ERP. Verifíquelo.
                                  <div style="margin:16px 0px 16px 0px;">
                                    <t t-set="website_url" t-value="object.get_base_url()"/>
                                    <a t-att-href='website_url' style="background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">Iniciar Sesión</a>
                                  </div>
                                  <br/><br/><br/>
                                  --<br/>Equipo de administración SICPRO ERP.
                                </div>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>
      </field>
    </record>
  </data>
</odoo>