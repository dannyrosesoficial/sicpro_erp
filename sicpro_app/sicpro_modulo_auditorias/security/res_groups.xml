<odoo>
  <record model="ir.module.category" id="security_auditlog_groups">
    <field name="name">Registro de auditoría</field>
  </record>

  <record model="res.groups.privilege" id="res_groups_privilege_auditlog">
    <field name="name">Registros de auditoría</field>
    <field name="category_id" ref="security_auditlog_groups"/>
    <field name="sequence">99</field>
  </record>

  <record model="res.groups" id="group_auditlog_user">
    <field name="name">Usuario</field>
    <field name="privilege_id" ref="res_groups_privilege_auditlog"/>
  </record>

  <record model="res.groups" id="group_auditlog_manager">
    <field name="name">Administrador</field>
    <field name="privilege_id" ref="res_groups_privilege_auditlog"/>
    <field
        name="implied_ids"
        eval="[Command.link(ref('sicpro_modulo_auditorias.group_auditlog_user'))]"
    />
  </record>

  <record id="base.group_system" model="res.groups">
    <field
        name="implied_ids"
        eval="[Command.link(ref('sicpro_modulo_auditorias.group_auditlog_manager'))]"
    />
  </record>
</odoo>
