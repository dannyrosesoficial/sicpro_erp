<templates id="template" xml:space="preserve">

    <t t-name="hr_resume_renderer_owl">
        <div class="o_resume_table_container">
            <table class="o_resume_table table-borderless w-100">
                <t t-foreach="groupedData" t-as="groupKey" t-key="groupKey">
                    <t t-set="group" t-value="groupedData[groupKey]"/>

                  <t t-call="hr_resume_group_row">
                        <t t-set="props" t-value="{group: {value: group.name}}"/>
                    </t>

                  <t t-foreach="group.records" t-as="record" t-key="record.id">
                        <t t-call="hr_resume_data_row">
                            <t t-set="props" t-value="{record: record, isLast: record_last}"/>
                        </t>
                    </t>

                  <tr t-if="!props.list.readonly">
                        <td colspan="100%">
                            <t t-call="group_add_item">
                                <t t-set="props" t-value="{
                                    context: {['default_' + props.groupByField]: groupKey !== 'undefined' ? parseInt(groupKey) : false},
                                    onAdd: props.list.add
                                }"/>
                            </t>
                        </td>
                    </tr>
                </t>

              <t t-if="props.list.records.length === 0">
                    <t t-call="group_add_item">
                        <t t-set="props" t-value="{context: {}, onAdd: props.list.add}"/>
                    </t>
                </t>
            </table>
        </div>
    </t>

  <t t-name="hr_resume_data_row">
        <tr class="o_data_row" t-attf-class="#{props.isLast ? 'o_data_row_last' : ''}" t-att-data-id="props.record.id">
            <t t-if="props.record.data.display_type === 'classic'">
                <td class="o_resume_timeline_cell position-relative pe-lg-2">
                    <div class="rounded-circle bg-info position-relative"/>
                </td>
              <td class="o_data_cell pt-0 w-100">
                    <div class="o_resume_line" t-att-data-id="props.record.id">
                        <small class="o_resume_line_dates">
                            <strong t-esc="props.record.data.date_start"/> - <strong
                            t-esc="props.record.data.date_end"/>
                        </small>
                      <h4 class="o_resume_line_title mt-2" t-esc="props.record.data.name"/>
                      <p t-if="props.record.data.description" class="o_resume_line_desc"
                         t-esc="props.record.data.description"/>
                    </div>
                </td>
            </t>

          <t t-elif="props.record.data.display_type === 'certification'">
                <td class="o_data_cell container-fluid" colspan="2">
                    <div class="o_resume_line row" t-att-data-id="props.record.id">
                        <div class="o_resume_line_dates col-lg-3">
                            <span t-esc="props.record.data.date_start"/>
                        </div>
                      <div class="o_resume_line_desc col-lg-8">
                            <h3 t-esc="props.record.data.name"/>
                        <t t-if="props.record.data.description" t-esc="props.record.data.description"/>
                        </div>
                      <div class="o_resume_line_icon icon_trophy col-lg-1 text-end">
                            <i class="fa fa-trophy fa-2x text-warning"></i>
                        </div>
                    </div>
                </td>
            </t>

          <t t-elif="props.record.data.display_type === 'homologar'">
                <td class="o_data_cell container-fluid" colspan="2">
                    <div class="o_resume_line row" t-att-data-id="props.record.id">
                        <div class="o_resume_line_dates col-lg-3">
                            <span class="badge rounded-pill bg-secondary">Expira: <t
                                t-esc="props.record.data.fecha_expiracion"/></span>
                        </div>
                      <div class="o_resume_line_desc col-lg-8">
                            <h3 t-esc="props.record.data.name"/>
                        <t t-if="props.record.data.description" t-esc="props.record.data.description"/>
                        </div>
                      <div class="o_resume_line_icon icon_certificar col-lg-1 text-end">
                            <i class="fa fa-star fa-2x text-primary"></i>
                        </div>
                    </div>
                </td>
            </t>
          <t t-if="!props.list.readonly">
                <t t-call="hr_trash_button"/>
            </t>
        </tr>
    </t>

  <t t-name="hr_skills_renderer_owl">
        <table class="table table-sm o_main_table">
            <t t-foreach="groupedData" t-as="groupKey" t-key="groupKey">
                <t t-set="group" t-value="groupedData[groupKey]"/>
              <t t-call="hr_resume_group_row">
                    <t t-set="props" t-value="{group: {value: group.name}}"/>
                </t>
              <t t-foreach="group.records" t-as="record" t-key="record.id">
                    <tr class="o_data_row">
                        <td class="o_data_cell w-100">
                            <span t-esc="record.data.skill_id[1]"/>
                        </td>
                      <td class="o_data_cell">
                            <span t-esc="record.data.skill_level_id[1]"/>
                        </td>
                      <td class="o_data_cell">
                            <ProgressBarField record="record" name="'level_progress'"/>
                        </td>
                      <t t-if="!props.list.readonly">
                            <t t-call="hr_trash_button">
                                <t t-set="props" t-value="{record: record}"/>
                            </t>
                        </t>
                    </tr>
                </t>
            </t>
        </table>
    </t>

  <t t-name="hr_trash_button">
        <td class="o_list_record_remove pe-3 text-end">
            <button type="button" class="btn btn-link text-danger p-0" t-on-click="() => props.record.delete()">
                <i class="fa fa-trash-o"/>
            </button>
        </td>
    </t>

  <t t-name="hr_resume_group_row">
        <tr class="o_resume_group_header">
            <td class="o_group_name" colspan="100%">
                <div class="o_horizontal_separator my-2 fw-bold" t-esc="props.group.value"/>
            </td>
        </tr>
    </t>

  <t t-name="group_add_item">
        <div
            t-attf-class="o_field_x2many_list_row_add p-2 #{Object.keys(props.context || {}).length === 0 ? 'd-block w-100 text-center' : 'float-end'}">
            <button type="button"
                    t-attf-class="btn #{Object.keys(props.context || {}).length === 0 ? 'btn-primary' : 'btn-secondary btn-sm'}"
                    t-on-click="() => props.onAdd({ context: props.context })">
                    <t t-if="Object.keys(props.context || {}).length === 0">CREAR UNA NUEVA ENTRADA</t>
              <t t-else="">AGREGAR</t>
            </button>
        </div>
    </t>

</templates>
