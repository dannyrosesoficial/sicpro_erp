<?xml version="1.0" encoding="utf-8"?>
<odoo><data>

    <record id="trabajadores_equipo_tecnico_search" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.equipo.tecnico.search</field>
        <field name="model">sicpro.app.trabajadores.equipo.tecnico</field>
        <field name="arch" type="xml">
            <search string="Equipo Técnico">
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <field name="name"/>
                <field name="lider"/>
                <group expand="0" string="Group By...">
                    <filter string="Lider de Equipo" name="lider_equipo" domain="[]" context="{'group_by':'lider'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="trabajadores_equipo_tecnico_view_form" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.equipo.tecnico.form</field>
        <field name="model">sicpro.app.trabajadores.equipo.tecnico</field>
        <field name="arch" type="xml">
            <form string="Equipo Técnico">
                <sheet>
                    <div name="button_box" class="oe_button_box">
                          <button class="oe_stat_button" icon="fa-users">
                              <field string="Trabajadores" name="trabajadores_count" widget="statinfo"/>
                          </button>
                      </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Equipo Técnico"/>
                        <h1>
                            <field name="name" placeholder="Nombre del Equipo Técnico..."/>
                        </h1>
                        <div name="options_active" />
                    </div>
                    <group>
                        <group name="left">
                            <field name="active" invisible="1"/>
                            <label for="lider" string="Lider de Equipo"/>
                            <div class="o_address_format">
                                <field name="lider" class="o_address_street"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="lider_ocupacion_id" class="o_address_street"/>
                                <field name="lider_movil_trabajo" class="o_address_street"/>
                                <field name="lider_correo_trabajo" class="o_address_street"/>
                            </div>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group name="right">
                        </group>
                    </group>
                    <notebook>
                        <page name="members" string="Miembros del equipo" >
                            <field name="member_ids" widget="many2many">
                                <kanban quick_create="false" create="true" delete="true">
                                    <field name="id"/>
                                    <field name="name"/>
                                    <field name="ocupacion_id"/>
                                    <field name="movil_trabajo"/>
                                    <field name="correo_trabajo"/>
                                    <field name="color"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                        <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click oe_applicant_kanban oe_semantic_html_override">
                                            <div class="oe_kanban_global_click" style="max-width: 200px">
                                                <div class="o_kanban_record_top">
                                                    <img t-att-src="kanban_image('sicpro.app.trabajadores', 'image_128', record.id.raw_value)" class="oe_avatar oe_kanban_avatar_smallbox o_image_40_cover mb0" alt="Avatar"/>
                                                    <div class="o_kanban_record_headings ml8">
                                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                                    <div>
                                                        <small><field name="ocupacion_id"/></small>
                                                        <strong><field name="movil_trabajo"/></strong>
                                                        <field name="correo_trabajo"  widget="email"/>
                                                    </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>

                        <page name="areas" string="Áreas Asociados" >
                            <field name="areas_ids" widget="many2many">
                                <kanban quick_create="false" create="true" delete="true">
                                    <field name="name"/>
                                    <field name="centro_costo"/>
                                    <field name="manager_id"/>
                                    <field name="parent_id"/>
                                    <field name="company_id"/>
                                    <field name="color"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                        <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click oe_applicant_kanban oe_semantic_html_override">
                                            <div class="oe_kanban_global_click" style="max-width: 200px">
                                                <div class="o_kanban_record_top">
                                                    <div class="o_kanban_record_headings ml8">
                                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                                    <div>
                                                        <small><field name="company_id"/></small>
                                                    </div>
                                                        <div>
                                                            <strong><field name="manager_id"/></strong>
                                                        </div>
                                                        <div>
                                                            <field name="centro_costo"/>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        </t>

                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="trabajadores_equipo_tecnico_view_tree" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.equipo.tecnico.tree</field>
        <field name="model">sicpro.app.trabajadores.equipo.tecnico</field>
        <field name="field_parent">child_ids</field>
        <field name="arch" type="xml">
            <tree string="Equipo Técnico" sample="1" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="active" invisible="1"/>
                <field name="lider" />
                <field name="member_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="trabajadores_equipo_tecnico_view_kanban" model="ir.ui.view">
        <field name="name">crm.team.kanban</field>
        <field name="model">sicpro.app.trabajadores.equipo.tecnico</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="trabajadores_count"/>
                <field name="company_id"/>
                <field name="color"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click oe_applicant_kanban oe_semantic_html_override">
                            <div class="o_dropdown_kanban dropdown">
                            <a class="dropdown-toggle o-no-caret btn" role="button" data-toggle="dropdown"
                               data-display="static" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                <span class="fa fa-ellipsis-v"/>
                            </a>
                            <div class="dropdown-menu" role="menu">
                                <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Editar</a>
                                </t>
                                <t t-if="widget.deletable"><a role="menuitem" type="delete"
                                                              class="dropdown-item">Eliminar</a>
                                </t>
                                <ul class="oe_kanban_colorpicker" data-field="color"/>
                            </div>
                        </div>
                            <div class="oe_kanban_content">
                            <div class="row">
                                <div class="col-8 o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="col-4">
                                    <strong>Lider: </strong>
                                    <span>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span><field name="member_ids" widget="many2many_tags"
                                                 options="{'color_field': 'color'}"/></span>
                                </div>

                                 <div class="col-12">
                                    <span class="float-right">
                                        <span class="fa fa-users text-black-50">: <field name="trabajadores_count"/></span>
                                    </span>
                                </div>
                            </div>
                        </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="trabajadores_equipo_tecnico_action" model="ir.actions.act_window">
        <field name="name">Equipo Técnico</field>
        <field name="res_model">sicpro.app.trabajadores.equipo.tecnico</field>
        <field name="view_id" ref="trabajadores_equipo_tecnico_search"/>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aquí define el equipo técnico que atiende la gestión de Capital Humano
            </p>
        </field>
    </record>

</data>
</odoo>
