<odoo>
  <record id="trabajadores_claves_hl_form_view" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.claves.form.view</field>
    <field name="model">sicpro.app.trabajadores.claves.horas</field>
    <field name="arch" type="xml">
      <form string="Claves Horas Labor">
        <sheet>
          <group>
            <field name="name"/>
            <field name="descripcion"/>
            <field name="active" invisible="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="trabajadores_claves_hl_list_view" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.claves.list.view</field>
    <field name="model">sicpro.app.trabajadores.claves.horas</field>
    <field name="arch" type="xml">
      <list string="Claves Horas Labor" editable="bottom">
        <field name="name"/>
        <field name="descripcion"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="trabajadores_claves_hl_filter_view" model="ir.ui.view">
    <field name="name">Bsicpro.app.trabajadores.claves.search</field>
    <field name="model">sicpro.app.trabajadores.claves.horas</field>
    <field name="arch" type="xml">
      <search string="Buscar Claves">
        <field name="name" string="Claves"/>
        <field name="descripcion" string="Descripción"/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
      </search>
    </field>
  </record>

  <record id="action_trabajadores_claves_hl" model="ir.actions.act_window">
    <field name="name">Claves de Horas Labor</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.trabajadores.claves.horas</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
