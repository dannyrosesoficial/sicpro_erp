<odoo>
  <record model='ir.ui.view' id='documentos_trabajador_form_view'>
    <field name="name">hr.employee.document.form</field>
    <field name="model">sicpro.app.trabajadores.documentos</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="active" invisible="1"/>
              <field name="name"/>
              <field name="trabajadores_id"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="tipo_documento"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </group>
            <group>
              <field name="fecha_agregado"/>
              <field name="fecha_expira"/>
            </group>
          </group>
          <notebook>
            <page string="Descripción">
              <field name="descripcion"/>
            </page>
          </notebook>
        </sheet>
        <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
      </form>
    </field>
  </record>

  <record model='ir.ui.view' id='documentos_trabajador_list_view'>
    <field name="name">hr.employee.document.list</field>
    <field name="model">sicpro.app.trabajadores.documentos</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="trabajadores_id" string="Employee"/>
        <field name="tipo_documento"/>
        <field name="fecha_expira"/>
      </list>
    </field>
  </record>

  <record id="search_documentos_trabajador" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.documentos.search</field>
    <field name="model">sicpro.app.trabajadores.documentos</field>
    <field name="arch" type="xml">
      <search string="Documentos del Trabajador">
        <field name="name"/>
        <field name="trabajadores_id"/>
        <field name="tipo_documento"/>
        <separator/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        <separator/>
        <group>
          <filter name="trabajador" string="Trabajador" context="{'group_by':'trabajadores_id'}"/>
          <filter string="Fecha Expiración" name="fecha_expira" context="{'group_by': 'fecha_expira'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="documentos_trabajador_action" model="ir.actions.act_window">
    <field name="name">Documentos del Trabajador</field>
    <field name="res_model">sicpro.app.trabajadores.documentos</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="documentos_trabajador_list_view"/>
    <field name="context">{'search_default_Employee': 1}</field>
  </record>
</odoo>
