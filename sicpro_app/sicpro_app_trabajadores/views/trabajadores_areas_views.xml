<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_department_form" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.areas.form</field>
            <field name="model">sicpro.app.trabajadores.areas</field>
            <field name="arch" type="xml">
                <form string="Departamento">
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <div class="oe_title">
                        <field name="active" invisible="1"/>
                        <field name="tipo_registro" widget="radio" class="oe_edit_only" options="{'horizontal': true}"/>
                        </div>
                        <group>
                        <group>
                            <field name="company_id"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="departamento_ids"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="parent_id"/>
                            <field name="equipo_tecnico_id" readonly="1"/>
                            </group>
                            <group>
                              <field name="manager_id"/>
                              <field name="manager_id_hide" invisible="1"/>
                            <field name="centro_costo"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="local" mode="tree">
                              <tree editable="bottom">
                               <field name="name"/>
                              </tree>
                             </field>
                            <field name="name" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_department_tree" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.areas.tree</field>
            <field name="model">sicpro.app.trabajadores.areas</field>
            <field name="arch" type="xml">
                <tree string="Departamentos">
                    <field name="departamento_ids"/>
                    <field name="manager_id"/>
                    <field name="parent_id"/>
                    <field name="centro_costo"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="view_department_filter" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.areas.search</field>
            <field name="model">sicpro.app.trabajadores.areas</field>
            <field name="arch" type="xml">
                <search string="Departamentos">
                    <field name="name" string="Área"/>
                    <field name="manager_id" />
                    <separator/>
                    <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="name" string="Área" context="{'group_by': 'name'}"/>
                        <filter name="company_id" string="Proceso" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
             </field>
        </record>

        <record id="trabajadores_departamentos_view_kanban" model="ir.ui.view" >
            <field name="name">sicpro.app.trabajadores.areas.kanban</field>
            <field name="model">sicpro.app.trabajadores.areas</field>
            <field name="arch" type="xml">
                <kanban class="oe_background_grey o_kanban_dashboard o_hr_kanban">
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="manager_id"/>
                    <field name="color"/>
                    <field name="centro_costo"/>
                    <field name="local"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="#{!selection_mode ? kanban_color(record.color.raw_value) : ''}">
                                <div t-attf-class="o_kanban_card_header">
                                    <div class="o_kanban_card_header_title">
                                        <div class="o_primary"><field name="name"/></div>
                                        <div class="text-danger"><b><field name="company_id"/></b></div>
                                    </div>
                                    <div class="o_kanban_manage_button_section" t-if="!selection_mode">
                                        <a class="o_kanban_manage_toggle_button" href="#">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="container o_kanban_card_content" t-if="!selection_mode">
                                    <div class="row">
                                        <div class="col-6 o_kanban_primary_left">
                                            <button class="btn btn-primary" name="%(act_trabajadores_en_areas)d"
                                                    type="action">Trabajadores</button>
                                        </div>
                                        <div class="col-6 o_kanban_primary_right">
                                           <div class="o_secondary"><field name="centro_costo"/></div>
                                        </div>
                                    </div>
                                </div>
                                <div class="container o_kanban_card_manage_pane dropdown-menu" role="menu">
                                    <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                        <div role="menuitem" aria-haspopup="true" class="col-8">
                                            <ul class="oe_kanban_colorpicker" data-field="color" role="menu"/>
                                        </div>
                                        <div class="col-4 text-right">
                                            <a role="menuitem" type="edit">Configurar</a>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="open_module_tree_department" model="ir.actions.act_window">
            <field name="name">Áreas</field>
            <field name="res_model">sicpro.app.trabajadores.areas</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="view_department_filter"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear una nueva Área de trabajo
              </p><p>
                Aquí podría crear y controlar las áreas de sus procesos.
              </p>
            </field>
        </record>
    </data>
</odoo>
