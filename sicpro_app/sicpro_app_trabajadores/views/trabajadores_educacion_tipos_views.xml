<odoo>
  <record id="trabajadores_educacion_tipo_list_view" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.educacion.tipos.list.view</field>
    <field name="model">sicpro.app.trabajadores.educacion.tipos</field>
    <field name="arch" type="xml">
      <list name="Tipos de líneas de Educación" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="company_id" invisible="1"/>
        <field name="company_currency" invisible="1"/>
        <field name="pago"/>
        <field name="ch"/>
      </list>
    </field>
  </record>

  <record id="trabajadores_educacion_tipo_action" model="ir.actions.act_window">
    <field name="name">Tipos de líneas de Educación</field>
    <field name="res_model">sicpro.app.trabajadores.educacion.tipos</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
