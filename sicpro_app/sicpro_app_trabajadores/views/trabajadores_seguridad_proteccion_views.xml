<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
         <record id="view_trabajadores_seguridad_proteccion_tree" model="ir.ui.view">
             <field name="name">sicpro.app.trabajadores.seguridad.proteccion.tree</field>
             <field name="model">sicpro.app.trabajadores.seguridad.proteccion</field>
             <field name="arch" type="xml">
                 <tree string="Módulos de Seguridad y Protección" editable="bottom">
                     <field name="codigo"/>
                     <field name="name"/>
                     <field name="vida_util"/>
                     <field name="company_currency_id" invisible="1" />
                     <field name="precio" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                     <field name="cantidad"/>
                     <field name="unida_medida"/>
                     <field name="cargo"/>
                 </tree>
             </field>
         </record>

         <record id="trabajadores_seguridad_proteccion_view_action" model="ir.actions.act_window">
             <field name="name">Módulos de Seguridad y Protección</field>
             <field name="res_model">sicpro.app.trabajadores.seguridad.proteccion</field>
             <field name="view_mode">tree</field>
         </record>

     </data>
 </odoo>
