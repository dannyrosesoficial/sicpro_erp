<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="trabajadores_cargo_trabajador_form_view" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.cargos.form</field>
        <field name="model">sicpro.app.trabajadores.cargos</field>
        <field name="arch" type="xml">
            <form string="Cargo del Trabajador">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_currency_id" invisible="1" />
                            <field name="salario" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                            <field name="alimentacion" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                        </group>
                    </group>
                    <div>
                        <label for="descripcion"/>
                        <field name="descripcion"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="trabajadores_cargo_trabajador_tree_view" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.cargos.tree</field>
        <field name="model">sicpro.app.trabajadores.cargos</field>
        <field name="arch" type="xml">
            <tree string="Cargo del Trabajador" editable="bottom">
                <field name="name"/>
                <field name="descripcion"/>
                <field name="company_currency_id" invisible="1" />
                <field name="salario" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                <field name="alimentacion" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
            </tree>
        </field>
    </record>

    <record id="trabajadores_cargo_trabajador_filter_view" model="ir.ui.view">
       <field name="name">sicpro.app.trabajadores.cargos.search</field>
       <field name="model">sicpro.app.trabajadores.cargos</field>
        <field name="arch" type="xml">
            <search string="Cargo del Trabajador">
            <field name="name"/>
            <field name="company_id"/>
            <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
            <group expand="0" string="Group By">
                <filter string="Proceso" name="company_id" domain="[]" context="{'group_by':'company_id'}"/>
            </group>
        </search>
       </field>
    </record>

    <record id="action_trabajadores_cargo_trabajador" model="ir.actions.act_window">
        <field name="name">Cargo del Trabajador</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.trabajadores.cargos</field>
        <field name="view_mode">tree,form</field>
    </record>


    </data>
</odoo>