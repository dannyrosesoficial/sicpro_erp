<odoo>
  <record id="trabajadores_cursos_niveles_view_list" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.niveles.list</field>
    <field name="model">sicpro.app.trabajadores.cursos.niveles</field>
    <field name="arch" type="xml">
      <list string="Nivel de habilidades">
        <field name="name"/>
        <field name="level_progress" widget="progressbar"/>
      </list>
    </field>
  </record>

  <record id="trabajadores_cursos_niveles_view_form" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.niveles.form</field>
    <field name="model">sicpro.app.trabajadores.cursos.niveles</field>
    <field name="arch" type="xml">
      <form string="Nivel de habilidades">
        <sheet>
          <group>
            <field name="name"/>
            <field name="level_progress" string="Progreso (%)"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="trabajadores_cursos_tipos_view_list" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.tipos.list</field>
    <field name="model">sicpro.app.trabajadores.cursos.tipos</field>
    <field name="arch" type="xml">
      <list string="Tipos de habilidades">
        <field name="name"/>
        <field name="skill_ids" widget="many2many_tags"/>
      </list>
    </field>
  </record>

  <record id="trabajadores_cursos_tipos_view_form" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.tipos.form</field>
    <field name="model">sicpro.app.trabajadores.cursos.tipos</field>
    <field name="arch" type="xml">
      <form string="Tipos de habilidades">
        <field name="id" invisible="1"/>
        <sheet>
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1>
              <field name="name" placeholder="Ej. Nombre del curso" required="True"/>
            </h1>
          </div>
          <group string="Habilidades">
            <field name="skill_ids" nolabel="1" context="{'default_skill_type_id': id}">
              <list editable="bottom">
                <field name="name"/>
              </list>
            </field>
          </group>
          <group string="Niveles">
            <field name="skill_level_ids" nolabel="1" context="{'default_skill_type_id': id}"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="trabajadores_cursos_habilidades_view_list" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.habilidades.list</field>
    <field name="model">sicpro.app.trabajadores.cursos.habilidades</field>
    <field name="arch" type="xml">
      <list string="Nivel de habilidades">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="trabajadores_cursos_habilidades_view_form" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.habilidades.form</field>
    <field name="model">sicpro.app.trabajadores.cursos.habilidades</field>
    <field name="arch" type="xml">
      <form string="Habilidades">
        <sheet>
          <field name="name"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="trabajadores_cursos_view_form" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.cursos.form</field>
    <field name="model">sicpro.app.trabajadores.cursos</field>
    <field name="arch" type="xml">
      <form string="Habilidades">
        <sheet>
          <group>
            <group>
              <field name="skill_type_id"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field
                  name="skill_id"
                  domain="[('skill_type_id', '=', skill_type_id)]"
                  options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </group>
            <group>
              <field name="skill_level_id" domain="[('skill_type_id', '=', skill_type_id)]"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="level_progress" widget="progressbar"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="trabajadores_cursos_habilidades_action" model="ir.actions.act_window">
    <field name="name">Tipos de Cursos</field>
    <field name="res_model">sicpro.app.trabajadores.cursos.tipos</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
