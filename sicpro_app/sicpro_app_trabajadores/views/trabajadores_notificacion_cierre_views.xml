<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="trabajadores_areas_tree" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.notificacion.cierre.tree</field>
        <field name="model">sicpro.app.trabajadores.notificacion.cierre</field>
        <field name="arch" type="xml">
            <tree string="Trabajadores" editable="bottom">
                <field name="name" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="correo_trabajo"/>
                 <field name="proceso"/>
            </tree>
        </field>
    </record>

    <record id="trabajadores_notificacion_cierre_action" model="ir.actions.act_window">
        <field name="name">Trabajadores a notificar cierre</field>
        <field name="res_model">sicpro.app.trabajadores.notificacion.cierre</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>