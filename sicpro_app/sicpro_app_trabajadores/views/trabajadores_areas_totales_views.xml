<odoo>
  <record id="view_list_trabajadores_areas_totales" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.areas.totales.list</field>
    <field name="model">sicpro.app.trabajadores.areas.totales</field>
    <field name="arch" type="xml">
      <list string="Totales por áreas" sample="1" create="false" decoration-danger="estado == 'error'">
        <field name="name"/>
        <field name="direccion"/>
        <field name="mes"/>
        <field name="anio"/>
        <field name="total"/>
        <field name="estado" class="font-weight-bold" widget="badge"
               decoration-danger="estado == 'error'" decoration-success="estado == 'ok'"/>
      </list>
    </field>
  </record>

  <record id="view_pivot_trabajadores_areas_totales" model="ir.ui.view">
  <field name="name">sicpro.app.trabajadores.areas.totales.pivot</field>
  <field name="model">sicpro.app.trabajadores.areas.totales</field>
  <field name="arch" type="xml">
    <pivot string="Análisis de los Totales por área" display_quantity="true" disable_linking="false" sample="1"
           default_order="total desc">
      <field name="direccion" type="row"/>
      <field name="name" type="row"/>
      <field name="mes" type="col"/>
      <field name="total" type="measure"/>
    </pivot>
  </field>
</record>

  <record id="view_filter_trabajadores_areas_totales" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.areas.totales.search</field>
    <field name="model">sicpro.app.trabajadores.areas.totales</field>
    <field name="arch" type="xml">
      <search string="Buscar">
        <field name="name"/>
        <field name="mes"/>
        <field name="anio"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <group>
          <filter string='Proceso' name="direccion" domain="[]"
                  context="{'group_by': 'direccion'}"/>
          <separator/>
          <filter string='Mes' name="mes" domain="[]" context="{'group_by': 'mes'}"/>
          <filter string='Año' name="anio" domain="[]" context="{'group_by': 'anio'}"/>
          <separator/>
          <filter string='Estado' name="estado" domain="[]" context="{'group_by': 'estado'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="trabajadores_areas_totales_action" model="ir.actions.act_window">
    <field name="name">Totales por áreas</field>
    <field name="res_model">sicpro.app.trabajadores.areas.totales</field>
    <field name="view_mode">list,pivot</field>
  </record>
</odoo>
