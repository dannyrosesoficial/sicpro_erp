<odoo>
  <record id="view_trabajadores_filtro" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.search</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="arch" type="xml">
      <search string="Trabajadores">
        <field name="name" string="Trabajador" filter_domain="[('name', 'ilike', self)]"/>
        <field name="plaza_id"/>
        <field name="identification_id"/>
        <field name="company_id"/>
        <field name="ocupacion_id"/>
        <field name="employee_skill_ids"/>
        <field name="resume_line_ids" string="Educación"
               filter_domain="['|', ('resume_line_ids.name', 'ilike', self),
                               ('resume_line_ids.description', 'ilike', self)]"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
        <filter string="Donantes" name="donante" domain="[('donante', '=', 'si')]"/>
        <group>
          <filter name="company_id" string="Proceso" context="{'group_by': 'company_id'}"/>
          <filter name="categoria_ocupacional" string="Categoría ocupacional"
                  context="{'group_by': 'categoria_ocupacional'}"/>
          <filter name="clase_contrato" string="Clase de Contrato"
                  context="{'group_by': 'clase_contrato'}"/>
          <filter name="group_manager" string="Responsable" context="{'group_by': 'parent_id'}"/>
          <filter name="group_department" string="Área" context="{'group_by': 'area_id'}"/>
          <filter name="group_job" string="Puesto de Trabajo" context="{'group_by': 'ocupacion_id'}"/>
          <filter name="grupo_sanguineo" string="Grupos Sanguíneos"
                  context="{'group_by': 'grupo_sanguineo'}"/>
        </group>
        <searchpanel>
          <field name="area_id" enable_counters="1" expand="1" icon="fa-building"/>
          <field name="ocupacion_id" enable_counters="1" icon="fa-users"/>
        </searchpanel>
      </search>
    </field>
  </record>

  <record id="view_trabajadores_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.kanban</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="priority">3</field>
    <field name="arch" type="xml">
      <kanban highlight_color="color" sample="1" duplicate="false">
        <field name="id"/>
        <field name="estado_conexion"/>
        <field name="user_id"/>
        <field name="image_128"/>
        <templates>
          <t t-name="menu" t-if="!selection_mode">
            <div class="container">
              <div class="o_kanban_card_manage_settings row">
                <div t-if="widget.editable" role="menuitem" aria-haspopup="true" class="col-6">
                  <field name="color" widget="kanban_color_picker"/>
                </div>
                <div class="col-6">
                  <a t-if="widget.editable" role="menuitem" class="dropdown-item" type="open">
                    Editar Trabajador
                  </a>
                </div>
              </div>
            </div>
          </t>
          <t t-name="card" class="flex-row">
            <aside>
              <t t-if="record.image_128.raw_value">
                <div class="o_kanban_image me-6">
                  <img alt="Trabajador"
                       t-att-src="'/web/image/sicpro.app.trabajadores/' + record.id.raw_value + '/image_128'"
                       class="img-fluid rounded"
                       style="width:100px; height:120px; object-fit: cover;"/>
                </div>
              </t>
              <div t-else=""
                   class="d-flex align-items-center justify-content-center bg-100 bg-gradient">
                <svg class="w-75 h-75 opacity-50" viewBox="0 0 20 20"
                     xmlns="http://www.w3.org/2000/svg">
                  <g fill="currentColor">
                    <path
                        d="M 10 11 C 4.08 11 2 14 2 16 L 2 19 L 18 19 L 18 16 C 18 14 15.92 11 10 11 Z"/>
                    <circle cx="10" cy="5.5" r="4.5"/>
                  </g>
                </svg>
              </div>
            </aside>
            <main class="ms-2">
              <div>
                <div t-if="record.estado_conexion.raw_value" class="float-end">
                  <strong class="o_kanban_record_title">
                    <div class="float-right"
                         t-if="record.estado_conexion.raw_value == 'present'">
                      <span class="fa fa-circle text-success" role="img"
                            aria-label="Presente"
                            title="Presente" name="presence_present"/>
                    </div>
                    <div class="float-right"
                         t-if="record.estado_conexion.raw_value == 'absent'">
                      <span class="fa fa-circle text-danger" role="img"
                            aria-label="Ausente"
                            title="Ausente" name="presence_absent"/>
                    </div>
                    <div class="float-right"
                         t-if="record.estado_conexion.raw_value == 'to_define'">
                      <span class="fa fa-circle text-warning" role="img"
                            aria-label="Sin Usuario" title="Sin Usuario"
                            name="presence_to_define"/>
                    </div>
                  </strong>
                </div>
                <span class="font-weight-bold">
                  <field class="fw-bold fs-5" name="name" placeholder="Nombre del trabajador"/>
                </span>
              </div>
              <div t-if="record.ocupacion_titulo.raw_value" class="text-truncate">
                <i class="fa fa-fw me-2 fa-suitcase text-primary" title="Ocupación"/>
                <field name="ocupacion_titulo"/>
              </div>

              <div t-if="record.correo_trabajo.raw_value">
                <i class="fa fa-fw me-2 fa-envelope text-primary" title="Email"/>
                <field name="correo_trabajo"/>
                <span t-if="record.correo_trabajo.raw_value">&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;</span>
                <i t-if="record.movil_trabajo.raw_value" class="fa fa-fw me-2 fa-phone text-primary" title="Celular"/>
                <field t-if="record.movil_trabajo.raw_value" name="movil_trabajo"/>
              </div>

              <div t-if="record.clase_contrato.raw_value">
                <i class="fa fa-fw me-2 fa-briefcase text-primary" title="Clase de contrato"/>
                <span style="color: red; font-weight: bold;">
                  <field name="clase_contrato"/>
                </span>
                <span t-if="record.categoria_ocupacional.raw_value">&amp;nbsp;&amp;nbsp;-&amp;nbsp;&amp;nbsp;</span>
                <span t-if="record.categoria_ocupacional.raw_value" style="color: black; font-weight: bold;">
                  <field name="categoria_ocupacional"/>
                </span>
              </div>

              <footer class="py-0">
                <div class="d-flex ms-auto">
                  <field name="user_id" widget="many2one_avatar_user" readonly="1"
                         class="mb-1 ms-2"/>
                  <field name="activity_ids" widget="kanban_activity" class="m-1 ms-2"/>
                </div>
              </footer>
            </main>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_trabajadores_form" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.form</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="priority" eval="1"/>
    <field name="arch" type="xml">
      <form string="Trabajadores" class='o_employee_form'>
        <header>
        </header>
        <field name="active" invisible="1"/>
        <field name="grupo_capacitador" invisible="1"/>
        <field name="grupo_seguridad_salud" invisible="1"/>
        <field name="user_partner_id" invisible="1"/>
        <field name="estado_conexion" invisible="1"/>
        <field name="last_activity" invisible="1"/>
        <sheet>
          <div name="button_box" class="oe_button_box">
            <button id="presencia_trabajador_button" class="oe_stat_button" disabled="1"
                    invisible="not last_activity or not user_id">
              <div role="img" class="fa fa-fw fa-circle text-success"
                   invisible="estado_conexion != 'present'" aria-label="Conectado" title="Conectado"/>
              <div role="img" class="fa fa-fw fa-circle text-warning"
                   invisible="estado_conexion != 'to_define'" aria-label="Away" title="Away"/>
              <div role="img" class="fa fa-fw fa-circle text-danger"
                   invisible="estado_conexion != 'absent'" aria-label="Desconectado" title="Desconectado"/>
              <div class="o_stat_info">
                <field name="last_activity_time" invisible="estado_conexion == 'present'"/>
                <span class="o_stat_text" invisible="estado_conexion != 'present'">Conectado</span>
                <span class="o_stat_text" invisible="estado_conexion == 'present'">Última vez</span>
              </div>
            </button>
            <button class="oe_stat_button" name="documentos_view" type="object" icon="fa-list-ol">
              <field string="Documentos" name="documentos_count" widget="statinfo"/>
            </button>
            <button name="disciplina_view" class="oe_stat_button" type="object" icon="fa-info-circle">
              <field string="Medidas" name="disciplina_count" widget="statinfo"/>
            </button>
          </div>

          <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active"/>

          <field name="image_1920" widget='image' class="oe_avatar" options='{"preview_image":"image_128"}'/>
          <div class="oe_title">
            <h1 class="d-flex flex-row">
              <field name="name" placeholder="Nombre del trabajador" required="1"
                     readonly="grupo_capacitador or grupo_seguridad_salud"/>
            </h1>
            <h2>
              <field name="ocupacion_titulo" placeholder="Puesto de Trabajo"/>
            </h2>
            <div class="o_row">
              <field name="clase_contrato" placeholder="Clase"
                     readonly="grupo_capacitador or grupo_seguridad_salud"
                     options="{'no_create': True, 'no_open': True}"/>
              <span class="mx-1">-</span>
              <field name="categoria_ocupacional" placeholder="Categoría"
                     readonly="grupo_capacitador or grupo_seguridad_salud"
                     options="{'no_create': True, 'no_open': True}"/>
            </div>
          </div>
          <group>
            <group string="Datos de Contacto">
              <field name="plaza_id" readonly="grupo_capacitador or grupo_seguridad_salud"/>
              <field name="movil_trabajo" widget="phone"/>
              <field name="telefono_trabajo" widget="phone"/>
              <field name="correo_trabajo" widget="email"/>
              <field name="importe" widget="monetary"/>
            </group>
            <group string="Estructura Organitativa">
              <field name="company_id" options="{'no_create': True}"/>
              <field name="area_id" options="{'no_create': True}"/>
              <field name="ocupacion_id" domain="[('area_id', '=', area_id)]" options="{'no_create': True}"/>
              <field name="parent_id" options="{'no_create': True}"/>
              <field name="centro_costo" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
              <field name="local_cc" domain="[('id', 'in', local_id)]" options="{'no_create': True}"/>
              <field name="local_id" invisible="1"/>
              <field name="qr_code" widget="image" class="oe_avatar m-0" style="max-width: 100px;"/>
            </group>
          </group>
          <notebook>
            <page name="public" string="Información del Trabajo">
              <div id="o_work_employee_container" class="d-lg-flex">
                <div id="o_work_employee_main" class="flex-grow-1">
                  <group string="Ubicación y Fechas">
                    <field name="fecha_incorporacion" readonly="grupo_capacitador or grupo_seguridad_salud"/>
                    <field name="inicio_contrato" readonly="grupo_capacitador or grupo_seguridad_salud"/>
                    <field name="ubicacion_laboral" placeholder="Oficina, Piso…"
                           readonly="grupo_capacitador or grupo_seguridad_salud"/>
                    <field name="fecha_baja" readonly="grupo_capacitador or grupo_seguridad_salud"/>
                  </group>
                  <group string="Planificación">
                    <field name="resource_calendar_id" options="{'no_create': True}"/>
                    <field name="tz"/>
                    <field name="color" widget="color_picker"/>
                  </group>
                </div>
              </div>
            </page>

            <page name="personal_information" string="Información Privada">
              <group>
                <group string="Contacto Privado">
                  <field name="direccion_privada"/>
                  <field name="direccion_carnet"/>
                  <field name="correo_privado" widget="email"/>
                  <field name="movil_privado" widget="phone"/>
                  <field name="telefono_privado" widget="phone"/>
                </group>
                <group string="Ciudadanía">
                  <field name="identification_id" required="1"/>
                  <field name="fecha_nacimiento"/>
                  <field name="genero"/>
                  <field name="raza" options='{"no_open": True, "no_create": True}'/>
                  <field name="estado_civil"/>
                </group>
              </group>

              <group>
                <group string="Dependientes">
                  <field name="madre"/>
                  <field name="padre"/>
                  <field name="hijos"/>
                </group>
                <group string="Educación">
                  <field name="nivel_escolar"/>
                  <field name="estudio_especialidad"/>
                  <field name="estudio_titulo"/>
                  <field name="estudio_graduacion"/>
                </group>
              </group>

              <group name="fam_ids" string="Nexo Familiar">
                <field name="nexo_familiar_ids" nolabel="1" colspan="2">
                  <list editable="bottom">
                    <field name="nombre" required="1"/>
                    <field name="relacion_id" required="1"/>
                    <field name="contacto"/>
                    <field name="cumple"/>
                  </list>
                </field>
              </group>

              <group>
                <group string="Emergencia">
                  <field name="emergencia_contacto"/>
                  <field name="emergencia_telefono"/>
                  <field name="donante"/>
                  <field name="grupo_sanguineo" invisible="donante != 'si'"/>

                  <div colspan="2" invisible="not grupo_sanguineo">
                    <div class="alert alert-info py-2 mt-2 w-100" role="alert">
                      <i class="fa fa-info-circle me-2" aria-label="Información de compatibilidad"/>
                      <strong>Compatibilidad Sanguínea:</strong>
                      <br/>
                      <span invisible="grupo_sanguineo != 'o_mas'">Da a: O+, A+, B+, AB+ | Recibe de: O+, O-</span>
                      <span invisible="grupo_sanguineo != 'o_menos'">Da a: TODOS | Recibe de: O-</span>
                      <span invisible="grupo_sanguineo != 'a_mas'">Da a: A+, AB+ | Recibe de: A+, A-, O+, O-</span>
                      <span invisible="grupo_sanguineo != 'a_menos'">Da a: A+, A-, AB+, AB- | Recibe de: A-, O-</span>
                      <span invisible="grupo_sanguineo != 'b_mas'">Da a: B+, AB+ | Recibe de: B+, B-, O+, O-</span>
                      <span invisible="grupo_sanguineo != 'b_menos'">Da a: B+, B-, AB+, AB- | Recibe de: B-, O-</span>
                      <span invisible="grupo_sanguineo != 'ab_mas'">Da a: AB+ | Recibe de: TODOS</span>
                      <span invisible="grupo_sanguineo != 'ab_menos'">Da a: AB+, AB- | Recibe de: AB-, A-, B-, O-</span>
                    </div>
                  </div>
                </group>

                <group string="Documentación y Salida">
                  <field name="pasaporte"/>
                  <field name="passport_expiry_date" invisible="not pasaporte"/>
                  <field name="passport_attachment_id" widget="many2many_binary" invisible="not pasaporte"/>
                  <field name="visa_no"/>
                  <field name="visa_expira"/>
                </group>
              </group>

              <group string="Salida del País" name="ext_movements">
                <group>
                  <field name="fecha_salida_pais"/>
                  <field name="fecha_regreso_pais"/>
                  <field name="permiso_trabajo"/>
                </group>
                <group>
                  <field name="incorporacion_trabajo"/>
                  <field name="fecha_baja"/>
                  <field name="motivo_salida"/>
                </group>
              </group>
            </page>

            <page name="educacion" string="Cursos y Educación">
              <group>
                <group>
                  <div class="o_hr_skills_group o_group_resume w-100">
                    <separator string="Resumen Académico"/>
                    <field mode="list" nolabel="1" name="resume_line_ids"
                           readonly="grupo_seguridad_salud">
                      <list>
                        <field name="line_type_id"/>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="display_type" column_invisible="True"/>
                      </list>
                    </field>
                  </div>
                </group>

                <group>
                  <div class="o_hr_skills_group o_group_skills w-100">
                    <separator string="Cursos Realizados"/>
                    <!--                           widget="hr_skills"-->
                    <field mode="list" nolabel="1" name="employee_skill_ids"
                           readonly="grupo_seguridad_salud">
                      <list>
                        <field name="skill_type_id" invisible="1"/>
                        <field name="skill_id"/>
                        <field name="skill_level_id"/>
                        <field name="level_progress" widget="progressbar"/>
                      </list>
                    </field>
                  </div>
                </group>
              </group>
            </page>

            <page name="salud" string="Instrucciones y Vacunación">
              <group>
                <group string='Instrucciones'>
                  <field name="intrucciones_ids" nolabel="1" mode="list">
                    <list create="false" edit="false" delete="false">
                      <field name="name" invisible="1"/>
                      <field name="tipo_intruccion" readonly="1"/>
                      <field name="instructor" readonly="1"/>
                      <field name="ocupacion_id" readonly="1"/>
                      <field name="fecha_desde" readonly="1"/>
                      <field name="evalucion" readonly="1"/>
                    </list>
                    <form create="false" edit="false" delete="false">
                      <sheet>
                        <group>
                          <field name="name" invisible="1"/>
                          <field name="tipo_intruccion" readonly="1"/>
                          <field name="instructor" readonly="1"/>
                          <field name="ocupacion_id" readonly="1"/>
                          <field name="fecha_desde" readonly="1"/>
                          <field name="evalucion" readonly="1"/>
                        </group>
                      </sheet>
                    </form>
                  </field>
                </group>

                <group string="Vacunación">
                  <field name="vacunacion_ids" class="col-lg-12" nolabel="1" mode="list">
                    <list create="false" edit="false" delete="false">
                      <field name="name" invisible="1"/>
                      <field name="tipo_vacuna" readonly="1"/>
                      <field name="fecha" readonly="1"/>
                    </list>
                    <form create="false" edit="false" delete="false">
                      <sheet>
                        <group>
                          <field name="name" invisible="1"/>
                          <field name="tipo_vacuna" readonly="1"/>
                          <field name="fecha" readonly="1"/>
                        </group>
                      </sheet>
                    </form>
                  </field>
                </group>
              </group>
            </page>

            <page name="proteccion" string="Medios de Protección">
              <group name="technical_fields">
                <field name="seguridad_ocupacion" invisible="1"/>
              </group>

              <group string='Medios de Seguridad y Protección' name="medios_seguridad_root">
                <field name="seguridad_ids"
                       nolabel="1"
                       mode="list"
                       colspan="2"
                       readonly="grupo_capacitador"
                       context="{'default_trabajador_id': id, 'default_cargo_get': seguridad_ocupacion}">
                  <list editable="bottom">
                    <field name="cargo_get" invisible="1"/>
                    <field name="trabajador_id" invisible="1"/>
                    <field name="cargo" invisible="1"/>
                    <field name="precio" invisible="1"/>
                    <field name="name"/>
                    <field name="talla" class="text-center text-warning"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="codigo"/>
                    <field name="vida_util"/>
                    <field name="unida_medida" class="text-center"/>
                    <field name="demanda" class="text-danger text-center" readonly="not name" required="name"/>
                    <field name="entregado" class="text-center" readonly="not demanda"/>
                    <field name="anio" class="text-center" options="{'no_create': True, 'no_open': True}"/>
                  </list>
                </field>
              </group>
            </page>

            <page name="notas_trabajador" string="Notas">
              <group string='Detalles del trabajador' name="detalles_active_group">
                <field name="notas"/>
              </group>
            </page>

            <page name="usuario_settings" string="Configuración de Usuario">
              <group>
                <group string='Estado' name="active_group">
                  <field name="user_id" readonly="1"
                         options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                  <field name="pin" readonly="1"/>
                </group>
                <group string="Atención">
                  <field name="equipo_tecnico"/>
                </group>
              </group>
            </page>
          </notebook>
        </sheet>
        <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
      </form>
    </field>
  </record>

  <record id="view_trabajadores_list" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.list</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="priority" eval="2"/>
    <field name="arch" type="xml">
      <list string="Trabajadores">
        <field name="company_id"/>
        <field name="area_id"/>
        <field name="plaza_id"/>
        <field name="name"/>
        <field name="ocupacion_id"/>
        <field name="parent_id"/>
        <field name="movil_trabajo" widget="phone"/>
      </list>
    </field>
  </record>

  <record id="menu_view_trabajadores" model="ir.actions.act_window">
    <field name="name">Trabajadores</field>
    <field name="res_model">sicpro.app.trabajadores</field>
    <field name="view_mode">kanban,list,form,activity</field>
    <field name="domain">[]</field>
    <field name="context">{}</field>
    <field name="view_id" eval="False"/>
    <field name="search_view_id" ref="view_trabajadores_filtro"/>
    <field name="view_id" ref="view_trabajadores_kanban"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregar Nuevo Trabajador
      </p>
      <p>
        En este módulo se tendrá el control de todos los datos generales de los trabajadores.
      </p>
    </field>
  </record>

  <record id="menu_view_trabajadores_list" model="ir.actions.act_window">
    <field name="name">Trabajadores</field>
    <field name="res_model">sicpro.app.trabajadores</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_trabajadores_list"/>
    <field name="search_view_id" ref="view_trabajadores_filtro"/>
    <field name="view_id" ref="view_trabajadores_list"/>
  </record>

  <record id="menu_view_trabajadores_activity" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.activity</field>
    <field name="model">sicpro.app.trabajadores</field>
    <field name="arch" type="xml">
      <activity string="Trabajadores">
        <field name="id"/>
        <field name="name"/>
        <templates>
          <div t-name="activity-box" class="d-flex justify-content-start align-items-center">
            <img t-attf-src="/web/image/sicpro.app.trabajadores/#{record.id.raw_value}/image_128"
                 role="img" t-att-title="record.name.value" t-att-alt="record.name.value" class="rounded-circle me-2"
                 style="width: 32px; height: 32px; object-fit: cover;"/>
            <div>
              <field name="name" display="full" class="fw-bold"/>
            </div>
          </div>
        </templates>
      </activity>
    </field>
  </record>

  <record id="act_trabajadores_en_areas" model="ir.actions.act_window">
    <field name="name">Trabajadores</field>
