<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

         <record id="view_trabajadores_instrucciones_tree" model="ir.ui.view">
             <field name="name">sicpro.app.trabajadores.intrucciones.tree</field>
             <field name="model">sicpro.app.trabajadores.intrucciones</field>
             <field eval="8" name="priority"/>
             <field name="arch" type="xml">
                 <tree string="Instrucciones del trabajador">
                     <field name="name"/>
                     <field name="plaza_id"/>
                     <field name="tipo_intruccion"/>
                     <field name="instructor"/>
                     <field name="ocupacion_id"/>
                     <field name="fecha_desde"/>
                     <field name="evalucion"/>
                 </tree>
             </field>
         </record>

         <record id="trabajadores_instrucciones_view_action" model="ir.actions.act_window">
             <field name="name">Registro de Instrucciones</field>
             <field name="res_model">sicpro.app.trabajadores.intrucciones</field>
             <field name="view_mode">tree</field>
         </record>

     </data>
 </odoo>
