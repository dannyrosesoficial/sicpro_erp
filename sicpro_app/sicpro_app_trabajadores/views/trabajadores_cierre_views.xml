<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="trabajadores_cierre_tree" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.cierre.tree</field>
        <field name="model">sicpro.app.trabajadores.cierre</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <tree string="Cierre mensual" decoration-bf="0" js_class="generar_cierre" sample="1"
                decoration-danger="estado == 'error'">
                <field name="name"/>
                <field name="direccion"/>
                <field name="mes"/>
                <field name="anio"/>
                <field name="total"/>
                <field name="altas"/>
                <field name="bajas"/>
                <field name="estado" class="font-weight-bold" widget="badge"
                    decoration-danger="estado == 'error'" decoration-success="estado == 'ok'"/>
            </tree>
        </field>
    </record>

    <record id="trabajadores_cierre_filter" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.cierre.search</field>
        <field name="model">sicpro.app.trabajadores.cierre</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name"/>
                <field name="mes"/>
                <field name="anio"/>
                <separator/>
                 <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string='Proceso' name="direccion" domain="[]" context="{'group_by': 'direccion'}"/>
                    <separator/>
                    <filter string='Mes' name="mes" domain="[]" context="{'group_by': 'mes'}"/>
                    <filter string='Año' name="anio" domain="[]" context="{'group_by': 'anio'}"/>
                    <separator/>
                    <filter string='Estado' name="estado" domain="[]" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="trabajadores_cierre_action" model="ir.actions.act_window">
        <field name="name">Cierre Mensual</field>
        <field name="res_model">sicpro.app.trabajadores.cierre</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="trabajadores_cierre_tree"/>
        <field name="search_view_id" ref="trabajadores_cierre_filter"/>
    </record>


    <record id="trabajadores_informe_cierre_tree" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.cierre.tree</field>
        <field name="model">sicpro.app.trabajadores.cierre</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <tree string="Cierre mensual" decoration-bf="0" decoration-danger="estado == 'error'"
                  create="false" edit="false">
                <field name="name"/>
                <field name="direccion"/>
                <field name="mes"/>
                <field name="anio"/>
                <field name="total"/>
                <field name="altas"/>
                <field name="bajas"/>
                <field name="estado" class="font-weight-bold" widget="badge"
                    decoration-danger="estado == 'error'" decoration-success="estado == 'ok'"/>
            </tree>
        </field>
    </record>

    <record id="trabajadores_informe_cierre_action" model="ir.actions.act_window">
        <field name="name">Cierre Mensual</field>
        <field name="res_model">sicpro.app.trabajadores.cierre</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="trabajadores_informe_cierre_tree"/>
        <field name="search_view_id" ref="trabajadores_cierre_filter"/>
    </record>

</odoo>

