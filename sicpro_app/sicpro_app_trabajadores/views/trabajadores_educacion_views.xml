<odoo>
  <record id="resume_line_view_form" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.educacion.form</field>
    <field name="model">sicpro.app.trabajadores.educacion</field>
    <field name="arch" type="xml">
      <form string="Educación">
        <div class="oe_title">
          <label for="name" class="oe_edit_only"/>
          <h1>
            <field name="name" placeholder="Titulo" invisible="ch" required="not ch"/>
            <field name="tipo_certificacion" placeholder="Titulo"
                   invisible="not ch" required="ch"
                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
          </h1>
        </div>
        <group>
          <group>
            <field name="line_type_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            <field name="ch" invisible="1"/>
            <field name="display_type" requsired="1"/>
          </group>
          <group>
            <field name="date_start" required="True"/>
            <field name="date_end" required="ch"/>
            <field name="dias_validacion" invisible="1"/>
            <field name="fecha_expiracion" invisible="not ch"/>
          </group>
        </group>
        <field name="description" placeholder="Descripción"/>
      </form>
    </field>
  </record>
</odoo>
