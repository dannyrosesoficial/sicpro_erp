<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="departamento_user_form" model="ir.ui.view">
    <field name="name">res.users.departamento.form</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook/page[1]" position="after">
         <page string="Detalles del trabajador" >
           <group string="Trabajador">
             <group>
                 <field name="tipo" widget="radio" options="{'horizontal': true}"/>
                 <field name="trabajador" attrs="{'required':[('tipo', '=', 'interno')]}"/>
             </group>
           </group>
           <group string="Datos del usuario">
             <group readonly="1">
               <field name="plaza_id"/>
               <field name="identification_id"/>
               <field name="job_id"/>
             </group>
             <group readonly="1">
               <field name="jefe_id"/>
               <field name="work_phone"/>
               <field name="mobile_phone"/>
               <field name="departamento"/>
             </group>
           </group>
           <group>
               <field name="notas"/>
             </group>
         </page>
      </xpath>
    </field>
  </record>

</odoo>
