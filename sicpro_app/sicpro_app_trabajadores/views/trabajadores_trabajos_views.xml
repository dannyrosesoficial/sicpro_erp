<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_trabajadores_trabajo_form" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.trabajos.form</field>
            <field name="model">sicpro.app.trabajadores.trabajos</field>
            <field name="arch" type="xml">
                <form string="Trabajos">
                    <sheet>
                        <div class="oe_button_box" name="button_box"/>
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="e.g. Jefe de Departamento"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" /></h1>
                        </div>
                        <group>
                            <group name="recruitment">
                                <field name="department_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}" />
                                <field name="salario" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                <field name="alimentacion" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                                <field name="company_currency_id" invisible="1" />
                                <field name="company_id"/>
                            </group>
                        </group>
                        <div>
                            <label for="descripcion"/>
                            <field name="descripcion"/>
                        </div>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_trabajadores_trabajo_tree" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.trabajos.tree</field>
            <field name="model">sicpro.app.trabajadores.trabajos</field>
            <field name="arch" type="xml">
                <tree string="Trabajos" decoration-bf="message_needaction==True">
                    <field name="name"/>
                    <field name="company_currency_id" invisible="1" />
                    <field name="salario" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                    <field name="alimentacion" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                    <field name="department_id"/>
                    <field name="cantidad_trabajadores"/>
                    <field name="message_needaction" invisible="1"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>

        <record id="trabajadores_trabajo_view_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.trabajos.kanban</field>
            <field name="model">sicpro.app.trabajadores.trabajos</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div>
                                    <strong><field name="name"/></strong>
                                </div>
                                 <div>
                                     <span>Cantidad de trabajadores: <field name="cantidad_trabajadores"/></span>
                                </div>
                                <div>
                                    <span><field name="department_id"/>&amp;nbsp;
                                    </span>
                                </div>
                                <div>
                                    <field name="company_currency_id" invisible="1" />
                                    <span>Salario: <field name="salario" widget="monetary"
                                                          options="{'currency_field': 'company_currency_id'}"/></span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="trabajadores_trabajo_filter" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.trabajos.search</field>
            <field name="model">sicpro.app.trabajadores.trabajos</field>
            <field name="arch" type="xml">
                <search string="Puestos de Trabajo">
                    <field name="name" string="Puestos de Trabajo"/>
                    <field name="department_id" operator="child_of"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Departamento" name="department" domain="[]"
                                context="{'group_by': 'department_id'}"/>
                        <filter string="Proceso" name="company" domain="[]" context="{'group_by': 'company_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_trabajadores_trabajo" model="ir.actions.act_window">
            <field name="name">Categoría ocupacional</field>
            <field name="res_model">sicpro.app.trabajadores.trabajos</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="search_view_id" ref="trabajadores_trabajo_filter"/>
            <field name="context">{"search_default_Current":1}</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Agregar puestos de trabajo
              </p><p>
                Incorporar las categorías ocupacionales del proceso
              </p>
            </field>
        </record>

    </data>
</odoo>
