<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="trabajadores_areas_altas_bajas_tree" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.areas.altas.bajas.tree</field>
        <field name="model">sicpro.app.trabajadores.areas.altas.bajas</field>
        <field name="arch" type="xml">
            <tree string="Altas y bajas por áreas" sample="1" create="false"
                  decoration-primary="estado == 'alta'" decoration-danger="estado == 'baja'">
                <field name="trabajador"/>
                <field name="name"/>
                <field name="direccion"/>
                <field name="fecha"/>
                <field name="mes"/>
                <field name="anio"/>
                <field name="estado" class="font-weight-bold" widget="badge"
                       decoration-primary="estado == 'alta'" decoration-danger="estado == 'baja'"/>
            </tree>
        </field>
    </record>

    <record id="trabajadores_areas_altas_bajas_filter" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.areas.altas.bajas.search</field>
        <field name="model">sicpro.app.trabajadores.areas.altas.bajas</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name"/>
                <field name="mes"/>
                <field name="anio"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter string='Proceso' name="direccion" domain="[]"
                            context="{'group_by': 'direccion'}"/>
                    <separator/>
                    <filter string='Mes' name="mes" domain="[]" context="{'group_by': 'mes'}"/>
                    <filter string='Año' name="anio" domain="[]" context="{'group_by': 'anio'}"/>
                    <separator/>
                    <filter string='Estado' name="estado" domain="[]" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="trabajadores_areas_altas_bajas_action" model="ir.actions.act_window">
        <field name="name">Altas y bajas por áreas</field>
        <field name="res_model">sicpro.app.trabajadores.areas.altas.bajas</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>
