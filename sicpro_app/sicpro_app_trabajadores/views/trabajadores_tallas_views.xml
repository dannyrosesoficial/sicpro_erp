<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_trabajadores_tallas_tree" model="ir.ui.view">
             <field name="name">sicpro.app.trabajadores.tallas.tree</field>
             <field name="model">sicpro.app.trabajadores.tallas</field>
             <field eval="10" name="priority"/>
             <field name="arch" type="xml">
                 <tree string="Tallas de los Trabajadores" editable="bottom">
                     <field name="name"/>
                     <field name="color" widget="color_picker"/>
                 </tree>
             </field>
         </record>

         <record id="view_trabajadores_tallas_actions" model="ir.actions.act_window">
             <field name="name">Tallas del trabajador</field>
             <field name="res_model">sicpro.app.trabajadores.tallas</field>
             <field name="view_mode">tree</field>
         </record>

     </data>
 </odoo>
