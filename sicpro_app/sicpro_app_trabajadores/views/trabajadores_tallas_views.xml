<odoo>
  <record id="view_trabajadores_tallas_list" model="ir.ui.view">
    <field name="name">sicpro.app.trabajadores.tallas.list</field>
    <field name="model">sicpro.app.trabajadores.tallas</field>
    <field eval="10" name="priority"/>
    <field name="arch" type="xml">
      <list string="Tallas de los Trabajadores" editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="view_trabajadores_tallas_actions" model="ir.actions.act_window">
    <field name="name">Tallas del trabajador</field>
    <field name="res_model">sicpro.app.trabajadores.tallas</field>
    <field name="view_mode">list</field>
  </record>
</odoo>
