<odoo>
  <record id="view_res_config_settings_form" model="ir.ui.view">
    <field name="name">res.config.settings.form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@id='user_default_rights']" position="before">
        <block title="Configuración de colores" id="branding_settings">
          <setting string="Colores del modo de claro" help="Personaliza la apariencia del modo claro.">
            <div class="w-50 row">
              <label for="color_brand_light" string="Panel superior" class="d-block w-75 py-2"/>
              <field name="color_brand_light" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_primary_light" string="Primario" class="d-block w-75 py-2"/>
              <field name="color_primary_light" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_info_light" string="Información" class="d-block w-75 py-2"/>
              <field name="color_info_light" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_success_light" string="Éxito" class="d-block w-75 py-2"/>
              <field name="color_success_light" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_warning_light" string="Advertencia" class="d-block w-75 py-2"/>
              <field name="color_warning_light" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_danger_light" string="Peligro" class="d-block w-75 py-2"/>
              <field name="color_danger_light" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <button name="action_reset_light_color_assets" icon="fa-refresh" type="object"
                string="Restablecer colores del modo claro" class="btn-link"/>
          </setting>
          <setting string="Colores del modo oscuro" help="Personaliza la apariencia del modo oscuro">
            <div class="w-50 row">
              <label for="color_brand_dark" string="Panel superior" class="d-block w-75 py-2"/>
              <field name="color_brand_dark" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_primary_dark" string="Primario" class="d-block w-75 py-2"/>
              <field name="color_primary_dark" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_info_dark" string="Información" class="d-block w-75 py-2"/>
              <field name="color_info_dark" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_success_dark" string="Éxito" class="d-block w-75 py-2"/>
              <field name="color_success_dark" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_warning_dark" string="Advertencia" class="d-block w-75 py-2"/>
              <field name="color_warning_dark" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <div class="w-50 row">
              <label for="color_danger_dark" string="Peligro" class="d-block w-75 py-2"/>
              <field name="color_danger_dark" class="d-block w-25 p-0 m-0" widget="color"/>
            </div>
            <button name="action_reset_dark_color_assets" icon="fa-refresh" type="object"
                string="Restablecer colores del modo oscuros" class="btn-link"/>
          </setting>
        </block>
      </xpath>
    </field>
  </record>
</odoo>
