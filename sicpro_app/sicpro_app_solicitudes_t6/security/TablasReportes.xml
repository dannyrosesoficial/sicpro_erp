<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>
         <!-- Creo la categoría de permisos Tablas & Reportes -->
    <record id="module_category_solicitud_tablasreportes" model="ir.module.category">
        <field name="name">Tablas &amp; Reportes</field>
        <field name="description">Módulo para la visualización de Tablas y Reportes.</field>
        <field name="sequence" >12</field>
    </record>
    <record id="grupo_app_tablasreportes_usuario" model="res.groups">
        <field name="name">Usuarios</field>
        <field name="comment">Permisos de lectura</field>
        <field name="category_id" ref="module_category_solicitud_tablasreportes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</data>

<data noupdate="0">
    <!-- REVISAR -->
    <record id="grupos_rule_grupos_1" model="ir.rule">
        <field name="name">Regla Grupos Procesos</field>
        <field ref="sicpro_app_solicitudes_t1.model_sicpro_app_solicitudes_oportunidades" name="model_id"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('grupo_app_tablasreportes_usuario'))]"/>
    </record>

</data>

</odoo>
