<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>
        <!-- Creo la categoría de transferencias de gastos generales-->
        <record id="module_category_transferencias_gastos" model="ir.module.category">
            <field name="name">Transferencias de Gastos Generales</field>
            <field name="description">Acceso a visualizar y modificar las transferencias de Gastos.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_gestión_gastos"/>
            <field name="sequence">2</field>
        </record>

        <record id="grupo_transferencias_visualizar" model="res.groups">
            <field name="name">Visualizar todas las Transferencias</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_transferencias_gastos"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_transferencias_economia" model="res.groups">
            <field name="name">Gestión Económica</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_transferencias_gastos"/>
            <field name="implied_ids" eval="[(4, ref('grupo_transferencias_visualizar'))]"/>
        </record>

        <record id="grupo_transferencias_inversionistas" model="res.groups">
            <field name="name">Gestión del Inversionista</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_transferencias_gastos"/>
            <field name="implied_ids" eval="[(4, ref('grupo_transferencias_economia'))]"/>
        </record>

        <record id="grupo_transferencias_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_transferencias_gastos"/>
            <field name="implied_ids" eval="[(4, ref('grupo_transferencias_inversionistas'))]"/>
        </record>

        <record id="grupo_transferencias_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos de lectura/Escritura/Eliminación</field>
            <field name="category_id" ref="module_category_transferencias_gastos"/>
            <field name="implied_ids" eval="[(4, ref('grupo_transferencias_responsable'))]"/>
        </record>
    </data>
