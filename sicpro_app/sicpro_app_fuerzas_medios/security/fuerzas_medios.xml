    <data>
        <!-- Creo la categoría de transferencias de gastos para los procesos claves-->
        <record id="module_category_transferencias_gastos_procesos" model="ir.module.category">
            <field name="name">Transferencias de Gastos Procesos</field>
            <field name="description">Acceso a visualizar y modificar las transferencias de Gastos e los Procesos.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_gestión_gastos"/>
            <field name="sequence">3</field>
        </record>

        <record id="grupo_transferencias_visualizar_proceso" model="res.groups">
            <field name="name">Visualizar Procesos</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_transferencias_gastos_procesos"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_transferencias_ejecutores_procesos" model="res.groups">
            <field name="name">Gestión del Ejecutor</field>
            <field name="comment">Permisos de lectura/Escritura</field>
            <field name="category_id" ref="module_category_transferencias_gastos_procesos"/>
            <field name="implied_ids" eval="[(4, ref('grupo_transferencias_visualizar_proceso'))]"/>
        </record>
