<?xml version="1.0"?>
<odoo>

    <record id="fuerzas_medios_etiquetas_tree" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.etiquetas.tree</field>
        <field name="model">sicpro.app.fuerzas.medios.etiquetas</field>
        <field name="arch" type="xml">
            <tree string="Etiquetas" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="fuerzas_medios_etiquetas_action" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">sicpro.app.fuerzas.medios.etiquetas</field>
        <field name="view_id" ref="fuerzas_medios_etiquetas_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear etiquetas para las fuerzas y medios
            </p>
        </field>
    </record>

</odoo>
