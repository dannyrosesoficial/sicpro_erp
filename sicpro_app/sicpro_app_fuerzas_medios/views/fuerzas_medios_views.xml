<?xml version="1.0"?>
<odoo>

    <!-- Inicio de las Vistas del modal para la cancelación de las fuerzas medios -->
    <record id="fuerzas_medios_canceladas_form" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.canceladas.form</field>
        <field name="model">sicpro.app.fuerzas.medios.canceladas</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <form string="Motivo de Cancelación">
                <group class="oe_title">
                    <field name="motivo_id"/>
                </group>
                <footer>
                    <button name="action_motivo_cancelacion" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="fuerzas_medios_canceladas_action" model="ir.actions.act_window">
        <field name="name">Motivo de la Cancelación</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.fuerzas.medios.canceladas</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fuerzas_medios_canceladas_form"/>
        <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para la cancelación de la orden -->

    <!-- Inicio de las Vistas del modal para la cancelación de las fuerzas medios -->
    <record id="fuerzas_medios_rechazo_form" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.rechazadas.form</field>
        <field name="model">sicpro.app.fuerzas.medios.rechazadas</field>
        <field name="priority">80</field>
        <field name="arch" type="xml">
            <form string="Aviso de Intensión">
                <group class="oe_title">
                    <field name="motivo_id"/>
                </group>
                <footer>
                    <button name="action_motivo_rechazo" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="fuerzas_medios_rechazo_action" model="ir.actions.act_window">
        <field name="name">Rechazar Orden</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.fuerzas.medios.rechazadas</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fuerzas_medios_rechazo_form"/>
        <field name="target">new</field>
    </record>
    <!-- Fin de las Vistas del modal para la cancelación de la orden -->


    <record id="fuerzas_medios_search" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.search</field>
        <field name="model">sicpro.app.fuerzas.medios</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name" string="Consecutivo de la orden"/>
                <field name="etiquetas_ids" string="Etiquetas" filter_domain="[('etiquetas_ids', 'ilike', self)]"/>
                <field name="cliente_id"/>
                <separator/>
                <filter string="Fecha de Solicitud" name="fecha_solicitud_orden" date="fecha_solicitud_orden"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>

                <separator/>

                <group expand="0" string="Agrupar por">

                    <separator orientation="vertical"/>

                </group>
            </search>
        </field>
    </record>

    <record id="fuerzas_medios_form" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.form</field>
        <field name="model">sicpro.app.fuerzas.medios</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form class="o_lead_opportunity_form">
                <header>

<!--                    <button name="action_terminar_orden" string="Terminar Obra" type="object"-->
<!--                            groups="sicpro_app_ordenes_trabajo.grupo_ordenes_solicitante,sicpro_app_ordenes_trabajo.grupo_ordenes_admin"-->
<!--                            attrs="{'invisible': ['|', ('active', '=', False), ('is_en_proceso', '!=', True)]}"/>-->

                    <field name="estado_id" widget="statusbar" options="{'clickable': '0', 'fold_field': 'fold'}"
                           domain="[('company_id', '=', company_id)]" readonly="1"/>
                </header>
                <sheet>
                    <field name="readonly_admin" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="is_cancelado" invisible="1"/>
                    <field name="is_paralizado" invisible="1"/>
                    <field name="is_terminada" invisible="1"/>
                    <field name="is_en_proceso" invisible="1"/>
                    <field name="company_currency" invisible="1"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <widget name="web_ribbon" title="Cancelada" bg_color="bg-danger"
                            attrs="{'invisible': [('is_cancelado', '!=', True)]}"/>
                    <widget name="web_ribbon" title="Paralizada" bg_color="bg-warning"
                            attrs="{'invisible': [('is_paralizado', '!=', True)]}"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Consecutivo de la Orden"/>
                        <h1><field name="name" readonly="1"/>
                        </h1>
                        <h4>
                            <field name="name"/>
                        </h4>
                    </div>
                    <group>
                        <group>

                        </group>
                        <group>

                            <field name="company_abreviatura" string="Proceso"/>
                            <field name="company_id" string="Proceso" invisible="1"
                                   options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            <field name="etiquetas_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"/>

                        </group>
                    </group>

                    <group string="Detalles de la solicitud">
                        <group>

                        </group>
                        <group>

                            <div>

                            </div>

                        </group>
                    </group>
                    <group>

                    </group>

                    <group>
                        <group string="Detalles importantes sobre la solicitud" class="oe_title">

                        </group>
                        <group string="Detalles importantes sobre la creación" class="oe_title">

                        </group>
                    </group>

                    <group string="Cancelación de la Orden" attrs="{'invisible': [('is_cancelado', '!=', True)]}">

                    </group>

                    <group>

                    </group>

                    <notebook>
                        <page name='clientes' string="Datos del Cliente">
                            <group>
                                <group>
                                    <field name="cliente_id"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="cliente_territorio_id" string="Unidad Organizativa"/>
                                    <field name="cliente_provincia_id" string="Provincia"/>
                                </group>
                                <group>
                                    <field name="cliente_cargo"/>
                                    <field name="cliente_telefono_fijo"/>
                                    <field name="cliente_telefono_movil"/>
                                    <field name="cliente_correo" widget="email"/>
                                </group>
                            </group>
                        </page>
                        <page name="sap" string="Datos para SAP">
                            <group>
                                <group>

                                </group>
                                <group>

                                </group>

                            </group>
                        </page>

                        <page name="fechas" string="información extra">
                            <group string="Asignación">
                                <group>
                                    <field name="user_id" readonly="1"/>

                                </group>
                                <group>

                                </group>
                            </group>
                            <group string="Cronograma">
                                <group>

                                </group>
                                <group>

                                </group>

                            </group>
                            <group string="Análisis">
                                <group>

                                </group>
                                <group>

                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids" options="{'open_attachments': True}"/>
                </div>
            </form>
        </field>
    </record>

    <record id="fuerzas_medios_tree" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.tree</field>
        <field name="model">sicpro.app.fuerzas.medios</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <tree string="Orden" decoration-bf="1" decoration-danger="is_cancelado == True"
                  decoration-warning="estado_interno in ['rechazar_solicitud', 'rechazar_creacion'] or is_paralizado == True"
                  decoration-success="is_en_proceso == True">

                <field name="estado_id"/>

                <field name="name" string="Consecutivo"/>

                <field name="cliente_id"/>
                <field name="priority" widget="priority"/>

                <field name="company_abreviatura"/>
                <field name="is_en_proceso" invisible="1"/>
                <field name="is_cancelado" invisible="1"/>
                <field name="is_paralizado" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="fuerzas_medios_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.kanban</field>
        <field name="model">sicpro.app.fuerzas.medios</field>
        <field name="priority" eval="50"/>
        <field name="arch" type="xml">
            <kanban default_group_by="estado_id" group_create="false" group_delete="false" group_edit="false"
                    class="o_kanban_small_column o_kanban_project_tasks"
                    archivable="false">

                <field name="estado_id" readonly="True"/><field name="name"/>
                <field name="cliente_id"/>
                <field name="priority"/>
                <field name="etiquetas_ids"/>
                <field name="user_id"/>
                <field name="message_needaction_counter"/>
                <field name="activity_ids"/>
                <field name="activity_state"/>

                <field name="etiquetas_ids"/>
                <progressbar field="estado_interno"
                             colors='{"creada": "success", "terminada": "success", "rechazar_creacion": "danger",
                             "rechazar_solicitud": "danger", "solicitada": "warning", "validada": "warning",
                             "pendiente_sap": "info"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title oe_partner_heading"><field name="name"/></strong>
                                <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                <ul>
                                    <li><field name="name"/></li>
                                    <li class="font-weight-bold"><field name="name"/></li>
                                    <li t-if="record.etiquetas_ids.raw_value">
                                        <field name="etiquetas_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </li>
                                </ul>
                                <div class="oe_kanban_partner_links"/>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="name"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="priority" widget="priority"/>
                                            <field name="activity_ids" widget="kanban_activity"/>
                                            <field name="user_id" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                                <div class="oe_clear"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="fuerzas_medios_activity" model="ir.ui.view">
        <field name="name">sicpro.app.fuerzas.medios.activity</field>
        <field name="model">sicpro.app.fuerzas.medios</field>
        <field name="arch" type="xml">
            <activity string="Ordene de Trabajo">
                <field name="cliente_id"/>
                <!--  <field name="company_currency"/> -->
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('sicpro.app.clientes', 'image_128', record.cliente_id.partner_id.raw_value)"
                             t-att-title="record.cliente_id.partner_id.value"
                             t-att-alt="record.cliente_id.partner_id.value"/>
                        <div>
                            <field name="name" display="full"/>
                            <!-- <field name="planned_revenue" widget="monetary" display="full" muted="1"/> -->
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record model="ir.actions.act_window" id="fuerzas_medios_action">
        <field name="name">Fuerzas y Medios</field>
        <field name="res_model">sicpro.app.fuerzas.medios</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="view_id" ref="fuerzas_medios_gastos_form"/>
        <field name="search_view_id" ref="fuerzas_medios_gastos_search"/>
        <field name="context">{'search_default_anio': (context_today().strftime('%Y'))}
        </field>
    </record>

    <record id="fuerzas_medios_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="fuerzas_medios_tree"/>
        <field name="act_window_id" ref="fuerzas_medios_action"/>
    </record>

    <record id="fuerzas_medios_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="fuerzas_medios_kanban"/>
        <field name="act_window_id" ref="fuerzas_medios_action"/>
    </record>


</odoo>