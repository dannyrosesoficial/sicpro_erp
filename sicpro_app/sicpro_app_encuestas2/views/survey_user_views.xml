<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>
    <record id="survey_user_input_line_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.user_input.line.view.form.inherit.enhanced</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_char_box']" position="after">
                <field name="value_url" attrs="{'invisible': [('answer_type','!=','url')]}"/>
                <field name="value_many2one" invisible="1"/>
                <field name="value_many2one_option" attrs="{'invisible': [('answer_type','!=','many2one')]}"/>
                <field name="value_many2many" attrs="{'invisible': [('answer_type','!=','many2many')]}"/>
                <field name="value_week" attrs="{'invisible': [('answer_type','!=','week')]}"/>
                <field name="value_time" attrs="{'invisible': [('answer_type','!=','time')]}"/>
                <field name="value_color" attrs="{'invisible': [('answer_type','!=','color')]}"/>
                <field name="value_email" attrs="{'invisible': [('answer_type','!=','email')]}"/>
                <field name="value_month" attrs="{'invisible': [('answer_type','!=','month')]}"/>
                <field name="value_name" attrs="{'invisible': [('answer_type','!=','name')]}"/>
                <field name="value_matrix" attrs="{'invisible': [('answer_type','!=','matrix')]}"/>
                <field name="value_address" attrs="{'invisible': [('answer_type','!=','address')]}"/>
                <field name="value_selection" attrs="{'invisible': [('answer_type','!=','selection')]}"/>
                <field name="value_password" attrs="{'invisible': [('answer_type','!=','password')]}"/>
                <field name="value_range" attrs="{'invisible': [('answer_type','!=','range')]}"/>
                <field name="value_qr" attrs="{'invisible': [('answer_type','!=','qr')]}"/>
                <field name="value_barcode" attrs="{'invisible': [('answer_type','!=','barcode')]}"/>
                <field name="filename" invisible="1"/>
                <field name="file_data" filename="filename" attrs="{'invisible': [('answer_type','!=','file')]}"/>
            </xpath>
        </field>
    </record>
</data>
</odoo>
