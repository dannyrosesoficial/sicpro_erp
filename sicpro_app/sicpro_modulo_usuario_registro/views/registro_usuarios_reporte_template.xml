<?xml version="1.0" encoding="utf-8"?>
<openerp>
<data>
    <template id="reporte_usuarios_report">
        <t t-set="company" t-value="env.company"/>
        <t t-call="web.html_container">
        <t t-call="web.internal_layout">
            <t t-foreach="docs" t-as="o">
            <div class="page">
                <div class="text-center">
                    <h2>Registro de sesión de usuarios</h2>

                    <span><t t-esc="o.start_date.strftime('%d-%m-%Y %H:%M:%S')"/>  -  <t t-esc="o.end_date.strftime('%d-%m-%Y %H:%M:%S')"/></span>
                </div>
                <br/>
                <br/>

                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Fecha</th>
                            <th>Dirección IP</th>
                            <th>Navegador Web</th>
                            <th>Sistema Operativo</th>
                            <th>VPN</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="count" t-value="0"/>
                        <tr t-foreach='o.gathering_user_details()' t-as='user'>
                            <t t-set="count" t-value="count + 1"/>
                            <td>
                                <span t-esc="user['name']"/>
                            </td>
                            <td>
                                <span t-esc="user['date_time'].strftime('%d-%m-%Y %H:%M:%S')"/>
                            </td>
                            <td>
                                <span t-esc="user['ip_address']"/>
                            </td>
                            <td>
                                <span t-esc="user['navegador_web']"/>
                            </td>
                            <td>
                                <span t-esc="user['sistema_operativo']"/>
                            </td>
                            <td>
                                <span t-esc="user['vpn']"/>
                            </td>

                        </tr>
                        <tr>
                            <td>
                                <t t-if="count == 0">
                                    <br/>
                                    <h3 class="text-danger">No se encontraron registros. Por favor verifique las fechas.</h3>
                                </t>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            </t>
        </t>
        </t>
    </template>
    </data>
</openerp>
