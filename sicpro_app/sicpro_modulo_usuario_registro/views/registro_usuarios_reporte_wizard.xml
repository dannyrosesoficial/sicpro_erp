<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reporte_sesion_usuario_wizard" model="ir.ui.view">
        <field name="name">sicpro.modulo.registro.usuarios.reporte.form</field>
        <field name="model">sicpro.modulo.registro.usuarios.reporte</field>
        <field name="arch" type="xml">
            <form string="Reporte de Sesión de Usuarios">
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <group>
                        <field name="type" widget="radio" string="Tipo"/>
                        <field name="user_id" attrs="{'required': [('type', '=', 'selected')], 'invisible': [('type', '!=', 'selected')]}"/>
                    </group>
                </group>
                <footer>
                    <button name="generar_reporte" string="Imprimir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
