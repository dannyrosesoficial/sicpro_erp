<odoo>
  <record id="ordenes_estados_search" model="ir.ui.view">
    <field name="name">Buscar Estados</field>
    <field name="model">sicpro.app.ordenes.estados</field>
    <field name="arch" type="xml">
      <search string="Buscar Estados">
        <field name="name"/>
      </search>
    </field>
  </record>

  <record id="ordenes_estados_list" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.estados.list</field>
    <field name="model">sicpro.app.ordenes.estados</field>
    <field name="arch" type="xml">
      <list string="Estados">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="fold"/>
        <field name="is_preparacion_tecnica"/>
        <field name="is_fecha_inicial"/>
        <field name="is_en_proceso"/>
        <field name="is_terminada"/>
        <field name="is_paralizado"/>
        <field name="is_cancelado"/>
        <field name="company_id"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="ordenes_estados_form" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.estados.form</field>
    <field name="model">sicpro.app.ordenes.estados</field>
    <field name="priority" eval="1"/>
    <field name="arch" type="xml">
      <form string="Estados">
        <sheet>
          <div class="oe_title">
            <div class="oe_edit_only">
              <label for="name"/>
            </div>
            <h1>
              <field name="name"/>
            </h1>
            <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
          </div>
          <field name="company_abreviatura"/>
          <field name="active" invisible="1"/>
          <group>
            <group>
              <field name="is_preparacion_tecnica"/>
              <field name="is_fecha_inicial"/>
              <field name="is_en_proceso"/>
              <field name="is_terminada"/>
            </group>
            <group>
              <field name="fold"/>
              <field name="is_paralizado"/>
              <field name="is_cancelado"/>
            </group>
          </group>
          <separator string="Detalles del estado"/>
          <field name="requirements" nolabel="1"/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="ordenes_estados_action" model="ir.actions.act_window">
    <field name="name">Estados</field>
    <field name="res_model">sicpro.app.ordenes.estados</field>
    <field name="view_id" ref="ordenes_estados_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregue un nuevo estado
      </p>
    </field>
  </record>
</odoo>
