<odoo>
  <record id="ordenes_estados_transporte_equipos_search" model="ir.ui.view">
    <field name="name">Buscar Estados</field>
    <field name="model">sicpro.app.ordenes.estados.transporte.equipos</field>
    <field name="arch" type="xml">
      <search string="Buscar Estados">
        <field name="name"/>
        <field name="tipo"/>
        <separator/>
        <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="ordenes_estados_transporte_equipos_list" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.estados.transporte.equipos.list</field>
    <field name="model">sicpro.app.ordenes.estados.transporte.equipos</field>
    <field name="arch" type="xml">
      <list string="Estados" editable="bottom">
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="tipo" class="font-weight-bold"/>
        <field name="detalles"/>
        <field name="contar" string="Contar en la barra"/>
        <field name="active" column_invisible="True"/>
      </list>
    </field>
  </record>

  <record id="ordenes_estados_transporte_equipos_action" model="ir.actions.act_window">
    <field name="name">Estado del Transporte</field>
    <field name="res_model">sicpro.app.ordenes.estados.transporte.equipos</field>
    <field name="view_id" ref="ordenes_estados_transporte_equipos_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregue un nuevo estado
      </p>
    </field>
  </record>
</odoo>
