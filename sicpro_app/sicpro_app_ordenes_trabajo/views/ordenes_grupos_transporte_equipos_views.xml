<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ordenes_grupos_transporte_equipos_search" model="ir.ui.view">
        <field name="name">Buscar Grupo</field>
        <field name="model">sicpro.app.ordenes.grupo.transporte.equipos</field>
        <field name="arch" type="xml">
            <search string="Buscar Grupo">
                <field name="name"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="ordenes_grupos_transporte_equipos_tree" model="ir.ui.view">
        <field name="name">sicpro.app.ordenes.grupo.transporte.equipos.tree</field>
        <field name="model">sicpro.app.ordenes.grupo.transporte.equipos</field>
        <field name="arch" type="xml">
            <tree string="Grupos" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="grupo_vehiculos" widget="many2many_tags" placeholder="Grupos"
                                   options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="detalles"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="ordenes_grupos_transporte_equipos_action" model="ir.actions.act_window">
        <field name="name">Grupos de Transporte y Equipos</field>
        <field name="res_model">sicpro.app.ordenes.grupo.transporte.equipos</field>
        <field name="view_id" ref="ordenes_grupos_transporte_equipos_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Agregue un nuevo grupo
            </p>
        </field>
    </record>

</odoo>
