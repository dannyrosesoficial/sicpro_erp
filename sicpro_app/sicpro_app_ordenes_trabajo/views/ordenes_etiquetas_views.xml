<?xml version="1.0"?>
<odoo>

    <record id="ordenes_etiquetas_tree" model="ir.ui.view">
        <field name="name">sicpro.app.ordenes.etiquetas.tree</field>
        <field name="model">sicpro.app.ordenes.etiquetas</field>
        <field name="arch" type="xml">
            <tree string="Etiquetas" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="ordenes_etiquetas_action" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">sicpro.app.ordenes.etiquetas</field>
        <field name="view_id" ref="ordenes_etiquetas_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear etiquetas para las órdenes de trabajo
            </p>
        </field>
    </record>

</odoo>
