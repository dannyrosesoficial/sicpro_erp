    </field>
  </record>

  <record id="ordenes_rechazo_action" model="ir.actions.act_window">
    <field name="name">Rechazar Orden</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.ordenes.trabajo.rechazadas</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="ordenes_rechazo_form"/>
    <field name="target">new</field>
  </record>
  <!-- Fin de la vistas wizard para la cancelación de la orden -->

  <!-- Inicio de las vistas wizard para los botones inteligentes de las órdenes -->
  <record id="view_ordenes_trabajadores_modal_list" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.trabajo.trabajadores.modal.list</field>
    <field name="model">sicpro.app.ordenes.trabajo.trabajadores</field>
    <field name="arch" type="xml">
      <list string="Trabajadores Asignados" create="0" edit="0" delete="0">
