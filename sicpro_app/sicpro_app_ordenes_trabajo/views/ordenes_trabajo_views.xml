<odoo>

  <!-- Inicio de las vistas wizard para la paralización de la orden -->
  <record id="ordenes_paralizada_form" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.trabajo.paralizacion.form</field>
    <field name="model">sicpro.app.ordenes.trabajo.paralizacion</field>
    <field name="priority">60</field>
    <field name="arch" type="xml">
      <form string="Motivo de la Paralización">
        <group class="oe_title">
          <field name="motivo_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
          <field name="detalles_paralizacion"/>
        </group>
        <footer>
          <button name="action_motivo_paralizacion" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="ordenes_paralizada_action" model="ir.actions.act_window">
    <field name="name">Motivo de la Paralización</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.ordenes.trabajo.paralizacion</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="ordenes_paralizada_form"/>
    <field name="target">new</field>
  </record>
  <!-- Fin de la vistas wizard para la paralización de la orden -->

  <!-- Inicio de las vistas wizard para la cancelación de la orden -->
  <record id="ordenes_canceladas_form" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.trabajo.canceladas.form</field>
    <field name="model">sicpro.app.ordenes.trabajo.canceladas</field>
    <field name="priority">80</field>
    <field name="arch" type="xml">
      <form string="Motivo de Cancelación">
        <group class="oe_title">
          <field name="motivo_id"/>
        </group>
        <footer>
          <button name="action_motivo_cancelacion" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="ordenes_canceladas_action" model="ir.actions.act_window">
    <field name="name">Motivo de la Cancelación</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.ordenes.trabajo.canceladas</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="ordenes_canceladas_form"/>
    <field name="target">new</field>
  </record>
  <!-- Fin de la vistas wizard para la cancelación de la orden -->

  <!-- Inicio de las vistas wizard para la cancelación de la orden -->
  <record id="ordenes_aviso_intension_form" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.trabajo.aviso.intension.form</field>
    <field name="model">sicpro.app.ordenes.trabajo.aviso.intension</field>
    <field name="priority">80</field>
    <field name="arch" type="xml">
      <form string="Aviso de Intensión">
        <group class="oe_title">
          <field name="nueva_fecha"/>
          <field name="motivo_aviso_intension"/>
        </group>
        <footer>
          <button name="action_motivo_cambio" string="Enviar" type="object" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="ordenes_aviso_intension_action" model="ir.actions.act_window">
    <field name="name">Aviso de Intensión</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.ordenes.trabajo.aviso.intension</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="ordenes_aviso_intension_form"/>
    <field name="target">new</field>
  </record>
  <!-- Fin de la vistas wizard para la cancelación de la orden -->

  <!-- Inicio de las vistas wizard para la cancelación de la orden -->
  <record id="ordenes_rechazo_form" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.trabajo.rechazadas.form</field>
    <field name="model">sicpro.app.ordenes.trabajo.rechazadas</field>
    <field name="priority">80</field>
    <field name="arch" type="xml">
      <form string="Aviso de Intensión">
        <group class="oe_title">
          <field name="motivo_id"/>
