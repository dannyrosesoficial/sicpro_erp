<odoo>
  <record id="ordenes_problemas_list" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.problemas.list</field>
    <field name="model">sicpro.app.ordenes.problemas</field>
    <field name="arch" type="xml">
      <list string="Problemas" editable="bottom">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="ordenes_problemas_action" model="ir.actions.act_window">
    <field name="name">Problemas en la Ejecución</field>
    <field name="res_model">sicpro.app.ordenes.problemas</field>
    <field name="view_id" ref="ordenes_problemas_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear problema para la ejecución
      </p>
    </field>
  </record>
</odoo>
