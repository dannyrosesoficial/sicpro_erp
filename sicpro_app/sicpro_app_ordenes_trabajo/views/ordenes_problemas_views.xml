<?xml version="1.0"?>
<odoo>

    <record id="ordenes_problemas_tree" model="ir.ui.view">
        <field name="name">sicpro.app.ordenes.problemas.tree</field>
        <field name="model">sicpro.app.ordenes.problemas</field>
        <field name="arch" type="xml">
            <tree string="Problemas" editable="bottom">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="ordenes_problemas_action" model="ir.actions.act_window">
        <field name="name">Problemas en la Ejecución</field>
        <field name="res_model">sicpro.app.ordenes.problemas</field>
        <field name="view_id" ref="ordenes_problemas_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear problema para la ejecución
            </p>
        </field>
    </record>

</odoo>
