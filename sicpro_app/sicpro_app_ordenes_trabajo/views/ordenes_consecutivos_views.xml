<odoo>
  <record id="ordenes_consecutivos_list" model="ir.ui.view">
    <field name="name">sicpro.app.ordenes.consecutivos.list</field>
    <field name="model">sicpro.app.ordenes.consecutivos</field>
    <field name="arch" type="xml">
      <list string="Programa" editable="bottom">
        <field name="name"/>
        <field name="moneda"/>
        <field name="tipo"/>
        <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
      </list>
    </field>
  </record>

  <record id="ordenes_consecutivos_action" model="ir.actions.act_window">
    <field name="name">Nomenclador del Consecutivo</field>
    <field name="res_model">sicpro.app.ordenes.consecutivos</field>
    <field name="view_id" ref="ordenes_consecutivos_list"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crear nomenclador del consecutivo
      </p>
    </field>
  </record>
</odoo>
