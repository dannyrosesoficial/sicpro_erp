<?xml version="1.0"?>
<odoo>

    <record id="ordenes_consecutivos_tree" model="ir.ui.view">
        <field name="name">sicpro.app.ordenes.consecutivos.tree</field>
        <field name="model">sicpro.app.ordenes.consecutivos</field>
        <field name="arch" type="xml">
            <tree string="Programa" editable="bottom">
                <field name="name"/>
                <field name="moneda"/>
                <field name="tipo"/>
                <field name="company_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </tree>
        </field>
    </record>

    <record id="ordenes_consecutivos_action" model="ir.actions.act_window">
        <field name="name">Nomenclador del Consecutivo</field>
        <field name="res_model">sicpro.app.ordenes.consecutivos</field>
        <field name="view_id" ref="ordenes_consecutivos_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear nomenclador del consecutivo
            </p>
        </field>
    </record>

</odoo>
