<?xml version="1.0" encoding="utf-8" ?>

<odoo>
	<record id="formato_papel_horizontal_credencial_personal_action" model="report.paperformat">
        <field name="name">Papel Horizontal Credencial Personal</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
		<field name="margin_top">7</field>
        <field name="margin_bottom">1</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
    </record>

	<record id="informe_credencial_personal_action" model="ir.actions.report">
		<field name="name">Credencial Personal</field>
		<field name="model">sicpro.app.credenciales</field>
		<field name="report_type">qweb-pdf</field>
		<field name="paperformat_id" ref="formato_papel_horizontal_credencial_personal_action"/>
		<field name="report_name">sicpro_app_credenciales.informe_credencial_personal</field>
		<field name="report_file">sicpro_app_credenciales.informe_credencial_personal</field>
		<field name="print_report_name">'Credencial Personal'</field>
		<field name="binding_model_id" ref="model_sicpro_app_credenciales"/>
		<field name="binding_type">report</field>
	</record>

	<template id="informe_credencial_personal">
		<!-- Página credencial personal -->
		<t t-call="web.html_container">
			<div t-attf-class="article">
				<div style=" width: 990px;">
					<t t-set="i" t-value="0"/>
					<t t-foreach="docs" t-as="inf">
						<t t-set="i" t-value="i+1"/>
						<t t-call="sicpro_app_credenciales.credencial_personal"/>
						<t t-if="i == 3">
							<t t-set="i" t-value="0"/>
							<div style="page-break-after: always;"/>
						</t>
					</t> 
				</div>	
			</div>
			
		</t>
	</template>

	<template id="credencial_personal">
		<t t-if="i &lt;= 3">
			<div style="position: relative; overflow: visible; width: 100%;">
				<t t-set="bordes_recorte_back"
				   t-value="'height: 490px; width: 330px; overflow: hidden; border: 2px dashed black; border-top: 0'"/>
				<t t-if="i == 1">
					<t t-set="bordes_recorte_back"
					   t-value="'height: 490px; width: 330px; overflow: hidden; border: 2px dashed black'"/>
				</t>

				<t t-set="color_titulo_back"
				   t-value="'height: 465px; width: 305px; margin: 10.5px auto auto auto; border: solid 1px grey; border-top: solid 85px rgb(128,128,128); border-radius: 20px;'"/>
				<t t-if="'PERMANENTE' in inf.tipo_credencial.name">
					<t t-set="color_titulo_back"
					   t-value="'height: 465px; width: 305px; margin: 10.5px auto auto auto; border: solid 1px grey; border-top: solid 85px rgb(8,52,128); border-radius: 20px;'"/>
				</t>
				<t t-if="'CONSTRUCTOR' in inf.tipo_credencial.name">
					<t t-set="color_titulo_back"
					   t-value="'height: 465px; width: 305px; margin: 10.5px auto auto auto; border: solid 1px grey; border-top: solid 85px rgb(0,12,66); border-radius: 20px;'"/>
				</t>
				<t t-if="'ESPECIAL' in inf.tipo_credencial.name">
					<t t-set="color_titulo_back"
					   t-value="'height: 465px; width: 305px; margin: 10.5px auto auto auto; border: solid 1px grey; border-top: solid 85px rgb(0,204,255); border-radius: 20px;'"/>
				</t>
				<div t-attf-style="{{ bordes_recorte_back }}">
					<div t-attf-style="{{ color_titulo_back }}">

						<div style="height: 60px; width: 290px; position: absolute; margin:-45px auto auto 8px; text-align: center; -webkit-transform: rtranslate(-40%); -webkit-transform-origin: center top">
							<b><h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 220% ; color: white; font-weight: 700"
								   t-field="inf.tipo_credencial"/></b>
						</div>
						<div style="height: 455px; width: 275px; margin: 10.5px auto auto auto;">
							<div style="position: relative; margin: 25px auto auto 15px; text-align: left;">
								<p style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 100%">
									ACCESOS</p>
							</div>
							<t t-if="'PERMANENTE' not in inf.tipo_credencial.name and 'CONSTRUCTOR' not in inf.tipo_credencial.name">
								<div style="position: relative; margin: 25px auto auto auto; height: 30px; width: 245px; border-top: 1px black; text-align: center;">
									<h1 style="font-family: Arial, 'Times New Roman', sans-serif; margin: auto; margin-left: 1px; margin-top: 13px; font-size: 130%; font-weight: 600"
										t-field="inf.accesos_credencial"/>
								</div>
								<div style="position: relative; margin: 15px auto auto auto; height: 30px; width: 245px; border-top: 1px solid black; text-align: center;"/>
								<div style="position: relative; margin: 5px auto auto auto; height: 30px; width: 245px; text-align: left;">
									<h5 style="font-family: Calibri, 'Times New Roman', sans-serif; font-size: 100% position: relative; margin: -10px auto auto auto;">
										Válido hasta:</h5>
									<div style="height: 100%; width: 50%; text-align: left; margin: -24px 55%"><p
											style="font-family: Arial, 'Times New Roman', sans-serif; font-size: 110%"
											t-field="inf.fecha_valida"/></div>
								</div>
								<div style="position: relative; margin: 60px auto auto auto; height: 20px; width: 225px; border-top: 1px solid black; text-align: center;">
									<p style="font-family: Calibri, 'Times New Roman', sans-serif; font-size: 85% position: relative; margin: 15px auto auto auto;">
										FIRMA AUTORIZADA</p>
								</div>
							</t>
							<t t-else="">
								<div style="position: relative; margin: 25px auto auto auto; height: 30px; width: 245px; border-top: 1px  black; text-align: center;">
									<h1 style="font-family: Arial, 'Times New Roman', sans-serif; margin: auto; margin-left: 1px; margin-top: 13px; font-size: 130%; font-weight: 600"
										t-field="inf.accesos_credencial"/>
								</div>
								<div style="position: relative; margin: 15px auto auto auto; height: 30px; width: 245px; border-top: 1px solid black; text-align: center;"/>
								<div style="position: relative; margin: 15px auto auto auto; height: 30px; width: 245px; border-top: 1px  black; text-align: center;"/>
								<div style="position: relative; margin: 27px auto auto auto; height: 20px; width: 225px; border-top: 1px solid black; text-align: center;">
									<p style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 85% position: relative; margin: 15px auto auto auto;">
										FIRMA AUTORIZADA</p>
								</div>
							</t>
							<div style="position: relative; margin: 30px auto auto 35px; height: 65px; width: 185px; text-align: center;">
								<img alt="Logo" src="sicpro_app_credenciales/static/src/img/etecsaId_300_8.png"
									 width="200" height="65"/>
							</div>
						</div>
					</div>
				</div>
				<t t-set="bordes_recorte_front"
				   t-value="'position relative; margin: -490px auto auto 330px; height: 490px; width: 330px; overflow: hidden; border: 2px dashed black; border-top: 0; border-left: 0;'"/>
				<t t-if="i == 1">
					<t t-set="bordes_recorte_front"
					   t-value="'position relative; margin: -490px auto auto 330px; height: 490px; width: 330px; overflow: hidden; border: 2px dashed black; border-left: 0'"/>
				</t>

				<div t-attf-style="{{ bordes_recorte_front }}">
					<div t-attf-style="{{ color_titulo_back }}">
						<div style="height: 60px; width: 290px; position: absolute; margin: -45px auto auto -50px; text-align: center; -webkit-transform: translate(20%); -webkit-transform-origin: center top">
							<b><h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 220% ; color: white; font-weight: 700"
								   t-field="inf.tipo_credencial"/></b>
						</div>
						<div style="position: relative; margin: 15px auto auto 70px; height: 160px; width: 160px; text-align: center;">
							<span t-field="inf.credencial_image_1920"
								  t-options='{"widget": "image", "style": "min-height: 160px; min-width: 160px; max-height: 160px; max-width: 160px"}'
								  style="text-align: center"/>
						</div>
						<div style="position: relative; height: 30px; width: 100%; margin: 17px auto auto 27px; text-align: left;">
							<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 100%; font-weight: 400"
								t-field="inf.name"/>
						</div>
						<div style="position: relative; margin: 15px auto auto 27px; height: 25px; width: 100%; text-align: left;">
							<div style="width: 15%; text-align: left; overflow: hidden">
								<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-weight: 400; font-size: 100%; ">
									CI. </h1>
							</div>
							<div style="width: 80%; text-align: left; position: relative; margin: -27px auto auto 22px; overflow: hidden">
								<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 100%; font-weight: 400; "
									t-field="inf.identification_id"/>
							</div>
						</div>
						<div style="height: 110px; width: 100%; margin: 0px auto auto 2px; overflow: hidden;">
							<div style="height: 110px; width: 60%; margin-left: 0px; margin-top: 0px;">
								<div style="position: relative; height: 50%; width: 100%; margin: 20px auto auto 24px; text-align: left">
									<t t-if="'PERMANENTE' in inf.tipo_credencial.name">
										<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 150%; font-weight: 700" t-field="inf.no_credencial_permanente"/>
								</t>
								<t t-if="'CONSTRUCTOR' in inf.tipo_credencial.name">
										<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 150%; font-weight: 700" t-field="inf.no_credencial_constructores"/>
								</t>
								<t t-if="'ESPECIAL' in inf.tipo_credencial.name">
										<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 150%; font-weight: 700" t-field="inf.no_credencial_especial"/>
								</t>
								<t t-if="'PROVISIONAL' in inf.tipo_credencial.name">
										<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-size: 150%; font-weight: 700" t-field="inf.no_credencial_provisional"/>
								</t>

								</div>
								<div style="position: relative; height: 50%; width: 100%; margin: 0px auto auto 24px; text-align: left">
									<div style="text-align: left position: relative; margin: -12px auto auto auto; overflow: hidden">
										<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; color: black; font-size: 190%; font-weight: 400"
											t-field="inf.alcance_credencial"/>
									</div>
									<div style="text-align: left position: relative; margin: -44px auto auto 85px; overflow: hidden">
										<h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; font-weight: 400; font-size: 190%; ">
											/ </h1>
									</div>
									<div style="text-align: left position: relative; margin: -44px auto auto 96px; overflow: hidden">
										<b><h1 style="font-family: 'Calibri', 'Times New Roman', sans-serif; color: black; font-size: 190%; font-weight: 700"
											   t-field="inf.siglas_credencial"/></b>
									</div>
								</div>
							</div>
							<div style="position: relative; height: 110px; width: 40%; margin: -130px auto auto 170px;">
								<div style="position: relative; margin: 0px auto auto 0px; height: 100%; width: 100%; text-align: left;">
									<img alt="Logo" src="sicpro_app_credenciales/static/src/img/etecsaId_300_4.png"
										 width="90" height="90"/>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</t>
	</template>


