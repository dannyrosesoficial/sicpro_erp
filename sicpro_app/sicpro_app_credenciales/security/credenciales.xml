<?xml version="1.0" ?>
<odoo>

        <!-- Creo la categoría de permisos credenciales-->
    <record id="modulo_categoria_credenciales" model="ir.module.category">
            <field name="name">Credenciales</field>
            <field name="description">Módulo credenciales de los trabajadores.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_capital_humano"/>
            <field name="sequence" >10</field>
         </record>
    <record id="grupo_app_credenciales_ejecutor" model="res.groups">
            <field name="name">Técnicos</field>
            <field name="comment">Permisos de Lectura/Escritura</field>
            <field name="category_id" ref="modulo_categoria_credenciales"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    <record id="grupo_app_credenciales_responsable" model="res.groups">
            <field name="name">Responsable</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="modulo_categoria_credenciales"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_credenciales_ejecutor'))]"/>
        </record>
    <record id="grupo_app_credenciales_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="modulo_categoria_credenciales"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_credenciales_responsable'))]"/>
        </record>
</odoo>
