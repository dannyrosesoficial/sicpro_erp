<odoo>
    <record id="sicpro_app_credenciales_recortador_de_imagenes_view_form" model="ir.ui.view">
        <field name="name">Credenciales - Editor de Imagen</field>
        <field name="model">sicpro.app.credenciales.modal</field>
        <field name="arch" type="xml">
            <form string="Editor de Imágenes">
                <sheet>
                    <div name="data" style="height: 120%; width: 100%; margin: 3% auto; position:relative;">
                        <div name="imagen_a_recortar" style="position: relative; margin: auto; text-align: center;">
                            <field name="imagen_a_recortar" widget="recortar_imagen" nolabel="1"
                                   class="w-100" style="height: 450px;"/>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button special="cancel" string="Cancelar" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_recortar_imagen" model="ir.actions.act_window">
        <field name="name">Editor de Imagen</field>
        <field name="res_model">sicpro.app.credenciales.modal</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="sicpro_app_credenciales_recortador_de_imagenes_view_form"/>
    </record>
</odoo>

