<odoo>
  <!-- Cron para desactivar usuario vencido -->
  <record id="credencial_user_desactivado" model="ir.cron">
    <field name="name">Credenciales: Usuario vencido</field>
    <field name="model_id" ref="sicpro_app_credenciales.model_sicpro_app_credenciales"/>
    <field name="state">code</field>
    <field name="code">model.desactivar_trabajador()</field>
    <field eval="True" name="active"/>
    <field name="user_id" ref="base.user_root"/>
    <field name="interval_number">1</field>
    <field name="interval_type">days</field>
  </record>
</odoo>
