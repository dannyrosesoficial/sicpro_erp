<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_credenciales_tipo_form" model="ir.ui.view">
             <field name="name">sicpro.app.credenciales.tipo.form</field>
             <field name="model">sicpro.app.credenciales.tipo</field>
             <field name="arch" type="xml">
                 <form string="Tipo de Credencial">
                    <sheet>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                    </sheet>
                 </form>
             </field>
         </record>

         <record id="view_credenciales_tipo_tree" model="ir.ui.view">
             <field name="name">sicpro.app.credenciales.tipo.list</field>
             <field name="model">sicpro.app.credenciales.tipo</field>
             <field eval="8" name="priority"/>
             <field name="arch" type="xml">
                 <tree string="Relaciones Familiares" editable="bottom">
                     <field name="name"/>
                     <field name="color" widget="color_picker"/>
                 </tree>
             </field>
         </record>

         <record id="credenciales_tipo_action" model="ir.actions.act_window">
             <field name="name">Tipo de Credencial</field>
             <field name="res_model">sicpro.app.credenciales.tipo</field>
             <field name="view_mode">tree,form</field>
         </record>

     </data>
 </odoo>
