<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_credenciales_filtro" model="ir.ui.view">
            <field name="name">sicpro.app.credenciales.search</field>
            <field name="model">sicpro.app.credenciales</field>
            <field name="arch" type="xml">
                <search string="Trabajadores">
                    <field name="trabajador" string="Trabajador" filter_domain="['|', ('telefono_trabajo', 'ilike', self), ('name', 'ilike', self)]"/>
                    <field name="no_credencial"/>
                    <field name="laptop_no_serie"/>
                    <field name="laptop_no_folio"/>
                    <field name="laptop_no_inventario"/>
                    <separator/>
                    <filter string="Laptop" name="tiene_laptop" domain="[('tiene_laptop', '=', True)]"/>
                    <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="tipo_credencial" string="Tipo de Credencial" context="{'group_by': 'tipo_credencial'}"/>
                        <filter name="accesos_credencial" string="Tipo de Acceso" context="{'group_by': 'accesos_credencial'}"/>
                        <filter name="siglas_credencial" string="Siglas" context="{'group_by': 'siglas_credencial'}"/>
                        <separator/>
                        <filter name="company_id" string="Proceso" context="{'group_by': 'company_id'}"/>
                        <filter name="clase_contrato" string="Clase de Contrato" context="{'group_by': 'clase_contrato'}"/>
                        <filter name="group_department" string="Área" context="{'group_by': 'area_id'}"/>
                        <filter name="group_job" string="Puesto de Trabajo" context="{'group_by': 'ocupacion_id'}"/>
                    </group>
                    <searchpanel>
                        <!-- <field name="company_id" icon="fa-building"/> -->
                        <field name="area_id" icon="fa-users"/>
                        <field name="ocupacion_id" icon="fa-users"/>
                    </searchpanel>
                </search>
             </field>
        </record>

        <record id="view_credenciales_kanban" model="ir.ui.view">
           <field name="name">sicpro.app.credenciales.kanban</field>
           <field name="model">sicpro.app.credenciales</field>
           <field name="priority">10</field>
           <field name="arch" type="xml">
               <kanban class="o_hr_employee_kanban" js_class="hr_employee_kanban" sample="1">
                   <field name="id"/>
                   <field name="user_id"/>
                   <templates>
                       <t t-name="kanban-box">
                       <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_hr_kanban_record">
                           <div class="o_kanban_image_fill_left d-none d-md-block"
                                t-attf-style="background-image:url('#{kanban_image('sicpro.app.credenciales',
                                'credencial_image_128', record.id.raw_value,  placeholder)}')">
                           </div>
                            <div class="oe_kanban_details">
                               <div class="o_kanban_record_top">
                                   <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                           <span class="font-weight-bold">
                                               <field name="trabajador" placeholder="Nombre del trabajador"/>
                                           </span>
                                       </strong>
                                      <span t-if="record.ocupacion_id.raw_value" class="o_kanban_record_subtitle">
                                            <field name="ocupacion_id"/></span>
                                   </div>
                               </div>
                                <span class="text-danger font-weight-bold"><field name="tipo_credencial"/></span>  -
                                <span class="text-blue font-weight-bold"><field name="no_credencial"/></span>
                                <div class="o_kanban_record_headings">
                                       <strong class="o_kanban_record_title">
                                           <span class="font-weight-bold">
                                               <field name="accesos_credencial"/>
                                           </span>
                                       </strong>
                                   </div>
                                <ul>
                                   <li id="last_login"/>
                                   <li t-if="record.correo_trabajo.raw_value" class="o_text_overflow">
                                       <field name="correo_trabajo"  widget="email"/>
                                   </li>
                                   <li t-if="record.telefono_trabajo.raw_value"><field name="telefono_trabajo" />
                                   </li>
                               </ul>
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left"/>
                                        <div class="oe_kanban_bottom_right">
                                            <a title="Chat" icon="fa-comments" href="#" class="ml8 o_employee_chat_btn"
                                               attrs="{'invisible': [('user_id','=', False)]}" role="button">
                                                <i class="fa fa-comments"/></a>
                                        </div>
                                    </div>
                                </div>

                           </div>
                       </div>
                       </t>
                   </templates>
               </kanban>
            </field>
        </record>

        <record id="view_credenciales_form" model="ir.ui.view">
            <field name="name">sicpro.app.credenciales.form</field>
            <field name="model">sicpro.app.credenciales</field>
            <field name="arch" type="xml">
                <form string="Trabajadores" js_class="hr_employee_form" class='o_employee_form'>
                    <header>
                    <button name="generate_qr" type="object" string="Generar Qr" class="btn btn-primary"/>
                    </header>
                    <field name="active" invisible="1"/>
                    <sheet>

                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                        <field name="credencial_image_1920" widget='image' class="oe_avatar"
                               options='{"zoom": true, "preview_image":"credencial_image_128"}'/>
                        <div class="oe_title">
                           <h1 class="d-flex">
                                <field name="trabajador" placeholder="Nombre del trabajador"
                                options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>

                                    <a title="Chat" icon="fa-comments" href="#" class="ml8 o_employee_chat_btn"
                                       attrs="{'invisible': [('user_id','=', False)]}" role="button">
                                        <i class="fa fa-comments"/></a>
                            </h1>
                            <h2>
                                <field name="ocupacion_id" placeholder="Puestos de Trabajo"/>
                            </h2>
                            <field class="font-weight-bold" decoration-danger="clase_contrato" name="clase_contrato" placeholder="Clases"
                                   options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            -
                            <field class="text-black-50 font-weight-bold" name="categoria_ocupacional" placeholder="Categorías"
                                   options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                        </div>
                        <group>
                            <group>
                                <div class="oe_title pr-0">
                                    <h2 class="d-flex flex-row justify-content-between">
                                        <field name="no_credencial" class="o_task_name text-truncate"/>
                                    </h2>
                                </div>
                                 <field name="name" invisible="1"/>
                                <field name="tipo_credencial"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="accesos_credencial"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="Usuario" readonly="1"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="fecha_actual" readonly="1"/>
                            </group>
                            <group>
                                <field name="siglas_credencial"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="alcance_credencial"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="fecha_entrega"/>
                                <field name="fecha_valida"/>
                                <field name="tiene_laptop" widget="boolean_toggle"/>
                                <field name="qr_code" widget="image" class="oe_avatar"/>
                            </group>
                        </group>

                        <group string="Registro de Laptop" attrs="{'invisible': [('tiene_laptop', '=', False)]}">
                            <group>
                                <field name="laptop_no_serie"/>
                                <field name="laptop_no_folio"/>
                            </group>
                            <group>
                                <field name="laptop_no_inventario"/>
                                <field name="laptop_image_1920" widget='image' class="oe_avatar"
                                       options='{"zoom": true, "preview_image":"laptop_image_256"}'/>
                            </group>
                        </group>
                        <notebook>
                            <page name="public" string="Información del trabajo">
                                <group>
                                    <group>
                                <field name="plaza_id"/>
                                <field name="movil_trabajo" widget="phone"/>
                                <field name="telefono_trabajo" widget="phone"/>
                                <field name="correo_trabajo" widget="email"/>
                            </group>
                                    <group>
                                <field name="company_id"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="area_id"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="ocupacion_id" domain="[('area_id', '=', area_id)]"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="parent_id" required="0"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>

                            </group>
                                </group>

                                <group>
                                    <group string="Ubicación">
                                            <field name="fecha_incorporacion"/>
                                            <field name="inicio_contrato"/>
                                            <field name="ubicacion_laboral" placeholder="Ej. Lugar, piso, número de oficina..."/>
                                        </group>
                                    <group string="Planificacion" >
                                            <field name="fecha_baja"/>
                                            <field name="color" widget="color_picker"/>
                                        </group>
                                </group>
                            </page>
                            <page name="personal_information" string="Información Privada" >
                                <group>
                                    <group string="Contacto Privado">
                                        <field name="identification_id"/>
                                        <field name="direccion_carnet"/>
                                    </group>
                                    <group string="Ciudadanía">
                                        <field name="genero"/>
                                        <field name="raza" options='{"no_open": True, "no_create": True}'/>
                                        <field name="fecha_nacimiento"/>
                                    </group>

                                </group>
                                <group>

                                </group>
                            </page>
                            <page name="usuario_settings" string="Configuración de Usuario" >
                                <group>
                                    <group string='Estado' name="active_group">
                                        <field name="user_id" readonly="1"
                                               options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'open_attachments': True}"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_credenciales_tree" model="ir.ui.view">
            <field name="name">sicpro.app.credenciales.tree</field>
            <field name="model">sicpro.app.credenciales</field>
            <field name="arch" type="xml">
                <tree string="Trabajadores">
                    <field name="name"/>
                    <field name="telefono_trabajo" widget="phone"/>
                    <field name="movil_trabajo" widget="phone"/>
                    <field name="company_id"/>
                    <field name="area_id"/>
                    <field name="ocupacion_id"/>
                    <field name="parent_id"/>
                </tree>
            </field>
        </record>

        <record id="menu_view_credenciales_tree" model="ir.actions.act_window">
            <field name="name">Credenciales de Accesos</field>
            <field name="res_model">sicpro.app.credenciales</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_credenciales_tree"/>
            <field name="search_view_id" ref="view_credenciales_filtro"/>
        </record>

        <record id="credencial_consecutivo_incrementar" model="ir.sequence">
            <field name="name">Credenciales: Consecutivo de la credencial del trabajador</field>
            <field name="code">credencial_consecutivo_incrementar</field>
            <field name="padding">4</field>
            <field name="prefix">No. </field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
    </record>

        <record id="credenciales_views_actions" model="ir.actions.act_window">
            <field name="name">Credenciales de Accesos</field>
            <field name="res_model">sicpro.app.credenciales</field>
            <field name="view_mode">kanban,form,tree</field>
            <field name="search_view_id" ref="view_credenciales_filtro"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Agregar Nuevo Trabajador
              </p><p>
                En este módulo se tendrá el control de todos los datos generales de los
                trabajadores.
              </p>
            </field>
        </record>
        
    </data>
</odoo>
