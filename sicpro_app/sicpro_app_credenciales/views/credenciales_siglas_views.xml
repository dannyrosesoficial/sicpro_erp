<odoo>
  <record id="view_credenciales_siglas_form" model="ir.ui.view">
    <field name="name">sicpro.app.credenciales.siglas.form</field>
    <field name="model">sicpro.app.credenciales.siglas</field>
    <field name="arch" type="xml">
      <form string="Tipo de Credencial">
        <sheet>
          <div class="oe_title">
            <div class="oe_edit_only">
              <label for="name"/>
            </div>
            <h1>
              <field name="name"/>
            </h1>
          </div>
          <group>
            <group>
              <field name="color" widget="color_picker"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_credenciales_siglas_list" model="ir.ui.view">
    <field name="name">sicpro.app.credenciales.siglas.list</field>
    <field name="model">sicpro.app.credenciales.siglas</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="credenciales_siglas_action" model="ir.actions.act_window">
    <field name="name">Siglas</field>
    <field name="res_model">sicpro.app.credenciales.siglas</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
