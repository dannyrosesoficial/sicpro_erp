<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>
         <!-- Creo la categoría de permisos Ejecutor -->
    <record id="module_category_solicitud_ejecutor" model="ir.module.category">
        <field name="name">Ejecutor</field>
        <field name="description">Módulo para el control del Negocio de trabajo de los inversionistas.</field>
        <field name="sequence" >10</field>
    </record>

    <record id="grupo_app_ejecutor_usuario" model="res.groups">
        <field name="name">Usuarios</field>
        <field name="comment">Permisos de lectura</field>
        <field name="category_id" ref="module_category_solicitud_ejecutor"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_ejecutor_ejecutor" model="res.groups">
        <field name="name">Ejecutor</field>
        <field name="comment">Permisos de lectura/Escritura</field>
        <field name="category_id" ref="module_category_solicitud_ejecutor"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_ejecutor_usuario'))]"/>
    </record>

    <record id="grupo_app_ejecutor_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="module_category_solicitud_ejecutor"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_ejecutor_ejecutor'))]"/>
    </record>
</data>

<data noupdate="0">
    <record id="ejecutor_rule_clientes_1" model="ir.rule">
        <field name="name">Regla Iniciativas Ejecutor Procesos</field>
        <field ref="sicpro_app_solicitudes_t1.model_sicpro_app_solicitudes_oportunidades" name="model_id"/>
        <field name="domain_force">['&amp;','&amp;', ('departamento', '=', user.departamento.id), ('company_id', 'in', company_ids),
            ('estado_interno', 'in', ('aprobada', 'rechazada_agrupacion', 'rechazada_ejecutor'))]</field>
        <field name="groups" eval="[(4, ref('grupo_app_ejecutor_usuario'))]"/>
    </record>
</data>

</odoo>
