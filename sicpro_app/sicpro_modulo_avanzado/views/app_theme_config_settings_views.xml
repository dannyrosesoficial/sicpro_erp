                            <field name="app_menu_perfil_3_url"
                                   attrs="{'invisible': [('app_menu_perfil_3','=', False)],
                                   'required': [('app_menu_perfil_3','=', True)]}"/>
                        </group>
                    </group>
                    <group string="Menu de Perfil 4">
