<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_app_theme_config_settings" model="ir.ui.view">
            <field name="name">Configuración de Personalización</field>
            <field name="model">res.config.settings</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form string="Configuración de Personalizaciones" class="oe_form_configuration">
                    <header>
                        <button string="Aplicar" type="object" name="execute" class="oe_highlight"/>
                        <button string="Cancelar" type="object" name="cancel" class="oe_link" special="cancel"/>
                    </header>
                    <h2>Personalización de SICPRO ERP</h2>
                    <group string="Nombre del sistema">
                        <label for="app_system_name"/>
                        <div>
                            <field name="app_system_name" readonly="0"/>
                        </div>
                    </group>
                    <group string="Contenido del Ribbon">
                        <label for="app_ribbon_name"/>
                        <div>
                            <field name="app_ribbon_name"/>
                            <div>
                                <span>Escriba False para ocultar</span>
                            </div>
                        </div>
                    </group>

                    <group string="Menu de Perfil 1">
                        <group>
                            <field name="app_menu_perfil_1"/>
                            <field name="app_menu_perfil_1_sequence"
                                   attrs="{'invisible': [('app_menu_perfil_1','=', False)],
                                   'required': [('app_menu_perfil_1','=', True)]}"/>
                        </group>
                        <group>
                            <field name="app_menu_perfil_1_titulo"
                                   attrs="{'invisible': [('app_menu_perfil_1','=', False)],
                                   'required': [('app_menu_perfil_1','=', True)]}"/>
                            <field name="app_menu_perfil_1_url"
                                   attrs="{'invisible': [('app_menu_perfil_1','=', False)],
                                   'required': [('app_menu_perfil_1','=', True)]}"/>
                        </group>
                    </group>
                    <group string="Menu de Perfil 2">
                        <group>
                            <field name="app_menu_perfil_2"/>
                            <field name="app_menu_perfil_2_sequence"
                                   attrs="{'invisible': [('app_menu_perfil_2','=', False)],
                                   'required': [('app_menu_perfil_2','=', True)]}"/>
                        </group>
                        <group>
                            <field name="app_menu_perfil_2_titulo"
                                   attrs="{'invisible': [('app_menu_perfil_2','=', False)],
                                   'required': [('app_menu_perfil_2','=', True)]}"/>
                            <field name="app_menu_perfil_2_url"
                                   attrs="{'invisible': [('app_menu_perfil_2','=', False)],
                                   'required': [('app_menu_perfil_2','=', True)]}"/>
                        </group>
                    </group>
                    <group string="Menu de Perfil 3">
