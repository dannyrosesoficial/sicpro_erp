<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <!-- Modules list -->
        <record id="app_module_tree" model="ir.ui.view">
            <field name="name">app.ir.module.module.tree</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.module_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="attributes">
                    <attribute name="groups"/>
                </field>
                <field name="installed_version" position="after">
                    <field name="latest_version"/>
                    <field name="local_updatable"/>
                </field>
                <field name="website" position="attributes">
                    <attribute name="optional">hide</attribute>
                </field>
            </field>
        </record>
        <!-- Modules search-->
        <record id="app_view_module_filter" model="ir.ui.view">
            <field name="name">app.ir.module.module.list.select</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.view_module_filter" />
            <field name="arch" type="xml">
                <filter name="not_installed" position="after">
                    <filter name="is_local_updatable" string="Local updatable" domain="[('local_updatable', '=', True)]"/>
                </filter>
            </field>
        </record>

        <record id="app_module_form" model="ir.ui.view">
            <field name="name">app.ir.module.module.form</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.module_form" />
            <field name="arch" type="xml">
                <h3 class="oe_fade" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </h3>
                <field name="website" position="attributes">
                    <attribute name="groups">base.group_system</attribute>
                </field>
            </field>
        </record>

    	<record id="app_module_view_kanban" model="ir.ui.view">
            <field name="name">ir.module.module.kanban.inherit.base</field>
            <field name="model">ir.module.module</field>
            <field name="inherit_id" ref="base.module_view_kanban"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('oe_module_vignette')]" position="attributes" groups="base.group_system">
                    <attribute name="class">oe_module_vignette oe_kanban_global_click</attribute>
                </xpath>

                <xpath expr="//div[hasclass('oe_module_desc')]//code" position="replace"/>
                <xpath expr="//div[hasclass('oe_module_desc')]//h4" position="after">
                    <code><field name="name"/></code>
                </xpath>

                <xpath expr="//div[hasclass('oe_module_action')]" position="inside" groups="base.group_system">

                    <div class="text-success text-small text-right font-weight-bold"><small>code: EZERCODE</small></div>
                    <button type="object" class="btn btn-danger btn-sm float-right"
                            name="button_uninstall_wizard" states="installed">Desinstalar</button>
                    <button type="object" class="btn btn-warning btn-sm float-right"
                            name="button_immediate_upgrade" states="installed">Actualizar</button>
                </xpath>

                <xpath expr="//div[hasclass('dropdown-menu')]" position="inside">
                    <a t-if="installed" name="%(sicpro_modulo_avanzado.action_server_module_multi_get_po)d"
                       type="action" role="menuitem" class="dropdown-item">Exportar Traducción</a>

                    <a t-if="installed" name="%(sicpro_modulo_avanzado.action_server_module_multi_refresh_po)d"
                       type="action" role="menuitem" class="dropdown-item">Refrescar Traducción</a>
                </xpath>
                <xpath expr="//div[hasclass('oe_module_action')]/a[@target='_blank']" position="replace"
                       groups="base.group_system"/>
            </field>
        </record>

</odoo>
