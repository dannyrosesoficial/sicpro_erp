<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="contratos_bancos_view_form" model="ir.ui.view">
            <field name="name">sicpro.app.contratos.economia.bancos.form</field>
            <field name="model">sicpro.app.contratos.economia.bancos</field>
            <field name="arch" type="xml">
                <form string="Bancos">
                    <sheet>
                        <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>

                        <div class="oe_title">
                        <field name="active" invisible="1"/>
                        <field name="tipo_banco" widget="radio" options="{'horizontal': true}"/> -
                        <field name="filtro_banco" widget="radio" options="{'horizontal': true}"
                               attrs="{'invisible': [('tipo_banco','=', 'beneficiario')]}"/>
                        <h1>
                            <field name="name" default_focus="1" placeholder="Nombre" />
                        </h1>

                        <div class="o_row">
                            <field name="cuenta_dvpe" placeholder="Cuenta DVPE" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"
                                   attrs="{'invisible': [('tipo_banco','=', 'beneficiario')]}" />

                            <field name="cuenta_beneficiario" placeholder="Cuenta Beneficiario" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"
                                   attrs="{'invisible': [('tipo_banco','=', 'dvpe')]}" />
                        </div>
                    </div>
                        <group name="bank_details">
                            <field name="codigo_id_bancaria"/>
                        </group>
                        <group>
                            <group name="address_details">
                                <label for="calle" string="Dirección del banco"/>
                                <div class="o_address_format">
                                    <field name="calle" placeholder="Calle..." class="o_address_street"/>
                                    <field name="calle2" placeholder="Calle 2..." class="o_address_street"/>
                                    <field name="provincia_id" class="o_address_state" placeholder="Provincia"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="municipios_id" placeholder="Municipio" class="o_address_city"
                                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                    <field name="postal" placeholder="C.P." class="o_address_zip"/>
                                </div>
                            </group>
                            <group name="communication_details">
                                <field name="swift"/>
                                <field name="telefono" class="o_force_ltr"/>
                                <field name="correo" widget="email"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="contratos_bancos_view_tree" model="ir.ui.view">
            <field name="name">sicpro.app.contratos.economia.bancos.tree</field>
            <field name="model">sicpro.app.contratos.economia.bancos</field>
            <field name="arch" type="xml">
                <tree string="Bancos">
                    <field name="tipo_banco"/>
                    <field name="name"/>
                    <field name="codigo_id_bancaria"/>
                    <field name="provincia_id"/>
                </tree>
            </field>
        </record>

        <record id="contratos_bancos_view_search" model="ir.ui.view">
            <field name="name">sicpro.app.contratos.economia.bancos.search</field>
            <field name="model">sicpro.app.contratos.economia.bancos</field>
            <field name="arch" type="xml">
                <search string="Buscar Bancos">
                    <field name="name"/>
                    <field name="tipo_banco"/>
                    <separator />
                    <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
                    <separator />
                <group expand="0" string="Agrupar por">
                    <filter string="Tipo de Banco" name="tipo_banco" context="{'group_by':'tipo_banco'}"/>
                    <filter string="Provincia" name="provincia_id" context="{'group_by':'provincia_id'}"/>
                    <filter string="Municipio" name="municipios_id" context="{'group_by':'municipios_id'}"/>
                </group>
                </search>
            </field>
        </record>

        <record id="contratos_bancos_action" model="ir.actions.act_window">
            <field name="name">Bancos</field>
            <field name="res_model">sicpro.app.contratos.economia.bancos</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="contratos_bancos_view_search"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear un nuevo Banco
              </p><p>
                Aquí controlara los bancos utilizados en las operaciones económicas del los contratos.
              </p>
            </field>
        </record>


</odoo>
