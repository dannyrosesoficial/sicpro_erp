<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="contratos_economia_acapite_search_view">
            <field name="name">sicpro.app.contratos.economia.acapite.search</field>
            <field name="model">sicpro.app.contratos.economia.acapite</field>
            <field name="arch" type="xml">
                <search string="indicador Pago">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="contratos_economia_acapite_form_view">
            <field name="name">sicpro.app.contratos.economia.acapite.form</field>
            <field name="model">sicpro.app.contratos.economia.acapite</field>
            <field name="arch" type="xml">
                <form string="Indicador de Economía">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="contratos_economia_acapite_tree_view">
            <field name="name">sicpro.app.contratos.economia.acapite.tree</field>
            <field name="model">sicpro.app.contratos.economia.acapite</field>
            <field name="arch" type="xml">
                <tree string="Indicador de economía" editable="bottom">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="contratos_economia_acapite_action" model="ir.actions.act_window">
            <field name="name">Acápites de Pagos</field>
            <field name="res_model">sicpro.app.contratos.economia.acapite</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear un nuevo acapite de pago...
              </p>
            </field>
        </record>
    </data>
</odoo>