      <!-- Vista del kanban para la gestion de contratos-->
    <record id="contratos_economia_gestion_kanban" model="ir.ui.view">
      <field name="name">sicpro.app.contratos.economia.gestion.kanban</field>
      <field name="model">sicpro.app.contratos.economia</field>
      <field name="priority">340</field>
      <field name="arch" type="xml">
      <kanban default_group_by="estado_id" class="o_kanban_small_column o_kanban_project_tasks"
                        archivable="false" >
                <field name="id"/>
                <field name="name"/>
                <field name="tipo_contrato"/>
                <field name="sol_pago_cuenta_gasto"/>
                <field name="proveedor"/>
                <field name="presupuesto_cup"/>
                <field name="vigencia_contrato_anios"/>
                <field name="etiquetas"/>
                <field name="company_currency"/>
                <field name="active" invisible="1"/>
                <field name="pep" invisible="1"/>
                <field name="estado_id" readonly="1" />
                <progressbar field="kanban_state" colors='{"done": "success", "blocked": "danger", "normal": "warning"}'/>
            <templates>
             <t t-name="kanban-box">
                   <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                  <div class="oe_kanban_details">
                      <strong class="o_kanban_record_title oe_partner_heading"><field name="name"/></strong>
                      <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                      <ul>
                          <li t-if="record.etiquetas.raw_value"><field name="etiquetas" widget="many2many_tags" options="{'color_field': 'color'}"/></li>
                          <li t-if="record.tipo_contrato.raw_value"><field name="tipo_contrato"/></li>
                          <li t-if="record.proveedor.raw_value"><field name="proveedor"/></li>
                          <li t-if="record.sol_pago_cuenta_gasto.raw_value"><field name="sol_pago_cuenta_gasto"/></li>
                          <li t-if="record.presupuesto_cup.raw_value and record.pep.raw_value" class="o_text_overflow">
                             <field name="pep"/>, <field name="presupuesto_cup" widget='monetary'
                                                         options="{'currency_field': 'company_currency'}"/></li>
                          <strong> </strong>
                      </ul>
                      <div class="oe_kanban_partner_links"/>
                  </div>
               </div>
             </t>
           </templates>
        </kanban>
     </field>
    </record>

        <!-- action del kanban para la gestion de contratos-->
    <record id="contratos_economia_gestion_action" model="ir.actions.act_window">
            <field name="name">Gestión de Operaciones</field>
