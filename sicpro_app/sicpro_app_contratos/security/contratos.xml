            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_contratacion"/>
            <field name="sequence" >3</field>
        </record>
        <record id="grupo_app_contratos_validar_gestor" model="res.groups">
            <field name="name">2. Gestor del Contrato</field>
            <field name="comment">Permisos validación del contrato por el Gestor</field>
            <field name="category_id" ref="module_category_contratos_validacion"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="grupo_app_contratos_validar_comite_contratacion" model="res.groups">
            <field name="name">3. Comité de Contratación</field>
            <field name="comment">Permisos validación del Comité de Contratación</field>
            <field name="category_id" ref="module_category_contratos_validacion"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_contratos_validar_gestor'))]"/>
        </record>
        <record id="grupo_app_contratos_validar_area" model="res.groups">
            <field name="name">4. Revisión del Área</field>
            <field name="comment">Permisos validación del contrato por Área</field>
            <field name="category_id" ref="module_category_contratos_validacion"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_contratos_validar_comite_contratacion'))]"/>
        </record>
        <record id="grupo_app_contratos_validar_legal" model="res.groups">
            <field name="name">5. Revisión Legal</field>
            <field name="comment">Permisos validación del contrato por Legal</field>
            <field name="category_id" ref="module_category_contratos_validacion"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_contratos_validar_area'))]"/>
        </record>
        <record id="grupo_app_contratos_validar_economica" model="res.groups">
            <field name="name">6. Revisión Económica</field>
            <field name="comment">Permisos validación del contrato por Económica</field>
            <field name="category_id" ref="module_category_contratos_validacion"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_contratos_validar_legal'))]"/>
       </record>

        <!-- Creo la categoría de visualizar todo Económica -->
        <record id="module_category_contratos_economia_visualizar_all" model="ir.module.category">
            <field name="name">Visual All Economía</field>
            <field name="description">Módulo para la gestión de los contratos generados en la division y su contabilidad.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_contratacion"/>
             <field name="sequence" >6</field>
         </record>
        <record id="grupo_app_contratos_economia_visual" model="res.groups">
            <field name="name">1. Visualizar Gestión Económica</field>
            <field name="comment">Permisos para visualizar la gestión de operciones</field>
            <field name="category_id" ref="module_category_contratos_economia_visualizar_all"/>
        </record>

        <!-- Creo la categoría de permisos técnicos de operaciones para economía -->
        <record id="module_category_contratos_economia" model="ir.module.category">
            <field name="name">Economía</field>
             <field name="description">Módulo para la gestión de los contratos generados en la division y su contabilidad.</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_contratacion"/>
             <field name="sequence" >4</field>
         </record>
        <record id="grupo_app_contratos_economia_operaciones_sp" model="res.groups">
            <field name="name">2. Solicitud de Pago</field>
            <field name="comment">Permisos para la gestión de la solicitud de pago</field>
            <field name="category_id" ref="module_category_contratos_economia"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="grupo_app_contratos_economia_operaciones_sip" model="res.groups">
            <field name="name">3. Solicitud de Instrumento de Pago</field>
            <field name="comment">Permisos para la gestión de la solicitud de instrumento de pago</field>
            <field name="category_id" ref="module_category_contratos_economia"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_contratos_economia_operaciones_sp'))]"/>
        </record>
        <record id="grupo_app_contratos_economia_operaciones_ip" model="res.groups">
            <field name="name">4. Emisión de Pago</field>
            <field name="comment">Permisos para la gestión del la emisión de pago</field>
            <field name="category_id" ref="module_category_contratos_economia"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_contratos_economia_operaciones_sip'))]"/>
        </record>
</data>

