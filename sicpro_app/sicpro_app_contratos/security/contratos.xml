            <field name="name">1. Visualizar Gestión del Contrato</field>
            <field name="comment">Permisos validación de todos los registros</field>
            <field name="category_id" ref="module_category_contratos_visualizar_all"/>
       </record>

         <!-- Creo la categoría de permisos técnicos del Contrato -->
        <record id="module_category_contratos_validacion" model="ir.module.category">
