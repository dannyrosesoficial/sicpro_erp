<?xml version="1.0" encoding="utf-8"?>
<template name="dashboard_contratos">
<t t-name="DashBoard">
    <t t-if="isMobile">
        <t t-set="node.attrs.layout" t-value="1"/>
    </t>
    <t t-if="!isMobile">
        <div>
            <h1>
                <div class="stat-icon stat-text text-danger"><i class="fa fa-dashboard"/> Dashboard de Contratación</div>
            </h1>
                <div class="stat-text"><strong>Tablero de mando para la aplicación de contratación.</strong></div>
        <hr/>
        </div>
        <t t-if="!node.grupo_acceso"></t>
        <t t-else="">
            <div class="oe_dashboard_links">
            <button type="button" class="button oe_dashboard_link_change_layout btn btn-secondary"
                title="Cambiar el diseño..">
                <img src="/sicpro_app_contratos/static/src/img/layout_1-1-1.png" width="16" height="16" alt=""/>
                <span> Cambiar el diseño </span>
            </button>
        </div>
        </t>
    </t>
    <table t-att-data-layout="node.attrs.layout" t-attf-class="oe_dashboard oe_dashboard_layout_#{node.attrs.layout}"
           cellspacing="0" cellpadding="0" border="0">
    <tr>
        <td t-foreach="node.children" t-as="column" t-if="column.tag == 'column'"
             t-att-id="'column_' + column_index" t-attf-class="oe_dashboard_column index_#{column_index}">

            <t t-foreach="column.children" t-as="action" t-if="action.tag == 'action'" t-call="DashBoard_contratos.action"/>
        </td>
    </tr>
    </table>
</t>
<t t-name="DashBoard_contratos.action">
    <div t-att-data-id="action.attrs.id" class="oe_action">
        <h2 t-attf-class="oe_header #{action.attrs.string ? '' : 'oe_header_empty'}">
            <span class="oe_header_txt"> <t t-esc="action.attrs.string"/> </span>
            <input class = "oe_header_text" type="text"/>
            <t t-if="!action.attrs.string">&amp;nbsp;</t>
            <t t-if="!node.grupo_acceso"></t>
            <t t-else=""><span class='oe_icon oe_close' ></span></t>
            <span class='oe_icon oe_minimize oe_fold' t-if="!action.attrs.fold"></span>
            <span class='oe_icon oe_maximize oe_fold' t-if="action.attrs.fold"></span>
        </h2>
        <div t-att-class="'oe_content' + (action.attrs.fold ? ' oe_folded' : '')"/>
    </div>
</t>
<t t-name="DashBoard_contratos.layouts">
    <div class="oe_dashboard_layout_selector">
        <p>
            <strong>Cambiar el diseño</strong>
        </p>
        <ul>
            <li t-foreach="'1 1-1 1-1-1 1-2 2-1'.split(' ')" t-as="layout" t-att-data-layout="layout">
                <img t-attf-src="/sicpro_app_contratos/static/src/img/layout_#{layout}.png" alt=""/>
                <i t-if="layout == currentLayout" class="oe_dashboard_selected_layout fa fa-check fa-lg text-success"
                   aria-label='Layout' role="img" title="Layout"/>
            </li>
        </ul>
    </div>
</t>
<t t-name="DashBoard_contratos.NoContent">
    <div class="o_view_nocontent">
        <div class="o_nocontent_help">
            <p class="o_view_nocontent_neutral_face">
                Su dashboard de contratos está vacío
            </p><p>
                Si esta acción persiste contacte al <i>"Administrador del sistema"</i>
            </p>
        </div>
    </div>
</t>
<t t-name="DashBoard_contratos.xml">
    <form t-att-string="form_title">
        <board t-att-style="style">
            <column t-foreach="columns" t-as="column">
                <action t-foreach="column" t-as="action" t-att="action"/>
            </column>
        </board>
    </form>
</t>
<div t-name="HomeWidget_contratos" class="oe_dashboard_home_widget"/>
<t t-name="HomeWidget_contratos.content">
    <h3><t t-esc="widget.title"/></h3>
    <iframe width="100%" frameborder="0" t-att-src="url"/>
</t>

<t t-name="AddToBoardMenu_contratos" owl="1">
    <li class="o_menu_item o_add_to_board" role="menuitem">
        <t t-if="!state.permisos"></t>
        <t t-else="">
            <button type="button" class="dropdown-item"
            t-ref="fallback-focus"
            t-on-click="state.open = !state.open"
            >
            <t>Agregar a Dashboard Contratos</t>
        </button>
            <t t-if="state.open">
            <div class="dropdown-item-text">
                <input type="text" class="o_input" autofocus=""
                    t-model.trim="state.name"
                    t-on-keydown="_onInputKeydown"
                />
            </div>
            <div class="dropdown-item-text">
                <button type="button" class="btn btn-primary" t-on-click="_addToBoard">Add</button>
            </div>
        </t>
        </t>
    </li>
</t>

