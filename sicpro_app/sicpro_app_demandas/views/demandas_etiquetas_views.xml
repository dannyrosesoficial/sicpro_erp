<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record model="ir.ui.view" id="demandas_etiquetas_search_view">
            <field name="name">ssicpro.app.demandas.etiquetas.search</field>
            <field name="model">sicpro.app.demandas.etiquetas</field>
            <field name="arch" type="xml">
                <search string="Buscar Etiquetas">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="demandas_etiquetas_tree_view">
            <field name="name">sicpro.app.demandas.etiquetas.tree</field>
            <field name="model">sicpro.app.demandas.etiquetas</field>
            <field name="arch" type="xml">
                <tree string="Etiquetas de economía" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <record id="demandas_etiquetas_action" model="ir.actions.act_window">
            <field name="name">Etiquetas de las Demandas</field>
            <field name="res_model">sicpro.app.demandas.etiquetas</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear nueva etiqueta...
              </p>
            </field>
        </record>
    
    </data>
</odoo>