<odoo>
  <data>
    <!-- Creo los privilegios de permisos para el Cuadro de Mando Integral-->
    <record id="privilege_cmi" model="res.groups.privilege">
      <field name="name">CMI</field>
      <field name="sequence">1</field>
      <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_gestion_produccion"/>
    </record>

    <record id="grupo_app_cmi_usuario" model="res.groups">
      <field name="name">Usuarios</field>
      <field name="comment">Permisos de lectura</field>
      <field name="privilege_id" ref="privilege_cmi"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_cmi_ejecutor" model="res.groups">
      <field name="name">Ejecutor</field>
      <field name="comment">Permisos de Lectura/Escritura</field>
      <field name="privilege_id" ref="privilege_cmi"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_cmi_usuario'))]"/>
    </record>

    <record id="grupo_app_cmi_responsable" model="res.groups">
      <field name="name">Responsable</field>
      <field name="comment">Permisos de Lectura/Escritura/Config</field>
      <field name="privilege_id" ref="privilege_cmi"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_cmi_ejecutor'))]"/>
    </record>

    <record id="grupo_app_cmi_admin" model="res.groups">
      <field name="name">Administrador</field>
      <field name="comment">Permisos Completos</field>
      <field name="privilege_id" ref="privilege_cmi"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_cmi_responsable'))]"/>
    </record>
  </data>
</odoo>