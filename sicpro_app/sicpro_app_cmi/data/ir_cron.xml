<odoo>
    <data noupdate="0">
       <!-- Cron para verificar el vencimiento de las acciones -->
        <record id="cmi_acciones_vencimiento" model="ir.cron">
            <field name="name">CMI: Inicio y Vencimiento de las Acciones</field>
            <field name="model_id" ref="sicpro_app_cmi.model_sicpro_app_cmi_acciones"/>
            <field name="state">code</field>
            <field name="code">model.acciones_vencimiento_acciones()</field>
            <field eval="True" name="active" />
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>
