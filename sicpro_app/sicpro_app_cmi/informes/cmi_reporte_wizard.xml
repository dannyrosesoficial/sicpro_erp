<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="reporte_cmi_wizard" model="ir.ui.view">
        <field name="name">sicpro.app.cmi.reporte.form</field>
        <field name="model">sicpro.app.cmi.reporte</field>
        <field name="arch" type="xml">
            <form string="Reporte del Cuadro de Mando Integral">
                <group>
                    <group>
                        <field name="anio"/>
                        <field name="periodo"/>
                        <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                    </group>
                    <group>
                        <field name="tipo" widget="radio"/>
                    </group>
                </group>
                <footer>
                    <button name="generar_reporte" string="Imprimir" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="reporte_cmi_wizard_action" model="ir.actions.act_window">
        <field name="name">Reporte del Cuadro de Mando Integral</field>
        <field name="res_model">sicpro.app.cmi.reporte</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
