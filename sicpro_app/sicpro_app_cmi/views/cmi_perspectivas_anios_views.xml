<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <!-- Vista del DASHBOARD-->
    <record id="cmi_perspectivas_anios_view_tree" model="ir.ui.view">
        <field name="name">sicpro.app.cmi.perspectivas.anios.tree</field>
        <field name="model">sicpro.app.cmi.perspectivas.anios</field>
        <field name="arch" type="xml">
            <tree string="Tablero de Perspectivas" editable="bottom">
                <field name="anio" class="font-weight-bold"/>
                <field name="user_id" widget="many2one_avatar_user"
                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="cmi_perspectivas_anios_view_filter" model="ir.ui.view">
       <field name="name">sicpro.app.cmi.perspectivas.anios.filter</field>
       <field name="model">sicpro.app.cmi.perspectivas.anios</field>
        <field name="arch" type="xml">
            <search string="Buscar Perspectivas">
                <field name="anio"/>
        </search>
       </field>
    </record>

    <record id="cmi_perspectivas_anios_views_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.cmi.perspectivas.anios.kanban</field>
        <field name="model">sicpro.app.cmi.perspectivas.anios</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" sample="1">
                <field name="name"/>
                <field name="color"/>
                <field name="user_id"/>
                <field name="anio"/>
                <field name="id"/>
                <field name="company_id"/>
                <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card o_kanban_record_has_image_fill">
                                <div class="o_kanban_image_fill_left o_kanban_image_full"
                                     t-attf-style="background-image: url(#{kanban_image('sicpro.app.cmi.perspectivas.anios', 'image_128', record.id.raw_value)})" role="img"/>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title oe_partner_heading font-weight-bold"
                                            style="font-size: 20px;">
                                        <field name="name"/> - <field name="anio"/>
                                    </strong>
                                    <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                    <ul>
                                        <li class="font-weight-bold"><field name="company_id"/></li>
                                    </ul>
                                     <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <button class="btn btn-primary" name="%(cmi_perspectivas_periodo_dashboard_action)d"
                                                type="action"
                                                t-attf-data-context="{'default_anual': #{record.anio.raw_value}}">
                                            Filtrar Períodos </button>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                                    <div class="oe_kanban_partner_links"/>
                                </div>
                            </div>
                        </t>
                    </templates>
            </kanban>
        </field>
    </record>

    <!-- Action del DASHBOARD-->
    <record id="cmi_perspectivas_anios_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tablero de Años</field>
        <field name="res_model">sicpro.app.cmi.perspectivas.anios</field>
        <field name="view_mode">kanban</field>
        <field name="search_view_id" ref="cmi_perspectivas_anios_view_filter"/>
        <field name="view_id" ref="cmi_perspectivas_anios_views_kanban"/>
    </record>

    <!-- Action del TREE-->
    <record id="cmi_perspectivas_anios_tree_action" model="ir.actions.act_window">
        <field name="name">Años de Perspectivas</field>
        <field name="res_model">sicpro.app.cmi.perspectivas.anios</field>
        <field name="view_mode">tree</field>
        <field name="search_view_id" ref="cmi_perspectivas_anios_view_filter"/>
        <field name="view_id" ref="cmi_perspectivas_anios_view_tree"/>
    </record>

</odoo>