<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <!-- Vista del DASHBOARD-->
    <record id="cmi_perspectivas_periodo_views_kanban" model="ir.ui.view">
        <field name="name">sicpro.app.cmi.perspectivas.periodos.kanban</field>
        <field name="model">sicpro.app.cmi.perspectivas.periodos</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card o_kanban_record_has_image_fill">
                                <div class="o_kanban_image_fill_left o_kanban_image_full"
                                     t-attf-style="background-image: url(#{kanban_image('sicpro.app.cmi.perspectivas.periodos', 'image_128', record.id.raw_value)})" role="img"/>
                                <div class="oe_kanban_details">
                                    <t t-if="record.name.value === 'Anual'">
                                        <strong style="font-size: 20px;"  title="Anual"
                                                class="text-danger o_kanban_record_title oe_partner_heading font-weight-bold">
                                            <field name="name"/>
                                        </strong>
                                    </t>
                                    <t t-elif="record.name.value == 'Primer Semestre' or record.name.value == 'Segundo Semestre'">
                                        <strong style="font-size: 20px;"  title="Semestres"
                                                class="text-warning o_kanban_record_title oe_partner_heading font-weight-bold">
                                            <field name="name"/>
                                        </strong>
                                    </t>
                                    <t t-elif="record.name.value == 'Primer Trimestre' or record.name.value == 'Segundo Trimestre' or record.name.value == 'Tercer Trimestre' or record.name.value == 'Cuarto Trimestre'">
                                        <strong style="font-size: 20px;"  title="Trimestres"
                                                class="text-primary o_kanban_record_title oe_partner_heading font-weight-bold">
                                            <field name="name"/>
                                        </strong>
                                    </t>
                                    <t t-else="record.name.value">
                                        <strong style="font-size: 20px;" title="Meses"
                                                class="text-success o_kanban_record_title oe_partner_heading font-weight-bold">
                                            <field name="name"/>
                                        </strong>
                                    </t>

                                    <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                                    <strong style="font-size: 20px;"
                                            class="text-black o_kanban_record_title oe_partner_heading font-weight-bold">
                                        <field name="anio_temp"/>
                                    </strong>
                                     <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <button class="btn btn-primary" name="action_objetivos_anuales" type="object">
                                            Ver Período</button>
                                    </div>
                                    <div class="oe_kanban_bottom_right">

                                    </div>
                                </div>
                                    <div class="oe_kanban_partner_links"/>
                                </div>
                            </div>
                        </t>
                    </templates>
            </kanban>
        </field>
    </record>

    <!-- Action del DASHBOARD-->
    <record id="cmi_perspectivas_periodo_dashboard_action" model="ir.actions.act_window">
        <field name="name">Tablero de Períodos</field>
        <field name="res_model">sicpro.app.cmi.perspectivas.periodos</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="cmi_perspectivas_periodo_views_kanban"/>
    </record>


     <!-- Vista de CONFIGURACIÓN-->
    <record id="cmi_perspectivas_periodo_views_tree" model="ir.ui.view">
        <field name="name">sicpro.app.cmi.perspectivas.periodos.tree</field>
        <field name="model">sicpro.app.cmi.perspectivas.periodos</field>
        <field name="arch" type="xml">
            <tree string="Periodos" editable="bottom">
                <field name="active" widget="boolean_toggle"/>
                <field name="name" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="cmi_perspectivas_periodo_tree_action" model="ir.actions.act_window">
        <field name="name">Filtros de Períodos</field>
        <field name="res_model">sicpro.app.cmi.perspectivas.periodos</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="cmi_perspectivas_periodo_views_tree"/>
    </record>

    <record id="cmi_perspectivas_periodo_filter" model="ir.ui.view">
       <field name="name">sicpro.app.cmi.perspectivas.periodos.filter</field>
       <field name="model">sicpro.app.cmi.perspectivas.periodos</field>
        <field name="arch" type="xml">
            <search string="Buscar Periodos">
                <field name="name"/>
                <separator />
                <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
                <separator />
        </search>
       </field>
    </record>
</odoo>