<odoo>
  <record id="cmi_modo_control_view_list" model="ir.ui.view">
    <field name="name">sicpro.app.cmi.acciones.modo.control.list</field>
    <field name="model">sicpro.app.cmi.acciones.modo.control</field>
    <field name="arch" type="xml">
      <list string="Modo Control" editable="bottom">
        <field name="name"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="cmi_modo_control_view_filter" model="ir.ui.view">
    <field name="name">sicpro.app.cmi.acciones.modo.control.filter</field>
    <field name="model">sicpro.app.cmi.acciones.modo.control</field>
    <field name="arch" type="xml">
      <search string="Buscar Modo control">
        <field name="name"/>
      </search>
    </field>
  </record>

  <record id="cmi_modo_control_action" model="ir.actions.act_window">
    <field name="name">Modos de Control</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">sicpro.app.cmi.acciones.modo.control</field>
    <field name="view_mode">list</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea los Modos de control
      </p>
    </field>
  </record>
</odoo>
