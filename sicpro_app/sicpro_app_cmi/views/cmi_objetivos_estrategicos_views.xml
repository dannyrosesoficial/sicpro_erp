<odoo>
  <record id="cmi_objetivos_estrategicos_view_list" model="ir.ui.view">
    <field name="name">sicpro.app.cmi.objetivos.estrategicos.list</field>
    <field name="model">sicpro.app.cmi.objetivos.estrategicos</field>
    <field name="arch" type="xml">
      <list string="Objetivos Estratégicos">
        <field name="porciento_superior"/>
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="cmi_objetivos_estrategicos_view_filter" model="ir.ui.view">
    <field name="name">sicpro.app.cmi.objetivos.estrategicos.filter</field>
    <field name="model">sicpro.app.cmi.objetivos.estrategicos</field>
    <field name="arch" type="xml">
      <search string="Buscar Objetivos Estratégicos">
        <field name="name"/>
        <field name="id" invisible="1"/>
        <separator/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        <separator/>
        <group>
          <filter string="Ejes Estratégicos" name="eje_estrategico_id" context="{'group_by':'eje_estrategico_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="cmi_objetivos_estrategicos_view_form" model="ir.ui.view">
    <field name="name">sicpro.app.cmi.objetivos.estrategicos.form</field>
    <field name="model">sicpro.app.cmi.objetivos.estrategicos</field>
    <field name="arch" type="xml">
      <form string="Objetivos Estratégicos">
        <sheet>
          <group>
            <label for="name" string="Nombre"/>
            <div class="o_row">
              <field name="name"/>
            </div>

            <field name="perspectivas_id" invisible="1"/>
          </group>
          <group>
            <group>
              <field name="porciento_superior" string="Peso"/>
            </group>
            <group>
              <field name="eje_estrategico_id"
                     options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </group>
          </group>
          <group string="Descripción del objetivo">
            <field name="detalles"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="cmi_objetivos_estrategicos_views_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.cmi.objetivos.estrategicos.kanban</field>
    <field name="model">sicpro.app.cmi.objetivos.estrategicos</field>
    <field name="arch" type="xml">
      <kanban highlight_color="color" class="oe_background_grey o_kanban_dashboard" create="true" sample="1">
        <field name="name"/>
        <field name="color"/>
        <field name="porciento_superior"/>
        <field name="porciento_avance_barra"/>
        <field name="json_anuales"/>
        <field name="json_indicadores"/>
        <field name="incumplido"/>
        <field name="mes_temp"/>
        <field name="anio_temp"/>
        <field name="eje_estrategico_id"/>
        <field name="detalles"/>

        <templates>
          <t t-name="card">
            <div
                t-attf-class="oe_kanban_global_click #{!selection_mode ? 'oe_kanban_color_' + record.color.raw_value : ''}">
              <div class="ribbon ribbon-top-right">
                <span class="bg-muted text-dark fw-bold"><t t-esc="record.porciento_superior.value"/> %</span>
              </div>

              <div class="o_kanban_card_header">
                <div class="o_kanban_card_header_title">
                  <div class="o_primary col-12 fw-bold" style="font-size: 1.2em;">
                    <span><t t-esc="record.name.value"/></span>
                  </div>
                </div>
              </div>

              <div class="container o_kanban_card_content mt-2">
                <div class="row align-items-center">
                  <div class="col-4 d-flex align-items-center">
                    <i t-if="record.incumplido.raw_value > 0" class="fa fa-chevron-down text-danger me-1"
                       title="Objetivo Incumplido"/>
                    <i t-if="record.incumplido.raw_value == 0" class="fa fa-chevron-up text-success me-1"
                       title="Objetivo Cumplido"/>
                    <span class="fw-bold text-dark"><t t-esc="Math.round(record.porciento_avance_barra.raw_value)"/>
                      %</span>
                  </div>
                  <div class="col-8">
                    <div class="progress" style="height: 10px;">
                      <div t-attf-class="progress-bar #{record.incumplido.raw_value > 0 ? 'bg-danger' : 'bg-success'}"
                           role="progressbar"
                           t-attf-style="width: #{record.porciento_avance_barra.raw_value}%">
                      </div>
                    </div>
                  </div>
                </div>

                <div class="row mt-3 mb-2">
                  <div class="col-7">
                    <button class="btn btn-primary btn-sm" name="action_objetivos_anuales" type="object">
                      Objetivos Anuales
                    </button>
                  </div>
                  <div class="col-5 text-end text-muted small fw-bold">
                    <field name="mes_temp"/> <field name="anio_temp"/>
                  </div>
                </div>

                <div class="row">
                  <div class="col-12 border-top pt-2">
                    <small class="text-muted d-block text-truncate"><field name="detalles"/></small>
                    <div class="text-center fst-italic small mt-1">
                      Eje: <field name="eje_estrategico_id"/>
                    </div>
                  </div>
                </div>

                <div class="o_kanban_primary_bottom mt-3">
                  <t t-if="record.json_anuales.raw_value">
                    <t t-set="anuales" t-value="JSON.parse(record.json_anuales.raw_value)"/>
                    <t t-set="indicadores"
                       t-value="record.json_indicadores.raw_value ? JSON.parse(record.json_indicadores.raw_value) : []"/>

                    <t t-foreach="anuales" t-as="anual" t-key="anual.id">
                      <div class="border rounded p-2 mb-2 bg-white-50">
                        <div class="d-flex justify-content-between align-items-center">
                          <div class="fw-bold small text-truncate" style="max-width: 85%;">
                            <i t-attf-class="fa fa-bars me-1 {{ anual.incumplido > 0 ? 'text-danger' : 'text-success' }}"
                               t-att-title="anual.incumplido > 0 ? 'Existen indicadores incumplidos' : 'Todos los indicadores cumplidos'"/>

                            <a name="%(sicpro_app_cmi.call_cmi_indicadores_dashboard_action)d"
                               type="action"
                               t-att-context="{'search_default_obj_anuales_id': anual.id}">
                              <t t-esc="anual.name"/>
                            </a>
                          </div>
                        </div>

                        <t t-foreach="indicadores" t-as="ind" t-key="ind.id">
                          <t t-if="ind.id_anual === anual.id">
                            <div class="ms-3 mt-1 ps-2 border-start">
                              <div class="d-flex justify-content-between align-items-center">
                                <div class="text-truncate" style="max-width: 75%;">
                                  <t t-set="is_bad"
                                     t-value="(ind.diferencia_acumulado &lt; 0 and !ind.condicion_presupuesto) or (ind.diferencia_acumulado &gt; 0 and ind.condicion_presupuesto)"/>
                                  <i t-attf-class="fa #{is_bad ? 'fa-chevron-down text-danger' : 'fa-chevron-up text-success'} small me-1"/>
                                  <a type="object"
                                     name="action_indicadores"
                                     t-att-context="{'default_id': ind.id}">
                                    <small class="text-dark"><t t-esc="ind.name"/></small>
                                  </a>
                                </div>
                                <small class="fw-bold"><t t-esc="ind.porciento_barra1"/>%</small>
                              </div>
                              <div class="progress" style="height: 4px;">
                                <div t-attf-class="progress-bar #{is_bad ? 'bg-danger' : 'bg-success'}"
                                     t-attf-style="width: #{ind.porciento_barra1}%">
                                </div>
                              </div>
                            </div>
                          </t>
                        </t>
                      </div>
                    </t>
                  </t>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="cmi_objetivos_estrategicos_dashboard_action" model="ir.actions.act_window">
    <field name="name">Tablero de Objetivos Estratégicos</field>
    <field name="res_model">sicpro.app.cmi.objetivos.estrategicos</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="view_id" ref="cmi_objetivos_estrategicos_views_kanban"/>
    <field name="search_view_id" ref="cmi_objetivos_estrategicos_view_filter"/>
    <field name="context">{'search_default_perspectivas_id': active_id, 'default_perspectivas_id': active_id}</field>
    <field name="domain">[('perspectivas_id', '=', active_id)]</field>
  </record>
</odoo>
