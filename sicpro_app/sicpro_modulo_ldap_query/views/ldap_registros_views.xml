<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sicpro_modulo_ldap_registros_tree_view" model="ir.ui.view">
        <field name="name">sicpro.app.modulo.ldap.registros.tree.view</field>
        <field name="model">sicpro.app.modulo.ldap.registros</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false">
                <field name="active" invisible="1"/>
                <field name="employeeNumber"/>
                <field name="cn"/>
                <field name="title"/>
                <field name="departmentNumber"/>
                <field name="mail"/>
                <field name="telephoneNumber"/>
                <field name="mobile"/>
                <field name="ou"/>
            </tree>
        </field>
    </record>

        <record id="sicpro_modulo_ldap_registros_filter_view" model="ir.ui.view">
       <field name="name">Buscar</field>
       <field name="model">sicpro.app.modulo.ldap.registros</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="cn"/>
                <field name="mail"/>
                <field name="departmentNumber"/>
                <field name="employeeNumber"/>
                <field name="ou"/>
                <field name="telephoneNumber"/>
                <field name="mobile"/>
                <field name="title"/>
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Unidad Organizativa" name="ou" domain="[]" context="{'group_by':'ou'}"/>
                </group>
        </search>
       </field>
    </record>

        <record id="sicpro_modulo_ldap_registros_kanban_view" model="ir.ui.view">
     <field name="name">sicpro.app.modulo.ldap.registros.kanban</field>
      <field name="model">sicpro.app.modulo.ldap.registros</field>
     <field name="arch" type="xml">
        <kanban>
                 <field name="employeeNumber"/>
                <field name="cn"/>
                <field name="title"/>
                <field name="departmentNumber"/>
                <field name="mail"/>
                <field name="telephoneNumber"/>
                <field name="mobile"/>
                <field name="ou"/>
           <templates>
             <t t-name="kanban-box">
                   <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                       <t>
                           <t t-set="placeholder" t-value="'/sicpro_app_clientes/static/src/img/etecsaCi_300_8.png'"/>
                       </t>
                  <div class="oe_kanban_details">
                      <strong class="o_kanban_record_title oe_partner_heading">
                          <span class="font-weight-bold"><field name="cn"/></span> -
                          <span class="text-primary"><field name="ou"/></span>
                      </strong>
                      <div class="o_kanban_tags_section oe_kanban_partner_categories"/>
                      <ul>
                          <li t-if="record.title.raw_value != '-'"><field name="title"/></li>
                          <li t-if="record.departmentNumber.raw_value != '-'"><field name="departmentNumber"/></li>
                          <div>
                          <t t-if="record.telephoneNumber.raw_value != '-'"><span class="font-weight-bold text-danger">F: </span><field name="telephoneNumber"/></t>
                          <t t-if="record.mobile.raw_value != '-'"><span class="font-weight-bold text-danger">M: </span><field name="mobile"/></t>
                          </div>
                          <li t-if="record.mail.raw_value" class="o_text_overflow"><field name="mail" widget="email"/></li>
                      </ul>
                      <div class="oe_kanban_partner_links"/>
                  </div>
               </div>
             </t>
           </templates>
        </kanban>
     </field>
    </record>

        <record id="action_sicpro_modulo_ldap_registros" model="ir.actions.act_window">
        <field name="name">Contactos LDAP</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.modulo.ldap.registros</field>
        <field name="view_mode">kanban,tree</field>
    </record>

        <menuitem id="menu_ldao_registros" action="action_sicpro_modulo_ldap_registros" name="Contactos LDAP"
                  parent="sicpro_app_contactos.menu_contactos" groups="base.group_user" sequence="5"/>
    </data>
</odoo>