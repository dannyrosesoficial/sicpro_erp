<odoo>
  <record id="app_view_attachment_search" model="ir.ui.view">
    <field name="name">app.ir.attachment.search</field>
    <field name="model">ir.attachment</field>
    <field name="inherit_id" ref="base.view_attachment_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <searchpanel class="" view_types="kanban,list">
          <field name="type" groupby="" icon="fa-filter" enable_counters="1"/>
          <field name="create_uid" groupby="" icon="fa-filter" enable_counters="1"/>
        </searchpanel>
      </xpath>
    </field>
  </record>
</odoo>
