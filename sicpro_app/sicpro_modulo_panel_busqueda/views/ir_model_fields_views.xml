<odoo>
  <record id="app_view_model_fields_search" model="ir.ui.view">
    <field name="name">app.ir.model.fields.search</field>
    <field name="model">ir.model.fields</field>
    <field name="inherit_id" ref="base.view_model_fields_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <searchpanel class="" view_types="kanban,list">
          <field name="state" groupby="" icon="fa-filter" enable_counters="1"/>
          <field name="ttype" groupby="" icon="fa-filter" enable_counters="1"/>
          <field name="model_id" groupby="" icon="fa-filter" enable_counters="1"/>
        </searchpanel>
      </xpath>
    </field>
  </record>
</odoo>
