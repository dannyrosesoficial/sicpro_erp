<odoo>
  <record id="app_ir_access_view_search" model="ir.ui.view">
    <field name="name">app.ir.model.access.search</field>
    <field name="model">ir.model.access</field>
    <field name="inherit_id" ref="base.ir_access_view_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <searchpanel class="" view_types="kanban,list">
          <field name="group_id" groupby="" icon="fa-filter" enable_counters="1"/>
          <field name="model_id" groupby="" icon="fa-filter" enable_counters="1"/>
        </searchpanel>
      </xpath>
    </field>
  </record>
</odoo>
