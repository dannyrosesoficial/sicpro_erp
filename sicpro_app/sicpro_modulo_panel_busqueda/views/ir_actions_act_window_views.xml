<odoo>
  <record id="app_view_window_action_search" model="ir.ui.view">
    <field name="name">app.ir.actions.windows.search</field>
    <field name="model">ir.actions.act_window</field>
    <field name="inherit_id" ref="base.view_window_action_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <searchpanel class="" view_types="kanban,list">
          <field name="binding_type" groupby="" icon="fa-filter" enable_counters="1"/>
          <field name="target" groupby="" icon="fa-filter" enable_counters="1"/>
        </searchpanel>
      </xpath>
    </field>
  </record>
</odoo>
