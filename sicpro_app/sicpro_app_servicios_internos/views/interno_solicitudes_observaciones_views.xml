<odoo>
  <record id="view_internos_solicitudes_observaciones_filtro" model="ir.ui.view">
    <field name="name">sicpro.app.servicios.internos.solicitudes.observaciones.filtro</field>
    <field name="model">sicpro.app.servicios.internos.solicitudes.observaciones</field>
    <field name="arch" type="xml">
      <search string="Lineas">
        <field name="name"/>
        <field name="tipo"/>
        <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        <separator/>
        <group>
          <filter string="Tipo" name="estado" context="{'group_by':'tipo'}"/>
        </group>
        <searchpanel>
          <field name="tipo" enable_counters="1" icon="fa-map-marker"/>
        </searchpanel>
      </search>
    </field>
  </record>

  <record id="view_internos_solicitudes_observaciones_list" model="ir.ui.view">
    <field name="name">sicpro.app.servicios.internos.solicitudes.observaciones.list</field>
    <field name="model">sicpro.app.servicios.internos.solicitudes.observaciones</field>
    <field name="arch" type="xml">
      <list string="Observaciones de Solicitudes" editable="bottom">
        <field name="name"/>
        <field name="tipo"/>
      </list>
    </field>
  </record>

  <record id="internos_solicitudes_observaciones_views_actions" model="ir.actions.act_window">
    <field name="name">Observaciones de Solicitudes</field>
    <field name="res_model">sicpro.app.servicios.internos.solicitudes.observaciones</field>
    <field name="view_mode">list</field>
    <field name="search_view_id" ref="view_internos_solicitudes_observaciones_filtro"/>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Agregar un nuevo registro de observación
      </p>
    </field>
  </record>
</odoo>
