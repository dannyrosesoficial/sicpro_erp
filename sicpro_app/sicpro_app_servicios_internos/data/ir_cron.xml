<odoo>
  <data noupdate="0">
    <!-- Cron del servicio de correo para verificar que el trabajador está activo, si no desactivo el registro -->
    <record id="servicios_internos_verifico_correos" model="ir.cron">
      <field name="name">Servicios Internos: Servicio de Correo, verificar Trabajador Activo</field>
      <field name="model_id" ref="sicpro_app_servicios_internos.model_sicpro_app_servicios_internos_correos"/>
      <field name="state">code</field>
      <field name="code">model.cron_verifico_trabajador_correos_servicios_internos()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

    <!-- Cron del servicio de líneas para verificar que el trabajador está activo, si no desactivo el registro -->
