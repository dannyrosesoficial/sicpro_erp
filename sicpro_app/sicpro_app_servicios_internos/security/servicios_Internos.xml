<?xml version="1.0" ?>
<odoo>

    <!-- Creo la categoría de permisos de servicios internos-->
    <record id="modulo_categoria_servicios_internos" model="ir.module.category">
        <field name="name">Servicios Internos</field>
        <field name="description">Módulo de servicios internos.</field>
        <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_gestión_documentos"/>
        <field name="sequence">5</field>
    </record>
    <record id="grupo_app_internos_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="comment">Permisos de Lectura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="grupo_app_internos_ejecutor_servicios" model="res.groups">
        <field name="name">Ejecutor de Servicios</field>
        <field name="comment">Permisos de Lectura/Escritura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_usuario'))]"/>
    </record>
    <record id="grupo_app_internos_ejecutor_interno" model="res.groups">
        <field name="name">Ejecutor Corporativo</field>
        <field name="comment">Permisos de Lectura/Escritura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_ejecutor_servicios'))]"/>
    </record>
    <record id="grupo_app_internos_responsable" model="res.groups">
        <field name="name">Responsable</field>
        <field name="comment">Permisos de Lectura/Escritura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_ejecutor_interno'))]"/>
    </record>
    <record id="grupo_app_internos_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_responsable'))]"/>
    </record>

    <data noupdate="0">
<!--        Reglas de control de usuarios para las líneas-->
        <record id="servicios_internos_lineas_rule_usuario" model="ir.rule">
            <field name="name">Regla de usuario servicios internos líneas</field>
            <field ref="model_sicpro_app_servicios_internos_lineas" name="model_id"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_usuario'))]"/>
        </record>
        <record id="servicios_internos_lineas_rule_ejecutor_servicios" model="ir.rule">
            <field name="name">Regla de ejecutor servicios de servicios internos líneas</field>
            <field ref="model_sicpro_app_servicios_internos_lineas" name="model_id"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_ejecutor_servicios'))]"/>
        </record>
        <record id="servicios_internos_lineas_rule_ejecutor" model="ir.rule">
            <field name="name">Regla de ejecutor servicios internos líneas</field>
            <field ref="model_sicpro_app_servicios_internos_lineas" name="model_id"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_ejecutor_interno'))]"/>
        </record>

<!--        Reglas de control de usuarios para las cuentas nautas-->
        <record id="servicios_internos_nauta_rule_usuario" model="ir.rule">
            <field name="name">Regla de usuario servicios internos nauta</field>
            <field ref="model_sicpro_app_servicios_internos_nauta" name="model_id"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_usuario'))]"/>
        </record>
        <record id="servicios_internos_nauta_rule_ejecutor_servicios" model="ir.rule">
            <field name="name">Regla de ejecutor servicios de servicios internos nauta</field>
            <field ref="model_sicpro_app_servicios_internos_nauta" name="model_id"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_ejecutor_servicios'))]"/>
        </record>
        <record id="servicios_internos_nauta_rule_ejecutor" model="ir.rule">
            <field name="name">Regla de ejecutor servicios internos nauta</field>
            <field ref="model_sicpro_app_servicios_internos_nauta" name="model_id"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_ejecutor_interno'))]"/>
        </record>
    </data>


        <!-- Creo la categoría de permisos de solicitudes de servicios internos-->
    <record id="modulo_categoria_servicios_internos_solicitudes" model="ir.module.category">
        <field name="name">Solicitudes de Servicios</field>
        <field name="description">Módulo de servicios internos Solicitudes.</field>
        <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_gestión_documentos"/>
        <field name="sequence">6</field>
    </record>
    <record id="grupo_app_internos_solicitudes_usuario" model="res.groups">
        <field name="name">Usuario</field>
        <field name="comment">Permisos de Lectura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos_solicitudes"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="grupo_app_internos_solicitudes_ejecutor" model="res.groups">
        <field name="name">Ejecutor de Solicitud</field>
        <field name="comment">Permisos de Lectura/Escritura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos_solicitudes"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_solicitudes_usuario'))]"/>
    </record>
    <record id="grupo_app_internos_solicitudes_revision" model="res.groups">
        <field name="name">Revisión de Solicitud</field>
        <field name="comment">Permisos de Lectura/Escritura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos_solicitudes"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_solicitudes_ejecutor'))]"/>
    </record>
    <record id="grupo_app_internos_solicitudes_validar" model="res.groups">
        <field name="name">Validación de Solicitud</field>
        <field name="comment">Permisos de Lectura/Escritura</field>
        <field name="category_id" ref="modulo_categoria_servicios_internos_solicitudes"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_internos_solicitudes_revision'))]"/>
    </record>

    <data noupdate="0">
<!--        Reglas de control de usuarios para las solicitudes-->
        <record id="servicios_internos_solicitudes_rule_usuario" model="ir.rule">
            <field name="name">Regla de usuario y ejecutor de servicios internos Solicitudes</field>
            <field ref="model_sicpro_app_servicios_internos_solicitudes" name="model_id"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                        ('company_id', 'child_of', company_ids)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_solicitudes_usuario'))]"/>
        </record>
        <record id="servicios_internos_lineas_rule_ejecutor" model="ir.rule">
            <field name="name">Regla de revisión y validación de servicios internos Solicitudes</field>
            <field ref="model_sicpro_app_servicios_internos_solicitudes" name="model_id"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('grupo_app_internos_solicitudes_revision'))]"/>
        </record>

    </data>
</odoo>
