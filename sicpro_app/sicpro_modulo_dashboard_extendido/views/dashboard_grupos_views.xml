<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="sicpro_dashboard_grupos_new_tree_view">
            <field name="model">sicpro.modulo.dashboard.grupos</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <tree string="Grupos" editable="bottom">
                    <field name="app" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                    <field name="app_name" invisible="1"/>
                    <field name="sequencia"/>
                    <field name="name"/>
                    <field name="graficos" widget="many2many_tags" domain="[('app', '=', app)]"/>
                    <field name="secciones_contenido" invisible = "1"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="sicpro_dashboard_grupos_new_form_view">
            <field name="model">sicpro.modulo.dashboard.grupos</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <form string="Grupo">
                    <group string="Datos del Grupo">
                        <group>
                            <field name="app" invisible="1"/>
                            <field name="app_name" invisible="1"/>
                            <field name="name"/>
                            <field name="sequencia"/>
                        </group>
                        <group>
                            <field name="graficos" widget="many2many_tags" domain="[('app', '=', app)]"/>
                            <field name="secciones_contenido" invisible = "1"/>
                        </group>
                    </group>
                </form>
            </field>
        </record>

        <record id="sicpro_dashboard_grupos_new_search_view" model="ir.ui.view">
            <field name="name">sicpro.modulo.dashboard.grupos.search</field>
            <field name="model">sicpro.modulo.dashboard.grupos</field>
            <field name="arch" type="xml">
                <search string="Gráficos">
                    <field name="app" string="Aplicación"/>
                    <separator/>
                    <filter string="Archivado" name="inactive" domain="[('active', '=', False)]"/>
                    <group expand="0" string="Agrupar por">
                        <filter name="app_group" string="Aplicación" context="{'group_by': 'app'}"/>
                    </group>
                </search>
             </field>
        </record>

        <record model="ir.actions.act_window" id="dashboard_grupos_config_action">
            <field name="name">Grupos del Tablero</field>
            <field name="res_model">sicpro.modulo.dashboard.grupos</field>
            <field name="view_mode">tree</field>
        </record>
        
    </data>
</odoo>
