<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

     <!--vista formulario-->
    <record id="dashboard_iconos_form_view" model="ir.ui.view">
        <field name="name">dashboard.iconos.form.view</field>
        <field name="model">sicpro.modulo.dashboard.iconos</field>
        <field name="arch" type="xml">
            <form string="Íconos">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="clase"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


     <!--vista arbol-->
    <record id="dashboard_iconos_tree_view" model="ir.ui.view">
        <field name="name">dashboard.iconos.tree.view</field>
        <field name="model">sicpro.modulo.dashboard.iconos</field>
        <field name="arch" type="xml">
            <tree string="Íconos"  editable="bottom">
                <field name="name"/>
                <field name="clase" widget="widget_icono"/>
            </tree>
        </field>
    </record>

    <!--Busqueda-->
    <record id="dashboard_iconos_filter_view" model="ir.ui.view">
       <field name="name">Buscar Íconos</field>
       <field name="model">sicpro.modulo.dashboard.iconos</field>
        <field name="arch" type="xml">
            <search string="Buscar Íconos">
            <field name="name"/>
            <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        </search>
       </field>
    </record>

    <!--Acción-->
    <record id="action_dashboard_iconos" model="ir.actions.act_window">
        <field name="name">Íconos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.modulo.dashboard.iconos</field>
        <field name="view_mode">tree,form</field>
    </record>


    </data>
</odoo>