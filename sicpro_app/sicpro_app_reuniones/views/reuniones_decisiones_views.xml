<odoo>
    <data>

        <record id="decisión_rechazada_form" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.decisiones.rechazadas.form</field>
            <field name="model">sicpro.app.reuniones.decisiones.rechazadas</field>
            <field name="priority">110</field>
            <field name="arch" type="xml">
                <form string="Motivo de Rechazo">
                    <group class="oe_title">
                        <field name="motivo"/>
                    </group>
                    <footer>
                        <button name="action_motivo_rechazo" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="decisión_rechazada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Rechazo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.reuniones.decisiones.rechazadas</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="decisión_rechazada_form"/>
            <field name="target" eval="'new'"/>
        </record>

        <record id="decisión_cancelada_form" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.decisiones.canceladas.form</field>
            <field name="model">sicpro.app.reuniones.decisiones.canceladas</field>
            <field name="priority">120</field>
            <field name="arch" type="xml">
                <form string="Motivo de Cancelación">
                    <group class="oe_title">
                        <field name="motivo"/>
                    </group>
                    <footer>
                        <button name="action_motivo_cancelacion" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="decisión_cancelada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Cancelación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.reuniones.decisiones.canceladas</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="decisión_cancelada_form"/>
            <field name="target" eval="'new'"/>
        </record>

        <record id="decisiones_view_list" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.decisiones.view.list</field>
            <field name="model">sicpro.app.reuniones.decisiones</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <list string="Decisiones de Reuniones">
                    <field name="consecutivo"/>
                    <field name="estado"/>
                    <field name="name"/>
                    <field name="responsable_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="cumplimiento" widget="progressbar"/>
                </list>
            </field>
        </record>

        <record id="decisiones_consecutivo_incrementar" model="ir.sequence">
            <field name="name">Decisiones: Consecutivo de las Decisiones</field>
            <field name="code">decisiones_consecutivo_incrementar</field>
            <field name="padding">4</field>
            <field name="prefix">D-%(range_year)s/</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">True</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="decisiones_view_form" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.decisiones.view.form</field>
            <field name="model">sicpro.app.reuniones.decisiones</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <form string="Decisiones de Reuniones">
                    <header>
                        <button name="estado_en_proceso" string="Pasar a En Proceso" type="object" class="oe_highlight"
                                invisible="estado != 'pendiente' or not es_responsable"/>
                        <button name="estado_en_revision" string="Enviar a Revisión" type="object" class="oe_highlight"
                                invisible="estado != 'proceso'"/>
                        <button name="estado_liberar" string="Liberar" type="object" class="oe_highlight"
                                invisible="estado != 'revision' or not es_responsable"/>
                        <button name="estado_cumplido" string="Cumplido" type="object" class="oe_highlight"
                                invisible="estado != 'liberar'"
                                groups="sicpro_app_reuniones.group_reuniones_director"/>
                        <button name="%(decisión_rechazada_action)d" string="Rechazar" type="action"
                                invisible="estado != 'liberar'"
                                groups="sicpro_app_reuniones.group_reuniones_director"/>
                        <button name="%(decisión_cancelada_action)d" string="Cancelar" type="action"
                                invisible="estado != 'liberar'"
                                groups="sicpro_app_reuniones.group_reuniones_director"/>
                        <field name="estado" widget="statusbar" options="{'clickable': '1'}" readonly="1"
                               statusbar_visible="pendiente,proceso,revision,liberar,cumplido,cancelado"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <field name="estado_id" invisible="1"/>
                            <field name="rechazado" invisible="1"/>
                            <field name="es_responsable" invisible="1"/>
                            <label for="name" class="oe_edit_only"/>
                            <h1>
                                <field name="name" placeholder="Decisión: "
                                       readonly="estado != 'borrador'"/>
                            </h1>
                            <field name="description" readonly="estado != 'borrador'"/>
                            <div class="oe_title pr-0">
                                <h2 class="d-flex flex-row justify-content-between">
                                    <field name="consecutivo" class="o_task_name text-truncate"/>
                                </h2>
                            </div>
                        </div>
                        <group>
                            <group>
                                <field name="reunion" readonly="estado != 'borrador'"
                                       options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="periodo_reunion"/>
                                <field name="otra_reunion" readonly="estado != 'borrador'"/>
                                <field name="modelo_reunion" options="{'color_field': 'color','no_create': True,
                                                                       'no_create_edit':True, 'no_open': True}"/>
                                <field name="responsable_ids" widget="many2many_tags"
                                       readonly="estado != 'borrador'"
                                       options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="participantes_ids" widget="many2many_tags"
                                       readonly="estado != 'pendiente'"
                                       options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="fecha_inicio" readonly="estado != 'borrador'"/>
                                <field name="fecha_fin" readonly="estado != 'borrador'"/>
                                <field name="cumplimiento" widget="progressbar"/>
                            </group>
                        </group>
                        <group>
                            <field name="motivo_rechazo" readonly="1"
                                   invisible="not rechazado"/>
                            <field name="motivo_cancelacion" readonly="1"
                                   invisible="estado != 'cancelado'"/>
                        </group>
                        <group string="Resultados">
                            <field name="resultado" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_acuerdos_search">
            <field name="name">sicpro.app.reuniones.decisiones.search</field>
            <field name="model">sicpro.app.reuniones.decisiones</field>
            <field name="arch" type="xml">
                <search string="Decisiones">
                    <field name="name" string="Acuerdo"/>
                    <field name="reunion" string="Reunion"/>
                    <field name="responsable_ids" string="Responsable"/>
                    <field name="participantes_ids" string="Participantes"/>
                    <separator/>

                    <filter string="Próximos/En marcha" name="upcoming"
                            domain="[('fecha_fin', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>

                    <separator/>
                    <filter string="Fecha de Inicio" name="fecha_inicio_1" date="fecha_inicio"/>
                    <filter string="Decisiones de este Año" name="filter_this_year"
                            domain="[('fecha_inicio', '&gt;=', context_today().strftime('%Y-01-01 00:00:00')),
                                     ('fecha_inicio', '&lt;=', context_today().strftime('%Y-12-31 23:59:59'))]"/>
                    <separator/>

                    <group>
                        <filter string="Responsable" name="responsable_ids" context="{'group_by': 'responsable_ids'}"/>
                        <filter string="Estado" name="estado" context="{'group_by': 'estado'}"/>
                        <filter string="Fecha de Inicio (Mes)" name="group_fecha_inicio_month" domain="[]"
                                context="{'group_by': 'fecha_inicio:month'}"/>
                        <filter string="Fecha de Cumplimiento" name="fecha_fin" domain="[]"
                                context="{'group_by': 'fecha_fin:day'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="decisiones_view_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.decisiones.kanban</field>
            <field name="model">sicpro.app.reuniones.decisiones</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="estado" default_order="estado_id" create="false">
                    <field name="name"/>
                    <field name="estado"/>
                    <field name="reunion"/>
                    <field name="responsable_ids"/>
                    <field name="fecha_fin"/>
                    <field name="fecha_inicio"/>
                    <field name="estado_id"/>
                    <field name="cumplimiento"/>
                    <field name="participantes_ids"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click p-3">
                                <div class="row">
                                    <div class="col-12">
                                        <strong class="o_kanban_record_title" style="font-size: 1.1em;">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="text-muted mb-2">
                                    <i class="fa fa-calendar-o mr-1" title="Fechas"/>
                                    <span class="small">
                                        Inicio: <t t-esc="record.fecha_inicio.value"/>
                                        <span class="mx-1">|</span>
                                        Fin: <t t-esc="record.fecha_fin.value"/>
                                    </span>
                                </div>
                                <div class="mb-3">
                                    <strong>Cumplimiento:</strong>
                                    <field name="cumplimiento" widget="progressbar"/>
                                </div>
                                <div class="row">
                                    <div class="col-6 border-right">
                                        <div class="small text-uppercase font-weight-bold mb-1">Responsables:</div>
                                        <field name="responsable_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </div>
                                    <div class="col-6">
                                        <div class="small text-uppercase font-weight-bold mb-1">Ejecutantes:</div>
                                        <field name="participantes_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_decisiones_view">
            <field name="name">Decisiones</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.reuniones.decisiones</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_acuerdos_search"/>
            <field name="context">{'search_default_filter_this_year': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Agregar Decisiones
                </p>
            </field>
        </record>

    </data>
</odoo>