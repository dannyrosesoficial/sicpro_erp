<odoo>
    <data>

        <record id="acuerdos_rechazada_form" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.acuerdos.rechazadas.form</field>
            <field name="model">sicpro.app.reuniones.acuerdos.rechazados</field>
            <field name="priority">110</field>
            <field name="arch" type="xml">
                <form string="Motivo de Rechazo">
                    <group class="oe_title">
                        <field name="motivo"/>
                    </group>
                    <footer>
                        <button name="action_motivo_rechazo" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="acuerdos_rechazada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Rechazo</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.reuniones.acuerdos.rechazados</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="acuerdos_rechazada_form"/>
            <field name="target">new</field>
        </record>

        <record id="acuerdos_cancelada_form" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.acuerdos.canceladas.form</field>
            <field name="model">sicpro.app.reuniones.acuerdos.cancelados</field>
            <field name="priority">120</field>
            <field name="arch" type="xml">
                <form string="Motivo de Cancelación">
                    <group class="oe_title">
                        <field name="motivo"/>
                    </group>
                    <footer>
                        <button name="action_motivo_cancelacion" string="Enviar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="acuerdos_cancelada_action" model="ir.actions.act_window">
            <field name="name">Motivo de Cancelación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.reuniones.acuerdos.cancelados</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="acuerdos_cancelada_form"/>
            <field name="target">new</field>
        </record>

        <record id="acuerdos_view_list" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.acuerdos.view.list.from.type</field>
            <field name="model">sicpro.app.reuniones.acuerdos</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <list string="Acuerdos de Reuniones" create="false">
                    <field name="estado"/>
                    <field name="name"/>
                    <field name="responsable_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="cumplimiento" widget="progressbar"/>
                </list>
            </field>
        </record>

        <record id="acuerdos_view_form" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.acuerdos.view.form.from.type</field>
            <field name="model">sicpro.app.reuniones.acuerdos</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <form string="Acuerdos de Reuniones">
                    <header>
                        <button name="estado_en_proceso" string="Pasar a En Proceso" type="object" class="oe_highlight"
                                invisible="estado != 'pendiente' or not es_responsable"/>
                        <button name="estado_en_revision" string="Enviar a Revisión" type="object" class="oe_highlight"
                                invisible="estado != 'proceso'"/>
                        <button name="estado_liberar" string="Liberar" type="object" class="oe_highlight"
                                invisible="estado != 'revision' or not es_responsable"/>
                        <button name="estado_cumplido" string="Cumplido" type="object" class="oe_highlight"
                                invisible="estado != 'liberar'"
                                groups="sicpro_app_reuniones.group_reuniones_director"/>
                        <button name="%(acuerdos_rechazada_action)d" string="Rechazar" type="action"
                                invisible="estado != 'liberar'"
                                groups="sicpro_app_reuniones.group_reuniones_director"/>
                        <button name="%(acuerdos_cancelada_action)d" string="Cancelar" type="action"
                                invisible="estado != 'liberar'"
                                groups="sicpro_app_reuniones.group_reuniones_director"/>
                        <field name="estado" widget="statusbar" options="{'clickable': '1'}" readonly="1"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <field name="estado_id" invisible="1"/>
                            <field name="rechazado" invisible="1"/>
                            <field name="es_responsable" invisible="1"/>
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" placeholder="Acuerdos de las reuniones...."/></h1>
                            <field name="description"/>
                        </div>
                        <group>
                            <group>
                                <field name="reunion" invisible="not reunion"/>
                                <field name="modelo_reunion" options="{'color_field': 'color','no_create': True,
                                                                       'no_create_edit':True, 'no_open': True}"/>
                                <field name="responsable_ids" widget="many2many_tags"
                                       readonly="estado != 'borrador'"
                                       options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="participantes_ids" widget="many2many_tags"
                                       options="{'color_field': 'color', 'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                                <field name="fecha_inicio" />
                                <field name="fecha_fin"/>
                                <field name="cumplimiento" widget="progressbar"/>
                            </group>
                        </group>
                        <group>
                            <field name="motivo_rechazo" readonly="1"
                                   invisible="not rechazado"/>
                            <field name="motivo_cancelacion" readonly="1"
                                   invisible="estado != 'cancelado'"/>
                        </group>
                        <group string="Resultados">
                            <field name="resultado" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter reload_on_post="True" reload_on_attachment_updated="True"/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_acuerdos_search">
            <field name="name">sicpro.app.reuniones.acuerdos.search</field>
            <field name="model">sicpro.app.reuniones.acuerdos</field>
            <field name="arch" type="xml">
                <search string="Reuniones">
                    <field name="name" string="Acuerdo"/>
                    <field name="reunion" string="Reunion"/>
                    <field name="responsable_ids" string="Responsable"/>
                    <field name="participantes_ids" string="Participantes"/>
                    <separator/>
                    <filter string="Próximos/En marcha" name="upcoming"
                            domain="[('fecha_fin', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                    <separator/>
                    <filter string="Año Actual" name="filter_active_year"
                            domain="[('fecha_inicio', '&gt;=', context_today().strftime('%Y-01-01 00:00:00')),
                                     ('fecha_inicio', '&lt;=', context_today().strftime('%Y-12-31 23:59:59'))]"/>
                    <separator/>
                    <filter string="Fecha de Inicio" name="fecha_inicio_1" date="fecha_inicio"/>
                    <separator/>
                    <group>
                        <filter string="Responsable" name="responsable_ids" context="{'group_by': 'responsable_ids'}"/>
                        <filter string="Estado" name="estado" context="{'group_by': 'estado'}"/>
                        <filter string="Fecha de Inicio" name="group_fecha_inicio"
                                context="{'group_by': 'fecha_inicio:month'}"/>
                        <filter string="Fecha de Cumplimiento" name="fecha_fin"
                                context="{'group_by': 'fecha_fin:day'}"/>
                        <separator/>
                        <filter string="Tipo de Reunión" name="tipo_reunion" context="{'group_by': 'tipo_reunion'}"/>
                        <filter string="Modelo de Reunión" name="modelo_reunion"
                                context="{'group_by': 'modelo_reunion'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="acuerdos_view_kanban" model="ir.ui.view">
            <field name="name">sicpro.app.reuniones.acuerdos.kanban</field>
            <field name="model">sicpro.app.reuniones.acuerdos</field>
            <field name="priority" eval="30"/>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="estado" default_order="estado_id" create="false">
                    <field name="name"/>
                    <field name="estado"/>
                    <field name="reunion"/>
                    <field name="responsable_ids"/>
                    <field name="fecha_fin"/>
                    <field name="fecha_inicio"/>
                    <field name="estado_id"/>
                    <field name="cumplimiento"/>
                    <field name="participantes_ids"/>
                    <templates>
                        <t t-name="card">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click p-3">
                                <div class="row">
                                    <div class="col-12">
                                        <strong><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="text-muted small mb-2">
                                    <i class="fa fa-calendar mr-1"/>
                                    <t t-esc="record.fecha_inicio.value"/> - <t t-esc="record.fecha_fin.value"/>
                                </div>
                                <div class="mb-3">
                                    <field name="cumplimiento" widget="progressbar"/>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="small text-uppercase fw-bold">Responsables:</div>
                                        <field name="responsable_ids" widget="many2many_tags"/>
                                    </div>
                                    <div class="col-6 border-start">
                                        <div class="small text-uppercase fw-bold">Ejecutantes:</div>
                                        <field name="participantes_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_acuerdos_view">
            <field name="name">Acuerdos</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">sicpro.app.reuniones.acuerdos</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_acuerdos_search"/>
            <field name="context">{'search_default_filter_active_year': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Agregar Acuerdos
                </p>
            </field>
        </record>

    </data>
</odoo>