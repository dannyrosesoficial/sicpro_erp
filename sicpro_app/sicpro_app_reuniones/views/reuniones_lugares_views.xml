<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="reuniones_lugares_search_view">
            <field name="name">ssicpro.app.reuniones.lugares.search</field>
            <field name="model">sicpro.app.reuniones.lugares</field>
            <field name="arch" type="xml">
                <search string="Buscar Etiquetas">
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="descripcion"/>
                    <field name="tipo"/>
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="reuniones_lugares_tree_view">
            <field name="name">sicpro.app.reuniones.lugares.tree</field>
            <field name="model">sicpro.app.reuniones.lugares</field>
            <field name="arch" type="xml">
                <tree string="Lugares de Reunión" editable="bottom">
                    <field name="tipo"/>
                    <field name="name"/>
                    <field name="company_id"/>
                    <field name="descripcion"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <record id="reuniones_lugares_action" model="ir.actions.act_window">
            <field name="name">Lugares de Reunión</field>
            <field name="res_model">sicpro.app.reuniones.lugares</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear nuevo lugar de reunión...
                </p>
            </field>
        </record>

    </data>
</odoo>