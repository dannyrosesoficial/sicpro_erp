<odoo>
  <!-- Creo los privilegios de permisos para las Reuniones-->
  <record id="privilege_reuniones" model="res.groups.privilege">
    <field name="name">Reuniones</field>
    <field name="sequence">1</field>
    <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_gestión_reuniones"/>
  </record>
  <record id="group_reuniones_usuario" model="res.groups">
    <field name="name">Usuario</field>
    <field name="privilege_id" ref="privilege_reuniones"/>
    <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
  </record>
  <record id="group_reuniones_secretaria" model="res.groups">
    <field name="name">Secretaria</field>
    <field name="privilege_id" ref="privilege_reuniones"/>
    <field name="implied_ids" eval="[(4, ref('group_reuniones_usuario'))]"/>
  </record>
  <record id="group_reuniones_director" model="res.groups">
    <field name="name">Director</field>
    <field name="privilege_id" ref="privilege_reuniones"/>
    <field name="implied_ids" eval="[(4, ref('group_reuniones_secretaria'))]"/>
  </record>
  <record id="group_reuniones_responsable" model="res.groups">
    <field name="name">Responsable</field>
    <field name="privilege_id" ref="privilege_reuniones"/>
    <field name="implied_ids" eval="[(4, ref('group_reuniones_director'))]"/>
  </record>
  <record id="group_reuniones_admin" model="res.groups">
    <field name="name">Administrator</field>
    <field name="privilege_id" ref="privilege_reuniones"/>
    <field name="implied_ids" eval="[(4, ref('group_reuniones_responsable'))]"/>
  </record>


  <data noupdate="0">
    <record id="reuniones_res_company_rule" model="ir.rule">
      <field name="name">Regla de Procesos de las reuniones</field>
      <field ref="base.model_res_company" name="model_id"/>
      <field name="groups" eval="[(4, ref('group_reuniones_usuario'))]"/>
      <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record model="ir.rule" id="reuniones_participantes_usuario_rule">
      <field name="name">Participantes de reuniones usuario</field>
      <field name="model_id" ref="model_sicpro_app_reuniones_participantes"/>
      <field name="domain_force">[('name', '=', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_reuniones_usuario'))]"/>
    </record>
    <record model="ir.rule" id="reuniones_participantes_secretaria_director_rule">
      <field name="name">Participantes de reuniones secretaria/director</field>
      <field name="model_id" ref="model_sicpro_app_reuniones_participantes"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_reuniones_secretaria'))]"/>
    </record>

    <record model="ir.rule" id="reuniones_acuerdos_usuario_rule">
      <field name="name">Acuerdos de reuniones Rol:usuario</field>
      <field name="model_id" ref="model_sicpro_app_reuniones_acuerdos"/>
      <field name="domain_force">['|', ('responsable_ids', '=', user.id), ('participantes_ids', 'in', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_reuniones_usuario'))]"/>
    </record>
    <record model="ir.rule" id="reuniones_acuerdos_secretaria_director_rule">
      <field name="name">Acuerdos de reuniones Rol:secretaria/director</field>
      <field name="model_id" ref="model_sicpro_app_reuniones_acuerdos"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_reuniones_secretaria'))]"/>
    </record>

    <record model="ir.rule" id="reuniones_decisiones_usuario_rule">
      <field name="name">Decisiones de reuniones Rol:usuario</field>
      <field name="model_id" ref="model_sicpro_app_reuniones_decisiones"/>
      <field name="domain_force">['|', ('responsable_ids', '=', user.id), ('participantes_ids', 'in', user.id)]</field>
      <field name="groups" eval="[(4, ref('group_reuniones_usuario'))]"/>
    </record>
    <record model="ir.rule" id="reuniones_decisiones_secretaria_director_rule">
      <field name="name">Decisiones de reuniones Rol:secretaria/director</field>
      <field name="model_id" ref="model_sicpro_app_reuniones_decisiones"/>
      <field name="domain_force">[(1, '=', 1)]</field>
      <field name="groups" eval="[(4, ref('group_reuniones_secretaria'))]"/>
    </record>
  </data>
</odoo>
