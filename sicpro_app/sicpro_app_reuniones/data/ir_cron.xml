<odoo>
  <data noupdate="0">
    <!-- Cron para verificar los acuerdos próximos a vencer -->
    <record id="reuniones_cron_acuerdos_vencimiento" model="ir.cron">
      <field name="name">Reuniones: Acuerdos vencimiento</field>
      <field name="model_id" ref="sicpro_app_reuniones.model_sicpro_app_reuniones_acuerdos"/>
      <field name="state">code</field>
      <field name="code">model.acuerdos_vencimiento()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
    </record>

    <!-- Cron para verificar los acuerdos próximos a vencer -->
    <record id="reuniones_cron_decisiones_vencimiento" model="ir.cron">
      <field name="name">Reuniones: Decisiones vencimiento</field>
      <field name="model_id" ref="sicpro_app_reuniones.model_sicpro_app_reuniones_decisiones"/>
      <field name="state">code</field>
      <field name="code">model.cron_decisiones_vencimiento()</field>
      <field eval="True" name="active"/>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
    </record>
  </data>
</odoo>
