<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record model="ir.module.category" id="module_category_document">
            <field name="name">Gestor Documental</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_gestión_documentos"/>
            <field name="sequence" >1</field>
        </record>

        <record id="group_document_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="comment">Permisos de lectura</field>
            <field name="category_id" ref="module_category_document"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_document_manager" model="res.groups">
            <field name="name">Ejecutor</field>
            <field name="comment">Permisos de Lectura/Escritura/Config</field>
            <field name="category_id" ref="module_category_document"/>
            <field name="implied_ids" eval="[(4, ref('group_document_user'))]"/>
        </record>

</odoo>