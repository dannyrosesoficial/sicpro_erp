<odoo>
  <!-- VISTA DE BÚSQUEDA -->
  <record id="view_document_search" model="ir.ui.view">
    <field name="name">sicpro.app.gestor.documental.search</field>
    <field name="model">sicpro.app.gestor.documental</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="parent_id"/>
        <filter name="filter_is_root" string="Directorios" domain="[('parent_id', '=', False)]"/>
        <group>
          <filter name="group_by_parent_id" string="Carpeta" context="{'group_by': 'parent_id'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- VISTA DE LISTA (TREE) -->
  <record id="view_document_list" model="ir.ui.view">
    <field name="name">sicpro.app.gestor.documental.list</field>
    <field name="model">sicpro.app.gestor.documental</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="parent_full_name" invisible="context.get('default_parent_id')"/>
        <field name="child_count"/>
        <field name="create_uid" widget="many2one_avatar_user"/>
        <field name="write_date"/>
      </list>
    </field>
  </record>

  <!-- VISTA KANBAN -->
  <record id="view_document_kanban" model="ir.ui.view">
    <field name="name">sicpro.app.gestor.documental.kanban</field>
    <field name="model">sicpro.app.gestor.documental</field>
    <field name="arch" type="xml">
      <kanban highlight_color="color" sample="1">
        <field name="id"/>
        <field name="color"/>
        <field name="name"/>
        <field name="description"/>
        <field name="child_count"/>
        <templates>
          <t t-name="menu">
            <div class="container">
              <div class="o_kanban_card_manage_settings row">
                <div role="menuitem" aria-haspopup="true" class="col-6">
                  <field name="color" widget="kanban_color_picker"/>
                </div>
                <div class="col-6 text-end">
                  <a role="menuitem" type="open" class="dropdown-item">Abrir</a>
                  <t t-if="widget.editable"><a role="menuitem" type="edit" class="dropdown-item">Editar</a></t>
                  <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Eliminar</a></t>
                </div>
              </div>
            </div>
          </t>
          <t t-name="card">
            <div t-attf-class="oe_kanban_color_#{record.color.raw_value || 0} oe_kanban_global_click p-2">
              <div class="d-flex align-items-start">
                <div class="o_kanban_image" style="width: 50px; position: relative;">
                  <!-- Acción para navegar entre carpetas -->
                  <a type="object" name="action_open_folder" title="Entrar" role="button">
                    <span class="badge rounded-pill bg-dark text-white"
                          style="position: absolute; top: -5px; right: -5px; z-index: 1;">
                      <t t-esc="record.child_count.value or '0'"/>
                    </span>
                    <img src="/sicpro_app_gestor_documental/static/description/icon.png"
                         alt="icon" class="img-fluid" style="max-height: 45px;"/>
                  </a>
                </div>
                <div class="ms-2 flex-grow-1">
                  <div class="o_kanban_record_top">
                    <strong class="o_kanban_record_title text-primary">
                      <field name="name"/>
                    </strong>
                  </div>
                  <div class="text-muted small" t-if="record.description.raw_value">
                    <field name="description"/>
                  </div>
                </div>
              </div>
              <div class="o_kanban_record_bottom mt-2 border-top pt-2">
                <div class="oe_kanban_bottom_left">
                  <span class="text-muted small" style="font-size: 0.7rem;">Sistema de Gestión</span>
                </div>
                <div class="oe_kanban_bottom_right">
                  <field name="create_uid" widget="many2one_avatar_user"/>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- VISTA FORMULARIO -->
  <record id="view_document_form" model="ir.ui.view">
    <field name="name">sicpro.app.gestor.documental.form</field>
    <field name="model">sicpro.app.gestor.documental</field>
    <field name="arch" type="xml">
      <form class="o_form_document">
        <sheet>
          <div class="oe_title">
            <label for="name" class="oe_edit_only"/>
            <h1><field name="name" placeholder="Ej. Carpeta de..."/></h1>
          </div>
          <group>
            <group>
              <field name="parent_id" options="{'no_create': True}" domain="[('id', '!=', id)]"/>
              <field name="description"/>
            </group>
            <group>
              <field name="parent_full_name" readonly="1"/>
            </group>
          </group>
          <notebook>
            <page string="Contenido" name="content">
              <field name="content" widget="html"/>
            </page>
            <page string="Sub-elementos" name="children">
              <field name="child_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="create_date"/>
                </list>
              </field>
            </page>
          </notebook>
          <group class="oe_read_only">
            <group>
              <field name="create_uid" string="Creada por:"/>
              <field name="write_uid" string="Actualizada por"/>
            </group>
            <group>
              <field name="create_date" string="Fecha Creada"/>
              <field name="write_date" string="Fecha Actualizada"/>
            </group>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- ACCIÓN INICIAL (Directorios Raíz) -->
  <record id="documental_inicio_view_action" model="ir.actions.act_window">
    <field name="name">Sistema de Gestión</field>
    <field name="res_model">sicpro.app.gestor.documental</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[]</field>
    <field name="context">{'search_default_filter_is_root': 1}</field>
  </record>

  <!-- ACCIÓN PARA NAVEGACIÓN DE CARPETAS (La que faltaba) -->
  <record id="documental_carpetas_view_action" model="ir.actions.act_window">
    <field name="name">Documentos</field>
    <field name="res_model">sicpro.app.gestor.documental</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[]</field>
    <field name="target">current</field>
  </record>

  <!-- MENÚ PRINCIPAL -->
  <menuitem id="menu_documents"
            name="Sistema de Gestión"
            sequence="10"
            action="documental_inicio_view_action"
            web_icon="sicpro_app_gestor_documental,static/description/icon.png"/>
</odoo>