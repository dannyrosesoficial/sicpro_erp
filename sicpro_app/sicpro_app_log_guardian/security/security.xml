<odoo>
    <record model="res.groups.privilege" id="privilege_log_guardian">
        <field name="name">Log Guardian</field>
        <field name="description">Ayuda a administrar los logs del sistema.</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_administracion_general"/>
    </record>

    <record id="group_log_guardian_user" model="res.groups">
        <field name="name">Visualizador</field>
        <field name="privilege_id" ref="privilege_log_guardian"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_log_guardian_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_log_guardian"/>
        <field name="implied_ids" eval="[(4, ref('group_log_guardian_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>