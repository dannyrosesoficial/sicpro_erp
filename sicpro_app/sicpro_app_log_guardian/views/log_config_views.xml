<odoo>
    <record id="view_log_source_form" model="ir.ui.view">
        <field name="name">sicpro.log.source.form</field>
        <field name="model">sicpro.log.source</field>
        <field name="arch" type="xml">
            <form string="Fuente de Log">
                <sheet>
                    <widget name="web_ribbon" title="Inactivo" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="source_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="file_path"/>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_log_source_kanban" model="ir.ui.view">
        <field name="name">sicpro.log.source.kanban</field>
        <field name="model">sicpro.log.source</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="source_type"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong class="o_kanban_record_title"><field name="name"/></strong>
                            <div class="text-muted mt-2">
                                <i class="fa fa-folder-open-o"/> <field name="file_path"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <span class="badge rounded-pill text-bg-info"><field name="source_type"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
