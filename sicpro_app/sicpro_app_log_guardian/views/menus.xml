<odoo>
    <record id="action_log_sources" model="ir.actions.act_window">
        <field name="name">Dashboard de Fuentes</field>
        <field name="res_model">sicpro.log.source</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="action_log_records" model="ir.actions.act_window">
        <field name="name">Histórico de Eventos</field>
        <field name="res_model">sicpro.log.record</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_log_guardian_root" name="Log Guardian" sequence="100" web_icon="sicpro_app_log_guardian,static/description/icon.png"/>

    <menuitem id="menu_log_dashboard" name="Dashboard Live" parent="menu_log_guardian_root" action="action_log_sources" sequence="10"/>
    <menuitem id="menu_log_history" name="Histórico (Casos)" parent="menu_log_guardian_root" action="action_log_records" sequence="20"/>

    <menuitem id="menu_log_config" name="Configuración" parent="menu_log_guardian_root" sequence="90" groups="group_log_guardian_admin"/>
</odoo>
