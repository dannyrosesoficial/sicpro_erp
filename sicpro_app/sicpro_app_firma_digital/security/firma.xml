<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Creo la categoría de permisos Contratos -->
        <record id="module_category_firma" model="ir.module.category">
            <field name="name">Firma Digital</field>
            <field name="description">Módulo para la gestión de la documentación y firma digital</field>
            <field name="parent_id" ref="sicpro_app_administracion.modulo_categoria_gestión_documentos"/>
             <field name="sequence" >3</field>
         </record>

        <record id="grupo_app_firma_usuario" model="res.groups">
            <field name="name">Usuario</field>
            <field name="comment">Permisos Crear/Editar</field>
            <field name="category_id" ref="module_category_firma"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="grupo_app_firma_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="category_id" ref="module_category_firma"/>
            <field name="implied_ids" eval="[(4, ref('grupo_app_firma_usuario'))]"/>
        </record>

</data>



