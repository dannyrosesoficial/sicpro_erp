<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_python_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.python.estado</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='performance']" position="after">
                <h2>Versión de Python Ejecutándose</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <label string="Versión:" for="running_python_version"/>
                        <field name="running_python_version" readonly="1"/>
                        <br/>
                        <button name="button_open_python_packages" type="object" string="Paquetes Python Instalados"
                                class="oe_link" icon="fa-list" style="margin-left:-12px;"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>


    <record id="view_form_python_paquetes_instalados" model="ir.ui.view">
        <field name="name">python.paquetes.instalados.tree</field>
        <field name="model">python.paquetes.instalados</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="version"/>
            </tree>
        </field>
    </record>

</odoo>