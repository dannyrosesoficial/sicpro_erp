<odoo>
  <record id="res_config_settings_python_view_form" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.inherit.python.estado</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//form" position="inside">
        <app data-string="Paquetes Python" string="Paquetes Python" name="sicpro_modulo_paquetes_python">
          <block title="Versión de Python Ejecutándose" id="python_version_block">
            <div class="row mt16 o_settings_container">
              <div class="col-12 col-lg-6 o_setting_box">
                <label string="Versión:" for="running_python_version"/>
                <field name="running_python_version" readonly="1"/>
                <br/>
                <button name="button_open_python_packages" type="object" string="Paquetes Python Instalados"
                        class="oe_link" icon="fa-list" style="margin-left:-12px;"/>
              </div>
            </div>
          </block>
        </app>
      </xpath>
    </field>
  </record>

  <record id="view_form_python_paquetes_instalados" model="ir.ui.view">
    <field name="name">python.paquetes.instalados.list</field>
    <field name="model">python.paquetes.instalados</field>
    <field name="arch" type="xml">
      <list create="0" edit="0" delete="0">
        <field name="name"/>
        <field name="version"/>
      </list>
    </field>
  </record>
</odoo>
