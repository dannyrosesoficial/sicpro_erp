<?xml version="1.0" encoding="UTF-8" ?>

<templates>
    <t t-name="sicpro_modulo_widget_contador">
        <t t-if="widget.mode != 'readonly'">
            <div class="input-group widget_numeric_step">
                <div class="input-group-prepend">
                    <button
                        class="fa fa-minus btn btn-default btn_numeric_step"
                        aria-label="Bajar"
                        title="Bajar"
                        type="button"
                        data-mode="minus"
                    />
                </div>
                <input
                    type="tel"
                    class="form-control input_numeric_step"
                    aria-label="Value"
                />
                <div class="input-group-append">
                    <button
                        class="fa fa-plus btn btn-default btn_numeric_step"
                        aria-label="Subir"
                        title="Subir"
                        type="button"
                        data-mode="plus"
                    />
                </div>
            </div>
        </t>
        <t t-else="">
            <field />
        </t>
    </t>
</templates>
