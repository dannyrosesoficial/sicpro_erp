            <field name="model_id" ref="sicpro_app_video_conferencias.model_sicpro_app_videoconferencias"/>
            <field name="domain_force">[('participants', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
