<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">
        <!--Email template -->
        <record id="email_template_edi_jitsi_meet" model="mail.template">
            <field name="name">VideoConferencia: Enviar invitación</field>
            <field name="email_from">"SICPRO ERP" &lt;${(object.company_id.email or user.email) | safe}&gt;</field>
            <field name="email_to">${object.name}</field>
            <field name="subject">${object.meeting_name}</field>
            <field name="model_id" ref="sicpro_app_video_conferencias.model_sicpro_app_videoconferencias_usuarioexterno"/>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div><p>Ha sido invitado a una videoconferencia</p>
                    <p>Por favor únase el ${object.date_formated} clicando en el siguiente enlace: </p>
                    <p>
                        <a href="${object.meeting_url}">UNIRSE A LA REUNIÓN</a>
                    </p>
                    <p>SICPRO ERP</p></div>
            </field>
        </record>
    </data>
</odoo>
