<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_trabajadores_sindicato_form" model="ir.ui.view">
            <field name="name">sicpro.app.trabajadores.sindicato.form</field>
            <field name="model">sicpro.app.trabajadores</field>
            <field name="inherit_id" ref="sicpro_app_trabajadores.view_trabajadores_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ocupacion_id']" position="after">
                    <field name="seccion_sindical_id"
                           options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
