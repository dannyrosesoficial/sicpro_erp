<odoo>
    <data>

        <!-- 1. INHERIT NAVBAR: Agrega la pestaña pública en la barra superior de la web -->
        <template id="layout_inherit_catalogo_link" inherit_id="website.layout" name="Link Menú Catálogo Modulos">
            <xpath expr="//ul[@id='top_menu']" position="inside">
                <li class="nav-item">
                    <a href="/modulos" class="nav-link fw-semibold text-primary">Ecosistema SICPRO</a>
                </li>
            </xpath>
        </template>

        <!-- 2. PORTAL GENERAL: Listado tipo Bento Grid con Filtro Reactivo -->
        <template id="catalogo_modulos_page" name="Catálogo de Aplicaciones SICPRO">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure oe_empty bg-light/30 py-5">
                    <div class="container">

                        <!-- Cabecera del Portal y Buscador -->
                        <div class="row mb-5 align-items-center">
                            <div class="col-md-7">
                                <h1 class="fw-bold text-dark display-5 mb-2">Ecosistema de Módulos</h1>
                                <p class="text-muted lead">Garantía de transparencia. Explora libremente los componentes de software desarrollados para la plataforma SICPRO ERP.</p>
                            </div>
                            <div class="col-md-5">
                                <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden border">
                                    <span class="input-group-text bg-white border-0 text-muted"><i class="oi oi-search"></i></span>
                                    <input type="text" id="sicpro_search_input" class="form-control border-0 bg-white" placeholder="Buscar módulo por nombre o funcionalidad..."/>
                                </div>
                            </div>
                        </div>

                        <!-- Grid de Módulos (Bento Card Style) -->
                        <div class="row g-4" id="sicpro_modules_container">
                            <t t-foreach="modulos" t-as="mod">
                                <div class="col-12 col-md-6 col-lg-4 sicpro-module-card"
                                     t-att-data-name="mod.shortdesc.lower()"
                                     t-att-data-tech="mod.name.lower()">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 transition-all hover-lift bg-white d-flex flex-column justify-content-between">
                                        <div>
                                            <!-- Icono y Badge Superior -->
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <div class="rounded-3 bg-primary/10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                                    <i class="oi oi-cube fs-4"></i>
                                                </div>
                                                <span class="badge rounded-pill bg-light text-dark border px-3 py-2 text-xs font-mono">
                                                    v<t t-out="mod.installed_version or '19.0.1.0.0'"/>
                                                </span>
                                            </div>

                                            <!-- Detalles del Módulo -->
                                            <h4 class="fw-bold text-dark mb-1 text-truncate" t-out="mod.shortdesc"/>
                                            <p class="text-primary text-xs font-mono mb-3" t-out="mod.name"/>
                                            <p class="text-muted text-sm line-clamp-3 mb-4" t-out="mod.summary or 'Sin resumen corto provisto por el desarrollador.'"/>
                                        </div>

                                        <!-- Footer de la Tarjeta -->
                                        <div class="border-top pt-3 d-flex align-items-center justify-content-between mt-auto">
                                            <span class="text-xs text-muted fw-medium"><i class="oi oi-tag me-1"></i><t t-out="mod.category_id.name"/></span>
                                            <a t-attf-href="/modulos/#{mod.name}" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold">
                                                Ver Detalles
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- Caja de Alerta: Sin Resultados -->
                        <div id="sicpro_no_results" class="text-center py-5 d-none">
                            <div class="display-3 text-muted">🔍</div>
                            <h3 class="mt-3 fw-bold text-secondary">No se encontraron módulos</h3>
                            <p class="text-muted">Prueba refinando los términos de la búsqueda.</p>
                        </div>

                    </div>
                </div>

                <!-- Lógica Javascript Nativa para el Filtrado Reactivo -->
                <script type="text/javascript">
                    document.addEventListener('DOMContentLoaded', function () {
                        const searchInput = document.getElementById('sicpro_search_input');
                        const cards = document.querySelectorAll('.sicpro-module-card');
                        const noResults = document.getElementById('sicpro_no_results');

                        if (searchInput) {
                            searchInput.addEventListener('input', function (e) {
                                const term = e.target.value.toLowerCase().trim();
                                let visibleCount = 0;

                                cards.forEach(function (card) {
                                    const name = card.getAttribute('data-name');
                                    const tech = card.getAttribute('data-tech');

                                    if (name.includes(term) || tech.includes(term)) {
                                        card.classList.remove('d-none');
                                        visibleCount++;
                                    } else {
                                        card.classList.add('d-none');
                                    }
                                });

                                if (visibleCount === 0) {
                                    noResults.classList.remove('d-none');
                                } else {
                                    noResults.classList.add('d-none');
                                }
                            });
                        }
                    });
                </script>

                <!-- Estilos CSS In-line del Bento Effect -->
                <style>
                    .hover-lift {
                        transition: transform 0.2s ease, box-shadow 0.2s ease;
                    }
                    .hover-lift:hover {
                        transform: translateY(-4px);
                        box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
                    }
                    .text-xs { font-size: 0.785rem; }
                    .text-sm { font-size: 0.885rem; }
                    .line-clamp-3 {
                        display: -webkit-box;
                        -webkit-line-clamp: 3;
                        -webkit-box-orient: vertical;
                        overflow: hidden;
                    }
                </style>
            </t>
        </template>

        <!-- 3. VISTA DE DETALLE: Contenedor Aislado y Seguro para las descripciones estáticas -->
        <template id="detalle_modulo_page" name="Detalle de Módulo SICPRO">
            <t t-call="website.layout">
                <div id="wrap" class="bg-white py-4">

                    <!-- Navegación de retorno -->
                    <div class="container border-bottom pb-3 mb-4">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb bg-transparent p-0 m-0">
                                <li class="breadcrumb-item"><a href="/modulos" class="text-decoration-none fw-medium">Ecosistema</a></li>
                                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page" t-out="modulo.shortdesc"/>
                            </ol>
                        </nav>
                    </div>

                    <!-- Contenedor Sanatizado Estricto -->
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-12 col-lg-10 shadow-sm border rounded-4 p-4 p-md-5 bg-white mb-5 sicpro-description-wrapper">
                                <!-- Inyección directa y segura del HTML del index.html estático -->
                                <t t-out="html_content"/>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Estilos de Aislamiento para la Descripción Estática -->
                <style>
                    .sicpro-description-wrapper img {
                        max-width: 100%;
                        height: auto;
                        border-radius: 8px;
                    }
                    .sicpro-description-wrapper pre, .sicpro-description-wrapper code {
                        background-color: #f8f9fa;
                        padding: 4px 8px;
                        border-radius: 4px;
                        font-family: monospace;
                    }
                </style>
            </t>
        </template>

    </data>
</odoo>
