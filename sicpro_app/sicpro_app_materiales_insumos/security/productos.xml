<?xml version="1.0" encoding="utf-8"?>

<odoo>
<data>
    <!-- Creo la categoría de permisos Materiales e Insumos -->
    <record id="module_category_materiales_insumos" model="ir.module.category">
        <field name="name">Materiales e Insumos</field>
        <field name="description">Módulo para el control de los Materiales e Insumos.</field>
        <field name="sequence" >8</field>
    </record>

    <record id="grupo_app_materiales_insumos_usuario" model="res.groups">
        <field name="name">Usuarios</field>
        <field name="comment">Permisos de lectura</field>
        <field name="category_id" ref="module_category_materiales_insumos"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="grupo_app_materiales_insumos_ejecutor" model="res.groups">
        <field name="name">Ejecutor</field>
        <field name="comment">Permisos de lectura/Escritura</field>
        <field name="category_id" ref="module_category_materiales_insumos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_materiales_insumos_usuario'))]"/>
    </record>

    <record id="grupo_app_materiales_insumos_responsable" model="res.groups">
        <field name="name">Responsable</field>
        <field name="comment">Permisos de lectura/Escritura/Config</field>
        <field name="category_id" ref="module_category_materiales_insumos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_materiales_insumos_ejecutor'))]"/>
    </record>

    <record id="grupo_app_materiales_insumos_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="comment">Permisos Completos</field>
        <field name="category_id" ref="module_category_materiales_insumos"/>
        <field name="implied_ids" eval="[(4, ref('grupo_app_materiales_insumos_responsable'))]"/>
    </record>



</data>
</odoo>
