<?xml version="1.0"?>
<odoo>

        <record id="productos_tag_form" model="ir.ui.view">
            <field name="name">sicpro.app.materiales.insumos.etiquetas.form</field>
            <field name="model">sicpro.app.materiales.insumos.etiquetas</field>
            <field name="arch" type="xml">
                <form string="Etiquetas">
                    <sheet>
                        <div class="oe_title">
                            <div class="oe_edit_only">
                                <label for="name"/>
                            </div>
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="color" widget="color_picker"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="productos_tag_tree" model="ir.ui.view">
            <field name="name">sicpro.app.materiales.insumos.etiquetas.tree</field>
            <field name="model">sicpro.app.materiales.insumos.etiquetas</field>
            <field name="arch" type="xml">
                <tree string="Etiquetas" editable="bottom">
                    <field name="name"/>
                    <field name="color" widget="color_picker"/>
                </tree>
            </field>
        </record>

        <record id="productos_tag_action" model="ir.actions.act_window">
            <field name="name">Etiquetas</field>
            <field name="res_model">sicpro.app.materiales.insumos.etiquetas</field>
            <field name="view_id" ref="productos_tag_tree"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Crear etiquetas para los productos
              </p><p>
                Aquí puede crear nuevas etiquetas para definir sus productos.
              </p>
            </field>
        </record>

        <menuitem
            id="menu_productos_etiquetas" name="Etiquetas" action="productos_tag_action"
            parent="productos_menu_config" groups="grupo_app_materiales_insumos_responsable" sequence="1"/>

</odoo>
