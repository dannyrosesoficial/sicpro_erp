<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Herede la línea de entrada de la encuesta para ver las respuestas de las preguntas personalizadas -->
    <record id="survey_user_input_line_view_form" model="ir.ui.view">
        <field name="name">survey.user_input.line.view.form.inherit.enhanced.survey.management</field>
        <field name="model">survey.user_input.line</field>
        <field name="inherit_id" ref="survey.survey_user_input_line_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_char_box']" position="after">
                <field name="value_url" colspan='2' attrs="{'invisible': [('answer_type','!=','url')]}"/>
                <field name="value_many2one" invisible="1"/>
                <field name="value_many2one_option" colspan='2' attrs="{'invisible': [('answer_type','!=','many2one')]}"/>
                <field name="value_week" colspan='2' attrs="{'invisible': [('answer_type','!=','week')]}"/>
                <field name="value_time" colspan='2' attrs="{'invisible': [('answer_type','!=','time')]}"/>
                <field name="value_color" colspan='2' attrs="{'invisible': [('answer_type','!=','color')]}"/>
                <field name="value_email" colspan='2' attrs="{'invisible': [('answer_type','!=','email')]}"/>
                <field name="value_month" colspan='2' attrs="{'invisible': [('answer_type','!=','month')]}"/>
                <field name="value_name" colspan='2' attrs="{'invisible': [('answer_type','!=','name')]}"/>
                <field name="value_matrix" colspan='2' attrs="{'invisible': [('answer_type','!=','matrix')]}"/>
                <field name="value_address" colspan='2' attrs="{'invisible': [('answer_type','!=','address')]}"/>
                <field name="value_selection" colspan='2' attrs="{'invisible': [('answer_type','!=','selection')]}"/>
                <field name="value_time" colspan='2' attrs="{'invisible': [('answer_type','!=','time')]}"/>
                <field name="value_password" colspan='2' attrs="{'invisible': [('answer_type','!=','password')]}"/>
                <field name="value_email" colspan='2' attrs="{'invisible': [('answer_type','!=','email')]}"/>
                <field name="value_range" colspan='2' attrs="{'invisible': [('answer_type','!=','range')]}"/>
                <field name="value_qr" colspan='2' attrs="{'invisible': [('answer_type','!=','qr')]}"/>
                <field name="value_barcode" colspan='2' attrs="{'invisible': [('answer_type','!=','barcode')]}"/>
                <field name="filename" invisible="1"/>
                <field name="file_data" filename="filename" colspan='2'
                       attrs="{'invisible': [('answer_type','!=','file')]}"/>
            </xpath>
        </field>
    </record>


    <record id="survey_user_input_view_form_inherit" model="ir.ui.view">
        <field name="name">survey.user_input.view.form.inherit</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='access_token']" position="after">
                <field name="trabajador_id" options="{'no_create': True, 'no_create_edit':True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <record id="survey_user_input_view_tree_inherit" model="ir.ui.view">
        <field name="name">survey.user_input.view.tree.inherit</field>
        <field name="model">survey.user_input</field>
        <field name="inherit_id" ref="survey.survey_user_input_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="trabajador_id"/>
            </xpath>

        </field>
    </record>
</odoo>
