<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="survey_page_statistics_question_inherit"
                  inherit_id="survey.survey_page_statistics_question">

            <xpath expr="//t[@t-call='survey.question_result_matrix']/.."
                   position="after">

                <t t-elif="question.question_type in ['time', 'month', 'week', 'color', 'email', 'url', 'range', 'name', 'address', 'qr', 'barcode', 'password', 'file']">
                    <t t-call="survey.question_result_text"/>
                </t>

                <t t-elif="question.question_type in ['many2one', 'selection']">
                    <t t-call="sicpro_app_encuestas.question_result_many2one_seleccion"></t>
                </t>
            </xpath>
        </template>

        <template id="question_result_many2one_seleccion" name="Question: Many2One/Selección result">

            <t t-set="graph_data" t-value="question_data['graph_data']"/>
            <t t-set="table_data" t-value="question_data['table_data']"/>
            <t t-set="common_lines" t-value="question_data['common_lines']"/>
            <t t-set="page_record_limit" t-value="300"/> <t t-set="no_print_url" t-value="request.env.context.get('no_print_url', False)"/>

            <ul class="nav nav-tabs d-print-none" role="tablist">
                <li class="nav-item">
                    <a t-att-href="'#survey_graph_question_%d' % question.id"
                        class="nav-link active" data-toggle="tab" role="tab">
                        <i class="fa fa-bar-chart-o"><span> Gráfico y Ocurrencias</span></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a t-att-href="'#survey_data_question_%d' % question.id"
                        class="nav-link" data-toggle="tab" role="tab">
                        <i class="fa fa-list-alt"></i> Datos
                    </a>
                </li>
            </ul>

            <div class="tab-content">

                <div role="tabpanel"
                     class="tab-pane active survey_graph with-3d-shadow with-transitions"
                     t-att-id="'survey_graph_question_%d' % question.id"
                     t-att-data-question_id="question.id"
                     data-graph-type="pie"
                     t-att-data-graph-data="graph_data or '{}'">

                    <canvas/>

                    <h4 class="mt-4">Ocurrencias (Respuestas)</h4>
                    <table class="table table-hover table-sm">
                        <thead>
                            <tr>
                                <th>Respuesta</th>
                                <th>Ocurrencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="common_lines" t-as="common_line">
                                <td><span t-esc="common_line[0]"/></td>
                                <td><span t-esc="common_line[1]"></span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div role="tabpanel" class="tab-pane" t-att-id="'survey_data_question_%d' % question.id">
                    <table class="table table-hover table-sm">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Respuestas de Usuario</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="table_data" t-as="input_line">
                                <tr t-if="not input_line.skipped"
                                    t-att-class="'d-none' if input_line_index >= page_record_limit else ''">
                                    <td>
                                        <t t-if="no_print_url"><t t-esc="input_line_index + 1"></t></t>
                                        <t t-else="">
                                            <a t-att-href="input_line.user_input_id.get_print_url()"><t
                                                    t-esc="input_line_index + 1"></t></a>
                                        </t>
                                    </td>
                                    <td class="survey_answer">
                                        <t t-if="question.question_type == 'many2one'">
                                           <a t-att-href="input_line.user_input_id.get_print_url()"
                                              t-field="input_line.value_many2one_option"/>
                                        </t>
                                        <t t-elif="question.question_type == 'selection'">
                                           <span t-field="input_line.value_selection"/>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    <t t-call="survey.question_table_pagination"/>
                </div>
            </div>
        </template>
    </data>
</odoo>