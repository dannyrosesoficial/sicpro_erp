<odoo>
    <record id="view_master_password_wizard_form" model="ir.ui.view">
        <field name="name">sicpro.app.db.master.password.wizard.form</field>
        <field name="model">sicpro.app.db.master.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Seguridad Maestra">
                <div class="alert alert-warning" role="alert">
                    Está a punto de habilitar la edición manual en una tabla del sistema.
                    Cualquier cambio será registrado. Introduzca la Contraseña Maestra.
                </div>
                <group>
                    <field name="table_id" invisible="1"/>
                    <field name="password_input" password="True" placeholder="Contraseña de administrador..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Verificar y Desbloquear" type="object" class="btn-danger"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>