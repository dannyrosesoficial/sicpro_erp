<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

                <!-- Informes por trabajador -->
        <record id="parte_horas_reporte_trabajadores_action" model="ir.actions.act_window">
            <field name="name">Informe por trabajador</field>
            <field name="res_model">sicpro.app.partes.horas</field>
            <field name="domain">[('especialista_ejecutor_id', '!=', False)]</field>
            <field name="context">{'search_default_groupby_employee':1,}</field>
            <field name="search_view_id" ref="sicpro_app_partes_horas.partes_horas_line_search"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Agregar nueva actividad
              </p>
            </field>
        </record>

        <record model="ir.actions.act_window.view" id="parte_horas_reporte_trabajadores_action_pivot">
            <field name="sequence" eval="5"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_pivot"/>
            <field name="act_window_id" ref="parte_horas_reporte_trabajadores_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="parte_horas_reporte_trabajadores_action_graph">
            <field name="sequence" eval="6"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_graph"/>
            <field name="act_window_id" ref="parte_horas_reporte_trabajadores_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="parte_horas_reporte_trabajadores_action_tree">
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_tree"/>
            <field name="act_window_id" ref="parte_horas_reporte_trabajadores_action"/>
        </record>

        <record model="ir.actions.act_window.view" id="parte_horas_reporte_trabajadores_action_form">
            <field name="sequence" eval="15"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_form"/>
            <field name="act_window_id" ref="parte_horas_reporte_trabajadores_action"/>
        </record>


               <!-- Informes por trabajador -->
        <record id="parte_horas_reporte_preparaciones_action" model="ir.actions.act_window">
            <field name="name">Informe por preparaciones</field>
            <field name="res_model">sicpro.app.partes.horas</field>
            <field name="domain">[('especialista_ejecutor_id', '!=', False)]</field>
            <field name="context">{'search_default_groupby_project':1,'search_default_groupby_task':1,}</field>
            <field name="search_view_id" ref="partes_horas_line_search"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Agregar ueva actividad
              </p>
            </field>
        </record>

        <record id="parte_horas_reporte_preparaciones_action_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="5"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_pivot"/>
            <field name="act_window_id" ref="parte_horas_reporte_preparaciones_action"/>
        </record>

        <record id="parte_horas_reporte_preparaciones_action_graph" model="ir.actions.act_window.view">
            <field name="sequence" eval="6"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_graph"/>
            <field name="act_window_id" ref="parte_horas_reporte_preparaciones_action"/>
        </record>

        <record id="parte_horas_reporte_preparaciones_action_tree" model="ir.actions.act_window.view">
            <field name="sequence" eval="10"/>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_tree"/>
            <field name="act_window_id" ref="parte_horas_reporte_preparaciones_action"/>
        </record>

        <record id="parte_horas_reporte_preparaciones_action_form" model="ir.actions.act_window.view">
            <field name="sequence" eval="15"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="sicpro_app_partes_horas.partes_horas_line_form"/>
            <field name="act_window_id" ref="parte_horas_reporte_preparaciones_action"/>
        </record>



        <menuitem id="menu_partes_horas_informes"
                  name="Informes"
                  parent="menu_partes_horas_root"
                  sequence="99"/>

        <menuitem id="menu_partes_horas_reportes"
                  name="Partes de horas"
                  parent="menu_partes_horas_informes"
                  sequence="10"/>

        <menuitem id="menu_partes_horas_trabajador"
                  parent="menu_partes_horas_reportes"
                  action="parte_horas_reporte_trabajadores_action"
                  name="Por trabajador"
                  sequence="10"/>

        <menuitem id="menu_partes_horas_preparaciones"
                  parent="menu_partes_horas_reportes"
                  action="parte_horas_reporte_preparaciones_action"
                  name="Por preparaciones"
                  sequence="20"/>

    </data>
</odoo>
