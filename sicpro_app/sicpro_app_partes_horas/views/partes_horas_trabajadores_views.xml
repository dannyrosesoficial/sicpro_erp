<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partes_horas_trabajadores_action" model="ir.actions.act_window">
        <field name="name">Partes de horas</field>
        <field name="res_model">sicpro.app.partes.horas</field>
        <field name="search_view_id" ref="partes_horas_line_search"/>
        <field name="domain">[('especialista_ejecutor_id', '!=', False)]</field>
        <field name="context">{
            'search_default_month':1,
            'search_default_employee_id': [active_id],
            'default_employee_id': active_id
        }</field>
    </record>

    <record id="partes_horas_trabajadores_action_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="5"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="partes_horas_line_tree"/>
        <field name="act_window_id" ref="partes_horas_trabajadores_action"/>
    </record>

    <record id="partes_horas_trabajadores_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="10"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="partes_horas_line_form"/>
        <field name="act_window_id" ref="partes_horas_trabajadores_action"/>
    </record>

    <record id="partes_horas_trabajadores_action_form_inherit_trabajadores" model="ir.ui.view">
        <field name="name">sicpro.app.trabajadores.general.form.partes.horas</field>
        <field name="model">sicpro.app.trabajadores.general</field>
        <field name="inherit_id" ref="sicpro_app_trabajadores.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group>
                    <group string="Partes de horas" name="timesheet">
                        <label for="costo"/>
                        <div>
                            <field name="costo" class="oe_inline"/> Partes horas
                            <field name="currency_id" invisible="1"/>
                        </div>
                    </group>
                </group>
            </xpath>
            <div name="button_box" position="inside">
                <button class="oe_stat_button" type="action" name="%(partes_horas_trabajadores_action)d"
                        icon="fa-calendar" groups="sicpro_app_partes_horas.grupo_app_partes_horas_todos_usuario">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Partes horas</span>
                    </div>
                </button>
            </div>
        </field>
    </record>

</odoo>
