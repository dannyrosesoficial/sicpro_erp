<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_web_plugins_filter" model="ir.ui.view">
        <field name="name">sicpro.modulo.web.plugins.filter</field>
        <field name="model">sicpro.modulo.web.plugins</field>
        <field name="arch" type="xml">
            <search string="Buscar">
                <field name="name"/>
                <separator/>
                <filter string="Archivados" name="active" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="view_web_plugins_form" model="ir.ui.view">
        <field name="name">sicpro.modulo.web.plugins.form</field>
        <field name="model">sicpro.modulo.web.plugins</field>
        <field name="arch" type="xml">
            <form string="Plugins SICPRO">
                <header>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title mb24">
                        <field name="active" invisible="1"/>
                      <h1>
                        <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="popular" widget="boolean_favorite"/>
                        </group>
                        <group>
                            <field name="plataforma"/>
                            <field name="archivo" filename="name"/>
                        </group>
                    </group>
                    <group>
                        <field name="descripcion" widget="html" class="oe-bordered-editor"
                               options="{'style-inline': true, 'codeview': true }"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_web_plugins_tree" model="ir.ui.view">
        <field name="name">sicpro.modulo.web.plugins.tree</field>
        <field name="model">sicpro.modulo.web.plugins</field>
        <field name="arch" type="xml">
            <tree string="Plugins SICPRO">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="descripcion"/>
                <field name="tipo"/>
                <field name="plataforma"/>
            </tree>
        </field>
    </record>

    <record id="action_web_plugins" model="ir.actions.act_window">
        <field name="name">Plugin y Aplicaciones</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.modulo.web.plugins</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_web_plugins_filter"/>
    </record>

</odoo>
