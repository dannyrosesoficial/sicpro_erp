<?xml version="1.0"?>
<odoo>

  <template id="web_plugins">
    <!--    <t t-call-assets="web.assets_common"/>-->
    <t t-call-assets="web.web_plugins"/>
    <head>
      <meta charset="utf-8"/>
      <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
      <title>SICPRO ERP - Plugins</title>
      <meta http-equiv="cache-control" content="no-cache"/>
      <meta http-equiv="pragma" content="no-cache"/>

      <!-- Favicons -->
      <link href="/sicpro_modulo_web_plugins/static/src/img/SICPRO_ERP.png" rel="icon"/>
      <link href="/sicpro_modulo_web_plugins/static/src/img/SICPRO_ERP.png" rel="apple-touch-icon"/>
    </head>

    <body>
      <!-- ======= Header ======= -->
      <header id="header" name="header" class="fixed-top d-flex align-items-center">
        <div class="container d-flex justify-content-between align-items-center">

          <div class="logo">
            <a href="#">
                <img src="/sicpro_modulo_web_plugins/static/src/img/SICPRO ERP_blanco.png" alt="SICPRO" class="img-fluid-plugins"/>
                <strong class="text-logo-plugins">SICPRO</strong>
              </a>
          </div>

          <nav id="navbar" class="navbar">
            <ul>
              <li><a class="active" href="#presentacion">Presentación</a></li>
              <li><a href="#descargas">Descargas</a></li>
              <li><a class="active" href="/web/inicio/">Inicio</a></li>
              <li><a class="active" href="/web/login/">Login</a></li>
            </ul>
            <i class="bi bi-list mobile-nav-toggle"></i>
          </nav>
          <!-- .navbar -->

        </div>
      </header>
      <!-- End Header -->

      <!-- ======= Inicio presentación ======= -->
      <section class="hero-section" id="presentacion">
        <div class="wave">
          <svg width="100%" height="355px" viewBox="0 0 1920 355" version="1.1" xmlns="http://www.w3.org/2000/svg">
            <g id="Page-1" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
              <g id="Apple-TV" transform="translate(0.000000, -402.000000)" fill="#FFFFFF">
                <path d="M0,439.134243 C175.04074,464.89273 327.944386,477.771974 458.710937,477.771974 C654.860765,477.771974 870.645295,442.632362 1205.9828,410.192501 C1429.54114,388.565926 1667.54687,411.092417 1920,477.771974 L1920,757 L1017.15166,757 L0,757 L0,439.134243 Z"
                      id="Path">
                </path>
              </g>
            </g>
          </svg>
        </div>

        <div class="container">
          <div class="row align-items-center">
            <div class="col-12 hero-text-image">
              <div class="row">
                <div class="col-lg-8 text-center text-lg-start">
                  <h1 data-aos="fade-right">Plugins SICPRO ERP</h1>
                  <p class="mb-5" data-aos="fade-right" data-aos-delay="100">
                    Selección de aplicaciones y Plugins par utilizar con el sistema.</p>
                  <p data-aos="fade-right" data-aos-delay="200" data-aos-offset="-500">
                    <a href="/web/login" class="btn btn-outline-white">Iniciar Sesión</a></p>
                </div>
                <div class="col-lg-4 iphone-wrap">
                  <img src="/sicpro_modulo_web_plugins/static/src/img/logo_1.png" alt="logo1" class="phone-1"
                       data-aos="fade-right"/>
                  <img src="/sicpro_modulo_web_plugins/static/src/img/logo_2.png" alt="logo2" class="phone-2"
                       data-aos="fade-right" data-aos-delay="200"/>
                </div>
              </div>
            </div>
          </div>
        </div>

      </section>
      <!-- Fin presentación -->

      <main id="main">
        <section class="section" id="descargas">
          <div class="container">

            <div class="row justify-content-center text-center">
              <div class="col-md-7 mb-5">
                <h2 class="section-heading">Descargas</h2>
                <p>Listado de aplicaciones y plugins para descargar y utilizar con SICPRO ERP</p>
              </div>
            </div>
            <t t-set="plugins_ids" t-value="request.env['sicpro.modulo.web.plugins'].sudo().buscar_datos_plugins()"/>
            <div class="row align-items-stretch">
              <t t-foreach='plugins_ids' t-as='plugins_data'>
                <div class="col-lg-4 mb-4 mb-lg-0">
                <div t-att-class="'pricing hg-50 text-center ' + plugins_data['popular']">
                  <span class="popularity"><t t-out="plugins_data['tipo']"/></span>
                  <h3><t t-out="plugins_data['nombre']"/></h3>
                  <ul class="list-unstyled">
                    <t t-out="plugins_data['descripcion']"/>
                  </ul>
                  <div class="price-cta">
                    <strong class="price"><t t-out="plugins_data['plataforma']"/></strong>
                    <p><a t-att-href="plugins_data['archivo']" class="btn btn-white">Descargar</a></p>
                  </div>
                </div>
              </div>
              </t>
            </div>
          </div>
        </section>
      </main>
      <!-- End #main -->

      <!-- ======= Footer ======= -->
      <footer class="footer" role="contentinfo">
        <div class="container">


          <div class="row justify-content-center text-center">
            <div class="col-md-7">
              <div class="copyright">
                <img src="/sicpro_modulo_web_plugins/static/src/img/etecsaCi_300_8 blanco.png" alt="ETECSA" width="32"
                     height="32"/>
                <strong>©2023 DIVISIÓN DE PROYECTOS Y EJECUCIÓN DE OBRAS </strong>
              </div>
              <div class="credits">
                <strong>Todos los derechos reservados </strong>
              </div>
            </div>
          </div>

        </div>
      </footer>

      <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i
              class="bi bi-arrow-up-short"></i></a>

      <script src="/sicpro_modulo_web_plugins/static/src/js/main.js"></script>
    </body>
  </template>


</odoo>
