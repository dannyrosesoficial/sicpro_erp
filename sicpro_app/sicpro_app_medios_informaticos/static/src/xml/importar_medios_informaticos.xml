<templates xml:space="preserve">
    <t t-name="sicpro_app_cmi.transferir" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="before">
            <t t-if="props.resModel === 'sicpro.app.medios.informaticos.importar'">
                <button type="button"
                    class="btn btn-primary o_button_importar_datos fa fa-upload"
                    t-on-click="_onImportarDatos">
                Importar datos
            </button>

            <button type="button"
                    class="btn btn-secondary o_button_actualizar_datos fa"
                    t-on-click="onActualizarDatos">
                Actualizar
            </button>
            </t>
        </xpath>

        <xpath expr="//button[hasclass('o_list_button_add')]" position="attributes">
            <attribute name="t-if">props.resModel !== 'sicpro.app.medios.informaticos.importar'</attribute>
        </xpath>
    </t>
</templates>