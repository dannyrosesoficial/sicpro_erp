<odoo>
  <data>
    <!-- Creo los privilegios de permisos para Medios Informáticos-->
    <record id="privilege_medios_informaticos_inventario" model="res.groups.privilege">
      <field name="name">Medios Informáticos</field>
      <field name="sequence">1</field>
      <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_informatica"/>
    </record>

    <record id="grupo_app_medios_informaticos_inventario_usuario" model="res.groups">
      <field name="name">Visualizar</field>
      <field name="comment">Permisos de lectura</field>
      <field name="privilege_id" ref="privilege_medios_informaticos_inventario"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="grupo_app_medios_informaticos_inventario_tecnico" model="res.groups">
      <field name="name">Técnico</field>
      <field name="comment">Permisos de Lectura/Escritura/Config</field>
      <field name="privilege_id" ref="privilege_medios_informaticos_inventario"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_medios_informaticos_inventario_usuario'))]"/>
    </record>
    <record id="grupo_app_medios_informaticos_responsable" model="res.groups">
      <field name="name">Responsable</field>
      <field name="comment">Permisos de Lectura/Escritura/Config</field>
      <field name="privilege_id" ref="privilege_medios_informaticos_inventario"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_medios_informaticos_inventario_tecnico'))]"/>
    </record>
    <record id="grupo_app_medios_informaticos_admin" model="res.groups">
      <field name="name">Administrador</field>
      <field name="comment">Permisos Completos</field>
      <field name="privilege_id" ref="privilege_medios_informaticos_inventario"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_medios_informaticos_responsable'))]"/>
    </record>
  </data>

  <data>
    <!-- Creo los privilegios de permisos para Taller Informática-->
    <record id="privilege_medios_informaticos_taller" model="res.groups.privilege">
      <field name="name">Taller</field>
      <field name="sequence">2</field>
      <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_informatica"/>
    </record>

    <record id="grupo_app_medios_informaticos_taller_usuario" model="res.groups">
      <field name="name">Visualizar</field>
      <field name="comment">Permisos de lectura</field>
      <field name="privilege_id" ref="privilege_medios_informaticos_taller"/>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="grupo_app_medios_informaticos_taller_tecnico" model="res.groups">
      <field name="name">Técnico</field>
      <field name="comment">Permisos de Lectura/Escritura/Config</field>
      <field name="privilege_id" ref="privilege_medios_informaticos_taller"/>
      <field name="implied_ids" eval="[(4, ref('grupo_app_medios_informaticos_taller_usuario'))]"/>
    </record>
  </data>
</odoo>