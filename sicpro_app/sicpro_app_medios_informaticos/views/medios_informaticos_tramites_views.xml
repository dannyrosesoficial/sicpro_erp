<odoo>
  <record id="medios_informaticos_tramites_form" model="ir.ui.view">
    <field name="name">sicpro.app.medios.informaticos.tramites.form</field>
    <field name="model">sicpro.app.medios.informaticos.tramites</field>
    <field name="arch" type="xml">
      <form string="Trámites">
        <header>
        </header>
        <sheet>
          <group name="group_top">
            <group name="group_left">
              <field name="name"/>
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="medios_informaticos_tramites_list" model="ir.ui.view">
    <field name="name">sicpro.app.medios.informaticos.tramites.list</field>
    <field name="model">sicpro.app.medios.informaticos.tramites</field>
    <field name="arch" type="xml">
      <list string="Trámites" editable="bottom">
        <field name="name"/>
      </list>
    </field>
  </record>

  <record id="medios_informaticos_tramites_action" model="ir.actions.act_window">
    <field name="name">Trámites</field>
    <field name="res_model">sicpro.app.medios.informaticos.tramites</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>

