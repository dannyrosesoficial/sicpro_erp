<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="medios_informaticos_bajas_form" model="ir.ui.view">
        <field name="name">sicpro.app.medios.informaticos.bajas.form</field>
        <field name="model">sicpro.app.medios.informaticos.bajas</field>
        <field name="arch" type="xml">
            <form string="Bajas o Destinos Finales">
                <header>
                </header>
                <sheet>
                    <group name="group_top">
                        <group name="group_left">
                            <field name="name"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
                            <field name="denominacion"/>
                            <field name="no_orden_mtto_taller"/>
                            <field name="unidad_org"/>
                            <field name="no_exp_economia"/>
                        </group>
                        <group name="group_right">
                            <field name="fecha_ent_exp_economia"/>
                            <field name="no_acta_acuerdo_consejo_dir"/>
                            <field name="fecha_acta_destino_final"/>
                            <field name="acta_entrega_sertod"/>
                        </group>
                    </group>
                    <group name="group_bottom">
                        <field name="dictamen_tec"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medios_informaticos_bajas_tree" model="ir.ui.view">
        <field name="name">sicpro.app.medios.informaticos.bajas.tree</field>
        <field name="model">sicpro.app.medios.informaticos.bajas</field>
        <field name="arch" type="xml">
            <tree string="Baja o Destinos Finales">
                <field name="denominacion"/>
                <field name="name"/>
                <field name="no_orden_mtto_taller"/>
                <field name="dictamen_tec"/>
                <field name="unidad_org"/>
                <field name="fecha_ent_exp_economia"/>
                <field name="no_acta_acuerdo_consejo_dir"/>
                <field name="fecha_acta_destino_final"/>
                <field name="acta_entrega_sertod"/>
                <field name="no_exp_economia"/>
            </tree>
        </field>
    </record>

    <record id="medios_informaticos_baja_action" model="ir.actions.act_window">
        <field name="name">Bajas o Destino Final</field>
        <field name="res_model">sicpro.app.medios.informaticos.bajas</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>

