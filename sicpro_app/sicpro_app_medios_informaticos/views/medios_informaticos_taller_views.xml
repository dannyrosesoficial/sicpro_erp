<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="medios_informaticos_taller_form" model="ir.ui.view">
        <field name="name">sicpro.app.medios.informaticos.taller.form</field>
        <field name="model">sicpro.app.medios.informaticos.taller</field>
        <field name="arch" type="xml">
            <form string="Taller">
                <header>
                    <button name="cerrar_tique" type="object" string="Cerrar Tique"/>
                </header>
                <sheet>
                    <group name="group_top">
                        <group name="group_left">
                            <field name="name"
                                   options="{'no_open': True, 'no_quick_create': True, 'no_create_edit':'True'}"/>
                            <field name="no_tique"/>
                            <field name="equipo"/>
                            <field name="denominacion"/>
                            <field name="fecha_entrada"/>
                            <field name="fecha_recogida"/>
                        </group>
                        <group name="group_right">
                            <field name="responsable"/>
                            <field name="unidad_org"/>
                            <field name="tramite"/>
                            <field name="no_orden_taller"/>
                            <field name="tique_cerrado" readonly="1"/>
                        </group>
                    </group>
                    <group name="group_bottom">
                        <field name="dictamen_tec"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="medios_informaticos_taller_tree" model="ir.ui.view">
        <field name="name">sicpro.app.medios.informaticos.taller.tree</field>
        <field name="model">sicpro.app.medios.informaticos.taller</field>
        <field name="arch" type="xml">
            <tree string="Taller">
                <field name="no_tique"/>
                <field name="fecha_entrada"/>
                <field name="fecha_recogida"/>
                <field name="responsable"/>
                <field name="name"/>
                <field name="equipo"/>
                <field name="denominacion"/>
                <field name="unidad_org"/>
                <field name="tramite"/>
                <field name="dictamen_tec"/>
                <field name="no_orden_taller"/>
                <field name="tique_cerrado"/>
            </tree>
        </field>
    </record>

    <record id="medios_informaticos_taller_calendar" model="ir.ui.view">
        <field name="name">sicpro.app.medios.informaticos.taller.calendar</field>
        <field name="model">sicpro.app.medios.informaticos.taller</field>
        <field name="arch" type="xml">
            <calendar string="Calendar" date_start="fecha_entrada" color="name" mode="month" quick_add="True">
                <field name="no_tique"/>
                <field name="name"/>
            </calendar>
        </field>
    </record>
    <record id="medios_informaticos_envio_taller_action" model="ir.actions.act_window">
        <field name="name">Envíos a Taller</field>
        <field name="res_model">sicpro.app.medios.informaticos.taller</field>
        <field name="view_mode">tree,form,calendar</field>
    </record>

</odoo>

