<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <record id="metodos_correos_entrantes_tree_view" model="ir.ui.view">
        <field name="name">sicpro.modulo.base.correos.entrantes.metodos.tree.view</field>
        <field name="model">sicpro.modulo.base.correos.entrantes.metodos</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="asunto" widget="many2many_tags"
                           options="{'color_field': 'color', 'no_create_edit': True}"
                           placeholder="Seleccionar el asunto a gestionar"/>
                <field name="active" invisible="1"/>
                <field name="color" widget="color_picker" invisible="1"/>
            </tree>
        </field>
    </record>


    <record id="metodos_correos_entrantes_filter_view" model="ir.ui.view">
       <field name="name">Buscar Métodos</field>
       <field name="model">sicpro.modulo.base.correos.entrantes.metodos</field>
        <field name="arch" type="xml">
            <search>
            <field name="name"/>
            <filter string="Archivado" name="active" domain="[('active', '=',False)]"/>
        </search>
       </field>
    </record>


    <record id="action_metodos_correos_entrantes" model="ir.actions.act_window">
        <field name="name">Métodos para Correos Entrantes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.modulo.base.correos.entrantes.metodos</field>
        <field name="view_mode">tree</field>
    </record>

    </data>
</odoo>