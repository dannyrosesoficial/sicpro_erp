<?xml version="1.0"?>
<odoo>
    <record id="view_email_server_form_herencia" model="ir.ui.view">
        <field name="name">fetchmail.server.form.herencia</field>
        <field name="model">fetchmail.server</field>
        <field name="inherit_id" ref="fetchmail.view_email_server_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='object_id']" position="before">
                <div class="text-danger">
                    <strong>ATENCIÓN: </strong>
                    <small>Si el campo de nuevo registro esta vació se pasara a la
                        comprobación interna de las aplicaciones.</small>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
