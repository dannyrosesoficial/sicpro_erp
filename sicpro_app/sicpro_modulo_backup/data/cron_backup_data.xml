<?xml version="1.0" ?>
<odoo>
    <data noupdate="1">
        <record id="backup_crear" model="ir.cron">
            <field name="interval_type">days</field>
            <field name="name">Backup: Ejecución de salvas programadas</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="model_id" ref="model_sicpro_modulo_backup"/>
            <field name="state">code</field>
            <field name="code">model.ejecutar_backup()</field>
        </record>

        <record id="backup_eliminar" model="ir.cron">
            <field name="interval_type">days</field>
            <field name="name">Backup: Eliminación de salvas programadas</field>
            <field name="numbercall">-1</field>
            <field name="priority">5</field>
            <field name="doall">False</field>
            <field name="active">True</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="model_id" ref="model_sicpro_modulo_backup"/>
            <field name="state">code</field>
            <field name="code">model.eliminar_backup()</field>
        </record>
    </data>
</odoo>
