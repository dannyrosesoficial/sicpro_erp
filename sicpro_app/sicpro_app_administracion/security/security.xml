<odoo>
    <data>
        <!-- Creo la categoría de Administración General -->
        <record id="modulo_categoria_administracion_general" model="ir.module.category">
            <field name="name">Administración SICPRO ERP</field>
            <field name="description">Módulo para el acceso a los tableros de mando de los sistemas SICPRO.</field>
            <field name="sequence">1</field>
        </record>

        <!-- Creo los privilegios de SICPRO Administración -->
        <record id="privilege_administracion" model="res.groups.privilege">
            <field name="name">Administrar SICPRO</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="sicpro_app_administracion.modulo_categoria_administracion_general"/>
        </record>
        <record id="grupo_app_administracion_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="comment">Permisos Completos</field>
            <field name="privilege_id" ref="privilege_administracion"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <!-- ################################################################################################ -->


        <!-- Creo los privilegios de notificaciones de la Administración -->
        <record id="privilege_notificaciones_administracion" model="res.groups.privilege">
