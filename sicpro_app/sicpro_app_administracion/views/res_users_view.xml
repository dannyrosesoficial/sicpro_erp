<odoo>
  <record id="view_res_users_kanban_merged_sicpro" model="ir.ui.view">
    <field name="name">res.users.kanban.inherit.merge</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_res_users_kanban"/>
    <field name="arch" type="xml">
      <xpath expr="//kanban" position="attributes">
        <attribute name="highlight_color">color</attribute>
      </xpath>

      <xpath expr="//field[@name='login_date']" position="after">
        <field name="id"/>
        <field name="color"/>
        <field name="identificador_corto"/>
        <field name="status"/>
        <field name="email"/>
      </xpath>

      <xpath expr="//div[contains(@class, 'text-success') and @t-if='record.active.raw_value']" position="replace">
        <field name="status" widget="state_selection" class="float-end mb4 me-1"/>
      </xpath>

      <xpath expr="//div[@t-else='']" position="replace">
      </xpath>

      <xpath expr="//field[@name='login']/.." position="after">
        <div class="mt-1">
          <span class="text-info small">
            <field name="email"/>
          </span>
        </div>

        <div t-if="record.identificador_corto.raw_value" class="mt-1">
          <span class="badge rounded-pill bg-info">
            <field name="identificador_corto"/>
          </span>
        </div>
      </xpath>
    </field>
  </record>

  <record id="base.action_res_users" model="ir.actions.act_window">
    <field name="view_mode">kanban,list,form</field>
  </record>

  <record id="base.action_res_users_view1" model="ir.actions.act_window.view">
    <field eval="5" name="sequence"/>
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_res_users_kanban_merged_sicpro"/>
    <field name="act_window_id" ref="base.action_res_users"/>
  </record>

  <!-- Heredo vista search de res.user y le agrego filtros de búsquedas -->
  <record id="view_users_mod_search_inherit" model="ir.ui.view">
    <field name="name">res.users.mod.search.inherit</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_search"/>
    <field name="arch" type="xml">
      <xpath expr="//filter[@name='Inactive']" position="after">
        <separator/>
        <filter string="Usuarios Conectados" name="online_usuarios" domain="[('status','=', 'done')]"/>
        <filter string="Usuarios Desconectados" name="offline_usuarios" domain="[('status','=', 'blocked')]"/>
        <separator/>
        <group>
          <filter name="company_id" string="Procesos" context="{'group_by': 'company_id'}"/>
        </group>
        <searchpanel view_types="list,kanban">
          <field name="company_id" enable_counters="1" expand="1" icon="fa-building"/>
          <field name="status" enable_counters="1" expand="1" icon="fa-user-times"/>
        </searchpanel>

      </xpath>
    </field>
  </record>

  <!-- Heredo vista form de res.user y le agrego campos -->
  <record id="user_email_form" model="ir.ui.view">
    <field name="name">res.users.views.form</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form"/>
    <field name="arch" type="xml">
      <!-- botones de envío de notificaciones -->
      <xpath expr="//button[@name='action_reset_password']" position="replace">
        <button string="Enviar Invitación" class="oe_highlight"
                type="object" name="enviar_invitacion_usuario"/>
        <button string="Enviar Actualización de Roles"
                type="object" name="enviar_actualizacion_roles"/>
      </xpath>

      <xpath expr="//div[(@name='button_box')]" position="replace">
        <div class="oe_button_box" name="button_box">
          <button id="presencia_usuario_button" class="oe_stat_button" disabled="1">
            <span title="btn_separador" class="o_stat_text fa fa-fw"></span>
            <field name="status" widget="state_selection" class="ml-auto oe_read_only"
                   style="margin-right:24px;"/>

            <div class="o_stat_info" invisible="status == 'blocked'">
              <span class="o_stat_text">En Línea</span>
            </div>

            <div class="o_stat_info" invisible="status == 'done'">
              <span class="o_stat_value" invisible="not last_activity_time">
                <field name="last_activity_time"/>
              </span>

              <span class="o_stat_value" invisible="last_activity_time">
                <field name="last_activity"/>
              </span>

              <span class="o_stat_text">Desconectado</span>
            </div>
          </button>

          <button name="action_show_groups" type="object" groups="base.group_system" class="oe_stat_button"
                  icon="fa-users">
            <field string="Grupos" name="groups_count" widget="statinfo"/>
          </button>
          <button name="action_show_accesses" type="object" groups="base.group_system" class="oe_stat_button"
                  icon="fa-list">
            <field string="Accesos" name="accesses_count" widget="statinfo"/>
          </button>
          <button name="action_show_rules" type="object" groups="base.group_system" class="oe_stat_button"
                  icon="fa-list-ul">
            <field string="Reglas" name="rules_count" widget="statinfo"/>
          </button>
        </div>
      </xpath>

      <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="before">
        <field name="status" widget="state_selection" class="ms-auto oe_read_only" style="margin-right: 24px;"/>
      </xpath>

      <xpath expr="//div[hasclass('oe_title')]//field[@name='name']" position="attributes">
        <attribute name="placeholder">Ej. Escriba el nombre del trabajador de SICPRO</attribute>
      </xpath>
      <xpath expr="//field[@name='login']" position="attributes">
        <attribute name="placeholder">Ej. daniel.borrero</attribute>
      </xpath>

      <xpath expr="//h5[@name='h5_email']//div/i[1]" position="attributes">
        <attribute name="class">fa fa-fw fa-user me-1 text-primary</attribute>
        <attribute name="invisible">False</attribute>
      </xpath>
      <xpath expr="//h5[@name='h5_email']//div/i[2]" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//h5[@name='h5_email']//i[hasclass('fa-envelope')]" position="attributes">
        <attribute name="invisible">False</attribute>
        <attribute name="class">fa fa-fw fa-envelope me-1 text-primary</attribute>
      </xpath>
      <xpath expr="//field[@name='email']" position="attributes">
        <attribute name="invisible">False</attribute>
      </xpath>

      <xpath expr="//field[@name='login']" position="after">
        <field name="last_activity" invisible="1"/>
        <field name="last_activity_time" invisible="1"/>
      </xpath>

      <xpath expr="//div[hasclass('oe_title')]" position="after">
        <group>
          <field name="color" widget="color_picker" string="Color de Perfil"/>
        </group>
      </xpath>

      <!-- Agrego un grupo para alojar a los mapas y calendario-->
      <group name="other_preferences" position="after">
        <group name="grupo_estatico_1">
        </group>
      </group>

    </field>
  </record>

  <!-- Heredo vista tree de res.user y le agrego campos -->
  <record id="user_email_list" model="ir.ui.view">
    <field name="name">res.users.views.list</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="before">
        <field name="status" widget="state_selection"/>
      </xpath>
      <field name="login" position="after">
        <field name="email"/>
      </field>
    </field>
  </record>

  <!-- Heredo vista forms del perfil de res.user y modifico campos -->
  <record id="view_users_form_preferencia_modif" model="ir.ui.view">
    <field name="name">res.users.preferences.form</field>
    <field name="model">res.users</field>
    <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='name']" position="replace">
        <field name="name" readonly="1"/>
      </xpath>
      <xpath expr="//field[@name='email']" position="replace">
        <field name="email" widget="email" readonly="1"/>
      </xpath>
      <xpath expr="//field[@name='lang']" position="replace">
        <field name="lang" required="1" readonly="1"/>
      </xpath>
      <xpath expr="//field[@name='tz']" position="replace">
        <field name="tz" widget="timezone_mismatch" options="{'tz_offset_field': 'tz_offset'}" readonly="1"/>
      </xpath>
      <xpath expr="//field[@name='notification_type']" position="replace">
        <field name="notification_type" widget="radio" readonly="1"/>
      </xpath>
      <xpath expr="//page[@name='page_security']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
    </field>
  </record>
</odoo>
