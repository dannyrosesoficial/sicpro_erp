<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Heredo vista search de res.module y le agrego filtros de búsquedas por el autor sicpro-->
    <record id="view_module_filter_inherit" model="ir.ui.view">
            <field name="name">ir.module.module.list.select</field>
            <field name="model">ir.module.module</field>
            <field name="arch" type="xml">
                <search string="Search modules">
                    <field name="name" filter_domain="['|', '|', ('summary', 'ilike', self), ('shortdesc', 'ilike', self), ('name',
                        'ilike', self)]" string="Module"/>
                    <filter name="sicpro" string="SICPRO" domain="[('author', '=', 'Daniel Barrero Reyes')]"/>
                    <filter name="app" string="Apps" domain="[('application', '=', True)]"/>
                    <filter name="extra" string="Extra" domain="[('application', '=', False)]"/>
                    <separator/>
                    <filter name="installed" string="Installed" domain="[('state', 'in', ['installed', 'to upgrade', 'to remove'])]"/>
                    <filter name="not_installed" string="Not Installed" domain="[('state', 'in', ['uninstalled', 'uninstallable', 'to install'])]"/>
                    <field name="category_id"/>
                    <group expand="0" string="Group By">
                        <filter string="Author" name="author" domain="[]" context="{'group_by':'author'}"/>
                        <filter string="Category" name="category" domain="[]" context="{'group_by':'category_id'}"/>
                        <filter string="State" name="state" domain="[]" context="{'group_by':'state'}"/>
                    </group>
                    <searchpanel>
                        <field name="category_id" string="Categories" enable_counters="1"/>
                    </searchpanel>
               </search>
            </field>
        </record>

    <!-- agrego vista al action la búsqueda automática por las apps de sicpro y la pongo como principal -->
        <record id="base.open_module_tree" model="ir.actions.act_window">
            <field name="context">{'search_default_sicpro':1}</field>
            <field name="search_view_id" ref="sicpro_app_administracion.view_module_filter_inherit"/>
        </record>

    <!-- Desactivo el menu de la tienda de aplicaciones internacional-->
    <record id="base.module_mi" model="ir.ui.menu">
            <field name="active">False</field>
        </record>
    <!-- Desactivo el menu de aplicacione de terceros -->
    <record id="base.menu_third_party" model="ir.ui.menu">
            <field name="active">False</field>
        </record>
    <!-- Desactivo el menu de tienda de temas -->
    <record id="base.menu_theme_store" model="ir.ui.menu">
            <field name="active">False</field>
        </record>



     <!-- Creo los actions para las nube de aplicaciones Apps modules -->
    <record id='action_listado_plicaciones' model='ir.actions.act_url' >
            <field name='name'>Listado de Aplicaciones</field>
            <field name='url'>https://nube.etecsa.cu/f/8687827</field>
        </record>

    <record id='action_backup_sistema' model='ir.actions.act_url' >
            <field name='name'>Backup del Sistema</field>
            <field name='url'>https://nube.etecsa.cu/f/8687836</field>
        </record>

     <!-- Creo menus para las nube de aplicaciones Apps modules -->
        <menuitem id="nube_app_cloud" parent="base.menu_management"
                  name="Nube de Aplicaciones" sequence="10"
                  groups="base.group_no_one"/>

             <menuitem id="nube_app_cloud_cloud" parent="nube_app_cloud"
                  name="Listado de Aplicaciones" sequence="1"
                  action="sicpro_app_administracion.action_listado_plicaciones"/>

             <menuitem id="nube_app_cloud_sync" parent="nube_app_cloud"
                  name="Sincronizar Aplicaciones" sequence="2"
                  action="sicpro_app_administracion.nube_app_sync_action"/>

             <menuitem id="nube_app_cloud_backup" parent="nube_app_cloud"
                  name="Backup del Sistema" sequence="3"
                  action="sicpro_app_administracion.action_backup_sistema"/>








</odoo>
