<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="mantenimiento_tree_view">
            <field name="name">sicpro.app.administracion.mantenimiento.tree</field>
            <field name="model">sicpro.app.administracion.mantenimiento</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <tree string="Versión" editable="bottom" create="false">
                    <field name="name"/>
                    <field name="activar_mantenimiento" widget="boolean_toggle"/>

                    <button name="mod_instalar_ldaps" type="object" class="btn btn-success rounded-bottom"
                            string="Habilitar LDAPS"/>
                    <button name="mod_desintalar_ldaps" type="object" class="btn btn-danger rounded-bottom"
                            string="Deshabilitar LDAPS"/>
                </tree>
            </field>
        </record>

    <record id="mantenimiento_action" model="ir.actions.act_window">
        <field name="name">Modo de Mantenimiento</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.app.administracion.mantenimiento</field>
        <field name="view_id" ref="mantenimiento_tree_view"/>
        <field name="view_mode">tree</field>
    </record>

    </data>
</odoo>