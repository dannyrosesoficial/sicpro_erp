<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="menu_administracion_cambios_version_search" model="ir.ui.view">
       <field name="name">sicpro.app.administracion.cambios.modal.search</field>
       <field name="model">sicpro.app.administracion.cambios</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="name"/>
        </search>
       </field>
    </record>


    <record id="menu_administracion_cambios_version_form" model="ir.ui.view">
            <field name="name">sicpro.app.administracion.cambios.modal.form</field>
            <field name="model">sicpro.app.administracion.cambios</field>
            <field name="priority">120</field>
            <field name="arch" type="xml">
                <form string="Cambios en la versión" create="false" delete="false" edit="false">
                    <group class="o_form_document">
                        <field name="name" readonly="1" nolabel="1"/>
                    </group>
                    <footer>
                        <button string="Aceptar" class="btn-primary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

     <record id="menu_administracion_cambios_version_action" model="ir.actions.act_window">
         <field name="name">Cambios en la versión</field>
         <field name="type">ir.actions.act_window</field>
         <field name="res_model">sicpro.app.administracion.cambios</field>
         <field name="view_id" ref="menu_administracion_cambios_version_form"/>
         <field name="target">new</field>
         <field name="view_mode">form</field>
        </record>


</odoo>