      <field name="body_html" type="html">
        <table
            style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
            cellspacing="0" cellpadding="0" border="0">
          <tbody>
            <tr>
              <td align="center">
                <table style="padding:16px;background-color: white; color: #454748; border-collapse:separate;"
                       width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <!-- ENCABEZADO -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table
                            style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                            width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td valign="middle">
                                <span style="font-size:10px;">Bienvenido/a a SICPRO
                                </span>
                                <br></br>
                                <span style="font-size:20px;font-weight: bold;">
                                  <t t-out="object.name"/>
                                </span>
                              </td>
                              <td valign="middle" align="right">
                                <img src="/sicpro_app_administracion/static/src/img/logo_sicpro 4.png"
                                     style="padding: 0px; margin: 0px; height: auto; width: 25%;"/>
                              </td>
                            </tr>
                            <tr>
                              <td colspan="2" style="text-align:center;">
                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                    width="100%"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                    <!-- CONTENIDO -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <t t-set="invited_users" t-value="object.role_line_ids"/>
                        <table
                            style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                            width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td style="text-align:left">
                                <span style="font-size:20px;font-weight: bold;">
                                  Actualización de roles de usuarios
                                </span>
                                <br></br>
                                <br></br>
                              </td>
                            </tr>
                            <tr>
                              <td style="font-size:13px;" valign="top">
                                <div>
                                  Estimado/a <t t-out="object.name"/>,
                                  <br></br>
                                  <br></br>
                                  Sus roles de usuarios para el sistema SICPRO ERP
                                  fueron actualizados correctamente:

                                  <ul>
                                    <t t-foreach="invited_users"
                                       t-as="invited_user">
                                      <li>
                                        <span style="font-weight: bold;">Rol:
                                        </span>
                                        <t t-out="invited_user.role_id.name"/>
                                        -
                                        <span style="font-weight: bold;">Fecha
                                          Inicio:
                                        </span>
                                        <t t-out="format_date(invited_user.date_from)"/>
                                        -
                                        <span style="font-weight: bold;">Fecha
                                          Fin:
                                        </span>
                                        <t t-out="format_date(invited_user.date_to)"/>
                                      </li>
                                    </t>
                                  </ul>
                                  Haga un seguimiento de sus permisos en el sistema
                                  SICPRO ERP y comienza a trabajar en línea con la
                                  División.
                                  <br></br>
                                  <br></br>
                                  <span
                                      style="box-sizing:border-box;line-height:inherit;font-weight: bolder; font-size: 11px;">
                                    <font style="color: #630000;">IMPORTANTE:
                                    </font>
                                    En el caso de ser solicitado un reinicio de usuario, el sistema estará esperando la
                                    primera
                                    entrada por un periodo de 24 horas, pasado este tiempo sin realizarse el acceso se
                                    procederá
                                    a desactivar nuevamente.
                                  </span>
                                  <br></br>
                                  <br></br>
                                  ¡Que tenga un buen día!
                                  <br></br>
                                  ¡Disfrute de SICPRO!
                                  <br></br>
                                  --<br></br>Equipo de administración SICPRO ERP.
                                </div>
                              </td>
                            </tr>
                            <tr>
                              <td style="text-align:center;">
                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                    width="100%"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                    <!-- PIE -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table
                            style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                            width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td valign="middle" align="left">
                                <t t-out="object.company_id.name"/>
                              </td>
                            </tr>
                            <tr>
                              <td style="opacity:0.7;" valign="middle" align="left">
                                <t t-out="object.company_id.phone"/>
                                <t t-if="object.company_id.email">
                                  |
                                  <a t-att-href="'mailto:%s' % object.company_id.email"
                                     style="color:#454748;">
                                    <t t-out="object.company_id.email"/>
                                  </a>
                                </t>
                                <t t-if="object.company_id.website">
                                  |
                                  <a t-att-href="'%s' % object.company_id.website"
                                     style="color:#454748;">
                                    <t t-out="website_url"/>
                                  </a>
                                </t>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
            <!-- POWERED BY -->
            <tr>
              <td style="min-width:590px;" align="center">
                <br></br>
                <table
                    style="min-width:590px;background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;"
                    width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <tr>
                      <td style="text-align:center;font-size: 13px;">
                        Recibes notificaciones con la tecnología de
                        <b>
                          <a target="_blank" style="color:#875A7B;">
                            <font style="color:rgb(7, 140, 7);">SICPRO</font>
                          </a>
                          <font style="color:rgb(7, 140, 7);">
                            <br></br>
                          </font>
                        </b>
                      </td>

                    </tr>
                    <tr>
                      <td style="text-align:center;font-size: 13px;">
                        <p>
                          <font style="font-size: 10px;" class="text-600">© 2019 - 2023
                            División de Proyectos y Ejecución de Obras, DVPE.
                          </font>
                          <br></br>
                          <font style="font-size: 10px;" class="text-600">Edificio Masónico,
                            Ave. Carlos III / Calle Santiago y Belascoain.
                          </font>
                        </p>
                      </td>

                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>


      </field>
      <field name="lang">{{ object.partner_id.lang }}</field>
      <field name="auto_delete" eval="False"/>
    </record>

  </data>
</odoo>