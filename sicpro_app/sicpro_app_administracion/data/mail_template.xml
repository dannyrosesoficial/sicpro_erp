    <record id="plantilla_invitacion_sicpro" model="mail.template">
      <field name="name">Usuarios: Invitación a usar SICPRO ERP</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="subject">•SICPRO ERP: {{ object.create_uid.name }} le invita a conectarse a SICPRO ERP</field>
      <field name="email_from">"SICPRO ERP" &lt;{{ (object.company_id.email or user.email) }}&gt;</field>
      <field name="email_to">{{ object.email_formatted }}</field>
      <field name="auto_delete" eval="False"/>
      <field name="body_html" type="html">
        <table
            style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
            cellspacing="0" cellpadding="0" border="0">
          <tbody>
            <tr>
              <td align="center">
                <table style="padding:16px;background-color: white; color: #454748; border-collapse:separate;"
                       width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <!-- ENCABEZADO -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table
                            style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                            width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td valign="middle">
                                <span style="font-size:10px;">Bienvenido/a a SICPRO
                                </span>
                                <br></br>
                                <span style="font-size:20px;font-weight: bold;">
                                  <t t-out="object.name"/>
                                </span>
                              </td>
                              <td valign="middle" align="right">
                                <img src="/sicpro_app_administracion/static/src/img/logo_sicpro 4.png"
                                     style="padding:0px;margin: 0px; height: auto; width: 25%;"/>
                              </td>
                            </tr>
                            <tr>
                              <td colspan="2" style="text-align:center;">
                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                    width="100%"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                    <!-- CONTENIDO -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table
                            style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                            width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td style="font-size:13px;" valign="top">
                                <div>Estimado/a <t t-out="object.name"/>,
                                  <br></br>
                                  <br></br>
                                  Ha sido invitado/a
                                  <t t-out="object.company_id.name"/>
                                  para conectarse en SICPRO ERP.
                                  <div style="margin:16px 0px 16px 0px;">
                                    <t t-set="website_url"
                                       t-value="object.get_base_url()"></t>
                                    <a t-att-href='website_url'
                                       style="color:rgb(124, 123, 173);background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                      Aceptar invitación

                                    </a>
                                  </div>
                                  Su dominio SICPRO es:
                                  <b>
                                    <a t-att-href='website_url'>
                                      <t t-out="website_url"/>
                                    </a>
                                  </b>
                                  <br></br>
                                  Su usuario es:
                                  <b>
                                    <a t-attf-href="/web/login?login={{ object.login }}"
                                       target="_blank">
                                      <t t-out="object.login"/>
                                    </a>
                                  </b>
                                  <br></br>
                                  <br></br>
                                  <br></br>Nunca ha escuchado de SICPRO?, es un
                                  sistema desarrollado para la planificación de los
                                  recursos de la División de Proyectos y Ejecución, un
                                  sistema de planeación diseñado para reducir el
                                  tiempo de respuesta, ciclo de producción, optimizar
                                  la calidad, mejorar el manejo de activos, reducir
                                  costos, optimizando la comunicación. SICPRO ERP es
                                  una herramienta que soporta de forma integrada los
                                  procesos claves de la división. Permite realizar
                                  operaciones tales como la generación de solicitudes
                                  de ejecución, ordenes de trabajo, la elaboración de
                                  las preparaciones técnicas, el control de los gastos
                                  certificados, y la gestión de subprocesos como los
                                  de transporte y capital humano, etc.
                                  <br></br>
                                  <br></br>Es una solución que se enfoca en las
                                  necesidades de la DVPE, tomando una visión de los
                                  procesos para cumplir los objetivos corporativos,
                                  buscando integrar todas las funciones de la empresa.
                                  Es un sistema de gestión de la información
                                  estructurado para satisfacer las demandas de
                                  soluciones de la gestión empresarial, basado en el
                                  ofrecimiento de una solución completa que permita a
                                  los procesos claves evaluar, implementar y gestionar
                                  más fácilmente su negocio.
                                  <br></br>
                                  <br></br>
                                  Dele un vistazo para descubrir la herramienta.
                                  <br></br>
                                  <br></br>
                                  ¡Disfrute de SICPRO!<br></br> --<br></br>Equipo de
                                  administración SICPRO ERP.
                                </div>
                              </td>
                            </tr>
                            <tr>
                              <td style="text-align:center;">
                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                    width="100%"/>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                    <!-- PIE -->
                    <tr>
                      <td style="min-width:590px;" align="center">
                        <table
                            style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                            width="590" cellspacing="0" cellpadding="0" border="0">
                          <tbody>
                            <tr>
                              <td valign="middle" align="left">
                                <t t-out="object.company_id.name"/>
                              </td>
                            </tr>
                            <tr>
                              <td style="opacity:0.7;" valign="middle" align="left">
                                <t t-out="object.company_id.phone"/>
                                <t t-if="object.company_id.email">
                                  |
                                  <a t-att-href="'mailto:%s' % object.company_id.email"
                                     style="color:#454748;">
                                    <t t-out="object.company_id.email"/>
                                  </a>
                                </t>
                                <t t-if="object.company_id.website">
                                  |
                                  <a t-att-href="'%s' % object.company_id.website"
                                     style="color:#454748;">
                                    <t t-out="website_url"/>
                                  </a>
                                </t>
                              </td>
                            </tr>
                          </tbody>
                        </table>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
            <!-- POWERED BY -->
            <tr>
              <td style="min-width:590px;" align="center">
                <br></br>
                <table
                    style="min-width:590px;background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;"
                    width="590" cellspacing="0" cellpadding="0" border="0">
                  <tbody>
                    <tr>
                      <td style="text-align:center;font-size: 13px;">
                        Recibes notificaciones con la tecnología de
                        <b>
                          <a target="_blank" style="color:#875A7B;">
                            <font style="color:rgb(7, 140, 7);">SICPRO</font>
                          </a>
                          <font style="color:rgb(7, 140, 7);">
                            <br></br>
                          </font>
                        </b>
                      </td>

                    </tr>
                    <tr>
                      <td style="text-align:center;font-size: 13px;">
                        <p>
                          <font style="font-size:10px;" class="text-600">© 2019 - 2023
                            División de Proyectos y Ejecución de Obras, DVPE.
                          </font>
                          <br></br>
                          <font style="font-size:10px;" class="text-600">Edificio Masónico,
                            Ave. Carlos III / Calle Santiago y Belascoain.
                          </font>
                        </p>
                      </td>

                    </tr>
                  </tbody>
                </table>
              </td>
            </tr>
          </tbody>
        </table>


      </field>
      <field name="lang">{{ object.partner_id.lang }}</field>
      <field name="auto_delete" eval="False"/>
    </record>

