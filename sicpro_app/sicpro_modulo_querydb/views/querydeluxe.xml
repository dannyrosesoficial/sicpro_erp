<odoo>
  <record id="querydeluxe_list" model="ir.ui.view">
    <field name="name">querydeluxe list</field>
    <field name="model">querydeluxe</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" string="Query"/>
        <field name="note" string="Note" optional="show"/>
      </list>
    </field>
  </record>

  <record id="querydeluxe_form" model="ir.ui.view">
    <field name="name">querydeluxe form</field>
    <field name="model">querydeluxe</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="print_result_pdf" string="Imprimir PDF" type="object" class="oe_highlight btn-danger"/>
        </header>
        <sheet>
          <group string="Escribe una consulta">
            <label string="Consulta :" for="name"/>
            <div class="o_row">
              <field name="name" placeholder="SELECT * FROM res_partner" style="border-bottom: 1px solid blue"/>
            </div>
          </group>
          <group>
            <button name="execute" type="object" string="Ejecutar" class="oe_highlight"/>
          </group>
          <group>
            <field name="note" placeholder="La consulta se utiliza para ..."/>
          </group>
          <group>
            <label string=" " for="rowcount"/>
            <div class="o_row">
              <field name="rowcount" readonly="1" nolabel="1"/>
            </div>
          </group>
          <group>
            <label string="" for="html"/>
            <div class="o_row">
              <field name="html" readonly="1"/>
            </div>
          </group>
          <chatter/>
        </sheet>
      </form>
    </field>
  </record>

  <record id="querydeluxe_search" model="ir.ui.view">
    <field name="name">querydeluxe search</field>
    <field name="model">querydeluxe</field>
    <field name="arch" type="xml">
      <search>
        <field name="name" string="Consultas"/>
        <field name="note"/>
        <group name="filter">
          <filter name="with_note" string="Notas" domain="[('note', '!=', False)]"/>
          <separator/>
          <filter name="active" string="Activo" domain="[('active', '=', True)]"/>
          <filter name="archive" string="Archivado" domain="[('active', '=', False)]"/>
        </group>
        <group name="group_by">
          <filter name="name" string="Consultas" context="{'group_by': 'name'}"/>
          <filter name="note" string="Notas" context="{'group_by': 'note'}"/>
        </group>
      </search>
    </field>
  </record>

  <record model='ir.actions.act_window' id='querydeluxe_action'>
    <field name="name">Crear nueva consulta</field>
    <field name="res_model">querydeluxe</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="sicpro_querydb_menu" name="Base Datos Query" groups="base.group_system"
            parent="sicpro_app_administracion.menu_configuracion_administrador" sequence="200"/>

  <menuitem id="query_deluxe_submenu_querydeluxe" parent="sicpro_querydb_menu" action="querydeluxe_action"
            sequence="1"/>
</odoo>
