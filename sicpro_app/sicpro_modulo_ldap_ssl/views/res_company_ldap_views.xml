<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_ldap_installer_form" model="ir.ui.view">
    <field name="name">res.company.ldap.form.inherit.sicpro</field>
    <field name="model">res.company.ldap</field>
    <field name="inherit_id" ref="auth_ldap.view_ldap_installer_form"/>
    <field name="arch" type="xml">

      <xpath expr="//field[@name='ldap_tls']" position="before">
        <field name="ssl"/>
        <field name="validar_certificado"/>
        <field name="active" invisible="1"/>
      </xpath>

      <xpath expr="//field[@name='ldap_base']" position="before">
        <field name="dir_certificado"
               invisible="ssl == False or validar_certificado == True"
               required="ssl == True and validar_certificado == False"/>
      </xpath>

    </field>
  </record>

  <record id="view_ldaps_installer_list" model="ir.ui.view">
    <field name="name">res.company.ldap.list.inherit.sicpro</field>
    <field name="model">res.company.ldap</field>
    <field name="inherit_id" ref="auth_ldap.res_company_ldap_view_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='company']" position="after">
        <field name="active" widget="boolean_toggle"/>
      </xpath>
    </field>
  </record>
</odoo>