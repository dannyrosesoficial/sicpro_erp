<?xml version="1.0" encoding="utf-8" ?>

<odoo>
    <record id="view_res_users_role_form" model="ir.ui.view">
        <field name="name">sicpro.modulo.roles.form</field>
        <field name="model">sicpro.modulo.roles</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="group_id" required="0" readonly="1"/>
                            <field name="roles_especiales"/>
                        </group>
                        <group name="code">
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                    <label for="descripcion"/>
                    <field name="descripcion"/>
                    <notebook>
                        <page string="Grupos">
                            <field name="implied_ids" nolabel="1"/>
                        </page>
                        <page string="Usuarios">
                            <field name="line_ids" nolabel="1">
                                <tree
                                        editable="bottom" decoration-muted="not is_enabled">
                                    <field name="user_id"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="is_enabled"/>
                                </tree>
                            </field>
                        </page>
                        <page name="page_internal_notes" string="Notas Internas">
                            <field name="comment"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_users_role_tree" model="ir.ui.view">
        <field name="name">sicpro.modulo.roles.tree</field>
        <field name="model">sicpro.modulo.roles</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_ids"/>
                <field name="implied_ids"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="view_res_users_role_search" model="ir.ui.view">
        <field name="name">sicpro.modulo.roles.search</field>
        <field name="model">sicpro.modulo.roles</field>
        <field name="arch" type="xml">
            <search string="Roles">
                <field name="name"/>
                <field name="user_ids"/>
                <field name="implied_ids"/>
                <separator/>
                <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Roles Especiales" name="roles_especiales" domain="[('roles_especiales','=',True)]"/>
                <separator/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_res_users_role_tree">
        <field name="name">Roles</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sicpro.modulo.roles</field>
        <field name="view_id" ref="view_res_users_role_tree"/>
    </record>

    <menuitem
            id="menu_action_res_users_role_tree"
            parent="base.menu_users"
            action="action_res_users_role_tree"
    />
</odoo>
