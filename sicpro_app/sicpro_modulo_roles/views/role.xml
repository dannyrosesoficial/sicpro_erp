<odoo>
  <record id="view_res_users_role_search" model="ir.ui.view">
    <field name="name">res.users.role.search</field>
    <field name="model">res.users.role</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="user_ids"/>
        <field name="implied_ids"/>
        <separator/>
        <filter name="is_default" string="Por defecto" domain="[('is_default', '=', True)]"/>
        <filter string="Archivado" name="inactive" domain="[('active','=',False)]"/>
        <separator/>
        <filter string="Roles Especiales" name="roles_especiales" domain="[('roles_especiales','=',True)]"/>
        <separator/>
      </search>
    </field>
  </record>

  <record id="view_res_users_role_form" model="ir.ui.view">
    <field name="name">res.users.role.form</field>
    <field name="model">res.users.role</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="show_model_access_ids" type="object" class="oe_stat_button" icon="fa-book">
              <field name="model_access_count" widget="statinfo" string="Derechos de acceso"/>
            </button>
            <button name="show_rule_ids" type="object" class="oe_stat_button" icon="fa-server">
              <field name="rules_count" widget="statinfo" string="Reglas de registro"/>
            </button>
          </div>
          <group>
            <group>
              <field name="active" invisible="1"/>
              <field name="name"/>
              <field name="group_id" required="0" readonly="1"/>
              <field name="roles_especiales"/>
              <field name="is_default"/>
            </group>
            <group name="code">
              <field name="color" widget="color_picker"/>
            </group>
          </group>
          <group>
            <field name="descripcion"/>
          </group>
          <notebook>
            <page string="Grupos">
              <field name="implied_ids" nolabel="1" widget="many2many_tags" class="w-100" ptions="{'no_create': True}"/>
            </page>
            <page string="Usuarios">
              <field name="line_ids" nolabel="1">
                <list editable="bottom" decoration-muted="not is_enabled">
                  <field name="user_id"/>
                  <field name="date_from"/>
                  <field name="date_to"/>
                  <field name="is_enabled"/>
                </list>
              </field>
            </page>
            <page name="page_internal_notes" string="Notas internas">
              <field name="comment"/>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_res_users_role_list" model="ir.ui.view">
    <field name="name">res.users.role.list</field>
    <field name="model">res.users.role</field>
    <field name="arch" type="xml">
      <list>
        <field name="sequence" widget="handle"/>
        <field name="name"/>
        <field name="is_default" string="Predeterminados"/>
        <field name="user_ids"/>
        <field name="implied_ids"/>
        <field name="color" widget="color_picker"/>
      </list>
    </field>
  </record>

  <record id="action_res_users_role_list" model="ir.actions.act_window">
    <field name="name">Roles de Usuarios</field>
    <field name="res_model">res.users.role</field>
    <field name="path">user-role</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="view_res_users_role_list"/>
  </record>

  <menuitem id="menu_action_res_users_role_list" parent="base.menu_users" action="action_res_users_role_list"/>
</odoo>
